load"Element_PkLagrange3d"
load"medit"
load"qf11to25"
load"MUMPS"
load "GrundmannMoller"
func uex=1./(3*pi^2)*sin(pi*x)*sin(pi*y)*sin(pi*z);
func f=sin(pi*x)*sin(pi*y)*sin(pi*z);

NewMacro MacroCvrgce (PK)
    int order=14;
    macro Grad(u) [dx(u),dy(u), dz(u)] // EOM
    for (int npts=1; npts<5;npts++){
    mesh3 ThG = cube(npts,npts,npts);

    fespace UhG(ThG,PK);

    UhG u,v;
    int GMactivated =1; 
    if(GMactivated==0)
    {
        solve pph(u,v,solver=sparsesolver) =

            int3d(ThG,qforder=order)(Grad(u)'*Grad(v))-int3d(ThG,qforder=order)(f*v)

            +on(1,2,3,4,5,6, u=0);

        real Err= (sqrt( int3d(ThG,qforder=order)((u-uex)^2)));
        real NormRef=(sqrt( int3d(ThG,qforder=order)(uex^2)));
        cout<<"Error= "<<Err/NormRef<<endl;
        //plot(u,cmm="u");
    }

    else if(GMactivated==1) {

        int GMorder=10;
        solve pph(u,v,solver=sparsesolver) =
            int3d(ThG,qfV=GMQuadrature3D(GMorder))(Grad(u)'*Grad(v))-int3d(ThG,qfV=GMQuadrature3D(GMorder))(f*v)
            +on(1,2,3,4,5,6, u=0);

        real Err= (sqrt( int3d(ThG,qfV=GMQuadrature3D(GMorder))((u-uex)^2)));
        real NormRef=(sqrt( int3d(ThG,qfV=GMQuadrature3D(GMorder))((uex)^2)));
        //plot(u,cmm="u");
        cout<<"Error= "<<Err/NormRef<<endl;
    }



    }


EndMacro



{cout<<"My PK "<<endl;

MacroCvrgce (PKLP63d);

}


