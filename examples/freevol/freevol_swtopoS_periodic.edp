// shallow water with topography on a surface (meshS) by the finite volume method with periodic boundary conditions
// (the system of freevol_swtopoS.edp: unknowns [H,Hu,Hv,Hw,zb] P0, the momentum tangent, the gravity normal to the
// surface)
//   the surface: the graph z = h(x,y) over [0,1]^2, h periodic in x and y (square3, labels 1 bottom, 2 right, 3 top,
//   4 left, as square), a wavy surface (-a 0: the plane z = 0); zb periodic
//   fvscheme FV([H,Hu,Hv,Hw,zb], eq="swtopo", ..., periodic=[[1,x],[3,x],[2,y],[4,y]]) (the syntax of a 2D fespace:
//   the faces are the edges): the edges of the borders 1 and 3 with the same x (2 and 4: the same y) are glued
//   (hydrostatic reconstruction with the zb of the 2 sides, the state of the neighbour turned into the plane of the
//   cell as on the interior edges)
//   -cas 0: the lake at rest (H + zb = 1, no velocity): it stays at rest, also across the periodic borders
//   -cas 1: a bump of H on the lake: the mass is conserved
// options: -cas (1), -n (16), -a (0.1), -Tf (0.2), -ordre (2 or 1), -nw: without plot
load "msh3"
include "getARGV.idp"
int n = getARGV("-n", 16), ordre = getARGV("-ordre", 2), cas = getARGV("-cas", 1);
real a = getARGV("-a", 0.1), Tf = getARGV("-Tf", 0.2), gr = 1., CFL = 0.5;
func h = a*(sin(2*pi*x) + cos(2*pi*y)) + 0.5*a*sin(2*pi*x)*sin(2*pi*y);   // periodic
meshS Th = square3(n, n, [x, y, h]);
fespace Ph(Th, P0);
func z0 = 0.1*cos(2*pi*x)*sin(2*pi*y);   // periodic topography
Ph zb = z0, H = 1 - z0 + cas*0.2*exp(-((x-0.3)^2+(y-0.5)^2)/0.01), Hu = 0, Hv = 0, Hw = 0;
Ph Hp, Hup, Hvp, Hwp, Hr = 0, Hur = 0, Hvr = 0, Hwr = 0, zbr = 0, HBC = 0, HuBC = 0, HvBC = 0, HwBC = 0, zbBC = 0;
real[int] params = [gr];
int[int] labBC = [1,2, 2,2, 3,2, 4,2];   // walls: no effect on the periodic borders
fvscheme FV([H,Hu,Hv,Hw,zb], eq="swtopo", labelBC=labBC, parameters=params, order=ordre,
            periodic=[[1,x],[3,x],[2,y],[4,y]]);
real m0 = int2d(Th)(H), t = 0, dt, dtsub;
Ph eta = H + zb;
plot(eta, cmm="surface (periodic): H + zb at t = 0", wait=1);
int it;
for (it = 0; t < Tf - 1e-10; it++) {
  Hp[] = H[]; Hup[] = Hu[]; Hvp[] = Hv[]; Hwp[] = Hw[];
  for (int l = 1; l <= 2; l++) {          // Heun, second order in time
    dtsub = fluxupdate(FV, [H,Hu,Hv,Hw,zb], [Hr,Hur,Hvr,Hwr,zbr], [HBC,HuBC,HvBC,HwBC,zbBC]);
    if (l == 1) { dt = CFL*dtsub; if (t + dt > Tf) dt = Tf - t; }
    H[] -= dt*Hr[]; Hu[] -= dt*Hur[]; Hv[] -= dt*Hvr[]; Hw[] -= dt*Hwr[];
    if (l == 1) t += dt;
    if (l == 2) { H[] += Hp[]; H[] *= .5; Hu[] += Hup[]; Hu[] *= .5; Hv[] += Hvp[]; Hv[] *= .5; Hw[] += Hwp[]; Hw[] *= .5; }
  }
}
eta = H + zb;
Ph q = sqrt(Hu^2+Hv^2+Hw^2);
cout << "swtopo surface periodic (cas " << cas << ", order " << ordre << ", n = " << n << ", a = " << a << ") : t = " << t << " , "
     << it << " steps , " << Th.nt << " triangles" << endl;
cout << "  mass " << int2d(Th)(H) << " (difference " << int2d(Th)(H)-m0 << ") , H + zb in [" << eta[].min << ", " << eta[].max
     << "] , max |H u| " << q[].max << endl;
plot(eta, cmm="surface (periodic): H + zb at t = " + t, wait=1);
