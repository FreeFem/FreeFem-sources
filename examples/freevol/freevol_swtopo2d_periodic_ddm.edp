// solves the shallow water system with topography by the finite volume method (2D, mesh)
// with periodic boundary conditions, parallel version (domain decomposition, PETSc) of freevol_swtopo2d_periodic.edp:
//   the shallow water on a periodic topography (-cas 0: the lake at rest, -cas 1: a hump of water in a flow)
//   the partition: createMat with macro ThPeriodicity()labPeriodic// (the labels of the periodic borders, macro_ddm.idp):
//   all the elements near the periodic borders are on one process (with the overlap: 2 cells, the order 2),
//   so the 2 sides of a periodic border are in the same local mesh, where fvscheme(..., periodic=...) glues them; the
//   other processes have no periodic border
//   at each stage: the time step is the min on all the processes, then exchange(A, Hr, scaled=true)
//   at the end, the solution is gathered on the global mesh (A.D): the same outputs as freevol_swtopo2d_periodic.edp
//   (the same values)
// run: ff-mpirun -np 4 freevol_swtopo2d_periodic_ddm.edp -wg   (options: -cas (1), -n (20), -Tf (5), -ordre (2 or 1), -nw: without plot)
// NBPROC 4
load "PETSc"                               // PETSc plugin
include "macro_ddm.idp"                    // additional DDM functions
include "getARGV.idp"
real s0 = clock();
real gr = 9.81;
int cas = getARGV("-cas", 1);
int n = getARGV("-n", 20), ordre = getARGV("-ordre", 2);
real L = 10.;
mesh ThG = square(n, n, [L*x, L*y]);       // labels 1 bottom, 2 right, 3 top, 4 left
real Tf = getARGV("-Tf", 5.), CFL = .5;
func z0 = 0.3*sin(2.*pi*x/L)*cos(2.*pi*y/L) + 0.2*cos(4.*pi*x/L);   // periodic topography
func h0 = (cas == 0) ? 2. - z0 : 2. - z0 + 0.5*exp(-((x-0.3*L)^2+(y-0.5*L)^2)/2.);
func hu0 = (cas == 0) ? 0. : 0.5*h0;
func PKN = [P0,P0,P0,P0];
mesh Th = ThG;                             // the local mesh
int[int] n2o;                              // local cell -> global cell
Mat A;
{
  macro ThOverlap()2//
  macro ThN2O()n2o//
  int[int] labPeriodic = [1, 3, 2, 4];
  macro ThPeriodicity()labPeriodic//       // the elements near the periodic borders on one process
  macro def(u)[u, u#B, u#C, u#D]// EOM
  macro init(u)[u, u, u, u]// EOM
  createMat(Th, A, PKN)
}
fespace PhN(Th, PKN);
fespace PhNG(ThG, PKN);
fespace PhG(ThG, P0);
PhN [H,Hu,Hv,zb] = [h0, hu0, 0, z0], [HBC,HuBC,HvBC,zbBC] = [0,0,0,0], [Hr,Hur,Hvr,zbr] = [0,0,0,0];
PhN [Hp,Hup,Hvp,zbp];
real[int] params = [gr];
int[int] labBC = [1,2, 2,2, 3,2, 4,2];   // no effect on the periodic borders; the interfaces (-111111): Neumann
fvscheme FV([H,Hu,Hv,zb], order=ordre, eq="swtopo", labelBC=labBC, limiter=1, numflux=0, parameters=params,
            periodic=[[1,x],[3,x],[2,y],[4,y]]);
// the local solution gathered on the global mesh (each cell counted once: the partition of unity A.D)
PhN [HD,HuD,HvD,zbD]; HD[] = A.D;
macro gather(Uloc, Uglob) { real[int] gl(Uglob[].n); gl = 0;
  for (int k = 0; k < Th.nt; k++) for (int c = 0; c < 4; c++) gl[4*n2o[k]+c] += HD[][4*k+c]*Uloc[][4*k+c];
  mpiAllReduce(gl, Uglob[], mpiCommWorld, mpiSUM); }//
PhNG [HG0,HuG0,HvG0,zbG0];
gather(H, HG0)
real t, dt, dtsub, dtl;
int iter = 0;
for (t = 0.; t < Tf-1.e-10; iter++) {
  Hp[] = H[];
  for (int l = 1; l <= 2; l++) {          // Heun, second order in time
    dtl = fluxupdate(FV, [H,Hu,Hv,zb], [Hr,Hur,Hvr,zbr], [HBC,HuBC,HvBC,zbBC]);
    mpiAllReduce(dtl, dtsub, mpiCommWorld, mpiMIN);
    exchange(A, Hr[], scaled=true);        // the overlap: the values of their process
    if (l == 1) { dt = dtsub*CFL; if (t+dt > Tf) dt = Tf-t; }
    H[] -= dt*Hr[];
    if (l == 1) t += dt;
    if (l == 2) { H[] += Hp[]; H[] *= .5; }
  }
}
PhNG [HG,HuG,HvG,zbG];
gather(H, HG)
if (!mpirank) {
  cout << "swtopo 2D periodic ddm (" << mpisize << " processes, order " << ordre << ", n = " << n << ") : t = " << t << " , " << iter << " steps" << endl;
  PhG h = HG, eta = HG + zbG, eta0 = HG0 + zbG0, qx = HuG, qy = HvG;
  real[int] deta = eta[] - eta0[];
  cout << "  mass " << int2d(ThG)(HG) << " (difference " << int2d(ThG)(HG)-int2d(ThG)(HG0) << ") , min H " << h[].min
       << " , max |H+zb - (H+zb)(0)| " << deta.linfty << " , max |Hu| " << qx[].linfty << " , max |Hv| " << qy[].linfty << endl;
  cout << "cputime = " << clock()-s0 << endl;
}
