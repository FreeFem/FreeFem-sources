// advection in 2D (mesh) by finite volumes with periodic boundary conditions, parallel version
// (domain decomposition, PETSc) of freevol_advection2d_periodic.edp: the same case, the same scheme
//   the partition: createMat with macro ThPeriodicity()labPeriodic// (the labels of the periodic boundaries, macro_ddm.idp):
//   all the cells near the periodic boundaries are on one process (with the overlap), so the 2 sides of a
//   periodic boundary are in the same local mesh, where fvscheme(..., periodic=...) glues them; the other
//   processes have no periodic boundary (a periodic face without its partner in the local mesh would become
//   a face of the local mesh boundary, -111111)
//   at each stage: the time step is the min over all the processes, then exchange(A, ur, scaled=true)
//   at the end, the solution is gathered on the global mesh (A.D: each cell counted once): mass, L2
//   error (to compare with freevol_advection2d_periodic.edp: the same values)
// run: ff-mpirun -np 4 freevol_advection2d_periodic_ddm.edp -wg   (options: -n (40), -ordre (2 or 1), -Tf (2),
//   -nw: no plot)
// NBPROC 4
load "PETSc"                               // PETSc plugin
include "macro_ddm.idp"                    // additional DDM functions
include "getARGV.idp"
bool adapt = getARGV("-adapt", 1);
int n = getARGV("-n", 40), ordre = getARGV("-ordre", 2);
real Tf = getARGV("-Tf", 2.);
mesh ThG = square(n, n);                   // the global mesh, labels 1 bottom, 2 right, 3 top, 4 left
fespace PhG(ThG, P0);
// the periodic initial data (the gaussian and its neighboring images)
func real gp(real xx, real yy) {
  real s = 0;
  for (int i = -1; i <= 1; i++) for (int j = -1; j <= 1; j++) s += exp(-((xx-0.5-i)^2+(yy-0.5-j)^2)/0.01);
  return s;
}
mesh Th = ThG;                             // the local mesh
int[int] n2o;                              // local cell -> global cell
Mat A;
{
  macro ThOverlap()2//                     // overlap of 2 cells (order 2)
  macro ThN2O()n2o//
  int[int] labPeriodic = [1, 3, 2, 4];
  macro ThPeriodicity()labPeriodic//       // the cells near the periodic boundaries on one process
  createMat(Th, A, P0)
}
fespace Ph(Th, P0);
Ph u = gp(x, y), up, ur = 0, uBC = 0;
Ph V1 = 1, V2 = 0.5;                       // constant velocity
int[int] labBC = [1,1, 2,1, 3,1, 4,1];     // no effect on the periodic boundaries; the interfaces (-111111): Neumann
fvscheme FV([V1,V2], eq="advection", labelBC=labBC, numflux=2, order=ordre, periodic=[[1,x],[3,x],[2,y],[4,y]]);
Ph D; D[] = A.D;                           // the partition of unity (1 on the cells of the process)
PhG u0G = gp(x, y);
real mass0 = int2d(ThG)(u0G), t = 0, dt, dtsub, dtl, CFL = 0.9;
int it;
for (it = 0; t < Tf - 1e-10; it++) {
  up[] = u[];
  for (int l = 1; l <= 2; l++) {           // Heun, second order in time
    dtl = fluxupdate(FV, [u], [ur], [uBC]);
    mpiAllReduce(dtl, dtsub, mpiCommWorld, mpiMIN);
    exchange(A, ur[], scaled=true);        // ur of the overlap cells: the one of their process
    if (l == 1) { dt = CFL*dtsub; if (t + dt > Tf) dt = Tf - t; }
    u[] -= dt*ur[];
    if (l == 1) t += dt;
    if (l == 2) { u[] += up[]; u[] *= .5; }
  }
}
// the solution gathered on the global mesh (each cell counted once)
PhG uG;
{ real[int] gl(ThG.nt); gl = 0; for (int k = 0; k < Th.nt; k++) gl[n2o[k]] += D[][k]*u[][k];
  mpiAllReduce(gl, uG[], mpiCommWorld, mpiSUM); }
func uex = gp(x - t - floor(x - t), y - 0.5*t - floor(y - 0.5*t));
real err = sqrt(int2d(ThG, qforder=5)((uG-uex)^2)), mass = int2d(ThG)(uG);
if (!mpirank) cout << "2D periodic ddm (" << mpisize << " processes, order " << ordre << ", n = " << n << "): t = " << t << " , "
                   << it << " steps , mass = " << mass << " (deviation " << mass-mass0 << ") , max u = " << uG[].max
                   << " , L2 error = " << err << endl;
if (!mpirank) plot(uG, fill=1, value=1, cmm="2D periodic ddm: solution at t = " + t, wait=1);
