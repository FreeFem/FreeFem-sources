// advection in 2D (mesh) by finite volumes: the same fvscheme command as in 1D and 3D,
// the dimension is given by the mesh of the velocity
// a gaussian rotated around the center of the square (rotation at angular velocity 1), P0 unknown and velocity
// options: -n (segments per side, 100), -nw: no plot
include "getARGV.idp"
int n = getARGV("-n", 100), ordre = getARGV("-ordre", 2);
mesh Th = square(n, n);                    // labels 1 to 4 on the sides of the square
fespace Ph(Th, P0);
func u0 = exp(-((x-0.3)^2+(y-0.5)^2)/0.01);
Ph u = u0, up, ur = 0, uBC = 0;
Ph V1 = -(y-0.5), V2 = x-0.5;              // rotation around the center (2 components in 2D)
int[int] labBC = [1,1, 2,1, 3,1, 4,1];               // 1: Neumann
fvscheme FV([V1,V2], eq="advection", labelBC=labBC, numflux=2, order=ordre);
real mass0 = int2d(Th)(u);
real t = 0, dt, dtsub, CFL = 0.9, Tf = 1.;
real dtplot = .1, tplot = min(dtplot, Tf);// the solution is plotted every dtplot (dt is cut to reach these times)
plot(u, cmm="2D: initial data (" + Th.nt + " triangles)", fill=1, value=1, wait=1);
int it;
for (it = 0; t < Tf - 1e-10; it++) {
  up[] = u[];
  for (int l = 1; l <= 2; l++) {           // Heun, second order in time
    dtsub = fluxupdate(FV, [u], [ur], [uBC]);
    if (l == 1) { dt = CFL*dtsub; if (t + dt > tplot) dt = tplot - t; }
    u[] -= dt*ur[];
    if (l == 1) t += dt;
    if (l == 2) { u[] += up[]; u[] *= .5; }
  }
  if (t > tplot - 1e-10) {plot(u, cmm="2D: solution at t = " + t + " (" + Th.nt + " triangles)", fill=1, value=1, wait=0); tplot = min(tplot + dtplot, Tf);}
}
// the exact solution: u0 rotated by the angle t
func uex = exp(-(((x-0.5)*cos(t)+(y-0.5)*sin(t)+0.2)^2+(-(x-0.5)*sin(t)+(y-0.5)*cos(t))^2)/0.01);
real err = sqrt(int2d(Th, qforder=5)((u-uex)^2));
cout << "2D: t = " << t << " , " << it << " steps , " << Th.nt << " triangles , mass = " << int2d(Th)(u)
     << " (initial " << mass0 << ") , max u = " << u[].max << " , L2 error = " << err << endl;
plot(u, cmm="2D: solution at t = " + t + " (" + Th.nt + " triangles)", fill=1, value=1, wait=1);
