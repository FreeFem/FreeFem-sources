// the BBM-BBM (Boussinesq) system in 2D (mesh) by a finite volume / finite element method:
//   A_BBM dE/dt + div([F(E),G(E)]) = 0, A_BBM = diag(I - b Delta, I - d Delta, I - d Delta),
//   E = [eta,u,v], F(E) = ((1+eta) u, eta + (u^2+v^2)/2, 0), G(E) = ((1+eta) v, 0, eta + (u^2+v^2)/2)
//   finite volume / finite element method with two meshes (G. Sadaka, as freevol_bbm2d_circle.edp): the finite
//   volumes on Th (P0, the values at the barycenters of the cells), the finite elements on Th1, the mesh whose
//   vertices are the barycenters of Th (P1, the values at the vertices): the transfer P0 (Th) <-> P1 (Th1) is
//   exact (the same values, no interpolation). At each stage of the Heun scheme:
//     1) finite volumes (FreeVol, eq="bbm", walls): R = div([F(E),G(E)]), E P0 on Th (fluxupdate)
//     2) R on Th1 (P1, R1 = R at the barycenters), finite elements P1 on Th1, the whole system together
//        (as FreeVol_BBM_FB.edp, varf vBBM): A_BBM W = -R1 (the walls are in the finite volumes: natural
//        Neumann boundary conditions on Th1); the matrix dAK1 is factorized once
//     3) W back on Th (the values at the vertices of Th1 = the values at the barycenters of Th), E += dt*W
//   b = d = 0: W = -R exactly, the finite volume scheme alone
//   1D: freevol_bbm1d.edp (meshL); the plots: plotFreeVol2d (the depth 1+eta above the bottom -1)
// options: -ordre (1 or 2), -nf (numflux), -lim (limiter), -b, -d
include "getARGV.idp"
real s0=clock();
load "isoline"// extractborder
load "Curvature"// Curve

macro case() Harbor//
// labels: 1 the walls y = constant, 2 the walls x = constant
IFMACRO(case,Gauss)
   // a hump of water at rest in a square basin: circular dispersive waves
   real Tf=15.;
   int Npx=60;
   int[int] lab=[1,2,1,2];
   mesh Th=square(Npx,Npx,[40*x-20,40*y-20],label=lab,flags=3);// flags=3: no triangle with 2 edges on the border
   func eta0 = 0.3*exp(-(x^2+y^2)/4.);
   func u0 = 0.; func v0 = 0.;
   macro bbsw() [[-20.,0.],[20.,20.]]// the window of the plots: half of the basin, cut at y = 0
ENDIFMACRO
IFMACRO(case,Channel)
   // the case Gauss of freevol_bbm1d.edp in a channel (invariant in y): compare with the 1D result
   real Tf=30.;
   int[int] lab=[1,2,1,2];
   mesh Th=square(600,4,[120*x-60,4*y-2],label=lab,flags=3);
   func eta0 = 0.2*exp(-(x/2.)^2);
   func u0 = 0.; func v0 = 0.;
   macro bbsw() [[-60.,-2.],[60.,2.]]//
ENDIFMACRO
IFMACRO(case,Harbor)
   // a wave going to the right (u = eta) through the entrance of a harbor (two breakwaters)
   real Tf=60.;
   real xa=-60., xb=60., ya=-15., yb=15., x0=5., x1=10., y0=2.;// breakwaters x0 < x < x1, |y| > y0
   border b1(t=xa,x0){x=t; y=ya; label=1;}
   border b2(t=ya,-y0){x=x0; y=t; label=2;}
   border b3(t=x0,x1){x=t; y=-y0; label=1;}
   border b4(t=-y0,ya){x=x1; y=t; label=2;}
   border b5(t=x1,xb){x=t; y=ya; label=1;}
   border b6(t=ya,yb){x=xb; y=t; label=2;}
   border b7(t=xb,x1){x=t; y=yb; label=1;}
   border b8(t=yb,y0){x=x1; y=t; label=2;}
   border b9(t=x1,x0){x=t; y=y0; label=1;}
   border b10(t=y0,yb){x=x0; y=t; label=2;}
   border b11(t=x0,xa){x=t; y=yb; label=1;}
   border b12(t=yb,ya){x=xa; y=t; label=2;}
   real h=0.75;// the size of the cells
   int n1=int((x0-xa)/h), n2=int((-ya-y0)/h), n3=int((x1-x0)/h), n5=int((xb-x1)/h), n6=int((yb-ya)/h);
   mesh Th=buildmesh(b1(n1)+b2(n2)+b3(n3)+b4(n2)+b5(n5)+b6(n6)+b7(n5)+b8(n2)+b9(n3)+b10(n2)+b11(n1)+b12(n6),
                     splitpbedge=1);// splitpbedge: no triangle with 2 edges on the border
   func eta0 = 0.2/cosh(0.5*(x+35.))^2;
   func u0 = 0.2/cosh(0.5*(x+35.))^2; func v0 = 0.;
   macro bbsw() [[-60.,-15.],[60.,15.]]//
ENDIFMACRO

int ordre=getARGV("-ordre",2), nfl=getARGV("-nf",0), lim=getARGV("-lim",1);
real b=getARGV("-b",1./6.), d=getARGV("-d",1./6.);
fespace Ph3(Th,[P0,P0,P0]);
fespace Ph(Th,P0);
Ph3 [eta,u,v]=[eta0,u0,v0], [etaBC,uBC,vBC]=[0,0,0], [Re,Ru,Rv]=[0,0,0];
Ph3 [etap,up,vp];// for the Heun scheme
int[int] labBC=[1,2,2,2];// walls
fvscheme FV([eta,u,v],order=ordre,eq="bbm",labelBC=labBC,limiter=lim,numflux=nfl);

// the mesh of the finite elements Th1: the vertices are the barycenters of Th (Delaunay triangulation of the
// barycenters, then the triangles with their barycenter out of Th removed: Th may be not convex, Harbor; the
// buildmesh with the border of Th + trunc of freevol_bbm2d_circle.edp loses the barycenters of the cells with 3
// vertices on the border, at the corners of Gauss and Harbor)
mesh Th1;
{
   real[int,int] b12(1,3);
   int[int] lab = labels(Th);
   real l12=extractborder(Th,lab,b12);
   b12(2,:)=0:b12.m-1;// the parameter of the curve: the number of the point
   border BB(t=0,1){P=Curve(b12,t);label=1;};
   Ph Px=x,Py=y;// the barycenters
   real[int,int] PF(Px[].n,2);
   for(int i=0;i<Px[].n;i++){ PF(i,0)=Px[](i); PF(i,1)=Py[](i); }
   Th1=buildmesh(BB(b12.m-1),points=PF,nbvx=PF.n+Th.nbe,fixedborder=1);
   Th1=change(Th1,fregion=0);
   fespace Ph1(Th1,P0);
   Ph1 order;
   OrderVF(Th1,order[],3);// order = 1 for the triangles with a vertex on the border
   Th1=trunc(Th1,order==2,label=1);
}
// k1[i]: the cell of Th whose barycenter is the vertex i of Th1 (P1 on Th1 <-> P0 on Th)
int[int] k1(Th1.nv), seen(Th.nt); seen=0;
for(int i=0;i<Th1.nv;i++){ k1[i]=Th(Th1(i).x,Th1(i).y).nuTriangle; seen[k1[i]]++; }
if(Th1.nv!=Th.nt || seen.min!=1) { cout << "Th1: the vertices are not the barycenters of Th" << endl; exit(1); }

// the finite element part on Th1: (Mm + b K) W = -Mm R1, K the P1 stiffness matrix on Th1, Mm the mass matrix
//   Mm = diag(|K_k|), the areas of the cells of Th (vertex i of Th1 <-> cell k1[i] of Th): the mass of eta on Th
//   is conserved exactly (K 1 = 0) and the symmetry in y is kept
//   the 3 lines together (G. Sadaka, varf vBBM): one matrix dAK1 of size 3*Th1.nv on [P1,P1,P1]
real tfe=0., tfe0=clock();// the cputime of the finite element part
Ph ar=area;
// the matrix of the whole system, dof 3*i+c (vertex i of Th1, component c), the same numbering
// as [P0,P0,P0] on Th (3*k+c): K3[3*i+c] = 3*k1[i]+c
fespace Wh(Th1,[P1,P1,P1]);
macro grad(u)[dx(u),dy(u)]//
varf vBBM([etah,uh,vh],[veta,vu,vv])=int2d(Th1)(b*grad(etah)'*grad(veta)+d*grad(uh)'*grad(vu)+d*grad(vh)'*grad(vv));// without the mass term
matrix Mm3, dAK1;
int[int] K3(3*Th1.nv);
for(int i=0;i<Th1.nv;i++) for(int c=0;c<3;c++) K3[3*i+c]=3*k1[i]+c;
Wh [r1e,r1u,r1v], [W1e,W1u,W1v];
{ real[int] da3(3*Th1.nv); for(int i=0;i<Th1.nv;i++) for(int c=0;c<3;c++) da3[3*i+c]=ar[][k1[i]];
  Mm3=[da3]; matrix K3m=vBBM(Wh,Wh); dAK1=Mm3+K3m; }
set(dAK1,solver=sparsesolver);
tfe+=clock()-tfe0;
// one stage: E -> W = -A^-1 div(F(E)), dtfv the time step of the finite volumes (CFL = 1)
macro bbmstage(dtfv){
  dtfv=fluxupdate(FV,[eta,u,v],[Re,Ru,Rv],[etaBC,uBC,vBC]);
  real tfe1=clock();
  r1e[]=Re[](K3);/* [Re,Ru,Rv] on Th -> [r1e,r1u,r1v] on Th1 (each vertex of Th1 is the barycenter of a cell) */
  real[int] bb3=Mm3*r1e[]; bb3=-bb3;
  W1e[]=dAK1^-1*bb3;
  Re[](K3)=W1e[];/* W on Th, in [Re,Ru,Rv] */
  tfe+=clock()-tfe1;
}//
macro advance(dt){ eta[]+=dt*Re[]; }// E += dt*W ([Re,Ru,Rv] = W)

real m0=int2d(Th)(eta);
real t=0., dt, dtfv, CFL=.5, tdraw=Tf/20.;
int ntdraw=0, iter=0;
// plotFreeVol2d(Th, 1+eta, -1, {options of plot}): the water above the bottom -1, see plotFreeVol.idp
include "plotFreeVol.idp"
plotFreeVolbb(bbsw)
for(t=0.; t<Tf-1.e-10; iter++){// TIME LOOP
    if(t >= ntdraw*tdraw) { Ph hp=1+eta; plotFreeVol2d(Th,hp,-1,{cmm="eta at t="+t,wait=0}) ntdraw++; }
    etap[]=eta[];
    bbmstage(dtfv)
    dt=CFL*dtfv; if(t+dt > Tf) dt=Tf-t;
    advance(dt)
    bbmstage(dtfv)
    advance(dt)
    eta[]+=etap[]; eta[]*=.5;// Heun
    t+=dt;
}//end of time loop
{ Ph hp=1+eta; plotFreeVol2d(Th,hp,-1,{cmm="eta at t="+t,wait=1}) }
Ph etaf=eta;
cout << Th.nt << " triangles (Th1: " << Th1.nt << " triangles), " << iter << " time steps, cputime = " << clock()-s0 << " (finite elements: " << tfe << ")" << endl;
cout << "mass error of eta = " << int2d(Th)(eta)-m0 << " , min eta = " << etaf[].min << " , max eta = " << etaf[].max << endl;
IFMACRO(case,Channel)
  // the profile on y = 0, to compare with freevol_bbm1d.edp (case Gauss, -n 600)
  { ofstream f("bbm2d_channel.txt"); for(int i=0;i<=1200;i++) { real xx=-60+120.*i/1200; f << xx << " " << etaf(xx,0.) << endl; } }
ENDIFMACRO
