// solves the system of freevol_swtopo3d.edp (the barotropic gas dynamics with a potential force) by the finite volume method in 3D (mesh3) with periodic boundary
// conditions, parallel version (domain decomposition, PETSc) of freevol_swtopo3d_periodic.edp:
//   the barotropic gas with a periodic potential zb (-cas 0: the lake at rest, -cas 1: a bump of H in a flow)
//   the partition: createMat with macro ThPeriodicity()labPeriodic// (the labels of the 6 periodic sides, macro_ddm.idp):
//   all the elements near the periodic sides are on one process (with the overlap: 2 cells, the order 2),
//   so the 2 sides of a periodic border are in the same local mesh, where fvscheme(..., periodic=...) glues them; the
//   other processes have no periodic side; the cube must not be too small (n >= 16: else the band near the
//   periodic sides is the whole cube, an empty local mesh for the other processes)
//   at each stage: the time step is the min on all the processes, then exchange(A, Hr, scaled=true)
//   at the end, the solution is gathered on the global mesh (A.D): the same outputs as freevol_swtopo3d_periodic.edp with
//   -n 16 -Tf 0.05 (the same values)
// run: ff-mpirun -np 4 freevol_swtopo3d_periodic_ddm.edp -wg   (options: -n (16), -Tf (0.05), -ordre (2 or 1), -cas (1), -nw: without plot)
// NBPROC 4
load "PETSc"                               // PETSc plugin
macro dimension()3// EOM
include "macro_ddm.idp"                    // additional DDM functions
include "getARGV.idp"
real s0 = clock();
real gr = 9.81;
int cas = getARGV("-cas", 1);
int n = getARGV("-n", 16), ordre = getARGV("-ordre", 2);
real Tf = getARGV("-Tf", 0.05), CFL = .5;
mesh3 ThG = cube(n, n, n);                  // labels 1 y=0, 2 x=1, 3 y=1, 4 x=0, 5 z=0, 6 z=1
func z0 = 0.3*sin(2.*pi*x)*cos(2.*pi*y) + 0.2*cos(2.*pi*z);   // periodic
func h0 = 2. - z0 + 0.5*cas*exp(-((x-0.3)^2+(y-0.5)^2+(z-0.5)^2)/0.02);
func PKN = [P0,P0,P0,P0,P0];
mesh3 Th = ThG;                            // the local mesh
int[int] n2o;                              // local cell -> global cell
Mat A;
{
  macro ThOverlap()2//
  macro ThN2O()n2o//
  int[int] labPeriodic = [1, 3, 2, 4, 5, 6];
  macro ThPeriodicity()labPeriodic//       // the elements near the periodic sides on one process
  macro def(u)[u, u#B, u#C, u#D, u#E]// EOM
  macro init(u)[u, u, u, u, u]// EOM
  createMat(Th, A, PKN)
}
fespace PhN(Th, PKN);
fespace PhNG(ThG, PKN);
fespace PhG(ThG, P0);
PhN [H,Hu,Hv,Hw,zb] = [h0, 0.5*cas*h0, 0, 0, z0], [HBC,HuBC,HvBC,HwBC,zbBC] = [0,0,0,0,0], [Hr,Hur,Hvr,Hwr,zbr] = [0,0,0,0,0];
PhN [Hp,Hup,Hvp,Hwp,zbp];
real[int] params = [gr];
int[int] labBC = [1,2, 2,2, 3,2, 4,2, 5,2, 6,2];   // no effect on the periodic sides; the interfaces (-111111): Neumann
fvscheme FV([H,Hu,Hv,Hw,zb], order=ordre, eq="swtopo", labelBC=labBC, limiter=1, numflux=2, parameters=params,
            periodic=[[1,x,z],[3,x,z],[2,y,z],[4,y,z],[5,x,y],[6,x,y]]);
// the local solution gathered on the global mesh (each cell counted once: the partition of unity A.D)
PhN [HD,HuD,HvD,HwD,zbD]; HD[] = A.D;
macro gather(Uloc, Uglob) { real[int] gl(Uglob[].n); gl = 0;
  for (int k = 0; k < Th.nt; k++) for (int c = 0; c < 5; c++) gl[5*n2o[k]+c] += HD[][5*k+c]*Uloc[][5*k+c];
  mpiAllReduce(gl, Uglob[], mpiCommWorld, mpiSUM); }//
PhNG [HG0,HuG0,HvG0,HwG0,zbG0];
gather(H, HG0)
real t, dt, dtsub, dtl;
int iter = 0;
for (t = 0.; t < Tf-1.e-10; iter++) {
  Hp[] = H[];
  for (int l = 1; l <= 2; l++) {          // Heun, second order in time
    dtl = fluxupdate(FV, [H,Hu,Hv,Hw,zb], [Hr,Hur,Hvr,Hwr,zbr], [HBC,HuBC,HvBC,HwBC,zbBC]);
    mpiAllReduce(dtl, dtsub, mpiCommWorld, mpiMIN);
    exchange(A, Hr[], scaled=true);        // the overlap: the values of their process
    if (l == 1) { dt = dtsub*CFL; if (t+dt > Tf) dt = Tf-t; }
    H[] -= dt*Hr[];
    if (l == 1) t += dt;
    if (l == 2) { H[] += Hp[]; H[] *= .5; }
  }
}
PhNG [HG,HuG,HvG,HwG,zbG];
gather(H, HG)
if (!mpirank) {
  cout << "swtopo 3D periodic ddm (" << mpisize << " processes, order " << ordre << ", n = " << n << ") : t = " << t << " , " << iter << " steps" << endl;
  PhG h = HG, eta = HG + zbG, eta0 = HG0 + zbG0, q1 = HuG, q2 = HvG, q3 = HwG;
  real[int] deta = eta[] - eta0[];
  cout << "  mass " << int3d(ThG)(HG) << " (difference " << int3d(ThG)(HG)-int3d(ThG)(HG0) << ") , min H " << h[].min << " , max |H+zb - (H+zb)(0)| " << deta.linfty
       << " , max |Hu| " << q1[].linfty << " " << q2[].linfty << " " << q3[].linfty << endl;
  cout << "cputime = " << clock()-s0 << endl;
}
