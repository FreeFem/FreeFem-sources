// solves the system of isentropic gas dynamics in 3D (mesh3): a minimal example (a few seconds), to check
// that the 3D version works:  U_t+div(F(U)) = 0, U=[rho,rho*u,rho*v,rho*w], p = kappa*rho^gamma
// cases:
//   Ball       : a ball of dense gas in a box with walls (mass, positivity, symmetry x,y,z -> y,z,x)
//   ShockTube1D: the shock tube of freevol_igd1d.edp in a bar, compared with the exact solution
// the same command fvscheme as in 1D and 2D: the dimension is given by the mesh of [rho,rhou,rhov,rhow]
// parallel version (domain decomposition, PETSc) of freevol_igd3d.edp: the same cases, the same scheme; the mesh
// is partitioned by createMat (overlap: macro ordre, 2 cells for the order 2, 1 cell for the order 1), fvscheme on the local mesh, the
// interfaces (label -111111): Neumann (the default), their cells are overlap cells set again by the exchange; at
// each stage: the time step the min on all the processes, then exchange(A,Hr,scaled=true); at the end the
// solution is gathered on the whole mesh ThG (ThN2O, A.D): the outputs of freevol_igd3d.edp
// run: ff-mpirun -np 2 freevol_igd3d_ddm.edp -wg   (-nw: no plot)
load "PETSc"// PETSc plugin
macro dimension()3// EOM
include "macro_ddm.idp"// additional DDM functions
macro def1(u) u// for plotMPI
macro PARAMS fill=true,value=true,wait=0,cmm = // for plotMPI
macro PARAMSW fill=true,value=true,wait=1,cmm = // for plotMPI (the last plot)
real s0=clock();
load "msh3"
macro case() Ball//
real gamma=1.4, kappa=1.;
IFMACRO(case,Ball)
   real Tf=.3;
   int Npx=10;
   mesh3 Th = cube(Npx,Npx,Npx,[2*x-1,2*y-1,2*z-1]);
   func rho0 = 1.+((x^2+y^2+z^2)<.25);
   func u0 = 0.;
ENDIFMACRO
IFMACRO(case,ShockTube1D)
   real Tf=.15;
   int Npx=200;
   real xp=0., xp1=1., x0=0.5, rhoL=1., uL=0., rhoR=0.125, uR=0.;
   mesh3 Th = cube(Npx,1,1,[x,0.02*y,0.02*z]);
   func rho0 = (x<x0)*rhoL+(x>=x0)*rhoR;
   func u0 = 0.;
ENDIFMACRO
real t,dt,CFL=.5;
func PK=[P0,P0,P0,P0];
mesh3 ThG=Th;// the whole mesh (for the outputs)
fespace PhG(ThG,P0);
macro ordre()2// the order of the scheme (2 or 1): also the overlap of the partition
Mat A;
int[int] n2o;// local cell -> global cell
{
   IFMACRO(ordre,2)
   macro ThOverlap()2// 2 cells for the order 2
   ENDIFMACRO
   IFMACRO(ordre,1)
   macro ThOverlap()1// 1 cell for the order 1
   ENDIFMACRO
   macro ThN2O()n2o//
   macro def(u)[u, u#B, u#C, u#D]// EOM
   macro init(u)[u, u, u, u]// EOM
   createMat(Th, A, PK)// Th: the local mesh (with overlap)
}
fespace Ph4(Th,PK);
fespace Ph(Th,P0);
Ph4 [H,Hu,Hv,Hw]=[rho0,0,0,0],[HBC,HuBC,HvBC,HwBC]=[0,0,0,0],[Hr,Hur,Hvr,Hwr]=[0,0,0,0];
Ph4 [Hp,Hup,Hvp,Hwp];//for second order in time
int[int] labBC=[1,2,2,2,3,2,4,2,5,2,6,2];// walls on the 6 faces of the cube
Ph4 [D0,D0B,D0C,D0D]; D0[]=A.D;// the partition of unity (1 on the cells of the process)
Ph Dc=D0;
// the local solution gathered on the whole mesh ThG (the partition of unity: each cell counted once)
macro gather(uloc,uglob){ real[int] gl(ThG.nt); gl=0; for(int k=0;k<Th.nt;k++) gl[n2o[k]]+=Dc[][k]*uloc[][k];
  mpiAllReduce(gl,uglob[],mpiCommWorld,mpiSUM); }//
real mass0;
{ PhG HG; Ph h0l=H; gather(h0l,HG) mass0=int3d(ThG)(HG); }
{ Ph rho=H; plotMPI(Th, rho, P0, def1, real, PARAMS "rho at t=0") }

int mtordre=2;// order of accuracy in time (1 or 2)
real[int] params=[gamma,kappa];
fvscheme FV([H,Hu,Hv,Hw],order=ordre,eq="igd",labelBC=labBC,limiter=1,numflux=2,parameters=params);

int iter=0;
real dtsub, rmin=1e30;
for(t=0.; t<Tf-1.e-10; iter++){// TIME LOOP
    if (mtordre==2) Hp[]=H[];
    for (int lmt=1;lmt<=mtordre;lmt++) {// internal time loop for second order in time
     real dtl = fluxupdate(FV,[H,Hu,Hv,Hw],[Hr,Hur,Hvr,Hwr],[HBC,HuBC,HvBC,HwBC]);
     mpiAllReduce(dtl,dtsub,mpiCommWorld,mpiMIN);
     exchange(A,Hr[],scaled=true);// the overlap cells: the values of their process
     if (lmt==1) {
      dt=dtsub*CFL;
      if(t+dt > Tf) dt=Tf-t;
     }
     H[] -= dt*Hr[];
     if (lmt==1) t+=dt;
     if (lmt==2) {//second-order Heun scheme in time
      H[]+=Hp[];
      H[]*=.5;
     }
    }//end of internal loop on lmt
    Ph rho=H; real rl=rho[].min, rg; mpiAllReduce(rl,rg,mpiCommWorld,mpiMIN); rmin=min(rmin,rg);
}//end of time loop
{ Ph rhol=H; plotMPI(Th, rhol, P0, def1, real, PARAMSW "rho at t="+t) }
// the outputs of freevol_igd3d.edp, on the whole mesh ThG (the local solution gathered)
PhG rho; { Ph c=H; gather(c,rho) }
if (!mpirank) {
cout << "3D (" << mpisize << " processes): " << ThG.nt << " tetrahedra, " << iter << " time steps, cputime = " << clock()-s0 << endl;
cout << "mass error = " << (int3d(ThG)(rho)-mass0)/mass0 << " , min rho (all the steps) = " << rmin << endl;
IFMACRO(case,Ball)
  // symmetry of the ball and of the mesh of cube (invariant by the circular permutation of x,y,z)
  PhG hsym=rho(y,z,x);
  hsym[]-=rho[];
  cout << "symmetry: max |rho(x,y,z)-rho(y,z,x)| = " << hsym[].linfty << endl;
ENDIFMACRO
IFMACRO(case,ShockTube1D)
// ---- the exact solution of the Riemann problem
  func real pres(real r) { return kappa*r^gamma; }
  func real cson(real r) { return sqrt(gamma*kappa*r^(gamma-1.)); }
  func real rhoofc(real c) { return (c^2/(gamma*kappa))^(1./(gamma-1.)); }
  // velocity change across the wave from the state rk to r (rarefaction if r<rk, shock otherwise)
  func real gwave(real r, real rk) {
     if (r <= rk) return 2./(gamma-1.)*(cson(r)-cson(rk));
     return sqrt((pres(r)-pres(rk))*(r-rk)/(r*rk));
  }
  real rhos=0., us=0.;// the intermediate state
  {
     real a=0., b=10.*max(rhoL,rhoR)+10.;
     if (gwave(0.,rhoL)+gwave(0.,rhoR)+uR-uL >= 0.) { rhos=0.; us=0.; }// vacuum
     else {
        for (int i=0; i<200; i++) { real m=(a+b)/2; if (gwave(m,rhoL)+gwave(m,rhoR)+uR-uL > 0.) b=m; else a=m; }
        rhos=(a+b)/2; us=uL-gwave(rhos,rhoL);
     }
  }
  real rexa, uexa;// the exact solution at xi = (x-x0)/t, set by riemann(xi)
  func real riemann(real xi) {
     real cL=cson(rhoL), cR=cson(rhoR);
     if (rhos<=0.) {// vacuum: two rarefactions down to rho=0
        if (xi <= uL-cL) { rexa=rhoL; uexa=uL; }
        else if (xi <= uL+2./(gamma-1.)*cL) { uexa=2./(gamma+1.)*(cL+(gamma-1.)/2.*uL+xi); rexa=rhoofc(uexa-xi); }
        else if (xi < uR-2./(gamma-1.)*cR) { rexa=0.; uexa=0.; }
        else if (xi < uR+cR) { uexa=2./(gamma+1.)*(-cR+(gamma-1.)/2.*uR+xi); rexa=rhoofc(xi-uexa); }
        else { rexa=rhoR; uexa=uR; }
        return rexa;
     }
     real cs=cson(rhos);
     if (xi <= us) {// left of the contact: the 1-wave
        if (rhos > rhoL) {// shock
           real s=(rhos*us-rhoL*uL)/(rhos-rhoL);
           if (xi < s) { rexa=rhoL; uexa=uL; } else { rexa=rhos; uexa=us; }
        } else {// rarefaction
           if (xi <= uL-cL) { rexa=rhoL; uexa=uL; }
           else if (xi >= us-cs) { rexa=rhos; uexa=us; }
           else { uexa=2./(gamma+1.)*(cL+(gamma-1.)/2.*uL+xi); rexa=rhoofc(uexa-xi); }
        }
     } else {// the 2-wave
        if (rhos > rhoR) {
           real s=(rhos*us-rhoR*uR)/(rhos-rhoR);
           if (xi > s) { rexa=rhoR; uexa=uR; } else { rexa=rhos; uexa=us; }
        } else {
           if (xi >= uR+cR) { rexa=rhoR; uexa=uR; }
           else if (xi <= us+cs) { rexa=rhos; uexa=us; }
           else { uexa=2./(gamma+1.)*(-cR+(gamma-1.)/2.*uR+xi); rexa=rhoofc(xi-uexa); }
        }
     }
     return rexa;
  }
  PhG xc=x, rhoe;
  for (int k=0;k<ThG.nt;k++) rhoe[][k]=riemann((xc[][k]-x0)/t);
  cout << "shock tube: L1 error on rho (per unit section) = " << int3d(ThG)(abs(rho-rhoe))/0.02^2 << " (1D with 200 cells: 0.0018)" << endl;
ENDIFMACRO
}
