// solves the Euler system of gas dynamics by the finite volume method in 2D (mesh) with periodic boundary conditions
//   fvscheme FV([H,Hu,Hv,E], eq="euler", ..., periodic=[[1,x],[3,x],[2,y],[4,y]] (the syntax of a fespace)): the boundary faces of the
//   linked borders are glued and become interior faces (the flux computed once, the slopes of the order 2 see the
//   neighbours on the other side)
//   -cas 1: a periodic wave rho = 1+0.2 sin(...), u = constant, p = 1: the mass, the momentum and the energy are
//           conserved exactly
//   -cas 0: a constant state: it stays constant
// options: -cas (1), -n (16), -Tf (0.3), -ordre (2 or 1), -nw: without plot
include "getARGV.idp"
real gamma = 1.4, p0 = 1., L = 1.;
int n = getARGV("-n", 16), ordre = getARGV("-ordre", 2), cas = getARGV("-cas", 1);
real Tf = getARGV("-Tf", 0.3), CFL = .5;
mesh Th = square(n, n, [L*x, L*y]);       // labels 1 bottom, 2 right, 3 top, 4 left
fespace PhN(Th, [P0,P0,P0,P0]);
fespace Ph(Th, P0);
func rho0 = 1. + 0.2*cas*sin(2.*pi*(x+y)/L);
PhN [H,Hu,Hv,E] = [rho0, 1.*rho0, 0.5*rho0, p0/(gamma-1.) + 0.5*rho0*(1.^2+0.5^2)], [HBC,HuBC,HvBC,EBC] = [0,0,0,0], [Hr,Hur,Hvr,Er] = [0,0,0,0];
PhN [Hp,Hup,Hvp,Ep];
real[int] params = [gamma];
int[int] labBC = [1,1, 2,1, 3,1, 4,1];   // no effect on the periodic borders
fvscheme FV([H,Hu,Hv,E], order=ordre, eq="euler", labelBC=labBC, limiter=1, numflux=2, parameters=params,
            periodic=[[1,x],[3,x],[2,y],[4,y]]);
Ph s0 = H;
Ph s1 = Hu;
Ph s2 = Hv;
Ph s3 = E;
real[int] c0 = [int2d(Th)(s0), int2d(Th)(s1), int2d(Th)(s2), int2d(Th)(s3)];
real t, dt, dtsub;
int iter = 0;
for (t = 0.; t < Tf-1.e-10; iter++) {
  Hp[] = H[];
  for (int l = 1; l <= 2; l++) {          // Heun, second order in time
    dtsub = fluxupdate(FV, [H,Hu,Hv,E], [Hr,Hur,Hvr,Er], [HBC,HuBC,HvBC,EBC]);
    if (l == 1) { dt = dtsub*CFL; if (t+dt > Tf) dt = Tf-t; }
    H[] -= dt*Hr[];
    if (l == 1) t += dt;
    if (l == 2) { H[] += Hp[]; H[] *= .5; }
  }
  plot(H,dim=2,fill=1);
}
s0 = H; s1 = Hu; s2 = Hv; s3 = E; 
real[int] drho = s0[];
drho -= 1.;
cout << "euler 2D periodic (cas " << cas << ", order " << ordre << ", n = " << n << ") : t = " << t << " , " << iter << " steps" << endl;
cout << "  conservation (mass, momentum, energy): " << int2d(Th)(s0) - c0[0] << " " << int2d(Th)(s1) - c0[1] << " " << int2d(Th)(s2) - c0[2] << " " << int2d(Th)(s3) - c0[3] << endl;
cout << "  min rho " << s0[].min << " , max rho " << s0[].max << endl;
if (cas == 0) cout << "  constant state: max |rho-1| " << drho.linfty << endl;
