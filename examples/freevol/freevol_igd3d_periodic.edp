// solves the system of isentropic gas dynamics in 3D (mesh3) with periodic boundary conditions
//   U_t+div(F(U)) = 0, U=[rho,rho*u,rho*v,rho*w], p = kappa*rho^gamma, parameters=[gamma,kappa]
//   fvscheme FV([H,Hu,Hv,Hw], eq="igd", ..., periodic=[[1,x,z],[3,x,z],[2,y,z],[4,y,z],[5,x,y],[6,x,y]]) (the syntax
//   of a 3D fespace): the faces of the opposite sides of the cube with the same values of the 2 functions at their
//   vertices are glued (interior faces: the flux computed once)
//   -cas 1: a periodic wave rho = 1+0.2 sin(2 pi (x+y+z)), u = (1, 0.5, 0.25): the mass and the 3 components of the
//           momentum are conserved exactly
//   -cas 0: a constant state: it stays constant
// options: -cas (1), -n (segments by side, 8), -Tf (0.5), -ordre (2 or 1), -nw: without plot
load "msh3"
include "getARGV.idp"
real gamma = 1.4, kappa = 1.;
int n = getARGV("-n", 8), ordre = getARGV("-ordre", 2), cas = getARGV("-cas", 1);
real Tf = getARGV("-Tf", 0.5), CFL = .5;
mesh3 Th = cube(n, n, n);                  // labels 1 y=0, 2 x=1, 3 y=1, 4 x=0, 5 z=0, 6 z=1
fespace Ph4(Th, [P0,P0,P0,P0]);
fespace Ph(Th, P0);
func rho0 = 1. + 0.2*cas*sin(2.*pi*(x+y+z));
Ph4 [H,Hu,Hv,Hw] = [rho0, rho0, 0.5*rho0, 0.25*rho0], [HBC,HuBC,HvBC,HwBC] = [0,0,0,0], [Hr,Hur,Hvr,Hwr] = [0,0,0,0];
Ph4 [Hp,Hup,Hvp,Hwp];
real[int] params = [gamma, kappa];
int[int] labBC = [1,1, 2,1, 3,1, 4,1, 5,1, 6,1];   // no effect on the periodic sides
fvscheme FV([H,Hu,Hv,Hw], order=ordre, eq="igd", labelBC=labBC, limiter=1, numflux=2, parameters=params,
            periodic=[[1,x,z],[3,x,z],[2,y,z],[4,y,z],[5,x,y],[6,x,y]]);
real m0 = int3d(Th)(H), qx0 = int3d(Th)(Hu), qy0 = int3d(Th)(Hv), qz0 = int3d(Th)(Hw);
real t, dt, dtsub;
int iter = 0;
for (t = 0.; t < Tf-1.e-10; iter++) {
  Hp[] = H[];
  for (int l = 1; l <= 2; l++) {          // Heun, second order in time
    dtsub = fluxupdate(FV, [H,Hu,Hv,Hw], [Hr,Hur,Hvr,Hwr], [HBC,HuBC,HvBC,HwBC]);
    if (l == 1) { dt = dtsub*CFL; if (t+dt > Tf) dt = Tf-t; }
    H[] -= dt*Hr[];
    if (l == 1) t += dt;
    if (l == 2) { H[] += Hp[]; H[] *= .5; }
  }
}
Ph rho = H, q1 = Hu;
real[int] drho = rho[], dq = q1[];
drho -= 1.; dq -= 1.;
cout << "igd 3D periodic (cas " << cas << ", order " << ordre << ", n = " << n << ") : t = " << t << " , " << iter << " steps , "
     << Th.nt << " tetrahedra" << endl;
cout << "  conservation: mass " << int3d(Th)(H)-m0 << " , momentum " << int3d(Th)(Hu)-qx0 << " " << int3d(Th)(Hv)-qy0 << " "
     << int3d(Th)(Hw)-qz0 << " , min rho " << rho[].min << " , max rho " << rho[].max << endl;
if (cas == 0) cout << "  constant state: max |rho-1| " << drho.linfty << " , max |rho u-1| " << dq.linfty << endl;
plot(rho, cmm="rho at t=" + t + " (periodic)", wait=1);
