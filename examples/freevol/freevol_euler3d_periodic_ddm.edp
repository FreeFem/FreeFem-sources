// solves the Euler system of gas dynamics by the finite volume method in 3D (mesh3) with periodic boundary
// conditions, parallel version (domain decomposition, PETSc) of freevol_euler3d_periodic.edp:
//   a periodic wave rho = 1+0.2 sin(2 pi (x+y+z)), u = (1, 0.5, 0.25), p = 1 (-cas 0: a constant state)
//   the partition: createMat with macro ThPeriodicity()labPeriodic// (the labels of the 6 periodic sides, macro_ddm.idp):
//   all the elements near the periodic sides are on one process (with the overlap: 2 cells, the order 2),
//   so the 2 sides of a periodic border are in the same local mesh, where fvscheme(..., periodic=...) glues them; the
//   other processes have no periodic side; the cube must not be too small (n >= 16: else the band near the
//   periodic sides is the whole cube, an empty local mesh for the other processes)
//   at each stage: the time step is the min on all the processes, then exchange(A, Hr, scaled=true)
//   at the end, the solution is gathered on the global mesh (A.D): the same outputs as freevol_euler3d_periodic.edp with
//   -n 16 -Tf 0.1 (the same values)
// run: ff-mpirun -np 4 freevol_euler3d_periodic_ddm.edp -wg   (options: -n (16), -Tf (0.1), -ordre (2 or 1), -cas (1), -nw: without plot)
// NBPROC 4
load "PETSc"                               // PETSc plugin
macro dimension()3// EOM
include "macro_ddm.idp"                    // additional DDM functions
include "getARGV.idp"
real s0 = clock();
real gamma = 1.4, p0 = 1.;
int cas = getARGV("-cas", 1);
int n = getARGV("-n", 16), ordre = getARGV("-ordre", 2);
real Tf = getARGV("-Tf", 0.1), CFL = .5;
mesh3 ThG = cube(n, n, n);                  // labels 1 y=0, 2 x=1, 3 y=1, 4 x=0, 5 z=0, 6 z=1
func rho0 = 1. + 0.2*cas*sin(2.*pi*(x+y+z));
func PKN = [P0,P0,P0,P0,P0];
mesh3 Th = ThG;                            // the local mesh
int[int] n2o;                              // local cell -> global cell
Mat A;
{
  macro ThOverlap()2//
  macro ThN2O()n2o//
  int[int] labPeriodic = [1, 3, 2, 4, 5, 6];
  macro ThPeriodicity()labPeriodic//       // the elements near the periodic sides on one process
  macro def(u)[u, u#B, u#C, u#D, u#E]// EOM
  macro init(u)[u, u, u, u, u]// EOM
  createMat(Th, A, PKN)
}
fespace PhN(Th, PKN);
fespace PhNG(ThG, PKN);
fespace PhG(ThG, P0);
PhN [H,Hu,Hv,Hw,E] = [rho0, 1.*rho0, 0.5*rho0, 0.25*rho0, p0/(gamma-1.) + 0.5*rho0*(1.^2+0.5^2+0.25^2)], [HBC,HuBC,HvBC,HwBC,EBC] = [0,0,0,0,0], [Hr,Hur,Hvr,Hwr,Er] = [0,0,0,0,0];
PhN [Hp,Hup,Hvp,Hwp,Ep];
real[int] params = [gamma];
int[int] labBC = [1,1, 2,1, 3,1, 4,1, 5,1, 6,1];   // no effect on the periodic sides; the interfaces (-111111): Neumann
fvscheme FV([H,Hu,Hv,Hw,E], order=ordre, eq="euler", labelBC=labBC, limiter=1, numflux=2, parameters=params,
            periodic=[[1,x,z],[3,x,z],[2,y,z],[4,y,z],[5,x,y],[6,x,y]]);
// the local solution gathered on the global mesh (each cell counted once: the partition of unity A.D)
PhN [HD,HuD,HvD,HwD,ED]; HD[] = A.D;
macro gather(Uloc, Uglob) { real[int] gl(Uglob[].n); gl = 0;
  for (int k = 0; k < Th.nt; k++) for (int c = 0; c < 5; c++) gl[5*n2o[k]+c] += HD[][5*k+c]*Uloc[][5*k+c];
  mpiAllReduce(gl, Uglob[], mpiCommWorld, mpiSUM); }//
PhNG [HG0,HuG0,HvG0,HwG0,EG0];
gather(H, HG0)
real t, dt, dtsub, dtl;
int iter = 0;
for (t = 0.; t < Tf-1.e-10; iter++) {
  Hp[] = H[];
  for (int l = 1; l <= 2; l++) {          // Heun, second order in time
    dtl = fluxupdate(FV, [H,Hu,Hv,Hw,E], [Hr,Hur,Hvr,Hwr,Er], [HBC,HuBC,HvBC,HwBC,EBC]);
    mpiAllReduce(dtl, dtsub, mpiCommWorld, mpiMIN);
    exchange(A, Hr[], scaled=true);        // the overlap: the values of their process
    if (l == 1) { dt = dtsub*CFL; if (t+dt > Tf) dt = Tf-t; }
    H[] -= dt*Hr[];
    if (l == 1) t += dt;
    if (l == 2) { H[] += Hp[]; H[] *= .5; }
  }
}
PhNG [HG,HuG,HvG,HwG,EG];
gather(H, HG)
if (!mpirank) {
  cout << "euler 3D periodic ddm (" << mpisize << " processes, order " << ordre << ", n = " << n << ") : t = " << t << " , " << iter << " steps" << endl;
  PhG rho = HG;
  cout << "  conservation: " << int3d(ThG)(HG)-int3d(ThG)(HG0) << " " << int3d(ThG)(HuG)-int3d(ThG)(HuG0) << " " << int3d(ThG)(HvG)-int3d(ThG)(HvG0) << " " << int3d(ThG)(HwG)-int3d(ThG)(HwG0) << " " << int3d(ThG)(EG)-int3d(ThG)(EG0) << endl;
  cout << "  min rho " << rho[].min << " , max rho " << rho[].max << endl;
  cout << "cputime = " << clock()-s0 << endl;
}
