// solves the Euler system of gas dynamics by the finite volume method (2D, mesh)
// with periodic boundary conditions, parallel version (domain decomposition, PETSc) of freevol_euler2d_periodic.edp:
//   a periodic wave rho = 1+0.2 sin(2 pi (x+y)), u = (1, 0.5), p = 1 (-cas 0: a constant state)
//   the partition: createMat with macro ThPeriodicity()labPeriodic// (the labels of the periodic borders, macro_ddm.idp):
//   all the elements near the periodic borders are on one process (with the overlap: 2 cells, the order 2),
//   so the 2 sides of a periodic border are in the same local mesh, where fvscheme(..., periodic=...) glues them; the
//   other processes have no periodic border
//   at each stage: the time step is the min on all the processes, then exchange(A, Hr, scaled=true)
//   at the end, the solution is gathered on the global mesh (A.D): the same outputs as freevol_euler2d_periodic.edp
//   (the same values)
// run: ff-mpirun -np 4 freevol_euler2d_periodic_ddm.edp -wg   (options: -cas (1), -n (16), -Tf (0.3), -ordre (2 or 1), -nw: without plot)
// NBPROC 4
load "PETSc"                               // PETSc plugin
include "macro_ddm.idp"                    // additional DDM functions
include "getARGV.idp"
real s0 = clock();
real gamma = 1.4, p0 = 1.;
int cas = getARGV("-cas", 1);
int n = getARGV("-n", 16), ordre = getARGV("-ordre", 2);
real L = 1.;
mesh ThG = square(n, n, [L*x, L*y]);       // labels 1 bottom, 2 right, 3 top, 4 left
real Tf = getARGV("-Tf", 0.3), CFL = .5;
func rho0 = 1. + 0.2*cas*sin(2.*pi*(x+y)/L);
func PKN = [P0,P0,P0,P0];
mesh Th = ThG;                             // the local mesh
int[int] n2o;                              // local cell -> global cell
Mat A;
{
  macro ThOverlap()2//
  macro ThN2O()n2o//
  int[int] labPeriodic = [1, 3, 2, 4];
  macro ThPeriodicity()labPeriodic//       // the elements near the periodic borders on one process
  macro def(u)[u, u#B, u#C, u#D]// EOM
  macro init(u)[u, u, u, u]// EOM
  createMat(Th, A, PKN)
}
fespace PhN(Th, PKN);
fespace PhNG(ThG, PKN);
fespace PhG(ThG, P0);
PhN [H,Hu,Hv,E] = [rho0, 1.*rho0, 0.5*rho0, p0/(gamma-1.) + 0.5*rho0*(1.^2+0.5^2)], [HBC,HuBC,HvBC,EBC] = [0,0,0,0], [Hr,Hur,Hvr,Er] = [0,0,0,0];
PhN [Hp,Hup,Hvp,Ep];
real[int] params = [gamma];
int[int] labBC = [1,1, 2,1, 3,1, 4,1];   // no effect on the periodic borders; the interfaces (-111111): Neumann
fvscheme FV([H,Hu,Hv,E], order=ordre, eq="euler", labelBC=labBC, limiter=1, numflux=2, parameters=params,
            periodic=[[1,x],[3,x],[2,y],[4,y]]);
// the local solution gathered on the global mesh (each cell counted once: the partition of unity A.D)
PhN [HD,HuD,HvD,ED]; HD[] = A.D;
macro gather(Uloc, Uglob) { real[int] gl(Uglob[].n); gl = 0;
  for (int k = 0; k < Th.nt; k++) for (int c = 0; c < 4; c++) gl[4*n2o[k]+c] += HD[][4*k+c]*Uloc[][4*k+c];
  mpiAllReduce(gl, Uglob[], mpiCommWorld, mpiSUM); }//
PhNG [HG0,HuG0,HvG0,EG0];
gather(H, HG0)
real t, dt, dtsub, dtl;
int iter = 0;
for (t = 0.; t < Tf-1.e-10; iter++) {
  Hp[] = H[];
  for (int l = 1; l <= 2; l++) {          // Heun, second order in time
    dtl = fluxupdate(FV, [H,Hu,Hv,E], [Hr,Hur,Hvr,Er], [HBC,HuBC,HvBC,EBC]);
    mpiAllReduce(dtl, dtsub, mpiCommWorld, mpiMIN);
    exchange(A, Hr[], scaled=true);        // the overlap: the values of their process
    if (l == 1) { dt = dtsub*CFL; if (t+dt > Tf) dt = Tf-t; }
    H[] -= dt*Hr[];
    if (l == 1) t += dt;
    if (l == 2) { H[] += Hp[]; H[] *= .5; }
  }
}
PhNG [HG,HuG,HvG,EG];
gather(H, HG)
if (!mpirank) {
  cout << "euler 2D periodic ddm (" << mpisize << " processes, order " << ordre << ", n = " << n << ") : t = " << t << " , " << iter << " steps" << endl;
  PhG rho = HG;
  cout << "  conservation (mass, momentum, energy): " << int2d(ThG)(HG)-int2d(ThG)(HG0) << " " << int2d(ThG)(HuG)-int2d(ThG)(HuG0) << " "
       << int2d(ThG)(HvG)-int2d(ThG)(HvG0) << " " << int2d(ThG)(EG)-int2d(ThG)(EG0) << endl;
  cout << "  min rho " << rho[].min << " , max rho " << rho[].max << endl;
  cout << "cputime = " << clock()-s0 << endl;
}
