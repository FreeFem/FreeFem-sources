// Test 3
real[int] bb(6);
boundingbox(ThS,bb);
meshS ThS1 = trunc(ThS,x<bb[0]+0.05 );
meshS ThS2 = trunc(ThS,x>bb[1]-0.05);

// // meshS ThS1 = trunc(ThS,(nuTriangle==27));
// meshS ThS2 = trunc(ThS,(nuTriangle==1000));
// ThS=square3(1,1,[x/10.99,y/10.99,z/10.99]);
// ThS1 = trunc(ThS,(nuTriangle==0));
// // ThS2 = movemesh(ThS1,[x+100,y,z]);
plot(ThS1,ThS2);

// fespace Uh(ThS,P1);
fespace Uh1(ThS1,P0);
fespace Uh2(ThS2,P0);

varf vk(u,v)=int2dx2d(ThS1)(ThS1)(BEM(BemKernel("SL",k=k),u,v)) ;  
HMatrix<complex> H = vk(Uh1,Uh2,eta=10,eps=1e-10,maxleafsize=10,compressor="HCA",qforder=3);
if (mpirank == 0) cout << H.infos << endl;
    display(H);
complex[int,int] Hdense(Uh2.ndof,Uh1.ndof),Hcompress(Uh2.ndof,Uh1.ndof);
Hcompress= H;
HMatrix<complex> Hmatdense = vk(Uh1,Uh2,eta=-10,eps=1e-4,maxleafsize=100,compressor="partialACA",qforder=3);
if (mpirank == 0) cout << Hmatdense.infos << endl;
    display(Hmatdense);
Hdense= Hmatdense;
