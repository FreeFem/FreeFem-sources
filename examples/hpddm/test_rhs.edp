// NBPROC 4
// PARAM -wg -ns -ffddm_overlap 1
// Test for the distributed-exchange hook (point B): once PETSc is loaded,
// rhs[] = vPb(0, Wdh) must be automatically exchanged (globally consistent),
// with NO explicit exchange(A, rhs[], scaled=true) call needed -- unlike the
// old pattern rhs[] = vPb(0, Wh); exchange(A, rhs[], scaled=true);
// This test compares the two paths, including through a full PETSc solve.

load "PETSc"
include "getARGV.idp"
macro dimension()3// EOM

macro grad(u)[dx(u), dy(u), dz(u)]// EOM
func Pk = P1;

mesh3 Th = cube(getARGV("-global", 6), getARGV("-global", 6), getARGV("-global", 6));
Dmesh3 DTh = distribute(Th, overlap = 1, partmethod = "metis");
mesh3 ThLocal = DTh.local;

fespace Wh(ThLocal, Pk);
fespace Wdh(DTh, Pk);
varf vPb(u, v) = int3d(DTh)(grad(u)' * grad(v)) + int2d(DTh)(v) + on(1, u = 0.0);
Mat A = vPb(Wdh, Wdh);

Wh rhsLocal, rhsRef, rhsNew, uRef, uNew, diff;

// raw local contribution, before any exchange at all
rhsLocal[] = vPb(0, Wh);

// reference path: manual exchange (existing, known-working)
rhsRef[] = rhsLocal[];
exchange(A, rhsRef[], scaled = true);

// path under test: automatic exchange via the hook, no manual exchange() call
rhsNew[] = vPb(0, Wdh);

diff[] = rhsLocal[] - rhsNew[];
real errVsLocal = diff[].linfty;
diff[] = rhsRef[] - rhsNew[];
real errAutoExchange = diff[].linfty;
if (mpirank == 0) {
    cout << "diagnostic: rhsLocal[].linfty  = " << rhsLocal[].linfty << endl;
    cout << "diagnostic: rhsRef[].linfty    = " << rhsRef[].linfty << endl;
    cout << "diagnostic: rhsNew[].linfty    = " << rhsNew[].linfty << endl;
    cout << "diagnostic: max abs diff rhsNew vs rhsLocal (unexchanged) = " << errVsLocal << endl;
    cout << "auto-exchange, max abs diff vs manual exchange = " << errAutoExchange << endl;
}
assert(errAutoExchange < 1.0e-12);

// "+=" variant sanity check (also goes through the auto-exchange hook)
rhsNew[] += vPb(0, Wdh);
diff[] = rhsNew[] - 2.0 * rhsRef[];
real errPlusEq = diff[].linfty;
if (mpirank == 0)
    cout << "auto-exchange, += variant, max abs diff vs 2*ref = " << errPlusEq << endl;
assert(errPlusEq < 1.0e-12);
rhsNew[] = vPb(0, Wdh);    // reset for what follows

// end-to-end sanity: full PETSc solve gives the same solution through
// either path (manual exchange vs automatic exchange)
set(A, sparams = "-pc_type lu");
uRef[] = A^-1 * rhsRef[];
uNew[] = A^-1 * rhsNew[];
diff[] = uRef[] - uNew[];
real errSolve = diff[].linfty;
if (mpirank == 0)
    cout << "auto-exchange, solve, max abs diff vs manual path = " << errSolve << endl;
assert(errSolve < 1.0e-8);

if (mpirank == 0)
    cout << "test_rhs: PASSED" << endl;
