// solves the system of isentropic gas dynamics in 3D (mesh3) over the dual mesh (P1 unknowns, the median dual
// mesh: one control volume by vertex), the same cases as freevol_igd3d.edp (P0 unknowns):
//   U_t+div(F(U)) = 0, U=[rho,rho*u,rho*v,rho*w], p = kappa*rho^gamma
// cases:
//   Ball       : a ball of dense gas in a box with walls (mass, positivity, symmetry x,y,z -> y,z,x)
//   ShockTube1D: the shock tube of freevol_igd1d.edp in a bar, compared with the exact solution
// the same command fvscheme as in 1D and 2D, with the dual mesh built in the script (meshdual3): the dimension is
// given by the mesh of [rho,rhou,rhov,rhow]
// plots on the dual mesh (as freevol_advectiondm3d.edp): plot(Thstar, rho[]) the control volumes colored on the
//   boundary; F1: cutting plane (the cut control volumes), m: edges of the control volumes
//   (macro plotdual()0: the usual plots of the P1 functions)
real s0=clock();
load "msh3"
macro plotdual()1// 1: plots on the dual mesh, 0: plots of the P1 functions
macro case() Ball//
real gamma=1.4, kappa=1.;
IFMACRO(case,Ball)
   real Tf=.3;
   int Npx=10;
   mesh3 Th = cube(Npx,Npx,Npx,[2*x-1,2*y-1,2*z-1]);
   func rho0 = 1.+((x^2+y^2+z^2)<.25);
   func u0 = 0.;
ENDIFMACRO
IFMACRO(case,ShockTube1D)
   real Tf=.15;
   int Npx=200;
   real xp=0., xp1=1., x0=0.5, rhoL=1., uL=0., rhoR=0.125, uR=0.;
   mesh3 Th = cube(Npx,1,1,[x,0.02*y,0.02*z]);
   func rho0 = (x<x0)*rhoL+(x>=x0)*rhoR;
   func u0 = 0.;
ENDIFMACRO
real t,dt,CFL=.5;
meshdual3 Thstar = builddualmesh(Th);// the dual mesh: the control volumes of the scheme (fvscheme finds it from the mesh Th of the unknowns)
fespace Vh4(Th,[P1,P1,P1,P1]);
fespace Vh(Th,P1);
Vh4 [H,Hu,Hv,Hw]=[rho0,0,0,0],[HBC,HuBC,HvBC,HwBC]=[0,0,0,0],[Hr,Hur,Hvr,Hwr]=[0,0,0,0];
Vh4 [Hp,Hup,Hvp,Hwp];//for second order in time
int[int] labBC=[1,2,2,2,3,2,4,2,5,2,6,2];// walls on the 6 faces of the cube
real mass0=int3d(Th)(H);
IFMACRO(plotdual,1)
{ Vh rho=H; plot(Thstar,rho[],cmm="rho at t=0 (F1: cut, m: edges)",value=true,wait=0); }
ENDIFMACRO
IFMACRO(plotdual,0)
{ Vh rho=H; plot(rho,cmm="rho at t=0",fill=true,value=true,wait=0); }
ENDIFMACRO

int mtordre=2;// order of accuracy in time (1 or 2)
real[int] params=[gamma,kappa];
fvscheme FV([H,Hu,Hv,Hw],order=2,eq="igddm",labelBC=labBC,limiter=1,numflux=2,parameters=params);

int iter=0;
real dtsub, rmin=1e30;
for(t=0.; t<Tf-1.e-10; iter++){// TIME LOOP
    if (mtordre==2) Hp[]=H[];
    for (int lmt=1;lmt<=mtordre;lmt++) {// internal time loop for second order in time
     dtsub = fluxupdate(FV,[H,Hu,Hv,Hw],[Hr,Hur,Hvr,Hwr],[HBC,HuBC,HvBC,HwBC]);
     if (lmt==1) {
      dt=dtsub*CFL;
      if(t+dt > Tf) dt=Tf-t;
     }
     H[] -= dt*Hr[];
     if (lmt==1) t+=dt;
     if (lmt==2) {//second-order Heun scheme in time
      H[]+=Hp[];
      H[]*=.5;
     }
    }//end of internal loop on lmt
    Vh rho=H; rmin=min(rmin,rho[].min);
}//end of time loop
Vh rho=H;
IFMACRO(plotdual,1)
plot(Thstar,rho[],cmm="rho at t="+t+" (F1: cut, m: edges)",value=true,wait=1);
ENDIFMACRO
IFMACRO(plotdual,0)
plot(rho,cmm="rho at t="+t,fill=true,value=true,wait=1);
ENDIFMACRO
cout << "3D: " << Th.nt << " tetrahedra, " << iter << " time steps, cputime = " << clock()-s0 << endl;
cout << "mass error = " << (int3d(Th)(H)-mass0)/mass0 << " , min rho (all the steps) = " << rmin << endl;
IFMACRO(case,Ball)
  // symmetry of the ball and of the mesh of cube (invariant by the circular permutation of x,y,z)
  Vh hsym=rho(y,z,x);
  hsym[]-=rho[];
  cout << "symmetry: max |rho(x,y,z)-rho(y,z,x)| = " << hsym[].linfty << endl;
ENDIFMACRO
IFMACRO(case,ShockTube1D)
// ---- the exact solution of the Riemann problem
  func real pres(real r) { return kappa*r^gamma; }
  func real cson(real r) { return sqrt(gamma*kappa*r^(gamma-1.)); }
  func real rhoofc(real c) { return (c^2/(gamma*kappa))^(1./(gamma-1.)); }
  // velocity change across the wave from the state rk to r (rarefaction if r<rk, shock otherwise)
  func real gwave(real r, real rk) {
     if (r <= rk) return 2./(gamma-1.)*(cson(r)-cson(rk));
     return sqrt((pres(r)-pres(rk))*(r-rk)/(r*rk));
  }
  real rhos=0., us=0.;// the intermediate state
  {
     real a=0., b=10.*max(rhoL,rhoR)+10.;
     if (gwave(0.,rhoL)+gwave(0.,rhoR)+uR-uL >= 0.) { rhos=0.; us=0.; }// vacuum
     else {
        for (int i=0; i<200; i++) { real m=(a+b)/2; if (gwave(m,rhoL)+gwave(m,rhoR)+uR-uL > 0.) b=m; else a=m; }
        rhos=(a+b)/2; us=uL-gwave(rhos,rhoL);
     }
  }
  real rexa, uexa;// the exact solution at xi = (x-x0)/t, set by riemann(xi)
  func real riemann(real xi) {
     real cL=cson(rhoL), cR=cson(rhoR);
     if (rhos<=0.) {// vacuum: two rarefactions down to rho=0
        if (xi <= uL-cL) { rexa=rhoL; uexa=uL; }
        else if (xi <= uL+2./(gamma-1.)*cL) { uexa=2./(gamma+1.)*(cL+(gamma-1.)/2.*uL+xi); rexa=rhoofc(uexa-xi); }
        else if (xi < uR-2./(gamma-1.)*cR) { rexa=0.; uexa=0.; }
        else if (xi < uR+cR) { uexa=2./(gamma+1.)*(-cR+(gamma-1.)/2.*uR+xi); rexa=rhoofc(xi-uexa); }
        else { rexa=rhoR; uexa=uR; }
        return rexa;
     }
     real cs=cson(rhos);
     if (xi <= us) {// left of the contact: the 1-wave
        if (rhos > rhoL) {// shock
           real s=(rhos*us-rhoL*uL)/(rhos-rhoL);
           if (xi < s) { rexa=rhoL; uexa=uL; } else { rexa=rhos; uexa=us; }
        } else {// rarefaction
           if (xi <= uL-cL) { rexa=rhoL; uexa=uL; }
           else if (xi >= us-cs) { rexa=rhos; uexa=us; }
           else { uexa=2./(gamma+1.)*(cL+(gamma-1.)/2.*uL+xi); rexa=rhoofc(uexa-xi); }
        }
     } else {// the 2-wave
        if (rhos > rhoR) {
           real s=(rhos*us-rhoR*uR)/(rhos-rhoR);
           if (xi > s) { rexa=rhoR; uexa=uR; } else { rexa=rhos; uexa=us; }
        } else {
           if (xi >= uR+cR) { rexa=rhoR; uexa=uR; }
           else if (xi <= us+cs) { rexa=rhos; uexa=us; }
           else { uexa=2./(gamma+1.)*(-cR+(gamma-1.)/2.*uR+xi); rexa=rhoofc(xi-uexa); }
        }
     }
     return rexa;
  }
  Vh xc=x, rhoe;// at the vertices: the values of the control volumes
  for (int i=0;i<Th.nv;i++) rhoe[][i]=riemann((xc[][i]-x0)/t);
  cout << "shock tube: L1 error on rho (per unit section) = " << int3d(Th)(abs(rho-rhoe))/0.02^2 << " (P0, freevol_igd3d.edp: 0.0021)" << endl;
ENDIFMACRO
