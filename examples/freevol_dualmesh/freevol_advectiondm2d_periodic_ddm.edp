// 2D advection (mesh) with finite volumes on the dual mesh of F. Bouchut with periodic boundary
// conditions, parallel version (domain decomposition, PETSc) of freevol_advectiondm2d_periodic.edp
//   the partition: createMat (P1, overlap of 3 layers: order 2 on the dual mesh) with
//   macro ThPeriodicity()labPeriodic// (the labels of the periodic boundaries, macro_ddm.idp): all the cells near
//   the periodic boundaries are on the same process, so the linked vertices are in the same local mesh, where
//   fvscheme(..., periodic=...) merges their control volumes (Thstar = builddualmesh(Th), the local dual)
//   at each step: the time step is the min over all processes, then exchange(A, ur, scaled=true)
//   at the end, the solution is gathered on the global mesh (A.D): the scheme mass (sum |C_i| u_i on the
//   global dual), the L2 error (to compare with freevol_advectiondm2d_periodic.edp: the same values)
// run: ff-mpirun -np 4 freevol_advectiondm2d_periodic_ddm.edp -wg   (options: -n (20), -ordre (2 or 1), -Tf (2),
//   -nw: no plot)
// NBPROC 4
load "PETSc"                               // PETSc plugin
include "macro_ddm.idp"                    // additional DDM functions
include "getARGV.idp"
int n = getARGV("-n", 20), ordre = getARGV("-ordre", 2);
real Tf = getARGV("-Tf", 2.);
mesh ThG = square(n, n);                   // the global mesh, labels 1 bottom, 2 right, 3 top, 4 left
fespace VhG(ThG, P1);
// the periodic initial data (the Gaussian and its neighbouring images)
func real gp(real xx, real yy) {
  real s = 0;
  for (int i = -1; i <= 1; i++) for (int j = -1; j <= 1; j++) s += exp(-((xx-0.5-i)^2+(yy-0.5-j)^2)/0.02);
  return s;
}
mesh Th = ThG;                             // the local mesh
Mat A;
{
  macro ThOverlap()3//                     // overlap of 3 layers (order 2 on the dual mesh)
  int[int] labPeriodic = [1, 3, 2, 4];
  macro ThPeriodicity()labPeriodic//       // the cells near the periodic boundaries on the same process
  createMat(Th, A, P1)
}
meshdual Thstar = builddualmesh(Th);       // the local dual mesh
fespace Vh(Th, P1);
Vh u = gp(x, y), up, ur = 0, uBC = 0;
Vh V1 = 1, V2 = 0.5;                       // constant P1 velocity
int[int] labBC = [1,1, 2,1, 3,1, 4,1];     // no effect on the periodic boundaries; the interfaces (-111111): Neumann
fvscheme FV([V1,V2], eq="advectiondm", labelBC=labBC, numflux=2, order=ordre, periodic=[[1,x],[3,x],[2,y],[4,y]]);
// the local solution gathered on the global mesh (each vertex counts once)
Vh D; D[] = A.D;                           // the partition of unity
matrix IG = interpolate(Vh, VhG);          // local <- global
macro gather(uloc,uglob){ real[int] tl=uloc[].*D[]; real[int] tg=IG'*tl;
  mpiAllReduce(tg,uglob[],mpiCommWorld,mpiSUM); }//
VhG uG;
gather(u,uG)
meshdual ThstarG = builddualmesh(ThG);     // the global dual: the scheme mass
real[int] cvaG(ThstarG.ncv);
dualmeshcvarea(cvaG, ThstarG);
real mass0 = cvaG'*uG[], t = 0, dt, dtsub, dtl, CFL = 0.9;
int it;
for (it = 0; t < Tf - 1e-10; it++) {
  up[] = u[];
  for (int l = 1; l <= 2; l++) {           // Heun, second order in time
    dtl = fluxupdate(FV, [u], [ur], [uBC]);
    mpiAllReduce(dtl, dtsub, mpiCommWorld, mpiMIN);
    exchange(A, ur[], scaled=true);        // ur of the overlap vertices: that of their process
    if (l == 1) { dt = CFL*dtsub; if (t + dt > Tf) dt = Tf - t; }
    u[] -= dt*ur[];
    if (l == 1) t += dt;
    if (l == 2) { u[] += up[]; u[] *= .5; }
  }
}
gather(u,uG)
func uex = gp(x - t - floor(x - t), y - 0.5*t - floor(y - 0.5*t));
real err = sqrt(int2d(ThG)((uG-uex)^2)), mass = cvaG'*uG[];
if (!mpirank) cout << "2D dual periodic ddm (" << mpisize << " processes, order " << ordre << ", n = " << n << "): t = " << t
                   << " , " << it << " steps , mass = " << mass << " (change " << mass-mass0 << ") , max u = " << uG[].max
                   << " , L2 error = " << err << endl;
if (!mpirank) plot(ThstarG, uG[], value=1, cmm="2D dual periodic ddm: solution at t = " + t, wait=1);
