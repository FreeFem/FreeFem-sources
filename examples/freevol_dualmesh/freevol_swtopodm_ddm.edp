/* ---------------------------------------------------------

   solves the Shallow Water system with topography
   U_t+div([F(U),G(U)])+(0,gr*H*zb_x,gr*H*zb_y) = 0, U=[H,Hu,Hv], H>0
          (       Hu        )         (       Hv        )
   F(U) = ( Hu^2 + gr/2*H^2 ), G(U) = (       Huv       )
          (       Huv       )         ( Hv^2 + gr/2*H^2 )
   finite volume method, hydrostatic reconstruction for topography
   numflux = 0 : HLL, numflux = 1 : Rusanov, numflux = 2 : HLLC
   MUSCL scheme for second order in space
   first or second order in time (mtordre=1 or 2)
   unknown in P1 (uses fvdualmesh)
   parallel version (domain decomposition, PETSc) of freevol_swtopodm.edp: the same cases, the same scheme, as
   freevol_eulerdm_ddm.edp
     the order of the scheme: macro ordre (2 or 1), it gives the overlap of the partition by DmeshCreate:
     3 layers of triangles for the order 2 (one more than on the primal mesh: the control volumes of the
     vertices on the border of the local mesh are cut, so their centers of gravity, used by the slopes, change),
     1 for the order 1
     the dual mesh Thstar and fvscheme on the local mesh (meshdual Thstar = builddualmesh(Th), found by
     fvscheme from Th); the interfaces (label -111111): Neumann (the default), their vertices are overlap vertices, set
     again by the exchange at each stage: the time step the min on all the processes, then
     exchange(dA0,Hr,scaled=true)
     at the end, the solution is gathered on the whole mesh ThG (onedomainsol: the partition of unity dA0.D
     and the interpolation matrix local <- global): the errors of the case 4 and the profiles on ThG
   plots on the dual mesh: the solution gathered on ThG, plotted by the process 0 on the dual mesh ThstarG of
   ThG, one value by control volume (the free surface H+zb)
     keys: m) edges of the polygons  3) relief in steps  v) palette  P) value under the mouse  c) cut
     (macro plotdual()0: the usual plots by plotMPI)
   ff-mpirun -np 2 freevol_swtopodm_ddm.edp -v 0 -wg

   --------------------------------------------------------*/

load "PETSc"                  // PETSc plugin
include "macro_ddm.idp"       // additional DDM functions
macro def1(u) u// for plotMPI
macro PARAMS fill=true,value=true,wait=0,dim=2,cmm =  // for plotMPI
real s0=clock();
macro plotdual()1// 1: plots on the dual mesh, 0: the usual plots
//include "macro_fvdualmesh.idp"

macro case() 2//

IFMACRO(case,1)
   real tdraw=.25,Tf=10.;
   real gr=9.81;
   int Npx=30;
   real xp=0, xp1=100;
   real yp=0, yp1=100;
   border aa(t=0,1) { x=xp+(xp1-xp)*t ; y=yp ; label=2; }
   border bb(t=0,1) { x=xp1 ; y=yp+(yp1-yp)*t ; label=2; }
   border cc(t=0,1) { x=xp+(xp1-xp)*(1.-t) ; y=yp1 ; label=2; }
   border dd(t=0,1) { x=xp ; y=yp+(yp1-yp)*(1.-t) ; label=2; }
   mesh Th = buildmesh(aa(Npx)+bb(Npx)+cc(Npx)+dd(Npx),splitpbedge=1);
   func z0 = 5.*(10.+(x/20.-10.*cos((y/5.-10.-4.*cos(x/10.))/4.))*(x/20.-10.*cos((y/5.-10.-4.*cos(x/10.))/4.)<0.));
   func h0 = (x>70)*max(40.-z0,0.);
   func hu0 = 0.;
   real[int] Tsave = [30., 40., 50., 60., 70.];
   string filenamesave = "swtopodm.txt";
ENDIFMACRO
IFMACRO(case,2)
   real tdraw=.1,Tf=20.;
   real gr=9.81;
   int Npx=100,Npy=Npx;
   real xp=0.,yp=0.,R=100.;
   real aa=-R,bb=R,cc=-R,dd=R;
   border AB(t=aa,bb){x=t; y=cc;label=1;};
   border BC(t=cc,dd){x=bb; y=t;label=2;};
   border CD(t=bb,aa){x=t; y=dd;label=3;};
   border DA(t=dd,cc){x=aa; y=t;label=4;};
   mesh Th = buildmesh(AB(Npx)+BC(Npy)+CD(Npx)+DA(Npy),splitpbedge=1);
   func z0 = -1.;func h0 = (dist(x-xp,y-yp)<=(R/4.)) - z0;
   //func z0 = -1.;func h0 = exp(-(x-xp)^2/100.-(y-yp)^2/100.) - z0;
   func hu0 = 0.;
   real[int] Tsave = [30., 40., 50., 60., 70.];
   string filenamesave = "swtopodm.txt";
ENDIFMACRO
IFMACRO(case,3)
   real tdraw=.1,Tf=10.;
   real gr=9.81;
   int Npx=3;
   real xp=0, xp1=1;
   real yp=0, yp1=1;
   border aa(t=0,1) { x=xp+(xp1-xp)*t ; y=yp ; label=2; }
   border bb(t=0,1) { x=xp1 ; y=yp+(yp1-yp)*t ; label=2; }
   border cc(t=0,1) { x=xp+(xp1-xp)*(1.-t) ; y=yp1 ; label=2; }
   border dd(t=0,1) { x=xp ; y=yp+(yp1-yp)*(1.-t) ; label=2; }
   mesh Th = buildmesh(aa(Npx)+bb(Npx)+cc(Npx)+dd(Npx),splitpbedge=1);
   func z0 = -1.;func h0 = x+2.;
   func hu0 = 0.;
   real[int] Tsave = [30., 40., 50., 60., 70.];
   string filenamesave = "swtopodm.txt";
ENDIFMACRO
IFMACRO(case,4)
   real tdraw=.1,Tf=3.;
   real gr=2.;
   int Npx=30;
   real L=5.,Haut=5.;
   border aa(t=0.,1.){x=L*(2.*t-1.);y=-Haut;label=1;};
   border bb(t=0.,1.){x=L;y=Haut*(2.*t-1.);label=2;};
   border cc(t=0.,1.){x=L*(1.-2.*t);y=Haut;label=3;};
   border dd(t=0.,1.){x=-L;y=Haut*(1.-2.*t);label=4;};
   mesh Th=buildmesh(aa(Npx)+bb(Npx)+cc(Npx)+dd(Npx),splitpbedge=1);
   func z0=0.;
   func hu0 = 0.;
   real gamma=2.;
func real rhoexact(real targ){
     real posx=x+3.-targ+4.*L;
     real posy=y;
     int nx=int(posx/(2.*L));
     posx=posx-nx*2.*L;
     if (posx>L) posx=posx-2.*L;
     return (1.-(gamma-1.)*5.^2/(8.*gamma*pi^2)*exp(1.-posx^2-posy^2))^(1./(gamma-1.));
}
func real uxexact(real targ){
     real posx=x+3.-targ+4.*L;
     real posy=y;
     int nx=int(posx/(2.*L));
     posx=posx-nx*2.*L;
     if (posx>L) posx=posx-2.*L;
     return 1.+5./(2.*pi)*exp(.5*(1.-posx^2-posy^2))*(-posy);
}
func real uyexact(real targ){
     real posx=x+3.-targ+4.*L;
     real posy=y;
     int nx=int(posx/(2.*L));
     posx=posx-nx*2.*L;
     if (posx>L) posx=posx-2.*L;
     return 5./(2.*pi)*exp(.5*(1.-posx^2-posy^2))*posx;
}
   func h0=rhoexact(0.);
   real[int] Tsave = [30., 40., 50., 60., 70.];
   string filenamesave = "swtopodm.txt";
ENDIFMACRO
IFMACRO(case,5)
   real tdraw=.1,Tf=1.;
   real gr=9.81;
   int Npx=80;
   int Npy=10;
   real xp=0, xp1=40;
   real yp=0, yp1=5.;
   border aa(t=0,1) { x=xp+(xp1-xp)*t ; y=yp ; label=1; }
   border bb(t=0,1) { x=xp1 ; y=yp+(yp1-yp)*t ; label=2; }
   border cc(t=0,1) { x=xp+(xp1-xp)*(1.-t) ; y=yp1 ; label=3; }
   border dd(t=0,1) { x=xp ; y=yp+(yp1-yp)*(1.-t) ; label=4; }
   mesh Th = buildmesh(aa(Npx)+bb(Npy)+cc(Npx)+dd(Npy),splitpbedge=1);
   func h0 = 4.;
   func hu0 = 4.*10./4.;
   real cntr=20.;
   real base=4.;
   real wh=0.48;
   real xl=cntr-base;
   real xr=cntr+base;
   func z0=max(0.,wh-wh*(x-cntr)^2/base^2);
   real[int] Tsave = [0.2, 0.4, 0.5, 0.6, 0.7];
   string filenamesave = "swtopodm.txt";
ENDIFMACRO
IFMACRO(case,6)
   real tdraw=0.5,Tf=60.;
   real gr=9.81;
   int Npx=75;
   int Npy=3;
   real xp=0, xp1=25.;
   real yp=0, yp1=1.;
   border aa(t=0,1) { x=xp+(xp1-xp)*t ; y=yp ; label=1; }
   border bb(t=0,1) { x=xp1 ; y=yp+(yp1-yp)*t ; label=2; }
   border cc(t=0,1) { x=xp+(xp1-xp)*(1.-t) ; y=yp1 ; label=3; }
   border dd(t=0,1) { x=xp ; y=yp+(yp1-yp)*(1.-t) ; label=4; }
   border gamma5(t=0,1) {x=0.5*xp1;y=yp1*t;label=5;};// to test internal boundaries
   mesh Th = buildmesh(aa(Npx)+bb(Npy)+cc(Npx)+dd(Npy),splitpbedge=1);
   func h0 = .33;
   func u0 = .18/.33;
   func hu0 = h0*u0;
   real cntr=10.;
   real base=2.;
   real wh=0.2;
   real xl=cntr-base;
   real xr=cntr+base;
   func z0=max(0.,wh-wh*(x-cntr)^2/base^2);
   real[int] Tsave = [10, 20, 30, 40];
   string filenamesave = "swtopodm.txt";
ENDIFMACRO
IFMACRO(case,7)
   real tdraw=.005,Tf=.25;
   real gr=9.81;
   int Npx=200;
   int Npy=10;
   real xp=0, xp1=25.;
   real yp=0, yp1=1.;
   border aa(t=0,1) { x=xp+(xp1-xp)*t ; y=yp ; label=1; }
   border bb(t=0,1) { x=xp1 ; y=yp+(yp1-yp)*t ; label=2; }
   border cc(t=0,1) { x=xp+(xp1-xp)*(1.-t) ; y=yp1 ; label=3; }
   border dd(t=0,1) { x=xp ; y=yp+(yp1-yp)*(1.-t) ; label=4; }
   border gamma5(t=0,1) {x=0.5*xp1;y=yp1*t;label=5;};// to test internal boundaries
   mesh Th = buildmesh(aa(Npx)+bb(Npy)+cc(Npx)+dd(Npy),splitpbedge=1);
   func h0 = ((25./3.<x)&&(x<12.5))? 9. : 10.;
   func u0 = (x<50./3.)? (((25./3.<x)&&(x<12.5))? -350./9. : -350./10.) : 350./10.;
   func hu0 = h0*u0;
   func z0=((25./3.<x)&&(x<12.5))? 1. : 0.;
   real[int] Tsave = [0.06, 0.12, 0.18, 0.24];
   string filenamesave = "swtopodm.txt";
ENDIFMACRO
IFMACRO(case,DambreakdrybedObstacle)
   int Npx=1001,Npy=4;
   real xp=0., xp1=5000.;
   real yp=-200., yp1=200.;
   border aa(t=0,1) { x=xp+(xp1-xp)*t ; y=yp ; label=2; }
   border bb(t=0,1) { x=xp1 ; y=yp+(yp1-yp)*t ; label=2; }
   border cc(t=0,1) { x=xp+(xp1-xp)*(1.-t) ; y=yp1 ; label=2; }
   border dd(t=0,1) { x=xp ; y=yp+(yp1-yp)*(1.-t) ; label=2; }
   //mesh Th1 = buildmesh(aa(Npx)+bb(Npy)+cc(Npx)+dd(Npy),splitpbedge=1);
   int[int] lab=[2,2,2,2];
   mesh Th = square(Npx,Npy,[x*(xp1-xp)+xp,y*(yp1-yp)+yp],label=lab,flags=3);
   func z0 = -((x < 618.)*0.
             + (x >= 618. && x < 653.)*(-0.2143*x + 0.2143*618.)
             + (x >= 653. && x <= 683.)*(-7.5)
             + (x > 683.  && x <= 718.)*(0.2143*x - 0.2143*683. - 7.5));
   func h0 = 25.*(x<=465.465) - z0(x,y);
   real gr=9.81;
   func hu0 = 0.;
   real[int] Tsave = [11.9,17.54,20.67,41.87];
   real tdraw=1.,Tf=42.;
   string filenamesave = "DambreakdrybedObstacle.txt";
ENDIFMACRO
IFMACRO(case,Dambreakdrybed)
   int Npx=201,Npy=4;
   real xp=0., xp1=200.;
   real yp=-2., yp1=2.;
   border aa(t=0,1) { x=xp+(xp1-xp)*t ; y=yp ; label=2; }
   border bb(t=0,1) { x=xp1 ; y=yp+(yp1-yp)*t ; label=2; }
   border cc(t=0,1) { x=xp+(xp1-xp)*(1.-t) ; y=yp1 ; label=2; }
   border dd(t=0,1) { x=xp ; y=yp+(yp1-yp)*(1.-t) ; label=2; }
   //mesh Th1 = buildmesh(aa(Npx)+bb(Npy)+cc(Npx)+dd(Npy),splitpbedge=1);
   int[int] lab=[2,2,2,2];
   mesh Th = square(Npx,Npy,[x*(xp1-xp)+xp,y*(yp1-yp)+yp],label=lab,flags=3);
   func z0 = 0.;
   func h0 = 1.*(x<=100.) - z0(x,y);
   real gr=9.81;
   func hu0 = 0.;
   real[int] Tsave = [10.,15.];
   real tdraw=1.,Tf=15.1;
   string filenamesave = "Dambreakdrybed.txt";
ENDIFMACRO
IFMACRO(case,RunupSynolakis)
   int Npx=192,Npy=4;
   real xp=-75., xp1=20.;
   real yp=-2., yp1=2.;
   border aa(t=0,1) { x=xp+(xp1-xp)*t ; y=yp ; label=2; }
   border bb(t=0,1) { x=xp1 ; y=yp+(yp1-yp)*t ; label=2; }
   border cc(t=0,1) { x=xp+(xp1-xp)*(1.-t) ; y=yp1 ; label=2; }
   border dd(t=0,1) { x=xp ; y=yp+(yp1-yp)*(1.-t) ; label=2; }
   //mesh Th = buildmesh(aa(Npx)+bb(Npy)+cc(Npx)+dd(Npy),splitpbedge=1);
   int[int] lab=[2,2,2,2];
   mesh Th = square(Npx,Npy,[x*(xp1-xp)+xp,y*(yp1-yp)+yp],label=lab,flags=3);
   real x0c = 19.85, height=1.;
   func z0 = (x < -x0c) ? -height : (x/x0c);
   real Am = 0.0185;
   real Lg = 2.0 / sqrt(3.0*Am/4.0) * acosh( sqrt(20.0) );
   real xs = x0c + Lg/2.0;
   func h0 = Am * sqr( 1./cosh( sqrt(0.75*Am)*( x + xs ) ) ) - z0(x,y);
   real gr=1.;
   func hu0 = sqrt(gr/height) * (h0+z0(x,y));
   real[int] Tsave = [30., 40., 50., 60., 70.];
   real tdraw=10.,Tf=100.;
   string filenamesave = "Runup_Synolakis.txt";
ENDIFMACRO

//initDualmesh(Th);
//setDualmesh(Th);
mesh ThG=Th;// the whole mesh (for the outputs)
if (mpirank==0) {cout << Th.nv << " degrees of freedom" << endl;}

macro ordre()2// the order of the scheme (2 or 1): also the overlap of the partition
IFMACRO(ordre,2)
macro ThOverlap()3// 3 layers of triangles for the order 2
ENDIFMACRO
IFMACRO(ordre,1)
macro ThOverlap()1// 1 layer for the order 1
ENDIFMACRO
DmeshCreate(Th)
mpiBarrier(mpiCommWorld);
Mat dA0;
{
 macro def(u)[u, u#B, u#C, u#D]// EOM
 macro init(u)[u, u, u, u]// EOM
 MatCreate(Th, dA0, [P1,P1,P1,P1]);
}
meshdual Thstar=builddualmesh(Th);// the dual mesh of the local mesh: the control volumes of the scheme

int ntdraw=0;
real t,dt,dtl,CFL=.5;//1.;//
fespace Vh4(Th,[P1,P1,P1,P1]);
fespace Vh(Th,P1);
Vh4 [H,Hu,Hv,zb]=[0,0,0,z0],[HBC,HuBC,HvBC,zbBC]=[0,0,0,0],[Hr,Hur,Hvr,zbr]=[0,0,0,0];
Vh4 [Hp,Hup,Hvp,zbp];//for second order in time
[H,Hu,Hv,zb]=[max(h0,0.),hu0,0,z0];
int[int] labBC=[2,2];
Vh PH=H+zb;
Vh ZB=zb;
Vh scal1,scal2;

IFMACRO(case,4)
     [H,Hu,Hv,zb]=[max(h0,0.),max(h0,0.)*uxexact(0.),max(h0,0.)*uyexact(0.),z0];
     labBC=[1,1,2,0,3,1,4,0];
ENDIFMACRO
IFMACRO(case,5)
     labBC=[1,2,3,2];
ENDIFMACRO
IFMACRO(case,6)
     labBC=[1,2,3,2];
ENDIFMACRO
IFMACRO(case,7)
     labBC=[1,2,3,2];
ENDIFMACRO


//plot(PH,zb,dim=3,fill=true,value=true,wait=0);

int mtordre=2;// order of accuracy in time (1 or 2)
real[int] params=[gr];//sets the value of gravity
//int[int] intparams=[-3,2];
fvscheme FV([H,Hu,Hv,zb],order=ordre,eq="swtopodm",labelBC=labBC,limiter=1,numflux=2,parameters=params);

// the local solution gathered on the whole mesh (onedomainsol: each vertex counted once)
fespace Vh4G(ThG,[P1,P1,P1,P1]);
fespace VhG(ThG,P1);
Vh4 [Dunity,DunityB,DunityC,DunityD]; Dunity[]=dA0.D;// the partition of unity
matrix interplocglobal=interpolate(Vh4,Vh4G);// local <- global
macro onedomainsol(uloc,uglob){ real[int] tl=uloc[].*Dunity[]; real[int] tg=interplocglobal'*tl;
  mpiAllReduce(tg,uglob[],mpiCommWorld,mpiSUM); }//
Vh4G [HG,HuG,HvG,zbG];
VhG PHG;
IFMACRO(plotdual,1)
meshdual ThstarG;// the dual mesh of the whole mesh, built by the process 0 (the plots)
if (mpirank==0) ThstarG=builddualmesh(ThG);
ENDIFMACRO

macro test()0//EOM
IFMACRO(test,0)

//bounding box for the plot
int NTsave = Tsave.n;
real[int,int] Savedata(Npx+1,NTsave+2);
Savedata = 0;
int ncsave=0;
int[int] donesave(NTsave);   // false by default
donesave = 0;
int iter=0;
real dtsub;
for(t=0.; t<Tf-1.e-10; iter++){// TIME LOOP
    if(t >= ntdraw*tdraw) {
        Vh PH=H+zb;
        IFMACRO(plotdual,1)
        onedomainsol(H,HG)// all the processes
        if (mpirank==0) {PHG=HG+zbG; plot(ThstarG,PHG[],cmm="Solution at t="+t+", dt="+dt,value=true,wait=0);}
        ENDIFMACRO
        IFMACRO(plotdual,0)
        plotMPI(Th, PH, P1, def1, real, PARAMS "Solution at t="+t+", dt="+dt)
        ENDIFMACRO
        //plot1d(PH,t)
        ntdraw++;
    }

    if (mtordre==2) Hp[]=H[];
    for (int lmt=1;lmt<=mtordre;lmt++) {// internal time loop for second order in time
     //time dependent BC:
     IFMACRO(case,4)
      //[HBC,HuBC,HvBC,zbBC]=[rhoexact(t),rhoexact(t)*uxexact(t),rhoexact(t)*uyexact(t),0];//lent
      for(int ib=0; ib<Th.nbe; ++ib){//rapide!!
          int kib=Th.be(ib).Element;//neighbouring triangle
          int iib=Th.be(ib).whoinElement;//edge in triangle
          int ee;
          int kee=Th[kib].adj((ee=iib));
          if(kee==kib){
           int jv=Th.be(ib)[0];
           x=Th(jv).x;
           y=Th(jv).y;
           HBC[][4*jv]=rhoexact(t);
           HBC[][4*jv+1]=rhoexact(t)*uxexact(t);
           HBC[][4*jv+2]=rhoexact(t)*uyexact(t);
           HBC[][4*jv+3]=0.;
          }
      }
     ENDIFMACRO
     dtl = fluxupdate(FV,[H,Hu,Hv,zb],[Hr,Hur,Hvr,zbr],[HBC,HuBC,HvBC,zbBC]);
     mpiAllReduce(dtl,dtsub,mpiCommWorld,mpiMIN);
     exchange(dA0,Hr[],scaled=true);// Hr of the overlap vertices: the one of their process
     if (lmt==1) {
      dt=dtsub*CFL;
      if(t+dt > Tf) dt=Tf-t;
     }
     H[] -= dt*Hr[];
     if (lmt==1) t+=dt;
     if (lmt==2) {//second-order Heun scheme in time
      H[]+=Hp[];
      H[]*=.5;
     }
    }//end of internal loop on lmt

    scal1=H;
    real Hminl=scal1[].min, Hmin;
    scal2=Hu;
    scal2=scal2/(scal1+1.e-13);
    real velmaxl=scal2[].linfty, velmax;
    mpiAllReduce(Hminl,Hmin,mpiCommWorld,mpiMIN);
    mpiAllReduce(velmaxl,velmax,mpiCommWorld,mpiMAX);
    if (mpirank==0) {
     cout << iter+1 << " t=" << t;
     if (Hmin<0.) cout << " Hmin=" << Hmin;
     cout << " velmax=" << velmax << endl;
     if (velmax>1.e5) {cout << "velmax >>> 1 " << endl;}
    }
}//end of time loop
if (mpirank==0) cout<<"cputime = "<<clock()-s0<<endl;
// the solution gathered on the whole mesh ThG
onedomainsol(H,HG)
if (mpirank==0) cout << "mass = " << int2d(ThG)(HG) << endl;
macro PARAMSf fill=true,value=true,wait=1,dim=2,cmm =  // for plotMPI
IFMACRO(plotdual,1)
if (mpirank==0) {
 PHG=HG+zbG;
 plot(ThstarG,PHG[],value=true,wait=1,cmm="H+zb at t = "+t+" (m, 3, c, P)");
 PHG=HG;
 plot(ThstarG,PHG[],value=true,wait=1,cmm="H at t = "+t);
}
ENDIFMACRO
IFMACRO(plotdual,0)
PH=H+zb;
plotMPI(Th, PH, P1, def1, real, PARAMSf "H+zb at t = "+t)
ENDIFMACRO

IFMACRO(case,4)
  VhG rhoex,uxex,uyex,scal2G;
  rhoex=rhoexact(t);
  uxex=uxexact(t);
  uyex=uyexact(t);
  scal2G=HuG/(HG+1.e-13);
  real errorrho=sqrt(int2d(ThG)((HG-rhoex)^2));
  real errorux=sqrt(int2d(ThG)((scal2G-uxex)^2));
  scal2G=HvG/(HG+1.e-13);
  real erroruy=sqrt(int2d(ThG)((scal2G-uyex)^2));
  if (mpirank==0) cout << "errorrho,errorux,erroruy " << errorrho << " " << errorux << " " << erroruy << endl;
ENDIFMACRO
IFMACRO(case,RunupSynolakis)
if (mpirank==0) {
  VhG ZBG=zbG;// the topography on the whole mesh
  real[int] xx(Npx),yy(Npx);
  for (int i=0;i<Npx;i++)
  {
     xx[i]=xp+i/real(Npx-1)*(xp1-xp);
     yy[i]=ZBG(xx[i],0.);
  }
  Savedata(:,ncsave) = yy;
  ofstream fout(filenamesave);
  cout<<"ncsave "<<ncsave<<endl;
  cout<<"<NTsave+2 "<<NTsave+2<<endl;
  for (int i=0;i<Npx;i++)
  {
     for(int nsave=0; nsave < NTsave+2; nsave++){
        fout<<Savedata(i,nsave);
        if(nsave<NTsave+2) fout<<" ";
     }
     fout<<endl;
  }
}
ENDIFMACRO

ENDIFMACRO
