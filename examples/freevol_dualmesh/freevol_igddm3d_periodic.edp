// solves the system of isentropic gas dynamics by the finite volume method on the dual mesh in
// 3D (mesh3, the median dual mesh) with periodic boundary conditions
//   fvscheme FV([H,Hu,Hv,Hw], eq="igddm", ..., periodic=[[1,x,z],[3,x,z],[2,y,z],[4,y,z],[5,x,y],[6,x,y]] (the syntax of a 3D fespace)):
//   the control volumes of the linked vertices are one control volume: no flux on the boundary pieces of the periodic
//   borders (inside the control volume), U and the flux balance are the means on the class weighted by the volumes,
//   at the order 2 the slope is the mean of the slopes and the reconstruction starts from the center of gravity of
//   the union; the conserved quantities of the scheme are the sums |C_i| U_i (dualmeshcvarea)
//   -cas 1: a periodic wave rho = 1+0.2 sin(...), u = constant: the mass and the momentum are conserved exactly
//   -cas 0: a constant state: it stays constant
// options: -cas (1), -n (6), -Tf (0.5), -ordre (2 or 1), -nw: without plot
load "msh3"
include "getARGV.idp"
real gamma = 1.4, kappa = 1., L = 1.;
int n = getARGV("-n", 6), ordre = getARGV("-ordre", 2), cas = getARGV("-cas", 1);
real Tf = getARGV("-Tf", 0.5), CFL = .5;
mesh3 Th = cube(n, n, n, [L*x, L*y, L*z]); // labels 1 y=0, 2 x=L, 3 y=L, 4 x=0, 5 z=0, 6 z=L
meshdual3 Thstar = builddualmesh(Th);   // the dual mesh
fespace VhN(Th, [P1,P1,P1,P1]);
fespace Vh(Th, P1);
func rho0 = 1. + 0.2*cas*sin(2.*pi*(x+y+z)/L);
VhN [H,Hu,Hv,Hw] = [rho0, 1.*rho0, 0.5*rho0, 0.25*rho0], [HBC,HuBC,HvBC,HwBC] = [0,0,0,0], [Hr,Hur,Hvr,Hwr] = [0,0,0,0];
VhN [Hp,Hup,Hvp,Hwp];
real[int] params = [gamma, kappa];
int[int] labBC = [1,1, 2,1, 3,1, 4,1, 5,1, 6,1];   // no effect on the periodic borders
fvscheme FV([H,Hu,Hv,Hw], order=ordre, eq="igddm", labelBC=labBC, limiter=1, numflux=2, parameters=params,
            periodic=[[1,x,z],[3,x,z],[2,y,z],[4,y,z],[5,x,y],[6,x,y]]);
real[int] cva(Thstar.ncv);
dualmeshcvarea(cva, Thstar);
Vh rho = H;
real m0 = cva'*rho[];
Vh q0 = Hu; real q00 = cva'*q0[];
Vh q1 = Hv; real q10 = cva'*q1[];
Vh q2 = Hw; real q20 = cva'*q2[];
real t, dt, dtsub;
int iter = 0;
for (t = 0.; t < Tf-1.e-10; iter++) {
  Hp[] = H[];
  for (int l = 1; l <= 2; l++) {          // Heun, second order in time
    dtsub = fluxupdate(FV, [H,Hu,Hv,Hw], [Hr,Hur,Hvr,Hwr], [HBC,HuBC,HvBC,HwBC]);
    if (l == 1) { dt = dtsub*CFL; if (t+dt > Tf) dt = Tf-t; }
    H[] -= dt*Hr[];
    if (l == 1) t += dt;
    if (l == 2) { H[] += Hp[]; H[] *= .5; }
  }
}
rho = H; q0 = Hu; q1 = Hv; q2 = Hw; 
real[int] drho = rho[];
drho -= 1.;
cout << "igddm 3D periodic (cas " << cas << ", order " << ordre << ", n = " << n << ") : t = " << t << " , " << iter << " steps" << endl;
cout << "  conservation: mass " << cva'*rho[]-m0 << " , momentum " << cva'*q0[]-q00 << " " << cva'*q1[]-q10 << " " << cva'*q2[]-q20 << " , min rho " << rho[].min << " , max rho " << rho[].max << endl;
if (cas == 0) cout << "  constant state: max |rho-1| " << drho.linfty << endl;
