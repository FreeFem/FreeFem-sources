// solves the system of isentropic gas dynamics by the finite volume method on the dual mesh of F. Bouchut (2D, mesh)
// with periodic boundary conditions, parallel version (domain decomposition, PETSc) of freevol_igddm2d_periodic.edp:
//   a periodic wave rho = 1+0.2 sin(2 pi (x+y)), u = (1, 0.5) (-cas 0: a constant state)
//   the partition: createMat with macro ThPeriodicity()labPeriodic// (the labels of the periodic borders, macro_ddm.idp):
//   all the elements near the periodic borders are on one process (with the overlap: 3 layers, the order 2 on the dual),
//   so the 2 sides of a periodic border are in the same local mesh, where fvscheme(..., periodic=...) glues them; the
//   other processes have no periodic border
//   at each stage: the time step is the min on all the processes, then exchange(A, Hr, scaled=true)
//   at the end, the solution is gathered on the global mesh (A.D): the same outputs as freevol_igddm2d_periodic.edp
//   (the same values)
//   the conserved quantities of the dual scheme: the sums |C_i| U_i on the global dual mesh
// run: ff-mpirun -np 4 freevol_igddm2d_periodic_ddm.edp -wg   (options: -cas (1), -n (32), -Tf (0.5), -ordre (2 or 1), -nw: without plot)
// NBPROC 4
load "PETSc"                               // PETSc plugin
include "macro_ddm.idp"                    // additional DDM functions
include "getARGV.idp"
real s0 = clock();
real gamma = 1.4, kappa = 1.;
int cas = getARGV("-cas", 1);
int n = getARGV("-n", 32), ordre = getARGV("-ordre", 2);   // not too small: the band near the periodic borders (1+overlap layers) is on one process
real L = 1.;
mesh ThG = square(n, n, [L*x, L*y]);       // labels 1 bottom, 2 right, 3 top, 4 left
real Tf = getARGV("-Tf", 0.5), CFL = .5;
func rho0 = 1. + 0.2*cas*sin(2.*pi*(x+y)/L);
func PKN = [P1,P1,P1];
mesh Th = ThG;                             // the local mesh
int[int] n2o;                              // local cell -> global cell
Mat A;
{
  macro ThOverlap()3//
  macro ThN2O()n2o//
  int[int] labPeriodic = [1, 3, 2, 4];
  macro ThPeriodicity()labPeriodic//       // the elements near the periodic borders on one process
  macro def(u)[u, u#B, u#C]// EOM
  macro init(u)[u, u, u]// EOM
  createMat(Th, A, PKN)
}
meshdual Thstar = builddualmesh(Th);       // the dual mesh of the local mesh
fespace VhN(Th, PKN);
fespace VhNG(ThG, PKN);
fespace VhG(ThG, P1);
VhN [H,Hu,Hv] = [rho0, 1.*rho0, 0.5*rho0], [HBC,HuBC,HvBC] = [0,0,0], [Hr,Hur,Hvr] = [0,0,0];
VhN [Hp,Hup,Hvp];
real[int] params = [gamma, kappa];
int[int] labBC = [1,1, 2,1, 3,1, 4,1];   // no effect on the periodic borders; the interfaces (-111111): Neumann
fvscheme FV([H,Hu,Hv], order=ordre, eq="igddm", labelBC=labBC, limiter=1, numflux=2, parameters=params,
            periodic=[[1,x],[3,x],[2,y],[4,y]]);
// the local solution gathered on the global mesh (each vertex counted once: the partition of unity A.D)
VhN [HD,HuD,HvD]; HD[] = A.D;
matrix IG = interpolate(VhN, VhNG);        // local <- global
macro gather(Uloc, Uglob) { real[int] tl = Uloc[] .* HD[]; real[int] tg = IG'*tl;
  mpiAllReduce(tg, Uglob[], mpiCommWorld, mpiSUM); }//
meshdual ThstarG = builddualmesh(ThG);     // the dual mesh of the global mesh: the conserved quantities
real[int] cvaG(ThstarG.ncv);
dualmeshcvarea(cvaG, ThstarG);
VhNG [HG0,HuG0,HvG0];
gather(H, HG0)
real t, dt, dtsub, dtl;
int iter = 0;
for (t = 0.; t < Tf-1.e-10; iter++) {
  Hp[] = H[];
  for (int l = 1; l <= 2; l++) {          // Heun, second order in time
    dtl = fluxupdate(FV, [H,Hu,Hv], [Hr,Hur,Hvr], [HBC,HuBC,HvBC]);
    mpiAllReduce(dtl, dtsub, mpiCommWorld, mpiMIN);
    exchange(A, Hr[], scaled=true);        // the overlap: the values of their process
    if (l == 1) { dt = dtsub*CFL; if (t+dt > Tf) dt = Tf-t; }
    H[] -= dt*Hr[];
    if (l == 1) t += dt;
    if (l == 2) { H[] += Hp[]; H[] *= .5; }
  }
}
VhNG [HG,HuG,HvG];
gather(H, HG)
if (!mpirank) {
  cout << "igddm 2D periodic ddm (" << mpisize << " processes, order " << ordre << ", n = " << n << ") : t = " << t << " , " << iter << " steps" << endl;
  VhG HGx = HG; real HGS = cvaG'*HGx[];
  VhG HG0x = HG0; real HG0S = cvaG'*HG0x[];
  VhG HuGx = HuG; real HuGS = cvaG'*HuGx[];
  VhG HuG0x = HuG0; real HuG0S = cvaG'*HuG0x[];
  VhG HvGx = HvG; real HvGS = cvaG'*HvGx[];
  VhG HvG0x = HvG0; real HvG0S = cvaG'*HvG0x[];
  VhG rho = HG;
  cout << "  conservation: mass " << HGS-HG0S << " , momentum " << HuGS-HuG0S << " " << HvGS-HvG0S
       << " , min rho " << rho[].min << " , max rho " << rho[].max << endl;
  cout << "cputime = " << clock()-s0 << endl;
}
