ENDIFMACRO

IFMACRO(TESTCASE,5)
 fespace V0(Th,P0);
 V0 dxyrho,dyyrho,normgradrho;
 dxyrho=dx(H);dyyrho=dy(H);
 normgradrho=sqrt(dxyrho*dxyrho+dyyrho*dyyrho);
 myorder=[0];
 savevtk("normgradrho.vtu",Th,normgradrho,order=myorder,bin=1);
