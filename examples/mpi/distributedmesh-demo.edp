// NBPROC 4
// PARAM -wg -ns

mesh3 Th = cube(10, 10, 10);
Dmesh3 DTh = distribute(Th, overlap = 1, keepGlobal = true);

fespace Udh(DTh, P1);
Udh u = 0;
Udh f = 1;
problem p(u, v, solver = CG) = int3d(DTh)(dx(u) * dx(v) + dy(u) * dy(v) + dz(u) * dz(v)) - int3d(DTh)(f * v) + on(1, 2, 3, 4, u = 0);
p;