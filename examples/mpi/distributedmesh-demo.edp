// NBPROC 4
// PARAM -wg -ns

// problem / solve sur un fespace distribue, ecrit comme en sequentiel.
// La resolution passe par PETSc (load "PETSc" obligatoire).
load "PETSc"

mesh3 Th = cube(10, 10, 10);
Dmesh3 DTh = distribute(Th, overlap = 1, keepGlobal = true);

fespace Udh(DTh, P1);
Udh u = 0, v;
Udh f = 1;
problem p(u, v, solver = CG, eps = 1e-10) =int3d(DTh)(dx(u) * dx(v) + dy(u) * dy(v) + dz(u) * dz(v)) - int3d(DTh)(f * v) + on(1, 2, 3, 4, u = 0);
p;

// verification : meme probleme sur le maillage global
fespace Uh(Th, P1);
Uh us, vs;
solve ps(us, vs) = int3d(Th)(dx(us) * dx(vs) + dy(us) * dy(vs) + dz(us) * dz(vs)) - int3d(Th)(1. * vs) + on(1, 2, 3, 4, us = 0);
real errL = sqrt(int3d(DTh)(square(u - us))) / sqrt(int3d(Th)(square(us))), errG;
mpiAllReduce(errL, errG, mpiCommWorld, mpiMAX);
if (mpirank == 0) cout << "ecart relatif distribue / sequentiel = " << errG << endl;
assert(errG < 1e-7);   // eps = 1e-10 transmis a PETSc (sans lui : ~1e-6)
