// NBPROC 4
// PARAM -wg -ns

// =====================================================================
//  Test multi-configurations de distribute(..., partmethod=...)
//  metis / scotch / parmetis / partition-utilisateur, sur meshL (1D),
//  meshS (surface) et mesh3 (3D).
//
//  Suppose FreeFEM configure avec Scotch ET ParMETIS (cf. SCOTCH_CORE et
//  PARMETIS_CORE dans la sortie de configure) : les cas correspondants ne
//  sont pas gardes et leveraient une erreur sinon.
//
//  Lancer :
//    ff-mpirun -np 4 test_distribute_multi.edp -ns
//    ff-mpirun -np 3 test_distribute_multi.edp -ns   (tranches inegales)
//
//  keepGlobal = true EXPLICITE sur les distribute() du bloc cas 0 : depuis
//  que le defaut est false, V1 (bijection loc2glob) exige de le redemander.
//  Les blocs N1..N15 ne le passent pas -- N5 exige meme false.
//
//  LANCER SOUS TIMEOUT. Les blocs N1..N14 sont des tests d'ERREUR COLLECTIVE :
//  ils verifient que TOUS les rangs levent (reduction MIN), donc qu'aucun rang
//  ne file en avant en laissant les autres dans un recv. Une regression s'y
//  manifeste soit en FAIL, soit -- et c'est le cas le plus courant -- en
//  BLOCAGE jusqu'au walltime. Sans timeout, ce fichier ne distingue pas les
//  deux :
//    timeout 300 ff-mpirun -np 3 test_distribute_multi.edp -ns
//
//  CONTRAT : creer un fespace distribue est COLLECTIF sur DTh.comm
//  (symetrie des intersections + residu de PoU), comme ffddmbuildDfespace.
//  checkDfespace = 0 le rend local : plus aucun controle, .checkPoU vaut -1.
//  Defaut 1.
//  Les criteres sont invariants au partitionnement : V1 (bijection
//  loc2glob), V2 (partition de l'unite), V4 (alignement PETSc) et V5
//  (comptage global) doivent valoir exactement 0. V3 (ecart a la solution
//  globale) peut varier legerement d'un run a l'autre sans que ce soit un
//  echec ; seuls les seuils comptent.
//
//  V4 est le test D1 : Udh.numbering doit coincider composante par
//  composante avec la numerotation que PETSc calcule via HPDDM. C'est le
//  seul critere qui detecte une regle de propriete valide mais desalignee
//  (departage des egalites inverse, ou ordre de numerotation different).
//  GlobalNumbering est appele juste apres le constructeur de Mat, AVANT
//  l'assemblage : apres "A = vPb(...)" il segfaute.
//
//  V5 : Udh.ndofglobal doit egaler UhGlob.ndof.
//
//  V6 : Udh.checkPoU -- residu de PoU le long des intersections de ddl, la
//  ou V2 la somme sur le maillage global. V2 valide la PoU, V6 valide la
//  carte d'intersections, soit l'objet transmis a HPDDM. La construction
//  verifie que les TAILLES concordent entre voisins ; leur appariement reste
//  POSITIONNEL et non verifie -- un decalage fait diverger V6 sans toucher
//  V2. Seul controle disponible en mode scatter. Calcule et reduit a la
//  construction : accesseur pur ici, et v6 < 0 = non calcule, donc FAIL.
//
//  O1..O4 : overlap = 0 de bout en bout -- decomposition non recouvrante,
//  intersections de mesure nulle, PoU = 1/multiplicite au ddl. Volontairement
//  SANS solveur : mesure faite, le KSP converge mais sur un operateur faux,
//  parce que Mat(ndof, intersection, D) exige des lignes locales completes la
//  ou D > 0 -- vrai a recouvrement >= 1, structurellement faux a 0. Detail
//  dans le commentaire du bloc. Les invariants propres a la decomposition,
//  eux, sont tous exacts.
//
//  N2 : carte d'intersections a overlap = 0. Test POSITIF -- il attendait le
//  refus tant que le chemin s = 0 n'existait pas. Il ne couvre PAS la PoU.
//
//  G0/G1 : detection des voisins. NI et NE ne peuvent PAS l'observer -- .intersection
//  est lu APRES purge, donc NE vaut structurellement 0 et NI ne compte que les
//  voisins reels. Un voisin manquant ne se voit que par V6, et seulement si la
//  configuration se presente. G0 la fabrique explicitement : un ilot d'un rang
//  non adjacent, entierement inclus dans la fermeture du rang 0. Exige np > 2.
//
//  DEGRE DES ELEMENTS : LocalMesh est obtenu par DEUX troncatures successives
//  (global -> cover -> local) et non une seule. La composition des deux n2o
//  n'est juste que si truncmesh preserve l'ordre des sommets DANS chaque
//  element ; sinon restrictDOF apparie les mauvais ddl et V1 diverge. P1 est
//  aveugle a ce defaut -- un ddl par sommet, une permutation ne se voit pas.
//  Le filet est donc pose sur les trois familles avec un element sensible :
//  P3 sur meshL (macro Pk), P2 sur mesh3 et meshS (cas "/ P2").
//
//  X1 : echappatoire checkDfespace = 0. Le bloc construit un fespace sur le
//  rang 0 SEUL ; si un collectif subsiste malgre le drapeau, il bloque. Test
//  de TERMINAISON : lancer avec un timeout, sinon une regression se presente
//  comme un job suspendu et non comme un echec.
//
//  NI / NE : nombre d'intersections de ddl declarees, et combien ont une
//  liste VIDE. La purge etant faite a la construction, NE doit valoir 0 ;
//  NE > 0 signale que la purge a ete contournee.
//
//  W1..W5 (macro CHECKPOU) : exercent le chemin "shell", c'est-a-dire
//  "Mat A = vPb(Udh, Udh)" SANS Mat construite au prealable. C'est le seul
//  chemin ou buildShellIfNeeded cede un tampon du fespace a HPDDM ; les
//  CHECK* ci-dessus passent tous par "Mat A(Udh.ndof, ...)" et sortent donc
//  au "if (B._A) return;", ils ne le couvrent pas.
//    W1 : Udh.D est la partition de l'unite FRACTIONNAIRE (nombre de ddl
//         dans ]0,1[, somme sur les rangs). Doit etre > 0.
//    W2 : Udh.D est inchange, bit a bit, par la construction de A. C'est le
//         critere central : HPDDM::Schwarz::restriction() ecrase en place le
//         tableau qu'on lui cede pour en faire le masque exclusif 0/1, et
//         initialize() en garde le pointeur brut. Si le tampon cede est
//         f->Ddof lui-meme, Udh.D change de valeur au milieu du script.
//         Doit valoir exactement 0.
//    W3 : A.D est bien ce masque exclusif (valeurs dans {0,1}) : la
//         restriction a bien lieu, elle s'applique juste ailleurs.
//    W4 : le chemin shell resout toujours juste (garde-fou sur la propriete
//         du scaling cote Dmat, dont depend la numerotation globale).
//    W5 : Udh.D relu APRES construction de A recompose encore exactement un
//         champ global par somme ponderee inter-rangs.
//    W6 : meme chose que W5 mais par la route des intersections plutot que
//         par loc2glob. W2 detecte une mutation bit a bit de Udh.D ; W6
//         detecte en plus une PoU restee intacte mais devenue incoherente
//         avec la carte d'intersections. Doit valoir ~0.
//
//  Parametres de ligne de commande :
//    -ov     recouvrement passe a distribute (defaut 1)
//    -nseg   raffinement du segment  (defaut 80)
//    -nc     raffinement du cube     (defaut 8)
//    -nsq    raffinement du carre    (defaut 16)
//    -case   0 = balayage standard (defaut)
//            1 = partition construite "bande" : trois sous-domaines
//                x<gauche | bande d'epaisseur -strip | x>droite,
//                pour eprouver les contacts a distance 2. Exige -np 3.
//    -strip  epaisseur de la bande en mailles, cas 1 (defaut 2)
// =====================================================================
load "Element_P3"
load "PETSc"
include "getARGV.idp"

macro Pk()P3//EOM

int npass = 0, ntot = 0;
string kspp = "-ksp_type gmres -pc_type asm -ksp_rtol 1e-8";

int ov    = getARGV("-ov", 1);
//  -ov 0 n'est pas une invocation valide de la suite : les blocs standards
//  resolvent avec PETSc, et Mat(ndof, intersection, D) exige des lignes
//  locales completes la ou D > 0 -- vrai a recouvrement >= 1, structurellement
//  faux a 0. Tout tomberait sur V3 (et W4) alors que V1, V2, V4..V7 restent
//  exacts. Le recouvrement nul est couvert de bout en bout par O1..O4.
if (ov < 1) {
  if (mpirank == 0)
    cout << "  [-ov 0 : utiliser les blocs O1..O4 ; les blocs standards"
         << " resolvent avec PETSc et exigent overlap >= 1]" << endl;
  assert(ov >= 1);
}
int nseg  = getARGV("-nseg", 80);
int nc    = getARGV("-nc", 8);
int nsq   = getARGV("-nsq", 16);
int cas   = getARGV("-case", 0);
int strip = getARGV("-strip", 2);

// -------- V7 : appariement POSITIONNEL des listes d'intersection --------
//  checkIntersectionSymmetry (donc V6 en amont) ne verifie que les TAILLES.
//  L'appariement lui-meme reste positionnel : la position p de ma liste doit
//  designer le MEME ddl que la position p de la liste d'en face. Un decalage
//  d'ordre passe les tailles, fait diverger V6, mais ne dit pas ou.
//
//  Ici on echange, dans l'ordre des listes, les COORDONNEES des ddl. En
//  Lagrange chaque ddl porte un point : si les deux listes se correspondent,
//  les points coincident exactement. V7 est donc un V6 qui localise -- et il
//  reste valide meme quand la PoU est fausse, ce qui en fait le seul controle
//  utilisable pendant la mise au point de overlap = 0.
macro PAIRV7(Udh, Uh, v7) {
  Uh pvx = x, pvy = y, pvz = z;
  int pvN = Udh.intersection[0].n;
  real[int][int] pvMine(pvN), pvHis(pvN);
  mpiRequest[int] pvRq(2*pvN);
  for (int pj = 0; pj < pvN; ++pj) {
    int[int] pvL = Udh.intersection[1 + pj];
    int pvM = pvL.n;
    pvMine[pj].resize(3*pvM); pvHis[pj].resize(3*pvM);
    for (int pp = 0; pp < pvM; ++pp) {
      pvMine[pj][3*pp]     = pvx[][pvL[pp]];
      pvMine[pj][3*pp + 1] = pvy[][pvL[pp]];
      pvMine[pj][3*pp + 2] = pvz[][pvL[pp]];
    }
    Irecv(processor(Udh.intersection[0][pj], mpiCommWorld, pvRq[pj]),        pvHis[pj]);
    Isend(processor(Udh.intersection[0][pj], mpiCommWorld, pvRq[pvN + pj]),  pvMine[pj]);
  }
  for (int pk = 0; pk < 2*pvN; ++pk) { int pw = mpiWaitAny(pvRq); }
  real pvE = 0;
  for (int pj = 0; pj < pvN; ++pj)
    for (int pp = 0; pp < pvMine[pj].n/3; ++pp)
      pvE = max(pvE, max(max(abs(pvMine[pj][3*pp]     - pvHis[pj][3*pp]),
                             abs(pvMine[pj][3*pp + 1] - pvHis[pj][3*pp + 1])),
                             abs(pvMine[pj][3*pp + 2] - pvHis[pj][3*pp + 2])));
  mpiAllReduce(pvE, v7, mpiCommWorld, mpiMAX);
}//EOM

// -------- comptage des intersections (commun aux trois macros) --------
macro COUNTI(Udh, nItot, nEtot) {
  int nI = Udh.intersection[0].n, nEmpty = 0;
  for (int j = 0; j < nI; ++j) if (Udh.intersection[1 + j].n == 0) nEmpty++;
  mpiAllReduce(nI,     nItot, mpiCommWorld, mpiSUM);
  mpiAllReduce(nEmpty, nEtot, mpiCommWorld, mpiSUM);
}//EOM

// -------- validation courbe/1D (meshL) --------
macro CHECKL(DTh, Th, tag) {
  meshL ThLocal = DTh.local;
  fespace Uh(ThLocal, Pk);
  fespace Udh(DTh, Pk);
  fespace UhGlob(Th, Pk);
  real[int] D = Udh.D;
  int[int]  l2g = Udh.loc2glob;
  int nItot = 0, nEtot = 0;
  COUNTI(Udh, nItot, nEtot)
  /* V6 : valeur figee a la construction du fespace, deja reduite en max
     sur les rangs. Lecture locale. */
  real v6 = Udh.checkPoU;
  real v7 = 0;
  PAIRV7(Udh, Uh, v7)
  Mat A(Udh.ndof, Udh.intersection, D);
  int[int] pnum;
  GlobalNumbering(A, pnum);        /* AVANT l'assemblage : sinon SEGV */
  int[int] gnum = Udh.numbering;
  func f = 1.0;
  varf vPb(u, v) = int1d(ThLocal)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v))
                 + int1d(ThLocal)(f*v) + on(1, 2, u = 0);
  A = vPb(Udh, Udh);
  real[int] rhs = vPb(0, Uh);
  set(A, sparams = kspp);
  real[int] uu = A^-1 * rhs;
  func fa = x + 2*y + 3*z + x*y;
  UhGlob gg = fa;  Uh gl = fa;
  real eBij = 0;
  for (int i = 0; i < gl.n; ++i) eBij = max(eBij, abs(gl[][i] - gg[][l2g[i]]));
  real[int] acc(UhGlob.ndof); acc = 0;
  for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D[i] * gg[][l2g[i]];
  real[int] accG(UhGlob.ndof);
  mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
  real ePoU = 0;
  for (int i = 0; i < UhGlob.ndof; ++i) ePoU = max(ePoU, abs(accG[i] - gg[][i]));
  varf vG(u, v) = int1d(Th)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v)) + int1d(Th)(f*v) + on(1,2,u=0);
  matrix AG = vG(UhGlob, UhGlob, solver = UMFPACK);
  real[int] rG = vG(0, UhGlob);
  real[int] ug = AG^-1 * rG;
  real eSol = 0;
  for (int i = 0; i < uu.n; ++i) eSol = max(eSol, abs(uu[i] - ug[l2g[i]]));
  real eNum = 0;
  int  nbad = 0;
  if (pnum.n != gnum.n) nbad = 1;
  else
    for (int i = 0; i < gnum.n; ++i) {
      real dd = pnum[i] - gnum[i];
      eNum = max(eNum, abs(dd));
    }
  real eNG = abs(Udh.ndofglobal - UhGlob.ndof);
  real b, p, s, n4, n5;
  int nb;
  mpiAllReduce(eBij, b, mpiCommWorld, mpiMAX);
  mpiAllReduce(ePoU, p, mpiCommWorld, mpiMAX);
  mpiAllReduce(eSol, s, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNum, n4, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNG,  n5, mpiCommWorld, mpiMAX);
  mpiAllReduce(nbad, nb, mpiCommWorld, mpiMAX);
  bool ok = (b < 1e-8 && p < 1e-8 && s < 1e-5 && n4 < 1e-12 && n5 < 1e-12 && nb == 0
          && v6 >= 0 && v6 < 1e-8 && v7 < 1e-12);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [" << tag << "]  V1=" << b << "  V2=" << p << "  V3=" << s
         << "  V4=" << n4 << "  V5=" << n5 << "  V6=" << v6 << "  V7=" << v7
         << "  NI=" << nItot << "  NE=" << nEtot
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}//EOM

// -------- validation volume/3D (mesh3) --------
macro CHECK3(DTh, Th, PkX, tag) {
  mesh3 ThLocal = DTh.local;
  fespace Uh(ThLocal, PkX);
  fespace Udh(DTh, PkX);
  fespace UhGlob(Th, PkX);
  real[int] D = Udh.D;
  int[int]  l2g = Udh.loc2glob;
  int nItot = 0, nEtot = 0;
  COUNTI(Udh, nItot, nEtot)
  /* V6 : valeur figee a la construction du fespace, deja reduite en max
     sur les rangs. Lecture locale. */
  real v6 = Udh.checkPoU;
  real v7 = 0;
  PAIRV7(Udh, Uh, v7)
  Mat A(Udh.ndof, Udh.intersection, D);
  int[int] pnum;
  GlobalNumbering(A, pnum);        /* AVANT l'assemblage : sinon SEGV */
  int[int] gnum = Udh.numbering;
  func f = 1.0;
  varf vPb(u, v) = int3d(ThLocal)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v))
                 + int3d(ThLocal)(f*v) + on(1,2,3,4,5,6, u = 0);
  A = vPb(Udh, Udh);
  real[int] rhs = vPb(0, Uh);
  set(A, sparams = kspp);
  real[int] uu = A^-1 * rhs;
  func fa = x + 2*y + 3*z + x*y;
  UhGlob gg = fa;  Uh gl = fa;
  real eBij = 0;
  for (int i = 0; i < gl.n; ++i) eBij = max(eBij, abs(gl[][i] - gg[][l2g[i]]));
  real[int] acc(UhGlob.ndof); acc = 0;
  for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D[i] * gg[][l2g[i]];
  real[int] accG(UhGlob.ndof);
  mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
  real ePoU = 0;
  for (int i = 0; i < UhGlob.ndof; ++i) ePoU = max(ePoU, abs(accG[i] - gg[][i]));
  varf vG(u, v) = int3d(Th)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v)) + int3d(Th)(f*v) + on(1,2,3,4,5,6,u=0);
  matrix AG = vG(UhGlob, UhGlob, solver = UMFPACK);
  real[int] rG = vG(0, UhGlob);
  real[int] ug = AG^-1 * rG;
  real eSol = 0;
  for (int i = 0; i < uu.n; ++i) eSol = max(eSol, abs(uu[i] - ug[l2g[i]]));
  real eNum = 0;
  int  nbad = 0;
  if (pnum.n != gnum.n) nbad = 1;
  else
    for (int i = 0; i < gnum.n; ++i) {
      real dd = pnum[i] - gnum[i];
      eNum = max(eNum, abs(dd));
    }
  real eNG = abs(Udh.ndofglobal - UhGlob.ndof);
  real b, p, s, n4, n5;
  int nb;
  mpiAllReduce(eBij, b, mpiCommWorld, mpiMAX);
  mpiAllReduce(ePoU, p, mpiCommWorld, mpiMAX);
  mpiAllReduce(eSol, s, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNum, n4, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNG,  n5, mpiCommWorld, mpiMAX);
  mpiAllReduce(nbad, nb, mpiCommWorld, mpiMAX);
  bool ok = (b < 1e-8 && p < 1e-8 && s < 1e-5 && n4 < 1e-12 && n5 < 1e-12 && nb == 0
          && v6 >= 0 && v6 < 1e-8 && v7 < 1e-12);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [" << tag << "]  V1=" << b << "  V2=" << p << "  V3=" << s
         << "  V4=" << n4 << "  V5=" << n5 << "  V6=" << v6 << "  V7=" << v7
         << "  NI=" << nItot << "  NE=" << nEtot
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}//EOM

// -------- validation surface/2D-dans-3D (meshS) --------
macro CHECKS(DTh, Th, PkX, tag) {
  meshS ThLocal = DTh.local;
  fespace Uh(ThLocal, PkX);
  fespace Udh(DTh, PkX);
  fespace UhGlob(Th, PkX);
  real[int] D = Udh.D;
  int[int]  l2g = Udh.loc2glob;
  int nItot = 0, nEtot = 0;
  COUNTI(Udh, nItot, nEtot)
  /* V6 : valeur figee a la construction du fespace, deja reduite en max
     sur les rangs. Lecture locale. */
  real v6 = Udh.checkPoU;
  real v7 = 0;
  PAIRV7(Udh, Uh, v7)
  Mat A(Udh.ndof, Udh.intersection, D);
  int[int] pnum;
  GlobalNumbering(A, pnum);        /* AVANT l'assemblage : sinon SEGV */
  int[int] gnum = Udh.numbering;
  func f = 1.0;
  varf vPb(u, v) = int2d(ThLocal)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v))
                 + int2d(ThLocal)(f*v) + on(1,2,3,4, u = 0);
  A = vPb(Udh, Udh);
  real[int] rhs = vPb(0, Uh);
  set(A, sparams = kspp);
  real[int] uu = A^-1 * rhs;
  func fa = x + 2*y + 3*z + x*y;
  UhGlob gg = fa;  Uh gl = fa;
  real eBij = 0;
  for (int i = 0; i < gl.n; ++i) eBij = max(eBij, abs(gl[][i] - gg[][l2g[i]]));
  real[int] acc(UhGlob.ndof); acc = 0;
  for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D[i] * gg[][l2g[i]];
  real[int] accG(UhGlob.ndof);
  mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
  real ePoU = 0;
  for (int i = 0; i < UhGlob.ndof; ++i) ePoU = max(ePoU, abs(accG[i] - gg[][i]));
  varf vG(u, v) = int2d(Th)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v)) + int2d(Th)(f*v) + on(1,2,3,4,u=0);
  matrix AG = vG(UhGlob, UhGlob, solver = UMFPACK);
  real[int] rG = vG(0, UhGlob);
  real[int] ug = AG^-1 * rG;
  real eSol = 0;
  for (int i = 0; i < uu.n; ++i) eSol = max(eSol, abs(uu[i] - ug[l2g[i]]));
  real eNum = 0;
  int  nbad = 0;
  if (pnum.n != gnum.n) nbad = 1;
  else
    for (int i = 0; i < gnum.n; ++i) {
      real dd = pnum[i] - gnum[i];
      eNum = max(eNum, abs(dd));
    }
  real eNG = abs(Udh.ndofglobal - UhGlob.ndof);
  real b, p, s, n4, n5;
  int nb;
  mpiAllReduce(eBij, b, mpiCommWorld, mpiMAX);
  mpiAllReduce(ePoU, p, mpiCommWorld, mpiMAX);
  mpiAllReduce(eSol, s, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNum, n4, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNG,  n5, mpiCommWorld, mpiMAX);
  mpiAllReduce(nbad, nb, mpiCommWorld, mpiMAX);
  bool ok = (b < 1e-8 && p < 1e-8 && s < 1e-5 && n4 < 1e-12 && n5 < 1e-12 && nb == 0
          && v6 >= 0 && v6 < 1e-8 && v7 < 1e-12);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [" << tag << "]  V1=" << b << "  V2=" << p << "  V3=" << s
         << "  V4=" << n4 << "  V5=" << n5 << "  V6=" << v6 << "  V7=" << v7
         << "  NI=" << nItot << "  NE=" << nEtot
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}//EOM

// -------- invariance de Udh.D sur le chemin "shell" (meshS) --------
//  Le seul chemin qui passe par buildShellIfNeeded : "Mat A = vPb(...)"
//  sans constructeur explicite. Voir W1..W5 dans l'entete.
macro CHECKPOU(DTh, Th, tag) {
  meshS ThLocal = DTh.local;
  fespace Uh(ThLocal, P1);
  fespace Udh(DTh, P1);
  fespace UhGlob(Th, P1);
  int[int] l2g = Udh.loc2glob;

  /* W1 : avant toute Mat, Udh.D doit etre fractionnaire */
  real[int] D0 = Udh.D;
  real nfrac = 0;
  for (int i = 0; i < D0.n; ++i)
    if (D0[i] > 1e-12 && D0[i] < 1.0 - 1e-12) nfrac += 1;

  func f = 1.0;
  varf vPb(u, v) = int2d(ThLocal)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v))
                 + int2d(ThLocal)(f*v) + on(1,2,3,4, u = 0);
  Mat A = vPb(Udh, Udh);           /* chemin shell : aucune Mat construite avant */

  /* W2 : Udh.D relu apres doit etre identique bit a bit */
  real[int] D1 = Udh.D;
  real eStable = 0;
  if (D1.n != D0.n) eStable = 1;
  else
    for (int i = 0; i < D0.n; ++i) eStable = max(eStable, abs(D0[i] - D1[i]));

  /* W3 : A.D est le masque exclusif 0/1 (lecture via .*= , seul motif expose) */
  Uh dmask; dmask[] = 1.0; dmask[] .*= A.D;
  real eMask = 0;
  for (int i = 0; i < dmask.n; ++i)
    eMask = max(eMask, min(abs(dmask[][i]), abs(dmask[][i] - 1.0)));

  /* W4 : la resolution par ce chemin coincide avec le probleme global */
  real[int] rhs = vPb(0, Uh);
  set(A, sparams = kspp);
  real[int] uu = A^-1 * rhs;
  varf vG(u, v) = int2d(Th)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v)) + int2d(Th)(f*v) + on(1,2,3,4,u=0);
  matrix AG = vG(UhGlob, UhGlob, solver = UMFPACK);
  real[int] rG = vG(0, UhGlob);
  real[int] ug = AG^-1 * rG;
  real eSol = 0;
  for (int i = 0; i < uu.n; ++i) eSol = max(eSol, abs(uu[i] - ug[l2g[i]]));

  /* W5 : la PoU relue apres coup recompose encore un champ global */
  func fa = x + 2*y + 3*z + x*y;
  UhGlob gg = fa;
  real[int] acc(UhGlob.ndof); acc = 0;
  for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D1[i] * gg[][l2g[i]];
  real[int] accG(UhGlob.ndof);
  mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
  real ePoU = 0;
  for (int i = 0; i < UhGlob.ndof; ++i) ePoU = max(ePoU, abs(accG[i] - gg[][i]));

  /* W6 : meme controle que W5 mais par la route des intersections, APRES
     que HPDDM a pris un tampon sur le chemin shell. W2 detecte deja une
     mutation bit a bit de Udh.D ; W6 detecte en plus une PoU restee intacte
     mais devenue incoherente avec la carte d'intersections. */
  real w6 = Udh.checkPoU;

  real w1, w2, w3, w4, w5;
  mpiAllReduce(nfrac,   w1, mpiCommWorld, mpiSUM);
  mpiAllReduce(eStable, w2, mpiCommWorld, mpiMAX);
  mpiAllReduce(eMask,   w3, mpiCommWorld, mpiMAX);
  mpiAllReduce(eSol,    w4, mpiCommWorld, mpiMAX);
  mpiAllReduce(ePoU,    w5, mpiCommWorld, mpiMAX);
  /* w2 : egalite EXACTE voulue, D0 et D1 sont deux copies du meme tampon
     sans aucune arithmetique entre les deux ; toute derive est une mutation.
     w1 n'est exigible qu'a plusieurs rangs : sans voisin, la PoU vaut 1
     partout et W2 passerait trivialement */
  bool ok = ((mpisize == 1 || w1 > 0) && w2 == 0.0 && w3 < 1e-12 && w4 < 1e-5 && w5 < 1e-8
          && w6 >= 0 && w6 < 1e-8);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [" << tag << "]  W1=" << w1 << "  W2=" << w2 << "  W3=" << w3
         << "  W4=" << w4 << "  W5=" << w5 << "  W6=" << w6
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}//EOM

if (mpirank == 0)
  cout << "===== distribute() multi-config  (np=" << mpisize
       << "  overlap=" << ov << "  case=" << cas
       << "  nseg=" << nseg << " nc=" << nc << " nsq=" << nsq << ") =====" << endl;

if (cas == 0) {

// ---------- meshL : metis vs scotch ----------
{ meshL Th = segment(nseg);
  DmeshL DTh = distribute(Th, overlap = ov, partmethod = "metis", keepGlobal = true);
  CHECKL(DTh, Th, "meshL / metis") }

{ meshL Th = segment(nseg);
  DmeshL DTh = distribute(Th, overlap = ov, partmethod = "scotch", keepGlobal = true);
  CHECKL(DTh, Th, "meshL / scotch") }

{ meshL Th = segment(nseg);
  DmeshL DTh = distribute(Th, overlap = ov, partmethod = "parmetis", keepGlobal = true);
  CHECKL(DTh, Th, "meshL / parmetis") }

// ---------- meshL : partition utilisateur (decoupage contigu) ----------
{ meshL Th = segment(nseg);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  DmeshL DTh = distribute(Th, overlap = ov, partition = part, keepGlobal = true);
  CHECKL(DTh, Th, "meshL / partition=user") }

// ---------- mesh3 : metis vs scotch ----------
{ mesh3 Th = cube(nc, nc, nc);
  Dmesh3 DTh = distribute(Th, overlap = ov, partmethod = "metis", keepGlobal = true);
  CHECK3(DTh, Th, P1, "mesh3 / metis") }

{ mesh3 Th = cube(nc, nc, nc);
  Dmesh3 DTh = distribute(Th, overlap = ov, partmethod = "scotch", keepGlobal = true);
  CHECK3(DTh, Th, P1, "mesh3 / scotch") }

{ mesh3 Th = cube(nc, nc, nc);
  Dmesh3 DTh = distribute(Th, overlap = ov, partmethod = "parmetis", keepGlobal = true);
  CHECK3(DTh, Th, P1, "mesh3 / parmetis") }

// ---------- meshS : metis vs scotch ----------
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis", keepGlobal = true);
  CHECKS(DTh, Th, P1, "meshS / metis") }

{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "scotch", keepGlobal = true);
  CHECKS(DTh, Th, P1, "meshS / scotch") }

{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "parmetis", keepGlobal = true);
  CHECKS(DTh, Th, P1, "meshS / parmetis") }

// ---------- meshS : partition utilisateur (decoupage contigu) ----------
{ meshS Th = square3(nsq, nsq);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  DmeshS DTh = distribute(Th, overlap = ov, partition = part, keepGlobal = true);
  CHECKS(DTh, Th, P1, "meshS / partition=user") }

// ---------- meshS : ilot inclus dans la fermeture d'un rang NON adjacent ----------
//  G0/G1 : le seul test qui EXERCE la detection des voisins par adjacence.
//
//  Construction : decoupage en tranches contigues, puis UN element pris au
//  coeur de la tranche du rang 0 est reaffecte au rang mpisize-1, qui n'est
//  pas adjacent au rang 0. Les trois sommets de cet ilot appartiennent donc
//  tous a des elements du rang 0, et a aucun element d'un autre rang.
//
//  Vu du rang 0, suppSmooth vaut exactement 1 sur ces trois sommets. L'ancien
//  critere de detection etait une BANDE, 0.001 < suppSmooth < 0.999, qui
//  EXCLUT la valeur 1 : le rang 0 ne voyait pas l'ilot. Le rang mpisize-1, lui,
//  voyait le rang 0 (son propre voisinage porte des valeurs intermediaires).
//  neighborRanks devenait dissymetrique, donc checkIntersectionSymmetry postait
//  un Irecv sans emetteur : BLOCAGE, et non FAIL. C'est aussi un test de
//  TERMINAISON -- lancer avec un timeout.
//
//  Le critere actuel, suppSmooth > 0.001, couvre la bande ET la valeur 1.
//
//  G0 est diagnostique dans les DEUX sens : le contact doit apparaitre AVEC
//  l'ilot et disparaitre SANS lui. Sans le second volet, le test passerait
//  encore si les deux tranches devenaient adjacentes pour une autre raison,
//  et ne prouverait plus rien.
//
//  Exige mpisize > 2 : il faut un rang non adjacent au rang 0.
if (mpisize > 2) {
  meshS Th = square3(nsq, nsq);
  int[int] partIso(Th.nt), partRef(Th.nt);
  for (int k = 0; k < Th.nt; ++k) partRef[k] = k * mpisize / Th.nt;
  partIso = partRef;
  int n0 = 0;
  for (int k = 0; k < Th.nt; ++k) if (partRef[k] == 0) n0++;
  int riso = mpisize - 1;
  partIso[n0 / 2] = riso;            /* element au coeur de la tranche 0 */

  /* rang "d'en face" pour le couple teste : 0 <-> riso */
  int face = (mpirank == 0) ? riso : 0;
  int concerne = (mpirank == 0 || mpirank == riso) ? 1 : 0;

  int vuIso = 0, vuRef = 0;
  DmeshS DThIso = distribute(Th, overlap = ov, partition = partIso, keepGlobal = true);
  { fespace Ui(DThIso, P1);
    for (int j = 0; j < Ui.intersection[0].n; ++j)
      if (Ui.intersection[0][j] == face && Ui.intersection[1 + j].n > 0) vuIso = 1; }
  { DmeshS DThRef = distribute(Th, overlap = ov, partition = partRef, keepGlobal = true);
    fespace Ur(DThRef, P1);
    for (int j = 0; j < Ur.intersection[0].n; ++j)
      if (Ur.intersection[0][j] == face && Ur.intersection[1 + j].n > 0) vuRef = 1; }

  /* concerne : contact present avec l'ilot, absent sans. Autres rangs : neutres. */
  int ok0 = concerne ? (vuIso == 1 && vuRef == 0) : 1;
  int g0; mpiAllReduce(ok0, g0, mpiCommWorld, mpiMIN);
  ntot++; if (g0 == 1) npass++;
  if (mpirank == 0)
    cout << "  [G0 ilot : contact 0<->" << riso << " cree par l'ilot]  G0=" << g0
         << "   => " << (g0 == 1 ? "PASS" : "FAIL") << endl;

  CHECKS(DThIso, Th, P2, "G1 meshS / ilot dans cl(rang 0) / P2")
}

// ---------- mesh3 / meshS en P2 : composition des deux troncatures ----------
//  Voir DEGRE DES ELEMENTS dans l'entete. P1 ne peut pas detecter une
//  permutation des sommets dans la composition global -> cover -> local ;
//  P2 la detecte via V1.
{ mesh3 Th = cube(nc, nc, nc);
  Dmesh3 DTh = distribute(Th, overlap = ov, partmethod = "metis", keepGlobal = true);
  CHECK3(DTh, Th, P2, "mesh3 / metis / P2") }

{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis", keepGlobal = true);
  CHECKS(DTh, Th, P2, "meshS / metis / P2") }

// ---------- C1 : accesseurs .local / .bordermesh / .cover ----------
//  Le cover est le maillage sur lequel distribute fait toute sa geometrie :
//  mon partitionnement plus ce qui le touche (une couche a s = 0, 2*s au-dela).
//  BorderMesh est la couche d'elements immediatement a l'exterieur du local.
//  Quatre relations, verifiees sur les trois familles :
//
//    (a) cover contient le local            cover.nt >= local.nt, cover.nv >= local.nv
//    (b) local et border sont DISJOINTS
//        et inclus dans le cover            local.nt + border.nt <= cover.nt
//    (c) a s <= 1 ils le PARTITIONNENT      local.nt + border.nt == cover.nt
//    (d) sans voisin, rien a ajouter        mpisize == 1 -> cover.nt == local.nt
//                                                       et border.nt == 0
//
//  (c) s'arrete a s = 1, et ce n'est pas un seuil arbitraire. Le masque du
//  cover garde tout element ayant un sommet a suppSmooth > 0 ; celui du border
//  demande une moyenne barycentrique > (s-0.999)/(2s). A s = 1 les valeurs
//  possibles sont 0, 0.5, 1 et le seuil vaut 0.0005 : les deux masques se
//  rejoignent exactement. A s = 2 le seuil monte a 0.25 et laisse dans le
//  cover des elements qui ne sont ni locaux ni de bord -- mesure : deficit de
//  50 a 131 elements sur cube(6,6,6). (b) reste vrai partout.
//
//  (d) est le cas que le lot BorderMesh a rendu sur : BorderMesh est nul, et
//  l'accesseur rend le pointeur nul, dont .nt vaut 0 comme pour "meshS Th;".
//  C'est aussi ce qui faisait avorter distribute avant, via ffassert(nbv_surf).
{ meshS Th = square3(nsq, nsq);
  int okLoc = 1;
  for (int io = 0; io < 2; ++io) {
    int ovc = (io == 0) ? ov : 0;
    DmeshS DTh = distribute(Th, overlap = ovc, partmethod = "metis");
    meshS L = DTh.local, B = DTh.bordermesh, C = DTh.cover;
    int nl = L.nt, nb = B.nt, ncv = C.nt;
    fespace Udh(DTh, P1);
    int nvois = Udh.intersection[0].n;
    if (nl <= 0 || ncv < nl || C.nv < L.nv)          okLoc = 0;   /* (a) */
    if (nl + nb > ncv)                               okLoc = 0;   /* (b) */
    if (ovc <= 1 && nl + nb != ncv)                  okLoc = 0;   /* (c) */
    if (mpisize == 1 && (ncv != nl || nb != 0))      okLoc = 0;   /* (d) */
    if (ovc == 0 && nvois > 0 && nb <= 0)            okLoc = 0;
  }
  int g; mpiAllReduce(okLoc, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [C1 accesseurs .local / .bordermesh / .cover]  C1=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// ---------- B1 : mesh3 portant une surface attachee ----------
//  Test de TERMINAISON. truncmesh reconstruit inconditionnellement la surface
//  attachee d'un mesh3 (msh3.cpp, "building of the meshS after trunc") et
//  BuildMeshS exige au moins un element de bord (ffassert(nbv_surf)). Une
//  troncature VIDE avortait donc, et le masque de BorderMesh etait vide dans
//  trois regimes : overlap = 0 toujours, mpisize == 1 a tout recouvrement, et
//  saturation de bande (2*ov couches remplissant le maillage). Le second
//  cassait deja sans rapport avec le recouvrement nul.
//  distribute ne tronque plus a vide : BorderMesh devient nul, sans abandon.
//  A lancer aussi a -np 1, regime que le reste de la suite ne couvre pas.
{ mesh3 Th = cube(nc, nc, nc); Th = buildBdMesh(Th);
  int okLoc = 1;
  {
    Dmesh3 D1 = distribute(Th, overlap = ov, partmethod = "metis");
    mesh3 T1 = D1.local;
    if (T1.nt <= 0 || T1.nbe <= 0) okLoc = 0;
  }
  {
    Dmesh3 D0 = distribute(Th, overlap = 0, partmethod = "metis");
    mesh3 T0 = D0.local;
    if (T0.nt <= 0 || T0.nbe <= 0) okLoc = 0;
  }
  int g; mpiAllReduce(okLoc, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [B1 mesh3+surface : ov=" << ov << " et 0]  B1=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// ---------- O1..O4 : overlap = 0, decomposition NON RECOUVRANTE ----------
//  Seconde voie de construction, pas un cas limite de la premiere. A s = 0
//  l'intersection entre deux sous-domaines est de MESURE NULLE -- une face,
//  une arete, un sommet -- donc aucun sous-maillage n'a les ddl partages pour
//  ddl. La liste est batie sur un porteur commun aux deux rangs puis filtree
//  aux ddl portes des deux cotes ; et la PoU ne peut plus etre un champ P1
//  nodal (un milieu d'arete d'interface est partage par 2 quand ses extremites
//  peuvent l'etre par 3 ou 4 a un coin), elle vaut 1/multiplicite AU DDL.
//
//  PAS DE SOLVEUR ICI, ET C'EST DELIBERE. Mesure faite : a s = 0 le KSP
//  converge (CONVERGED_RTOL) mais sur le MAUVAIS operateur. La convention de
//  Mat(ndof, intersection, D) exige des lignes locales COMPLETES partout ou
//  D > 0, puisque le produit global est somme(R_i^T D_i A_i R_i) : si chaque
//  A_i porte la ligne entiere, la somme des D la reconstitue.
//    ov = 1 : ecart ligne locale / ligne globale = 0 la ou D > 0
//             (les lignes incompletes sont celles de la couronne, ou D = 0)
//    ov = 0 : ecart = 1.2e-1 la ou D > 0, et aucun ddl n'a D = 0
//  A recouvrement nul un ddl d'interface n'a qu'une PARTIE de sa ligne dans
//  chaque sous-domaine -- format non assemble, celui de MATIS/BDDC, pas celui
//  du Schwarz recouvrant. L'operateur reconstruit vaut alors A/multiplicite
//  sur les lignes d'interface, d'ou une solution fausse a ~1e-2.
//  Ce n'est pas un defaut de la decomposition : tous les invariants propres
//  (V1, V2, V5, V6, V7, D = 1/multiplicite) sont exacts. C'est le CHAINAGE
//  vers PETSc qui demande un autre format. C'est aussi pourquoi macro_ddm
//  n'expose jamais overlap = 0 et pourquoi ffddm exige un opt-in explicite.
macro CHECKO(Th, ThLocal, Uh, Udh, UhGlob, tag) {
  real[int] D = Udh.D;
  int[int]  l2g = Udh.loc2glob;
  real v6 = Udh.checkPoU;
  real v7 = 0;
  PAIRV7(Udh, Uh, v7)

  /* V1 : bijection loc2glob */
  func fa = x + 2*y + 3*z + x*y;
  UhGlob gg = fa;  Uh gl = fa;
  real eBij = 0;
  for (int i = 0; i < gl.n; ++i) eBij = max(eBij, abs(gl[][i] - gg[][l2g[i]]));

  /* V2 : la PoU somme a 1 sur le maillage global */
  real[int] acc(UhGlob.ndof); acc = 0;
  for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D[i] * gg[][l2g[i]];
  real[int] accG(UhGlob.ndof);
  mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
  real ePoU = 0;
  for (int i = 0; i < UhGlob.ndof; ++i) ePoU = max(ePoU, abs(accG[i] - gg[][i]));

  /* O : D == 1/multiplicite, plus fort que V2 -- V2 laisserait passer {0.7,0.3} */
  real[int] cnt(UhGlob.ndof); cnt = 0;
  for (int i = 0; i < Udh.ndof; ++i) cnt[l2g[i]] += 1.0;
  real[int] cntG(UhGlob.ndof);
  mpiAllReduce(cnt, cntG, mpiCommWorld, mpiSUM);
  real eMult = 0;
  for (int i = 0; i < Udh.ndof; ++i) eMult = max(eMult, abs(D[i] - 1.0/cntG[l2g[i]]));

  /* partition EXACTE : pas un element en double */
  int ntLoc = ThLocal.nt, ntSum = 0;
  mpiAllReduce(ntLoc, ntSum, mpiCommWorld, mpiSUM);

  real eNG = abs(Udh.ndofglobal - UhGlob.ndof);
  real b, p, m, n5;
  mpiAllReduce(eBij,  b,  mpiCommWorld, mpiMAX);
  mpiAllReduce(ePoU,  p,  mpiCommWorld, mpiMAX);
  mpiAllReduce(eMult, m,  mpiCommWorld, mpiMAX);
  mpiAllReduce(eNG,   n5, mpiCommWorld, mpiMAX);
  bool ok = (b < 1e-8 && p < 1e-8 && m < 1e-12 && n5 < 1e-12
          && v6 >= 0 && v6 < 1e-8 && v7 < 1e-12 && ntSum == Th.nt);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [" << tag << "]  V1=" << b << "  V2=" << p << "  V5=" << n5
         << "  V6=" << v6 << "  V7=" << v7 << "  Dmult=" << m
         << "  nt=" << ntSum << "/" << Th.nt
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}//EOM

{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = 0, partmethod = "metis", keepGlobal = true);
  meshS ThLocal = DTh.local;
  fespace Uh(ThLocal, P2); fespace Udh(DTh, P2); fespace UhGlob(Th, P2);
  CHECKO(Th, ThLocal, Uh, Udh, UhGlob, "O1 meshS overlap=0 / P2") }

{ mesh3 Th = cube(nc, nc, nc);
  Dmesh3 DTh = distribute(Th, overlap = 0, partmethod = "metis", keepGlobal = true);
  mesh3 ThLocal = DTh.local;
  fespace Uh(ThLocal, P2); fespace Udh(DTh, P2); fespace UhGlob(Th, P2);
  CHECKO(Th, ThLocal, Uh, Udh, UhGlob, "O2 mesh3 overlap=0 / P2") }

{ meshL Th = segment(nseg);
  DmeshL DTh = distribute(Th, overlap = 0, partmethod = "metis", keepGlobal = true);
  meshL ThLocal = DTh.local;
  fespace Uh(ThLocal, Pk); fespace Udh(DTh, Pk); fespace UhGlob(Th, Pk);
  CHECKO(Th, ThLocal, Uh, Udh, UhGlob, "O3 meshL overlap=0 / Pk") }

{ meshS Th = square3(nsq, nsq);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  DmeshS DTh = distribute(Th, overlap = 0, partition = part, keepGlobal = true);
  meshS ThLocal = DTh.local;
  fespace Uh(ThLocal, P2); fespace Udh(DTh, P2); fespace UhGlob(Th, P2);
  CHECKO(Th, ThLocal, Uh, Udh, UhGlob, "O4 meshS overlap=0 / partition=user") }

// ---------- chemin shell : invariance de Udh.D ----------
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis", keepGlobal = true);
  CHECKPOU(DTh, Th, "shell / Udh.D invariant / metis") }

{ meshS Th = square3(nsq, nsq);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  DmeshS DTh = distribute(Th, overlap = ov, partition = part, keepGlobal = true);
  CHECKPOU(DTh, Th, "shell / Udh.D invariant / partition=user") }

// ---------- X1 : echappatoire non collective (checkDfespace = 0) ----------
//  Voir X1 dans l'entete : test de TERMINAISON, lancer avec un timeout.
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis", keepGlobal = true);
  int nloc = 0;
  checkDfespace = 0;
  if (mpirank == 0) {
    fespace Udh(DTh, P1);            /* declenche buildDistributedDofData */
    real[int] D   = Udh.D;           /* ... sur le rang 0 SEUL             */
    int[int]  l2g = Udh.loc2glob;
    nloc = Udh.ndof;
    if (nloc <= 0 || D.n != nloc || l2g.n != nloc) nloc = 0;
  }
  checkDfespace = 1;
  mpiBarrier(mpiCommWorld);          /* si on arrive ici, rien n'a bloque  */
  int x1 = ((mpirank == 0 && nloc == 0) ? 1 : 0), gx1;
  mpiAllReduce(x1, gx1, mpiCommWorld, mpiMAX);
  ntot++; if (gx1 == 0) npass++;
  if (mpirank == 0)
    cout << "  [fespace non collectif]  X1=" << gx1
         << "   => " << (gx1 == 0 ? "PASS" : "FAIL") << endl;
}

// ---------- N1..N3 : chemins d'erreur ----------
//  Une PoU cassee SEULE n'est pas atteignable depuis un script : PoU et carte
//  d'intersections derivent du meme globalPartition, dont la coherence entre
//  rangs est desormais verifiee DANS distribute. N1 et N4 exercent donc
//  l'incoherence a sa source, le tableau partition= lui-meme.
//  Chaque test reduit en MIN : verifie que TOUS les rangs levent, donc que
//  l'erreur est collective et non un blocage.

// N1 : partition incoherente entre rangs -> erreur collective. Le rang 0 seul
//  revendique un element de l'autre slab. checkPartitionConsistency intercepte
//  l'ecart DANS distribute, avant tout usage de la partition : le test n'est
//  plus plafonne a np = 2, l'ilot ne peut plus creer un voisin d'un seul cote
//  puisque distribute leve avant d'en arriver la.
//  Corollaire : checkIntersectionSymmetry n'est plus atteignable depuis un
//  script ; il ne peut plus se declencher que sur un bug interne.
//  Test multi-rangs par nature : sans voisin il n'y a pas d'incoherence.
if (mpisize > 1) {
  meshS Th = square3(nsq, nsq);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  if (mpirank == 0) part[Th.nt - 1] = 0;   /* rang 0 seul : ilot chez le voisin */
  int caught = 0;
  try {
    DmeshS DTh = distribute(Th, overlap = ov, partition = part);
    fespace Udh(DTh, P1);
    if (Udh.ndof < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N1 partition incoherente -> erreur collective]  N1=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N2 : overlap = 0 -- carte d'intersections. Test POSITIF depuis que le
//  chemin s = 0 existe (il attendait auparavant le refus a la construction).
//
//  Ne verifie QUE la carte d'intersections, pas la partition de l'unite :
//  a s = 0 l'intersection est de mesure nulle, donc aucun sous-maillage n'a
//  les ddl partages pour ddl. La liste est batie sur un porteur commun puis
//  filtree ; c'est cette construction que N2 met a l'epreuve, via
//     - la symetrie des tailles, verifiee a la construction du fespace,
//     - V7, l'appariement positionnel, qui LOCALISE un decalage.
//  P2 est obligatoire : en P1 un ddl par sommet rend une permutation
//  invisible. Les milieux d'aretes d'interface sont ce qui la revele.
//
//  La PoU relevera des blocs O* quand elle sera calculee au niveau ddl.
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = 0, partmethod = "metis");
  meshS ThLocal = DTh.local;
  fespace Uh(ThLocal, P2);
  fespace Udh(DTh, P2);
  real v7 = 0;
  PAIRV7(Udh, Uh, v7)
  /* la partition doit etre exacte : pas un element en double */
  int ntLoc = ThLocal.nt, ntSum = 0;
  mpiAllReduce(ntLoc, ntSum, mpiCommWorld, mpiSUM);
  int okLoc = (Udh.ndof > 0) ? 1 : 0, g;
  mpiAllReduce(okLoc, g, mpiCommWorld, mpiMIN);
  bool ok = (g == 1 && v7 < 1e-12 && ntSum == Th.nt);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [N2 overlap=0 / P2]  V7=" << v7
         << "  nt(somme)=" << ntSum << "/" << Th.nt
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}

// N3 : espace composite refuse (interpolatePoU).
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis");
  int caught = 0;
  try { fespace Udh(DTh, [P1, P2]); if (Udh.ndof < 0) caught = 1; }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N3 espace composite refuse]  N3=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N4 : maillages differents entre rangs -> erreur collective. partition= a la
//  bonne taille LOCALEMENT sur chaque rang, donc le controle de taille
//  existant ("partition[] requires Th.nt values") passe. C'est l'accord sur
//  part.n dans checkPartitionConsistency qui tombe -- la seule branche du
//  controle que N1 n'atteint pas. Multi-rangs par nature, comme N1.
if (mpisize > 1) { meshS Th = square3(nsq + (mpirank == 0 ? 1 : 0), nsq);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  int caught = 0;
  try {
    DmeshS DTh = distribute(Th, overlap = ov, partition = part);
    fespace Udh(DTh, P1);
    if (Udh.ndof < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N4 maillages differents refuses]  N4=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N5 : keepGlobal = false -> loc2glob indisponible, par erreur collective.
//  La construction du fespace est HORS du try : elle doit reussir. keepGlobal
//  n'enleve que le maillage global et ce qui en derive ; tout le reste (PoU,
//  intersections, numbering, ndofglobal) doit continuer a se construire.
//  Sans garde de np : le refus vaut aussi a un rang.
//  Reduction en MIN, comme N1-N4 : verifie que TOUS les rangs levent. Cette
//  collectivite n'est PAS une propriete locale de buildLoc2globIfNeeded, qui
//  est appelee hors de tout contexte collectif : elle tient uniquement parce
//  que TrueGlobalMesh est nul partout a la fois, ce que garantit la garde
//  d'uniformite de keepGlobal= dans distribute. Si cette garde disparait, ce
//  test se transforme en blocage -- le lancer avec un timeout.
//  Le cas 2 de test_distribute_scatter.edp reprend ce controle en le doublant
//  de son pendant positif (loc2glob toujours disponible du cote true).
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis", keepGlobal = false);
  fespace Udh(DTh, P1);
  int caught = 0;
  try { int[int] l2g = Udh.loc2glob; if (l2g.n < 0) caught = 1; }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N5 keepGlobal=false -> loc2glob indisponible]  N5=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// ---------- N6..N15 : validation collective des arguments de distribute ----------
//  Tous ces blocs sont des tests de TERMINAISON autant que de valeur, et la
//  distinction PASS / FAIL / blocage porte tout le sens :
//    - g == 1 (reduction MIN) : TOUS les rangs ont leve -> erreur collective ;
//    - g == 0                 : au moins un rang n'a pas leve -> l'erreur est
//                               asymetrique, et un script un peu plus long que
//                               celui-ci bloquerait ;
//    - pas de sortie du tout  : le rang fautif est deja parti en avant sans les
//                               autres. C'est le mode d'echec d'origine.
//  DONC : lancer ce fichier sous timeout. Un depassement n'est pas une lenteur,
//  c'est le bug que ces blocs surveillent.
//
//  Le motif est celui de N1..N5, avec deux variantes :
//    - N13 reduit en MIN *et* en MAX et n'exige que l'ACCORD (min == max),
//      parce que le declenchement depend du partitionneur et de np ;
//    - N15 est le controle NEGATIF de N14 : sans lui, N14 passerait aussi bien
//      si le garde levait sur tout recouvrement.
//
//  Les erreurs sont levees AVANT le premier envoi point a point : c'est ce qui
//  permet au script de continuer apres le catch. Si un futur lot deplace une
//  levee au-dela du dernier agreeOnStatus, ces blocs cesseront de rendre FAIL
//  et se mettront a pendre.

// N6 : partmethod inconnu. Le cas (a) : la levee etait dans
//  computeGlobalPartition, donc sur le rang 0 seul en mode scatter. Elle est
//  remontee dans distribute, avant tout MPI point a point.
{ meshS Th = square3(nsq, nsq);
  int caught = 0;
  try {
    DmeshS DTh = distribute(Th, overlap = ov, partmethod = "bogus");
    meshS L = DTh.local; if (L.nt < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N6 partmethod inconnu]  N6=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N7 : overlap non uniforme entre rangs. Pas une coquetterie : en mode scatter
//  le rang 0 taille les covers avec SON overlap tandis que le rang i derive son
//  masque local du sien -- resultat faux, sans blocage ni message. Le refus est
//  aussi ce qui rend collectif le garde overlap = 0 de N14, qui lit DTh->overlap
//  rang par rang. Multi-rangs par nature.
if (mpisize > 1) {
  meshS Th = square3(nsq, nsq);
  int caught = 0;
  try {
    DmeshS DTh = distribute(Th, overlap = (mpirank == 0 ? ov : ov + 1),
                            partmethod = "metis");
    meshS L = DTh.local; if (L.nt < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N7 overlap non uniforme refuse]  N7=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N8 : partmethod non uniforme. Les deux methodes sont VALIDES : ce qui est
//  refuse est le desaccord, pas le nom. Sans ce controle, metis (rang 0 puis
//  broadcast) et parmetis (collectif, sans broadcast) s'attendent mutuellement.
if (mpisize > 1) {
  meshS Th = square3(nsq, nsq);
  int caught = 0;
  try {
    DmeshS DTh = distribute(Th, overlap = ov,
                            partmethod = (mpirank == 0 ? "metis" : "scotch"));
    meshS L = DTh.local; if (L.nt < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N8 partmethod non uniforme refuse]  N8=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N9 : scatter = true alors que tous les rangs portent le maillage. Le mode est
//  DETECTE (detectDistributionMode) ; scatter= n'est qu'une assertion de
//  l'utilisateur sur ce qu'il croit avoir construit, et une assertion fausse
//  doit tomber du meme cote sur tous les rangs.
{ meshS Th = square3(nsq, nsq);
  int caught = 0;
  try {
    DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis", scatter = true);
    meshS L = DTh.local; if (L.nt < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N9 scatter=true en mode replique refuse]  N9=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N10 : partition= hors de [0, mpisize[. Controle qui n'existait pas : une
//  valeur >= mpisize ecrivait hors bornes dans le tableau isNeighbor de
//  distribute. Les deux bornes sont eprouvees, la haute et la negative.
if (mpisize > 1) {
  meshS Th = square3(nsq, nsq);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  int gHi = 0, gLo = 0;
  { int caught = 0;
    part[0] = mpisize;
    try { DmeshS DTh = distribute(Th, overlap = ov, partition = part);
          meshS L = DTh.local; if (L.nt < 0) caught = 1; }
    catch (...) { caught = 1; }
    mpiAllReduce(caught, gHi, mpiCommWorld, mpiMIN); }
  { int caught = 0;
    part[0] = -1;
    try { DmeshS DTh = distribute(Th, overlap = ov, partition = part);
          meshS L = DTh.local; if (L.nt < 0) caught = 1; }
    catch (...) { caught = 1; }
    mpiAllReduce(caught, gLo, mpiCommWorld, mpiMIN); }
  int g = min(gHi, gLo);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N10 partition hors domaine]  haut=" << gHi << " bas=" << gLo
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N11 : partition= laissant un rang SANS ELEMENT. Version deterministe de N13 :
//  tout au rang 0, donc les rangs > 0 sont vides a coup sur, sans dependre du
//  partitionneur. C'est ici que se lit la decision de l'etape 1 -- un maillage
//  local vide est REFUSE, pas supporte. L'etape 4 (redistribution) basculera
//  l'argument allowEmpty de checkPartitionUsable et ce bloc devra changer de
//  camp : il deviendra un test positif.
if (mpisize > 1) {
  meshS Th = square3(nsq, nsq);
  int[int] part(Th.nt);
  part = 0;
  int caught = 0;
  try {
    DmeshS DTh = distribute(Th, overlap = ov, partition = part);
    meshS L = DTh.local; if (L.nt < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N11 partition laissant un rang vide]  N11=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N12 : mpisize >= Th.nt. Le cas (b), avec le plus petit maillage possible --
//  square3(1,1) porte 2 triangles, donc la condition tient des np = 2 et ne
//  depend d'aucun raffinement. Le maillage est construit LOCALEMENT au bloc :
//  aucun autre test de ce fichier ne doit heriter d'un maillage degenere.
if (mpisize > 1) {
  meshS Tiny = square3(1, 1);
  int caught = 0;
  try {
    DmeshS DTh = distribute(Tiny, overlap = ov, partmethod = "metis");
    meshS L = DTh.local; if (L.nt < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N12 mpisize >= Th.nt]  N12=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N13 : le cas (c) tel quel -- cube(1,1,1), 6 tetraedres, partitionne par METIS.
//  A np = 3 METIS rend une partie VIDE alors meme que nt > mpisize : c'est
//  pourquoi le controle porte sur le tableau part effectif et non sur une
//  prediction a partir de nt. Le declenchement depend de np et du partitionneur,
//  donc le bloc ne prejuge PAS du resultat : il exige seulement que les rangs
//  soient d'accord. min != max, c'est exactement la configuration d'origine --
//  un rang qui poursuit, un rang qui meurt, un rang qui attend.
if (mpisize > 1) {
  mesh3 Th = cube(1, 1, 1);
  int caught = 0;
  try {
    Dmesh3 DTh = distribute(Th, overlap = ov, partmethod = "metis");
    mesh3 L = DTh.local; if (L.nt < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int gmin, gmax;
  mpiAllReduce(caught, gmin, mpiCommWorld, mpiMIN);
  mpiAllReduce(caught, gmax, mpiCommWorld, mpiMAX);
  bool ok = (gmin == gmax);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [N13 cube(1,1,1) : rangs d'accord]  min=" << gmin << " max=" << gmax
         << (gmin == 1 ? "  (tous levent)" : "  (aucun ne leve)")
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}

// N14 : overlap = 0 + PETSc. Le garde de buildShellIfNeeded. Sans lui le KSP
//  converge sur un operateur FAUX sans rien signaler : mesure faite a np = 3 sur
//  cube(10^3) en P1, max|u - u_ref| = 6.86 pour |u_ref|_inf = 3.34, tandis que
//  le CG annonce 4e-13. Voir l'entete des blocs O1..O4 pour le mecanisme.
//  Le chemin vise est le chemin SHELL, "Mat A = varf(...)" sans Mat construite
//  au prealable : c'est le seul par lequel PETSc voit le DistributedMesh. Le
//  chemin explicite Mat(ndof, intersection, D) ne recoit que des tableaux et
//  reste ouvert par construction -- il faudra §5.3 pour le fermer.
//  Sans garde de np : a un rang il n'y a pas d'interface, mais le garde s'en
//  remet a mpisize > 1 et doit donc laisser passer -- c'est ce que N15 verifie.
if (mpisize > 1) {
  meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = 0, partmethod = "metis");
  meshS ThLocal = DTh.local;
  fespace Uh(ThLocal, P1);
  fespace Udh(DTh, P1);
  func f = 1.0;
  varf vPb(u, v) = int2d(ThLocal)(dx(u)*dx(v) + dy(u)*dy(v) + dz(u)*dz(v))
                 + int2d(ThLocal)(f*v) + on(1, 2, 3, 4, u = 0);
  int caught = 0;
  try { Mat A = vPb(Udh, Udh); }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N14 overlap=0 + Mat shell refuse]  N14=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N15 : controle NEGATIF de N14. Le meme chemin shell, au meme endroit, avec
//  overlap = ov : il doit passer sans lever. Sans ce bloc, un garde qui
//  leverait a tout recouvrement rendrait N14 vert. Reduction en MAX : un seul
//  rang qui leve suffit a faire echouer.
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis");
  meshS ThLocal = DTh.local;
  fespace Uh(ThLocal, P1);
  fespace Udh(DTh, P1);
  func f = 1.0;
  varf vPb(u, v) = int2d(ThLocal)(dx(u)*dx(v) + dy(u)*dy(v) + dz(u)*dz(v))
                 + int2d(ThLocal)(f*v) + on(1, 2, 3, 4, u = 0);
  int raised = 0;
  try { Mat A = vPb(Udh, Udh); }
  catch (...) { raised = 1; }
  int g; mpiAllReduce(raised, g, mpiCommWorld, mpiMAX);
  ntot++; if (g == 0) npass++;
  if (mpirank == 0)
    cout << "  [N15 overlap=" << ov << " + Mat shell accepte]  N15=" << g
         << "   => " << (g == 0 ? "PASS" : "FAIL") << endl;
}

}
else {

// ---------- cas 1 : bande construite, contacts a distance -strip ----------
//  Trois sous-domaines empiles en x : 0 | 2 (bande de -strip mailles) | 1.
//  Les rangs 0 et 1 sont separes par -strip mailles. A overlap = 1 :
//    strip = 1 -> ils se touchent, tout doit passer ;
//    strip = 2 -> leurs recouvrements ne partagent AUCUN element mais
//                 partagent un plan de sommets : c'est le contact en coin ;
//    strip = 3 -> ils ne partagent plus rien, tout doit passer.
assert(mpisize == 3);
{ mesh3 Th = cube(nc, nc, nc);
  fespace Ph(Th, P0);
  Ph px = x;                            /* P0 = valeur au barycentre */
  int c0 = (nc - strip) / 2;
  int[int] part(Th.nt);
  int n0 = 0, n1 = 0, n2 = 0;
  for (int k = 0; k < Th.nt; ++k) {
    int ix = int(px[][k] * nc);
    if (ix < c0)               { part[k] = 0; n0++; }
    else if (ix < c0 + strip)  { part[k] = 2; n2++; }
    else                       { part[k] = 1; n1++; }
  }
  if (mpirank == 0)
    cout << "  bande : strip=" << strip << " mailles, tailles = "
         << n0 << " / " << n2 << " / " << n1 << endl;
  assert(n0 > 0 && n1 > 0 && n2 > 0);
  Dmesh3 DTh = distribute(Th, overlap = ov, partition = part, keepGlobal = true);
  CHECK3(DTh, Th, P1, "mesh3 / bande strip=" + strip) }

}

if (mpirank == 0) {
  cout << "===== BILAN : " << npass << " / " << ntot << " PASS =====" << endl;
  cout << (npass == ntot ? "  >>> ALL PASS" : "  >>> DES ECHECS") << endl;
}
