// NBPROC 2
// PARAM -wg -ns

// =====================================================================
//  Test multi-configurations de distribute(..., partmethod=...)
//  metis / scotch / parmetis / partition-utilisateur, sur meshL (1D),
//  meshS (surface) et mesh3 (3D).
//
//  Suppose FreeFEM configure avec Scotch ET ParMETIS (cf. SCOTCH_CORE et
//  PARMETIS_CORE dans la sortie de configure) : les cas correspondants ne
//  sont pas gardes et leveraient une erreur sinon.
//
//  Lancer :
//    ff-mpirun -np 4 test_distribute_multi.edp -ns
//    ff-mpirun -np 3 test_distribute_multi.edp -ns   (tranches inegales)
//
//  CONTRAT : creer un fespace distribue est COLLECTIF sur DTh.comm
//  (symetrie des intersections + residu de PoU), comme ffddmbuildDfespace.
//  checkDfespace = 0 le rend local : plus aucun controle, .checkPoU vaut -1.
//  Defaut 1.
//  Les criteres sont invariants au partitionnement : V1 (bijection
//  loc2glob), V2 (partition de l'unite), V4 (alignement PETSc) et V5
//  (comptage global) doivent valoir exactement 0. V3 (ecart a la solution
//  globale) peut varier legerement d'un run a l'autre sans que ce soit un
//  echec ; seuls les seuils comptent.
//
//  V4 est le test D1 : Udh.numbering doit coincider composante par
//  composante avec la numerotation que PETSc calcule via HPDDM. C'est le
//  seul critere qui detecte une regle de propriete valide mais desalignee
//  (departage des egalites inverse, ou ordre de numerotation different).
//  GlobalNumbering est appele juste apres le constructeur de Mat, AVANT
//  l'assemblage : apres "A = vPb(...)" il segfaute.
//
//  V5 : Udh.ndofglobal doit egaler UhGlob.ndof.
//
//  V6 : Udh.checkPoU -- residu de PoU le long des intersections de ddl, la
//  ou V2 la somme sur le maillage global. V2 valide la PoU, V6 valide la
//  carte d'intersections, soit l'objet transmis a HPDDM. La construction
//  verifie que les TAILLES concordent entre voisins ; leur appariement reste
//  POSITIONNEL et non verifie -- un decalage fait diverger V6 sans toucher
//  V2. Seul controle disponible en mode scatter. Calcule et reduit a la
//  construction : accesseur pur ici, et v6 < 0 = non calcule, donc FAIL.
//
//  DEGRE DES ELEMENTS : LocalMesh est obtenu par DEUX troncatures successives
//  (global -> cover -> local) et non une seule. La composition des deux n2o
//  n'est juste que si truncmesh preserve l'ordre des sommets DANS chaque
//  element ; sinon restrictDOF apparie les mauvais ddl et V1 diverge. P1 est
//  aveugle a ce defaut -- un ddl par sommet, une permutation ne se voit pas.
//  Le filet est donc pose sur les trois familles avec un element sensible :
//  P3 sur meshL (macro Pk), P2 sur mesh3 et meshS (cas "/ P2").
//
//  X1 : echappatoire checkDfespace = 0. Le bloc construit un fespace sur le
//  rang 0 SEUL ; si un collectif subsiste malgre le drapeau, il bloque. Test
//  de TERMINAISON : lancer avec un timeout, sinon une regression se presente
//  comme un job suspendu et non comme un echec.
//
//  NI / NE : nombre d'intersections de ddl declarees, et combien ont une
//  liste VIDE. La purge etant faite a la construction, NE doit valoir 0 ;
//  NE > 0 signale que la purge a ete contournee.
//
//  W1..W5 (macro CHECKPOU) : exercent le chemin "shell", c'est-a-dire
//  "Mat A = vPb(Udh, Udh)" SANS Mat construite au prealable. C'est le seul
//  chemin ou buildShellIfNeeded cede un tampon du fespace a HPDDM ; les
//  CHECK* ci-dessus passent tous par "Mat A(Udh.ndof, ...)" et sortent donc
//  au "if (B._A) return;", ils ne le couvrent pas.
//    W1 : Udh.D est la partition de l'unite FRACTIONNAIRE (nombre de ddl
//         dans ]0,1[, somme sur les rangs). Doit etre > 0.
//    W2 : Udh.D est inchange, bit a bit, par la construction de A. C'est le
//         critere central : HPDDM::Schwarz::restriction() ecrase en place le
//         tableau qu'on lui cede pour en faire le masque exclusif 0/1, et
//         initialize() en garde le pointeur brut. Si le tampon cede est
//         f->Ddof lui-meme, Udh.D change de valeur au milieu du script.
//         Doit valoir exactement 0.
//    W3 : A.D est bien ce masque exclusif (valeurs dans {0,1}) : la
//         restriction a bien lieu, elle s'applique juste ailleurs.
//    W4 : le chemin shell resout toujours juste (garde-fou sur la propriete
//         du scaling cote Dmat, dont depend la numerotation globale).
//    W5 : Udh.D relu APRES construction de A recompose encore exactement un
//         champ global par somme ponderee inter-rangs.
//    W6 : meme chose que W5 mais par la route des intersections plutot que
//         par loc2glob. W2 detecte une mutation bit a bit de Udh.D ; W6
//         detecte en plus une PoU restee intacte mais devenue incoherente
//         avec la carte d'intersections. Doit valoir ~0.
//
//  Parametres de ligne de commande :
//    -ov     recouvrement passe a distribute (defaut 1)
//    -nseg   raffinement du segment  (defaut 80)
//    -nc     raffinement du cube     (defaut 8)
//    -nsq    raffinement du carre    (defaut 16)
//    -case   0 = balayage standard (defaut)
//            1 = partition construite "bande" : trois sous-domaines
//                x<gauche | bande d'epaisseur -strip | x>droite,
//                pour eprouver les contacts a distance 2. Exige -np 3.
//    -strip  epaisseur de la bande en mailles, cas 1 (defaut 2)
// =====================================================================
load "Element_P3"
load "PETSc"
include "getARGV.idp"

macro Pk()P3//EOM

int npass = 0, ntot = 0;
string kspp = "-ksp_type gmres -pc_type asm -ksp_rtol 1e-8";

int ov    = getARGV("-ov", 1);
int nseg  = getARGV("-nseg", 80);
int nc    = getARGV("-nc", 8);
int nsq   = getARGV("-nsq", 16);
int cas   = getARGV("-case", 0);
int strip = getARGV("-strip", 2);

// -------- comptage des intersections (commun aux trois macros) --------
macro COUNTI(Udh, nItot, nEtot) {
  int nI = Udh.intersection[0].n, nEmpty = 0;
  for (int j = 0; j < nI; ++j) if (Udh.intersection[1 + j].n == 0) nEmpty++;
  mpiAllReduce(nI,     nItot, mpiCommWorld, mpiSUM);
  mpiAllReduce(nEmpty, nEtot, mpiCommWorld, mpiSUM);
}//EOM

// -------- validation courbe/1D (meshL) --------
macro CHECKL(DTh, Th, tag) {
  meshL ThLocal = DTh.local;
  fespace Uh(ThLocal, Pk);
  fespace Udh(DTh, Pk);
  fespace UhGlob(Th, Pk);
  real[int] D = Udh.D;
  int[int]  l2g = Udh.loc2glob;
  int nItot = 0, nEtot = 0;
  COUNTI(Udh, nItot, nEtot)
  /* V6 : valeur figee a la construction du fespace, deja reduite en max
     sur les rangs. Lecture locale. */
  real v6 = Udh.checkPoU;
  Mat A(Udh.ndof, Udh.intersection, D);
  int[int] pnum;
  GlobalNumbering(A, pnum);        /* AVANT l'assemblage : sinon SEGV */
  int[int] gnum = Udh.numbering;
  func f = 1.0;
  varf vPb(u, v) = int1d(ThLocal)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v))
                 + int1d(ThLocal)(f*v) + on(1, 2, u = 0);
  A = vPb(Udh, Udh);
  real[int] rhs = vPb(0, Uh);
  set(A, sparams = kspp);
  real[int] uu = A^-1 * rhs;
  func fa = x + 2*y + 3*z + x*y;
  UhGlob gg = fa;  Uh gl = fa;
  real eBij = 0;
  for (int i = 0; i < gl.n; ++i) eBij = max(eBij, abs(gl[][i] - gg[][l2g[i]]));
  real[int] acc(UhGlob.ndof); acc = 0;
  for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D[i] * gg[][l2g[i]];
  real[int] accG(UhGlob.ndof);
  mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
  real ePoU = 0;
  for (int i = 0; i < UhGlob.ndof; ++i) ePoU = max(ePoU, abs(accG[i] - gg[][i]));
  varf vG(u, v) = int1d(Th)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v)) + int1d(Th)(f*v) + on(1,2,u=0);
  matrix AG = vG(UhGlob, UhGlob, solver = UMFPACK);
  real[int] rG = vG(0, UhGlob);
  real[int] ug = AG^-1 * rG;
  real eSol = 0;
  for (int i = 0; i < uu.n; ++i) eSol = max(eSol, abs(uu[i] - ug[l2g[i]]));
  real eNum = 0;
  int  nbad = 0;
  if (pnum.n != gnum.n) nbad = 1;
  else
    for (int i = 0; i < gnum.n; ++i) {
      real dd = pnum[i] - gnum[i];
      eNum = max(eNum, abs(dd));
    }
  real eNG = abs(Udh.ndofglobal - UhGlob.ndof);
  real b, p, s, n4, n5;
  int nb;
  mpiAllReduce(eBij, b, mpiCommWorld, mpiMAX);
  mpiAllReduce(ePoU, p, mpiCommWorld, mpiMAX);
  mpiAllReduce(eSol, s, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNum, n4, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNG,  n5, mpiCommWorld, mpiMAX);
  mpiAllReduce(nbad, nb, mpiCommWorld, mpiMAX);
  bool ok = (b < 1e-8 && p < 1e-8 && s < 1e-5 && n4 < 1e-12 && n5 < 1e-12 && nb == 0
          && v6 >= 0 && v6 < 1e-8);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [" << tag << "]  V1=" << b << "  V2=" << p << "  V3=" << s
         << "  V4=" << n4 << "  V5=" << n5 << "  V6=" << v6
         << "  NI=" << nItot << "  NE=" << nEtot
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}//EOM

// -------- validation volume/3D (mesh3) --------
macro CHECK3(DTh, Th, PkX, tag) {
  mesh3 ThLocal = DTh.local;
  fespace Uh(ThLocal, PkX);
  fespace Udh(DTh, PkX);
  fespace UhGlob(Th, PkX);
  real[int] D = Udh.D;
  int[int]  l2g = Udh.loc2glob;
  int nItot = 0, nEtot = 0;
  COUNTI(Udh, nItot, nEtot)
  /* V6 : valeur figee a la construction du fespace, deja reduite en max
     sur les rangs. Lecture locale. */
  real v6 = Udh.checkPoU;
  Mat A(Udh.ndof, Udh.intersection, D);
  int[int] pnum;
  GlobalNumbering(A, pnum);        /* AVANT l'assemblage : sinon SEGV */
  int[int] gnum = Udh.numbering;
  func f = 1.0;
  varf vPb(u, v) = int3d(ThLocal)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v))
                 + int3d(ThLocal)(f*v) + on(1,2,3,4,5,6, u = 0);
  A = vPb(Udh, Udh);
  real[int] rhs = vPb(0, Uh);
  set(A, sparams = kspp);
  real[int] uu = A^-1 * rhs;
  func fa = x + 2*y + 3*z + x*y;
  UhGlob gg = fa;  Uh gl = fa;
  real eBij = 0;
  for (int i = 0; i < gl.n; ++i) eBij = max(eBij, abs(gl[][i] - gg[][l2g[i]]));
  real[int] acc(UhGlob.ndof); acc = 0;
  for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D[i] * gg[][l2g[i]];
  real[int] accG(UhGlob.ndof);
  mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
  real ePoU = 0;
  for (int i = 0; i < UhGlob.ndof; ++i) ePoU = max(ePoU, abs(accG[i] - gg[][i]));
  varf vG(u, v) = int3d(Th)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v)) + int3d(Th)(f*v) + on(1,2,3,4,5,6,u=0);
  matrix AG = vG(UhGlob, UhGlob, solver = UMFPACK);
  real[int] rG = vG(0, UhGlob);
  real[int] ug = AG^-1 * rG;
  real eSol = 0;
  for (int i = 0; i < uu.n; ++i) eSol = max(eSol, abs(uu[i] - ug[l2g[i]]));
  real eNum = 0;
  int  nbad = 0;
  if (pnum.n != gnum.n) nbad = 1;
  else
    for (int i = 0; i < gnum.n; ++i) {
      real dd = pnum[i] - gnum[i];
      eNum = max(eNum, abs(dd));
    }
  real eNG = abs(Udh.ndofglobal - UhGlob.ndof);
  real b, p, s, n4, n5;
  int nb;
  mpiAllReduce(eBij, b, mpiCommWorld, mpiMAX);
  mpiAllReduce(ePoU, p, mpiCommWorld, mpiMAX);
  mpiAllReduce(eSol, s, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNum, n4, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNG,  n5, mpiCommWorld, mpiMAX);
  mpiAllReduce(nbad, nb, mpiCommWorld, mpiMAX);
  bool ok = (b < 1e-8 && p < 1e-8 && s < 1e-5 && n4 < 1e-12 && n5 < 1e-12 && nb == 0
          && v6 >= 0 && v6 < 1e-8);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [" << tag << "]  V1=" << b << "  V2=" << p << "  V3=" << s
         << "  V4=" << n4 << "  V5=" << n5 << "  V6=" << v6
         << "  NI=" << nItot << "  NE=" << nEtot
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}//EOM

// -------- validation surface/2D-dans-3D (meshS) --------
macro CHECKS(DTh, Th, PkX, tag) {
  meshS ThLocal = DTh.local;
  fespace Uh(ThLocal, PkX);
  fespace Udh(DTh, PkX);
  fespace UhGlob(Th, PkX);
  real[int] D = Udh.D;
  int[int]  l2g = Udh.loc2glob;
  int nItot = 0, nEtot = 0;
  COUNTI(Udh, nItot, nEtot)
  /* V6 : valeur figee a la construction du fespace, deja reduite en max
     sur les rangs. Lecture locale. */
  real v6 = Udh.checkPoU;
  Mat A(Udh.ndof, Udh.intersection, D);
  int[int] pnum;
  GlobalNumbering(A, pnum);        /* AVANT l'assemblage : sinon SEGV */
  int[int] gnum = Udh.numbering;
  func f = 1.0;
  varf vPb(u, v) = int2d(ThLocal)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v))
                 + int2d(ThLocal)(f*v) + on(1,2,3,4, u = 0);
  A = vPb(Udh, Udh);
  real[int] rhs = vPb(0, Uh);
  set(A, sparams = kspp);
  real[int] uu = A^-1 * rhs;
  func fa = x + 2*y + 3*z + x*y;
  UhGlob gg = fa;  Uh gl = fa;
  real eBij = 0;
  for (int i = 0; i < gl.n; ++i) eBij = max(eBij, abs(gl[][i] - gg[][l2g[i]]));
  real[int] acc(UhGlob.ndof); acc = 0;
  for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D[i] * gg[][l2g[i]];
  real[int] accG(UhGlob.ndof);
  mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
  real ePoU = 0;
  for (int i = 0; i < UhGlob.ndof; ++i) ePoU = max(ePoU, abs(accG[i] - gg[][i]));
  varf vG(u, v) = int2d(Th)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v)) + int2d(Th)(f*v) + on(1,2,3,4,u=0);
  matrix AG = vG(UhGlob, UhGlob, solver = UMFPACK);
  real[int] rG = vG(0, UhGlob);
  real[int] ug = AG^-1 * rG;
  real eSol = 0;
  for (int i = 0; i < uu.n; ++i) eSol = max(eSol, abs(uu[i] - ug[l2g[i]]));
  real eNum = 0;
  int  nbad = 0;
  if (pnum.n != gnum.n) nbad = 1;
  else
    for (int i = 0; i < gnum.n; ++i) {
      real dd = pnum[i] - gnum[i];
      eNum = max(eNum, abs(dd));
    }
  real eNG = abs(Udh.ndofglobal - UhGlob.ndof);
  real b, p, s, n4, n5;
  int nb;
  mpiAllReduce(eBij, b, mpiCommWorld, mpiMAX);
  mpiAllReduce(ePoU, p, mpiCommWorld, mpiMAX);
  mpiAllReduce(eSol, s, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNum, n4, mpiCommWorld, mpiMAX);
  mpiAllReduce(eNG,  n5, mpiCommWorld, mpiMAX);
  mpiAllReduce(nbad, nb, mpiCommWorld, mpiMAX);
  bool ok = (b < 1e-8 && p < 1e-8 && s < 1e-5 && n4 < 1e-12 && n5 < 1e-12 && nb == 0
          && v6 >= 0 && v6 < 1e-8);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [" << tag << "]  V1=" << b << "  V2=" << p << "  V3=" << s
         << "  V4=" << n4 << "  V5=" << n5 << "  V6=" << v6
         << "  NI=" << nItot << "  NE=" << nEtot
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}//EOM

// -------- invariance de Udh.D sur le chemin "shell" (meshS) --------
//  Le seul chemin qui passe par buildShellIfNeeded : "Mat A = vPb(...)"
//  sans constructeur explicite. Voir W1..W5 dans l'entete.
macro CHECKPOU(DTh, Th, tag) {
  meshS ThLocal = DTh.local;
  fespace Uh(ThLocal, P1);
  fespace Udh(DTh, P1);
  fespace UhGlob(Th, P1);
  int[int] l2g = Udh.loc2glob;

  /* W1 : avant toute Mat, Udh.D doit etre fractionnaire */
  real[int] D0 = Udh.D;
  real nfrac = 0;
  for (int i = 0; i < D0.n; ++i)
    if (D0[i] > 1e-12 && D0[i] < 1.0 - 1e-12) nfrac += 1;

  func f = 1.0;
  varf vPb(u, v) = int2d(ThLocal)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v))
                 + int2d(ThLocal)(f*v) + on(1,2,3,4, u = 0);
  Mat A = vPb(Udh, Udh);           /* chemin shell : aucune Mat construite avant */

  /* W2 : Udh.D relu apres doit etre identique bit a bit */
  real[int] D1 = Udh.D;
  real eStable = 0;
  if (D1.n != D0.n) eStable = 1;
  else
    for (int i = 0; i < D0.n; ++i) eStable = max(eStable, abs(D0[i] - D1[i]));

  /* W3 : A.D est le masque exclusif 0/1 (lecture via .*= , seul motif expose) */
  Uh dmask; dmask[] = 1.0; dmask[] .*= A.D;
  real eMask = 0;
  for (int i = 0; i < dmask.n; ++i)
    eMask = max(eMask, min(abs(dmask[][i]), abs(dmask[][i] - 1.0)));

  /* W4 : la resolution par ce chemin coincide avec le probleme global */
  real[int] rhs = vPb(0, Uh);
  set(A, sparams = kspp);
  real[int] uu = A^-1 * rhs;
  varf vG(u, v) = int2d(Th)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v)) + int2d(Th)(f*v) + on(1,2,3,4,u=0);
  matrix AG = vG(UhGlob, UhGlob, solver = UMFPACK);
  real[int] rG = vG(0, UhGlob);
  real[int] ug = AG^-1 * rG;
  real eSol = 0;
  for (int i = 0; i < uu.n; ++i) eSol = max(eSol, abs(uu[i] - ug[l2g[i]]));

  /* W5 : la PoU relue apres coup recompose encore un champ global */
  func fa = x + 2*y + 3*z + x*y;
  UhGlob gg = fa;
  real[int] acc(UhGlob.ndof); acc = 0;
  for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D1[i] * gg[][l2g[i]];
  real[int] accG(UhGlob.ndof);
  mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
  real ePoU = 0;
  for (int i = 0; i < UhGlob.ndof; ++i) ePoU = max(ePoU, abs(accG[i] - gg[][i]));

  /* W6 : meme controle que W5 mais par la route des intersections, APRES
     que HPDDM a pris un tampon sur le chemin shell. W2 detecte deja une
     mutation bit a bit de Udh.D ; W6 detecte en plus une PoU restee intacte
     mais devenue incoherente avec la carte d'intersections. */
  real w6 = Udh.checkPoU;

  real w1, w2, w3, w4, w5;
  mpiAllReduce(nfrac,   w1, mpiCommWorld, mpiSUM);
  mpiAllReduce(eStable, w2, mpiCommWorld, mpiMAX);
  mpiAllReduce(eMask,   w3, mpiCommWorld, mpiMAX);
  mpiAllReduce(eSol,    w4, mpiCommWorld, mpiMAX);
  mpiAllReduce(ePoU,    w5, mpiCommWorld, mpiMAX);
  /* w2 : egalite EXACTE voulue, D0 et D1 sont deux copies du meme tampon
     sans aucune arithmetique entre les deux ; toute derive est une mutation.
     w1 n'est exigible qu'a plusieurs rangs : sans voisin, la PoU vaut 1
     partout et W2 passerait trivialement */
  bool ok = ((mpisize == 1 || w1 > 0) && w2 == 0.0 && w3 < 1e-12 && w4 < 1e-5 && w5 < 1e-8
          && w6 >= 0 && w6 < 1e-8);
  ntot++; if (ok) npass++;
  if (mpirank == 0)
    cout << "  [" << tag << "]  W1=" << w1 << "  W2=" << w2 << "  W3=" << w3
         << "  W4=" << w4 << "  W5=" << w5 << "  W6=" << w6
         << "   => " << (ok ? "PASS" : "FAIL") << endl;
}//EOM

if (mpirank == 0)
  cout << "===== distribute() multi-config  (np=" << mpisize
       << "  overlap=" << ov << "  case=" << cas
       << "  nseg=" << nseg << " nc=" << nc << " nsq=" << nsq << ") =====" << endl;

if (cas == 0) {

// ---------- meshL : metis vs scotch ----------
{ meshL Th = segment(nseg);
  DmeshL DTh = distribute(Th, overlap = ov, partmethod = "metis");
  CHECKL(DTh, Th, "meshL / metis") }

{ meshL Th = segment(nseg);
  DmeshL DTh = distribute(Th, overlap = ov, partmethod = "scotch");
  CHECKL(DTh, Th, "meshL / scotch") }

{ meshL Th = segment(nseg);
  DmeshL DTh = distribute(Th, overlap = ov, partmethod = "parmetis");
  CHECKL(DTh, Th, "meshL / parmetis") }

// ---------- meshL : partition utilisateur (decoupage contigu) ----------
{ meshL Th = segment(nseg);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  DmeshL DTh = distribute(Th, overlap = ov, partition = part);
  CHECKL(DTh, Th, "meshL / partition=user") }

// ---------- mesh3 : metis vs scotch ----------
{ mesh3 Th = cube(nc, nc, nc);
  Dmesh3 DTh = distribute(Th, overlap = ov, partmethod = "metis");
  CHECK3(DTh, Th, P1, "mesh3 / metis") }

{ mesh3 Th = cube(nc, nc, nc);
  Dmesh3 DTh = distribute(Th, overlap = ov, partmethod = "scotch");
  CHECK3(DTh, Th, P1, "mesh3 / scotch") }

{ mesh3 Th = cube(nc, nc, nc);
  Dmesh3 DTh = distribute(Th, overlap = ov, partmethod = "parmetis");
  CHECK3(DTh, Th, P1, "mesh3 / parmetis") }

// ---------- meshS : metis vs scotch ----------
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis");
  CHECKS(DTh, Th, P1, "meshS / metis") }

{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "scotch");
  CHECKS(DTh, Th, P1, "meshS / scotch") }

{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "parmetis");
  CHECKS(DTh, Th, P1, "meshS / parmetis") }

// ---------- meshS : partition utilisateur (decoupage contigu) ----------
{ meshS Th = square3(nsq, nsq);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  DmeshS DTh = distribute(Th, overlap = ov, partition = part);
  CHECKS(DTh, Th, P1, "meshS / partition=user") }

// ---------- mesh3 / meshS en P2 : composition des deux troncatures ----------
//  Voir DEGRE DES ELEMENTS dans l'entete. P1 ne peut pas detecter une
//  permutation des sommets dans la composition global -> cover -> local ;
//  P2 la detecte via V1.
{ mesh3 Th = cube(nc, nc, nc);
  Dmesh3 DTh = distribute(Th, overlap = ov, partmethod = "metis");
  CHECK3(DTh, Th, P2, "mesh3 / metis / P2") }

{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis");
  CHECKS(DTh, Th, P2, "meshS / metis / P2") }

// ---------- chemin shell : invariance de Udh.D ----------
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis");
  CHECKPOU(DTh, Th, "shell / Udh.D invariant / metis") }

{ meshS Th = square3(nsq, nsq);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  DmeshS DTh = distribute(Th, overlap = ov, partition = part);
  CHECKPOU(DTh, Th, "shell / Udh.D invariant / partition=user") }

// ---------- X1 : echappatoire non collective (checkDfespace = 0) ----------
//  Voir X1 dans l'entete : test de TERMINAISON, lancer avec un timeout.
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis");
  int nloc = 0;
  checkDfespace = 0;
  if (mpirank == 0) {
    fespace Udh(DTh, P1);            /* declenche buildDistributedDofData */
    real[int] D   = Udh.D;           /* ... sur le rang 0 SEUL             */
    int[int]  l2g = Udh.loc2glob;
    nloc = Udh.ndof;
    if (nloc <= 0 || D.n != nloc || l2g.n != nloc) nloc = 0;
  }
  checkDfespace = 1;
  mpiBarrier(mpiCommWorld);          /* si on arrive ici, rien n'a bloque  */
  int x1 = ((mpirank == 0 && nloc == 0) ? 1 : 0), gx1;
  mpiAllReduce(x1, gx1, mpiCommWorld, mpiMAX);
  ntot++; if (gx1 == 0) npass++;
  if (mpirank == 0)
    cout << "  [fespace non collectif]  X1=" << gx1
         << "   => " << (gx1 == 0 ? "PASS" : "FAIL") << endl;
}

// ---------- N1..N3 : chemins d'erreur ----------
//  Une PoU cassee SEULE n'est pas atteignable depuis un script : PoU et carte
//  d'intersections derivent du meme globalPartition, dont la coherence entre
//  rangs est desormais verifiee DANS distribute. N1 et N4 exercent donc
//  l'incoherence a sa source, le tableau partition= lui-meme.
//  Chaque test reduit en MIN : verifie que TOUS les rangs levent, donc que
//  l'erreur est collective et non un blocage.

// N1 : partition incoherente entre rangs -> erreur collective. Le rang 0 seul
//  revendique un element de l'autre slab. checkPartitionConsistency intercepte
//  l'ecart DANS distribute, avant tout usage de la partition : le test n'est
//  plus plafonne a np = 2, l'ilot ne peut plus creer un voisin d'un seul cote
//  puisque distribute leve avant d'en arriver la.
//  Corollaire : checkIntersectionSymmetry n'est plus atteignable depuis un
//  script ; il ne peut plus se declencher que sur un bug interne.
//  Test multi-rangs par nature : sans voisin il n'y a pas d'incoherence.
if (mpisize > 1) {
  meshS Th = square3(nsq, nsq);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  if (mpirank == 0) part[Th.nt - 1] = 0;   /* rang 0 seul : ilot chez le voisin */
  int caught = 0;
  try {
    DmeshS DTh = distribute(Th, overlap = ov, partition = part);
    fespace Udh(DTh, P1);
    if (Udh.ndof < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N1 partition incoherente -> erreur collective]  N1=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N2 : overlap = 0 refuse a la construction du fespace.
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = 0, partmethod = "metis");
  int caught = 0;
  try { fespace Udh(DTh, P1); if (Udh.ndof < 0) caught = 1; }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N2 overlap=0 refuse]  N2=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N3 : espace composite refuse (interpolatePoU).
{ meshS Th = square3(nsq, nsq);
  DmeshS DTh = distribute(Th, overlap = ov, partmethod = "metis");
  int caught = 0;
  try { fespace Udh(DTh, [P1, P2]); if (Udh.ndof < 0) caught = 1; }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N3 espace composite refuse]  N3=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

// N4 : maillages differents entre rangs -> erreur collective. partition= a la
//  bonne taille LOCALEMENT sur chaque rang, donc le controle de taille
//  existant ("partition[] requires Th.nt values") passe. C'est l'accord sur
//  part.n dans checkPartitionConsistency qui tombe -- la seule branche du
//  controle que N1 n'atteint pas. Multi-rangs par nature, comme N1.
if (mpisize > 1) { meshS Th = square3(nsq + (mpirank == 0 ? 1 : 0), nsq);
  int[int] part(Th.nt);
  for (int k = 0; k < Th.nt; ++k) part[k] = k * mpisize / Th.nt;
  int caught = 0;
  try {
    DmeshS DTh = distribute(Th, overlap = ov, partition = part);
    fespace Udh(DTh, P1);
    if (Udh.ndof < 0) caught = 1;
  }
  catch (...) { caught = 1; }
  int g; mpiAllReduce(caught, g, mpiCommWorld, mpiMIN);
  ntot++; if (g == 1) npass++;
  if (mpirank == 0)
    cout << "  [N4 maillages differents refuses]  N4=" << g
         << "   => " << (g == 1 ? "PASS" : "FAIL") << endl;
}

}
else {

// ---------- cas 1 : bande construite, contacts a distance -strip ----------
//  Trois sous-domaines empiles en x : 0 | 2 (bande de -strip mailles) | 1.
//  Les rangs 0 et 1 sont separes par -strip mailles. A overlap = 1 :
//    strip = 1 -> ils se touchent, tout doit passer ;
//    strip = 2 -> leurs recouvrements ne partagent AUCUN element mais
//                 partagent un plan de sommets : c'est le contact en coin ;
//    strip = 3 -> ils ne partagent plus rien, tout doit passer.
assert(mpisize == 3);
{ mesh3 Th = cube(nc, nc, nc);
  fespace Ph(Th, P0);
  Ph px = x;                            /* P0 = valeur au barycentre */
  int c0 = (nc - strip) / 2;
  int[int] part(Th.nt);
  int n0 = 0, n1 = 0, n2 = 0;
  for (int k = 0; k < Th.nt; ++k) {
    int ix = int(px[][k] * nc);
    if (ix < c0)               { part[k] = 0; n0++; }
    else if (ix < c0 + strip)  { part[k] = 2; n2++; }
    else                       { part[k] = 1; n1++; }
  }
  if (mpirank == 0)
    cout << "  bande : strip=" << strip << " mailles, tailles = "
         << n0 << " / " << n2 << " / " << n1 << endl;
  assert(n0 > 0 && n1 > 0 && n2 > 0);
  Dmesh3 DTh = distribute(Th, overlap = ov, partition = part);
  CHECK3(DTh, Th, P1, "mesh3 / bande strip=" + strip) }

}

if (mpirank == 0) {
  cout << "===== BILAN : " << npass << " / " << ntot << " PASS =====" << endl;
  cout << (npass == ntot ? "  >>> ALL PASS" : "  >>> DES ECHECS") << endl;
}
