// NBPROC 2
// PARAM -wg -ns -ffddm_overlap 1
// Validation Phase 1 : DmeshS, élément scalaire paramétrable.
load "Element_P3"//
macro Pk()P3//EOM        // <-- mettre P1, P2 ou P3 ici

include "ffddm.idp"
load "PETSc"

meshS Th = square3(20, 20);
DmeshS DTh = distribute(Th, overlap = ffddmoverlap);
meshS ThLocal = DTh.local;

fespace Uh(ThLocal, Pk);     // standard local (champ + rhs)
fespace Udh(DTh, Pk);        // distribué : .D / .intersection / .loc2glob
fespace UhGlob(Th, Pk);      // global répliqué (référence)

real[int] Dvec = Udh.D;
int[int]  l2g  = Udh.loc2glob;

// ---- T1 : bijection loc2glob (valeurs nodales identiques des deux côtés) ----
func fa = x + 2*y + 3*z + x*y;
UhGlob gglob = fa;
Uh     gloc  = fa;
real errBij = 0;
for (int i = 0; i < gloc.n; ++i)
  errBij = max(errBij, abs(gloc[][i] - gglob[][l2g[i]]));

// ---- T2 : partition de l'unité  Σ_i R_i^T D_i R_i = Id  (sans solveur) ----
// teste DIRECTEMENT Udh.D (interpolatePoU) pour P2/P3
real[int] dloc(Udh.ndof);
for (int i = 0; i < Udh.ndof; ++i) dloc[i] = Dvec[i] * gglob[][l2g[i]];
real[int] acc(UhGlob.ndof); acc = 0;
for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += dloc[i];
real[int] accG(UhGlob.ndof);
mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
real errPoU = 0;
for (int i = 0; i < UhGlob.ndof; ++i) errPoU = max(errPoU, abs(accG[i] - gglob[][i]));

// ---- T3 : solve distribué vs global (Laplace-Beltrami, valable P1/P2/P3) ----
real[int] Dv = Dvec;
Mat A(Udh.ndof, Udh.intersection, Dv);
func f = 1.0;
varf vPb(u, v) = int2d(ThLocal)(dx(u)*dx(v) + dy(u)*dy(v) + dz(u)*dz(v))
               + int2d(ThLocal)(f*v) + on(1,2,3,4, u = 0);
A = vPb(Udh, Udh);
real[int] rhs = vPb(0, Uh);
set(A, sparams = "-ksp_type cg -pc_type asm -ksp_rtol 1e-8");
real[int] u = A^-1 * rhs;

varf vPbG(u, v) = int2d(Th)(dx(u)*dx(v) + dy(u)*dy(v) + dz(u)*dz(v))
                + int2d(Th)(f*v) + on(1,2,3,4, u = 0);
matrix AG = vPbG(UhGlob, UhGlob, solver = UMFPACK);
real[int] rhsG = vPbG(0, UhGlob);
real[int] uG = AG^-1 * rhsG;
real errSol = 0;
for (int i = 0; i < u.n; ++i) errSol = max(errSol, abs(u[i] - uG[l2g[i]]));

// ---- verdict global ----
real eBij, ePoU, eSol;
mpiAllReduce(errBij, eBij, mpiCommWorld, mpiMAX);
mpiAllReduce(errPoU, ePoU, mpiCommWorld, mpiMAX);
mpiAllReduce(errSol, eSol, mpiCommWorld, mpiMAX);
if (mpirank == 0) {
  cout << "==== VALIDATION (scalaire) ====" << endl;
  cout << " T1 bijection      : " << eBij << "  (~1e-12)" << endl;
  cout << " T2 partition unite: " << ePoU << "  (~1e-12)" << endl;
  cout << " T3 vs global      : " << eSol << "  (~1e-7)"  << endl;
  cout << ((eBij < 1e-8 && ePoU < 1e-8 && eSol < 1e-5) ? " => PASS" : " => FAIL") << endl;
}
