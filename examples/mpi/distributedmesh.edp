// NBPROC 4
// PARAM -wg -ns -ffddm_overlap 1
include "ffddm.idp"
load "PETSc"

meshS Th = square3(20, 20);

DmeshS DTh = distribute(Th, overlap = ffddmoverlap);
meshS ThLocal = DTh.local;

fespace Uh(ThLocal, P1);              // fespace standard pour le rhs
fespace Udh(DTh, P1); // v_dfesS, construit sur DTh.LocalMesh

// ===== Construction minimale (c==1) : structure distribuée seule, matrice vide =====
real[int] Dvec = DTh.D;
Mat A(Udh.ndof, DTh.intersection, Dvec); // structure seule, matrice vide

// Remplissage de la matrice
func f = 1.0;
varf vPb(u, v) = int2d(ThLocal)(dx(u)*dx(v) + dy(u)*dy(v) + dz(u)*dz(v))
               + int2d(ThLocal)(f*v)
               + on(1, 2, 3, 4, u = 0);    


A = vPb(Udh, Udh);                          
real[int] rhs = vPb(0, Uh);              

// Résolution distribuée
set(A, sparams = "-ksp_type cg -pc_type asm -ksp_rtol 1e-4 -ksp_converged_reason");
real[int] u = A^-1 * rhs;

// Check validation
// ---- C.1 : bijection loc2glob (champ analytique, sans solveur) ----
int[int] l2g = DTh.loc2glob;                 // KN<long> : sommet local -> sommet global
fespace UhGlob(Th, P1);                       // maillage GLOBAL (Th existe sur chaque rang)
UhGlob gglob = x + 2*y + 3*z;                 // champ connu, non trivial
Uh      gloc = x + 2*y + 3*z;                 // même champ sur ThLocal (Uh standard)

real errBij = 0;
for (int i = 0; i < gloc.n; ++i)
  errBij = max(errBij, abs(gloc[][i] - gglob[][l2g[i]]));
cout << "[" << mpirank << "] C.1 |loc2glob bijection|_inf = " << errBij << endl;




// ---- C.3 : résolution de référence sur le maillage global ----
varf vPbGlob(u, v) = int2d(Th)(dx(u)*dx(v) + dy(u)*dy(v) + dz(u)*dz(v))
                   + int2d(Th)(f*v)
                   + on(1, 2, 3, 4, u = 0);   // MÊMES labels physiques que la varf locale
matrix AGlob       = vPbGlob(UhGlob, UhGlob, solver = UMFPACK);  // séquentiel, par-process
real[int] rhsGlob  = vPbGlob(0, UhGlob);
real[int] uglob    = AGlob^-1 * rhsGlob;

// ---- C.4 : solution distribuée vs solution globale ----
real errSol = 0;
for (int i = 0; i < u.n; ++i)
  errSol = max(errSol, abs(u[i] - uglob[l2g[i]]));
cout << "[" << mpirank << "] C.4 |u_loc - u_glob[l2g]|_inf = " << errSol << endl;

// Test sous domaine ou domaine global le soucis
real[int] ug(u.n);
for (int i = 0; i < u.n; ++i) ug[i] = uglob[l2g[i]];
cout << "[" << mpirank << "] u_loc:[" << u.min << "," << u.max << "]"
     << "  uglob[l2g]:[" << ug.min << "," << ug.max << "]" << endl;


// ---- C.5 : agrégation et verdict ----
real[int] Au = A * u;
real eRes = 0;
for (int i = 0; i < Au.n; ++i) eRes = max(eRes, abs(Au[i] - uglob[l2g[i]]));
real errResG;
mpiAllReduce(eRes, errResG, mpiCommWorld, mpiMAX);   // eRes est une variable, pas une expression

real errBijG, errSolG;
mpiAllReduce(errBij,        errBijG, mpiCommWorld, mpiMAX);
mpiAllReduce(errSol,        errSolG, mpiCommWorld, mpiMAX);
if (mpirank == 0) {
  cout << "==== VALIDATION ====" << endl;
  cout << " C.1 bijection : " << errBijG << "  (attendu ~1e-12)" << endl;
  cout << " C.2 residu    : " << errResG << "  (attendu ~rtol*|rhs|)" << endl;
  cout << " C.4 vs global : " << errSolG << "  (attendu ~1e-6)" << endl;
  cout << ((errBijG < 1e-8 && errSolG < 1e-4) ? " => PASS" : " => FAIL") << endl;
}