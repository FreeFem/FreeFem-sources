DmeshS DTh = distribute(Th, overlap=ffddmoverlap);
//ffddmbuildDmesh(M,Th,mpiCommWorld);
meshS ThLocal = DTh.local;
fespace Uh(ThLocal,P1);
fespace Uh0(ThLocal, P0);
fespace Uh2(ThLocal, P2);

// Test identité P1
real[int] DP1 = interpolatePoU(DTh, Uh);
real[int] diff = DP1 - DTh.D;
cout << "[" << mpirank << "] P1 diff = " << diff.linfty << " (attendu: 0)" << endl;

// Test projection sur P0
real[int] DP0 = interpolatePoU(DTh, Uh0);
cout << "[" << mpirank << "] P0 : n=" << DP0.n << " (attendu =" << ThLocal.nt << ")" << "min = " << DP0.min << " max = " << DP0.max << endl;

// Plot PoU et interpolation
Uh Dfunc;
Dfunc[] = DTh.D;
plot(Dfunc, fill=1, value=1, cmm="Partition of UNity -rank" + mpirank);


Uh0 DinterpP0;
DinterpP0[] = interpolatePoU(DTh, Uh0);
plot(DinterpP0, fill=1, value=1, cmm="PoU interpolee P0");


// Test P2
Uh2 DinterpP2;
DinterpP2[] = interpolatePoU(DTh, Uh2);
plot(DinterpP2, fill=1, value=1, cmm="PoU interpolee P2 - rank " + mpirank);
cout << "[" << mpirank << "] P2 : n=" << DinterpP2[].n
     << " (== Uh2.ndof=" << Uh2.ndof << ")"
     << " min=" << DinterpP2[].min << " max=" << DinterpP2[].max << endl;

/*
Uh u = mpirank;
plot(u);
*/

varf a(u,v) = int2d(ThLocal)(u*v);
Mat A;
MatCreate(ThLocal, A, P1);
A = a(Uh,Uh);

