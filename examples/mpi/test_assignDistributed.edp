// NBPROC 4
// PARAM -ns

// ---------------------------------------------------------------------
//  Affectation entre fonctions EF distribuees : u = v et Vdh v = u;
//
//  En sequentiel, u = v interpole v sur l'espace de u en evaluant v aux
//  points d'interpolation de u. En distribue ce mecanisme est faux : le
//  point peut tomber hors du maillage LOCAL de v. L'operateur = entre deux
//  fonctions EF distribuees passe donc par le transfert distribue
//  (interpolateD), et Vdh v = u; par le meme chemin.
//
//  L'oracle est interpolateD(Udh, u[], Vdh, ref[]) : l'operateur doit en
//  etre un simple habillage langage. Les cas qui empruntent une copie ou le
//  chemin local ont un oracle plus fort (egalite exacte, ou interpolation
//  sequentielle sur DTh.local).
//
//  CAS VERIFIES
//   A.  Declaration avec init : Vdh v = u;  (P2 sur DTh1 -> P1 sur DTh2).
//   B.  Affectation : w = u, puis reaffectation apres modification de u
//       (la destination est deja allouee).
//   C.  Champ affine, P1 -> P2 : exact, a l'arrondi pres.
//   D.  Meme espace : w2 = u  => COPIE, egalite exacte.
//   E.  Deux fespaces distincts sur le meme Dmesh et le meme EF : copie
//       aussi, egalite exacte.
//   F.  Meme Dmesh, EF different (P2 -> P1) : chemin local, egal a
//       l'interpolation sequentielle sur DTh1.local a 1e-12.
//   G.  u = u : u inchange, exactement.
//   H.  Complexe.
//   I.  Source jamais initialisee : destination nulle, source allouee a
//       zero a la bonne taille.
//   J.  Chainage a = b = u.
//   K.  MeshS.
//   L.  MeshL.
//
//  FORMULES : u = f, Udh u = f, [u1,...] = [f1,...], Vd [u1,...] = [f1,...]
//  La formule est evaluee aux DDL du maillage LOCAL, sans communication.
//  L'oracle est la meme formule affectee a la fonction sequentielle du
//  fespace local DTh.local : meme maillage, meme numerotation, meme calcul.
//   FM1. Udh uf = f;                  scalaire, declaration.
//   FM2. uf = g;                      scalaire, reaffectation.
//   FM3. complexe.
//   FM4. Formule contenant une fonction EF SEQUENTIELLE definie sur le
//        maillage global : chaque rang l'evalue en ses propres DDL.
//   FM5. Wdh [w1,w2,w3] = [f,g,h];    vectoriel [P2,P2,P1], declaration.
//   FM6. [w1,w2,w3] = [...];          vectoriel, reaffectation.
//   FM7. vectoriel complexe.
//   FM8. MeshS (scalaire et vectoriel) et MeshL.
//
//  TRANSFERT VECTORIEL : [b1,...] = [a1,...] et Vd [b1,...] = [a1,...]
//  Oracle : interpolateD(Sd, a1[], Dd, ref) sur le tableau complet des DDL
//  (interpolateD traite deja les N composantes).
//   V1. [b1,b2,b3] = [a1,a2,a3] : [P2,P2,P1] sur DTh1 -> [P1,P1,P1] sur DTh2.
//   V2. Dd [e1,e2,e3] = [a1,a2,a3];  declaration avec init.
//   V3. Champ affine : exact, compare a la formule sur DTh2.local.
//   V4. Meme Dmesh, EF differents ([P2,P2,P1] -> [P1,P2,P1]) : chemin local,
//       egal a l'affectation SEQUENTIELLE sur DTh1.local a 1e-12.
//   V5. Meme fespace : copie, egalite exacte.
//   V6. Complexe.
//   V7. [a1,a2,a3] = [a1,a2,a3] : inchange, exactement.
//   V8. MeshS, [P2,P1] -> [P1,P1].
//
//  EGALITES EXACTES. La note de test_interpolationDMeshes.edp interdit
//  d'asserter une valeur exacte sur un transfert : l'ordre d'arrivee des
//  fragments change l'ordre de sommation. D, E, G et le couple a/b de J sont
//  des COPIES, sans aucune sommation : l'egalite exacte y est la propriete
//  testee, pas une observation. Tout le reste est asserte a 1e-10 (transfert)
//  ou 1e-12 (chemin local, sans communication). Les FM sont asserees a
//  1e-14 : meme calcul DDL par DDL que l'oracle, sans aucune sommation.
//
//  HORS SUITE, verifies a la main (une erreur interrompt l'execution) :
//    * fespace vectoriel : b1 = a1  -> ExecError "only scalar ..." ;
//    * reel <- complexe  : ur = uc  -> erreur de compilation "operator =" ;
//    * formule contenant une fonction distribuee d'un AUTRE Dmesh :
//      Vdh u2 = 2*u;  -> ExecError "evaluated outside its local mesh".
//      Sur le meme Dmesh, c'est permis (voir test_evalDistributed.edp).
//      Ecrire Vdh u2 = u; u2[] *= 2;
//    * composantes desordonnees : [c2,c1] = [x,y]  -> erreur de compilation ;
//    * tailles differentes : [c1,c2] = [x]         -> erreur de compilation ;
//    * transfert, droite desordonnee : [c1,c2] = [a2,a1]
//        -> erreur de compilation "the right side must be all the components" ;
//    * transfert, composante et formule melangees : [c1,c2] = [a1, x]
//        -> affectation par formule : ExecError "evaluated outside its local mesh"
//           quand a vit sur un autre Dmesh ;
//    * composante seule d'une fonction vectorielle : c1 = a1
//        -> ExecError "b1 = a1 on a vector FE function" ;
//    * nombres de composantes differents : [e1,e2] = [a1,a2], e a 3 comp.
//        -> ExecError "incompatible number of components".
//
//  Options :
//    -nc1  raffinement de Th1                 (defaut 10)
//    -nc2  raffinement de Th2, dans Th1       (defaut 7)
//    -ov   recouvrement passe a distribute    (defaut 1)
//
//  Lancer :
//    ff-mpirun -np 4 test_assignDistributed.edp -ns
// ---------------------------------------------------------------------

load "PETSc"
include "getARGV.idp"

int nc1 = getARGV("-nc1", 10);
int nc2 = getARGV("-nc2",  7);   // non commensurable avec nc1 : vraie geometrie
int ov  = getARGV("-ov",   1);

macro FIELD() (sin(3*x)*cos(2*y) + exp(z))// EOM
macro AFFINE() (1 + x + 2*y + 3*z)// EOM

// max global de |a - b| sur deux tableaux reels
macro GDIFF(a, b, g)
real g = 0;
{
  real[int] dd = a - b;
  real ll = dd.linfty;
  mpiAllReduce(ll, g, mpiCommWorld, mpiMAX);
}// EOM

macro VERDICT(tag, e, tol, extra)
if (mpirank == 0)
  cout << "  [" << tag << "]  ecart = " << e << extra
       << "   => " << (e <= tol ? "PASS" : "FAIL") << endl;
assert(e <= tol);
// EOM

// Th2 strictement inclus dans Th1 : tous les DDL destination sont couverts.
mesh3 Th1 = cube(nc1, nc1, nc1);
mesh3 Th2 = cube(nc2, nc2, nc2, [0.25 + 0.5*x, 0.25 + 0.5*y, 0.25 + 0.5*z]);
Dmesh3 DTh1 = distribute(Th1, overlap = ov);
Dmesh3 DTh2 = distribute(Th2, overlap = ov);
mesh3 L1 = DTh1.local, L2 = DTh2.local;

fespace Udh(DTh1, P2);  fespace Ul(L1, P2);
fespace Vdh(DTh2, P1);  fespace Vl(L2, P1);

// Remplissage d'une fonction distribuee : pas encore de u = expression en
// distribue, on passe par le fespace local (meme numerotation de DDL).
Ul ul = FIELD;
Udh u;
u[] = ul[];
assert(u[].n == Udh.ndof);

real[int] ref(Vdh.ndof);
interpolateD(Udh, u[], Vdh, ref);

// --- A : declaration avec init ---------------------------------------------
{
  Vdh v = u;
  assert(v[].n == Vdh.ndof);
  GDIFF(v[], ref, eA)
  VERDICT("A  Vdh v = u          ", eA, 1e-10, "")
}

// --- B : affectation, puis reaffectation -----------------------------------
{
  Vdh w;
  w = u;
  GDIFF(w[], ref, eB1)
  VERDICT("B1 w = u               ", eB1, 1e-10, "")

  // destination deja allouee, source modifiee : le resultat doit suivre
  Udh u2;
  u2[] = 2*u[];
  w = u2;
  real[int] ref2 = 2*ref;
  GDIFF(w[], ref2, eB2)
  VERDICT("B2 w = 2u (realloue)   ", eB2, 1e-10, "")
}

// --- C : champ affine, degre montant ---------------------------------------
{
  fespace Uadh(DTh1, P1);  fespace Ual(L1, P1);
  fespace Vadh(DTh2, P2);  fespace Val(L2, P2);
  Ual ua = AFFINE;
  Uadh a;
  a[] = ua[];
  Vadh b = a;
  Val exact = AFFINE;
  GDIFF(b[], exact[], eC)
  VERDICT("C  affine P1 -> P2     ", eC, 1e-10, "")
}

// --- D : meme espace => copie exacte ---------------------------------------
{
  Udh w2;
  w2 = u;
  GDIFF(w2[], u[], eD)
  VERDICT("D  meme espace         ", eD, 0, "   (copie)")
}

// --- E : deux fespaces, meme Dmesh, meme EF => copie exacte ---------------
{
  fespace Udh2(DTh1, P2);
  Udh2 z = u;
  assert(z[].n == u[].n);
  GDIFF(z[], u[], eE)
  VERDICT("E  deux noms, meme EF  ", eE, 0, "   (copie)")
}

// --- F : meme Dmesh, EF different => chemin local --------------------------
//  Reference : l'affectation SEQUENTIELLE sur le maillage local, qui evalue
//  la fonction P2 aux sommets. Pas interpolate(Pl, Ul), qui appellerait la
//  meme buildInterpolationMatrixT que le raccourci.
{
  fespace Pdh(DTh1, P1);  fespace Pl(L1, P1);
  Pdh p = u;
  Pl pl = ul;
  GDIFF(p[], pl[], eF)
  VERDICT("F  meme Dmesh, P2 -> P1", eF, 1e-12, "")
}

// --- G : u = u -------------------------------------------------------------
{
  real[int] before = u[];
  u = u;
  GDIFF(u[], before, eG)
  VERDICT("G  u = u               ", eG, 0, "")
}

// --- H : complexe ------------------------------------------------------------
{
  Ul<complex> ulc = FIELD + 1i*AFFINE;
  Udh<complex> uc;
  uc[] = ulc[];
  Vdh<complex> vc = uc;
  complex[int] refc(Vdh.ndof);
  interpolateD(Udh, uc[], Vdh, refc);
  real hl = 0;
  for (int i = 0; i < vc[].n; i++) hl = max(hl, abs(vc[][i] - refc[i]));
  real eH = 0;
  mpiAllReduce(hl, eH, mpiCommWorld, mpiMAX);
  VERDICT("H  complexe            ", eH, 1e-10, "")
}

// --- I : source jamais initialisee ------------------------------------------
{
  Udh un;
  Vdh vn = un;
  real zl = vn[].linfty, zg = 0;
  mpiAllReduce(zl, zg, mpiCommWorld, mpiMAX);
  int badSize = (un[].n != Udh.ndof), gBad = 0;
  mpiAllReduce(badSize, gBad, mpiCommWorld, mpiSUM);
  VERDICT("I  source non initialisee", zg, 0, "   tailles fausses = " + gBad)
  assert(gBad == 0);
}

// --- J : chainage --------------------------------------------------------------
{
  Vdh a, b;
  a = b = u;
  GDIFF(b[], ref, eJ1)
  VERDICT("J1 a = b = u : b       ", eJ1, 1e-10, "")
  GDIFF(a[], b[], eJ2)
  VERDICT("J2 a = b = u : a == b  ", eJ2, 0, "   (copie)")
}

// --- K : MeshS -----------------------------------------------------------------
{
  meshS Sa = square3(12, 12), Sb = square3(17, 17);   // meme plan, non commensurables
  DmeshS DSa = distribute(Sa, overlap = ov), DSb = distribute(Sb, overlap = ov);
  meshS La = DSa.local, Lb = DSb.local;
  fespace WsA(DSa, P2); fespace wsA(La, P2);
  fespace WsB(DSb, P1); fespace wsB(Lb, P1);
  wsA ls = FIELD;
  WsA us;
  us[] = ls[];
  WsB vs = us;
  real[int] rs(WsB.ndof);
  interpolateD(WsA, us[], WsB, rs);
  GDIFF(vs[], rs, eK)
  VERDICT("K  MeshS               ", eK, 1e-10, "")
}

// --- L : MeshL -----------------------------------------------------------------
{
  meshL Ca = segment(40), Cb = segment(57);
  DmeshL DCa = distribute(Ca, overlap = ov), DCb = distribute(Cb, overlap = ov);
  meshL La = DCa.local, Lb = DCb.local;
  fespace WlA(DCa, P2); fespace wlA(La, P2);
  fespace WlB(DCb, P1); fespace wlB(Lb, P1);
  wlA ll = FIELD;
  WlA ul1;
  ul1[] = ll[];
  WlB vl1 = ul1;
  real[int] rl(WlB.ndof);
  interpolateD(WlA, ul1[], WlB, rl);
  GDIFF(vl1[], rl, eL)
  VERDICT("L  MeshL               ", eL, 1e-10, "")
}

// =======================================================================
//  FORMULES : evaluation locale, oracle = meme formule sur DTh.local
// =======================================================================

// max global de |a - b| sur deux tableaux complexes
macro GDIFFC(a, b, g)
real g = 0;
{
  real ll = 0;
  for (int i = 0; i < a.n; i++) ll = max(ll, abs(a[i] - b[i]));
  mpiAllReduce(ll, g, mpiCommWorld, mpiMAX);
}// EOM

// --- FM1 / FM2 : scalaire, declaration puis reaffectation ------------------
{
  Udh uf = FIELD;
  Ul ref1 = FIELD;
  GDIFF(uf[], ref1[], eFM1)
  VERDICT("FM1 Udh uf = f          ", eFM1, 1e-14, "")

  uf = AFFINE;
  Ul ref2 = AFFINE;
  GDIFF(uf[], ref2[], eFM2)
  VERDICT("FM2 uf = g              ", eFM2, 1e-14, "")
}

// --- FM3 : complexe -----------------------------------------------------------
{
  Udh<complex> ucf = FIELD + 1i*AFFINE;
  Ul<complex> refc = FIELD + 1i*AFFINE;
  GDIFFC(ucf[], refc[], eFM3)
  VERDICT("FM3 complexe            ", eFM3, 1e-14, "")
}

// --- FM4 : fonction EF sequentielle sur le maillage global dans la formule -----
//  Th1 est construit a l'identique sur tous les rangs. Les noeuds P2 du
//  maillage local sont des noeuds P2 de Th1 : ug y vaut exactement FIELD a
//  l'arrondi pres, d'ou un seuil 1e-12 et non 1e-14 (Find + evaluation).
{
  fespace Ug(Th1, P2);
  Ug ug = FIELD;
  Udh ufg = ug;
  Ul ref4 = FIELD;
  GDIFF(ufg[], ref4[], eFM4)
  VERDICT("FM4 Udh u = ug (global) ", eFM4, 1e-12, "")
}

// --- FM5 / FM6 : vectoriel [P2,P2,P1] -----------------------------------------
{
  fespace Wdh(DTh1, [P2, P2, P1]);  fespace Wl(L1, [P2, P2, P1]);
  Wdh [w1, w2, w3] = [FIELD, AFFINE, x*y];
  Wl [r1, r2, r3] = [FIELD, AFFINE, x*y];
  assert(w1[].n == Wdh.ndof);
  GDIFF(w1[], r1[], eFM5)
  VERDICT("FM5 Wdh [w..] = [f,g,h] ", eFM5, 1e-14, "")

  [w1, w2, w3] = [z, sin(x), AFFINE];
  [r1, r2, r3] = [z, sin(x), AFFINE];
  GDIFF(w1[], r1[], eFM6)
  VERDICT("FM6 [w..] = [...]       ", eFM6, 1e-14, "")
}

// --- FM7 : vectoriel complexe ----------------------------------------------------
{
  fespace Wdh(DTh1, [P2, P1]);  fespace Wl(L1, [P2, P1]);
  Wdh<complex> [c1, c2] = [FIELD + 1i*x, 1i*AFFINE];
  Wl<complex> [s1, s2] = [FIELD + 1i*x, 1i*AFFINE];
  GDIFFC(c1[], s1[], eFM7a)
  VERDICT("FM7 vect. complexe decl ", eFM7a, 1e-14, "")
  [c1, c2] = [y - 1i*z, FIELD];
  [s1, s2] = [y - 1i*z, FIELD];
  GDIFFC(c1[], s1[], eFM7b)
  VERDICT("FM7 vect. complexe aff  ", eFM7b, 1e-14, "")
}

// --- FM8 : MeshS et MeshL ----------------------------------------------------------
{
  meshS Sf = square3(12, 12);
  DmeshS DSf = distribute(Sf, overlap = ov);
  meshS LSf = DSf.local;
  fespace Sdh(DSf, P2);           fespace Sl(LSf, P2);
  Sdh sf = FIELD;
  Sl sref = FIELD;
  GDIFF(sf[], sref[], eFM8a)
  VERDICT("FM8 MeshS scalaire      ", eFM8a, 1e-14, "")

  fespace SVdh(DSf, [P2, P1]);    fespace SVl(LSf, [P2, P1]);
  SVdh [t1, t2] = [FIELD, AFFINE];
  SVl [q1, q2] = [FIELD, AFFINE];
  GDIFF(t1[], q1[], eFM8b)
  VERDICT("FM8 MeshS vectoriel     ", eFM8b, 1e-14, "")

  meshL Cf = segment(40);
  DmeshL DCf = distribute(Cf, overlap = ov);
  meshL LCf = DCf.local;
  fespace Cdh(DCf, P2);           fespace Cl(LCf, P2);
  Cdh cf = FIELD;
  Cl cref = FIELD;
  GDIFF(cf[], cref[], eFM8c)
  VERDICT("FM8 MeshL scalaire      ", eFM8c, 1e-14, "")
}

// =======================================================================
//  TRANSFERT VECTORIEL : [b1,...] = [a1,...]
// =======================================================================

fespace Sd(DTh1, [P2, P2, P1]);  fespace Sl(L1, [P2, P2, P1]);
fespace Dd(DTh2, [P1, P1, P1]);  fespace Dl(L2, [P1, P1, P1]);
Sd [a1, a2, a3] = [FIELD, AFFINE, x*y + z];
real[int] refV(Dd.ndof);
interpolateD(Sd, a1[], Dd, refV);

// --- V1 : affectation --------------------------------------------------------
{
  Dd [b1, b2, b3];
  [b1, b2, b3] = [a1, a2, a3];
  GDIFF(b1[], refV, eV1)
  VERDICT("V1 [b..] = [a..]        ", eV1, 1e-10, "")
}

// --- V2 : declaration avec init -------------------------------------------------
{
  Dd [e1, e2, e3] = [a1, a2, a3];
  GDIFF(e1[], refV, eV2)
  VERDICT("V2 Dd [e..] = [a..]     ", eV2, 1e-10, "")
}

// --- V3 : champ affine, exact ----------------------------------------------------
{
  Sd [p1, p2, p3] = [AFFINE, 2*AFFINE - z, x - y];
  Dd [q1, q2, q3];
  [q1, q2, q3] = [p1, p2, p3];
  Dl [r1, r2, r3] = [AFFINE, 2*AFFINE - z, x - y];
  GDIFF(q1[], r1[], eV3)
  VERDICT("V3 affine vectoriel     ", eV3, 1e-10, "")
}

// --- V4 : meme Dmesh, EF differents => chemin local ---------------------------------
//  Reference : affectation SEQUENTIELLE sur DTh1.local, a partir de la meme
//  fonction posee sur le fespace local (meme numerotation).
{
  fespace Td(DTh1, [P1, P2, P1]);  fespace Tl(L1, [P1, P2, P1]);
  Sl [al1, al2, al3] = [FIELD, AFFINE, x*y + z];
  Td [t1, t2, t3];
  [t1, t2, t3] = [a1, a2, a3];
  Tl [s1, s2, s3] = [al1, al2, al3];
  GDIFF(t1[], s1[], eV4)
  VERDICT("V4 meme Dmesh, EF diff. ", eV4, 1e-12, "")
}

// --- V5 : meme fespace => copie exacte ------------------------------------------------
{
  Sd [f1, f2, f3];
  [f1, f2, f3] = [a1, a2, a3];
  GDIFF(f1[], a1[], eV5)
  VERDICT("V5 meme fespace         ", eV5, 0, "   (copie)")
}

// --- V6 : complexe ---------------------------------------------------------------------
{
  Sd<complex> [ca1, ca2, ca3] = [FIELD + 1i*x, 1i*AFFINE, y - 1i*z];
  Dd<complex> [cb1, cb2, cb3];
  [cb1, cb2, cb3] = [ca1, ca2, ca3];
  complex[int] refVc(Dd.ndof);
  interpolateD(Sd, ca1[], Dd, refVc);
  GDIFFC(cb1[], refVc, eV6)
  VERDICT("V6 complexe             ", eV6, 1e-10, "")
}

// --- V7 : [a..] = [a..] -------------------------------------------------------------------
{
  real[int] before = a1[];
  [a1, a2, a3] = [a1, a2, a3];
  GDIFF(a1[], before, eV7)
  VERDICT("V7 [a..] = [a..]        ", eV7, 0, "")
}

// --- V8 : MeshS -------------------------------------------------------------------------------
{
  meshS Sa = square3(12, 12), Sb = square3(17, 17);   // meme plan, non commensurables
  DmeshS DSa = distribute(Sa, overlap = ov), DSb = distribute(Sb, overlap = ov);
  fespace VsA(DSa, [P2, P1]);
  fespace VsB(DSb, [P1, P1]);
  VsA [m1, m2] = [FIELD, AFFINE];
  VsB [n1, n2];
  [n1, n2] = [m1, m2];
  real[int] rs(VsB.ndof);
  interpolateD(VsA, m1[], VsB, rs);
  GDIFF(n1[], rs, eV8)
  VERDICT("V8 MeshS vectoriel      ", eV8, 1e-10, "")
}

mpiBarrier(mpiCommWorld);
if (mpirank == 0)
  cout << "== affectation distribuee : toutes les assertions passent ==" << endl;
