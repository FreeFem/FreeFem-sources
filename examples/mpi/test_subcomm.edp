// NBPROC 4
// PARAM -ns

// =====================================================================
//  Maillages distribues sur un SOUS-COMMUNICATEUR : distribute(..., comm=c)
//
//  Un rang a deux identites : son rang dans mpiCommWorld (mpirank) et son
//  rang dans c (mpiRank(c)). Les numeros de partition (coverPartition,
//  neighborRanks, Udh.intersection[0], rangs des plans de transfert) sont
//  des rangs DANS c. Chaque bloc ci-dessous fabrique un communicateur ou ces
//  deux identites different, et verifie que rien ne les confond.
//
//  COMMUNICATEURS (-np 4)
//   W  mpiCommWorld : temoin, doit passer avant tout changement du code.
//   P  monde PERMUTE : mpiComm cP(mpiCommWorld, 0, mpisize-1-mpirank).
//      Meme taille que le monde, donc tout le code accepte d'y entrer,
//      mais mpiRank(cP) = mpisize-1-mpirank : chaque mpirank oublie donne
//      un resultat faux. C'est le detecteur principal.
//   H  deux MOITIES : couleur mpirank < mpisize/2. Deux distribute
//      independants tournent EN MEME TEMPS, un par moitie. Les rangs monde
//      2 et 3 deviennent 0 et 1 : un mpirank oublie sort de [0, taille[.
//   X  monde SANS le rang 0 : le rang 0 de cX est le rang monde 1. Le
//      rang monde 0 recoit MPI_COMM_NULL et ne participe pas. En mode
//      scatter, la racine est donc le rang monde 1.
//      E1 : erreur collective sur cX (partition hors de [0, mpiSize(cX)[),
//      refusee sur tous les rangs de cX et affichee par le rang monde 1.
//      E2..E4 : erreurs de detection du mode (maillage hors du rang 0 de cX,
//      aucun maillage -- erreur typique if (mpirank == 0) --, mode mixte).
//      E5, E5b, E6 : erreurs deterministes ([e1,e2] = [a1,a2] avec e a 3
//      composantes, b1 = a1 sur une fonction vectorielle, Udh.loc2glob en
//      scatter), refusees sur tous les rangs de cX, affichees par le rang
//      monde 1.
//      A1 : avertissement "automatic exchange of a Complex distributed rhs"
//      (second membre complexe, plugin PETSc reel), affiche une fois par le
//      rang monde 1.
//   U  tailles INEGALES : le rang monde 0 SEUL (taille 1), les autres
//      ensemble (taille mpisize-1). Un communicateur de taille 1 prend les
//      chemins "sequentiels" (partition triviale, XFER_SINGLE_RANK...) alors
//      que mpisize > 1 : tout collectif reste sur mpiCommWorld y bloque,
//      puisque les autres rangs ne l'appellent pas.
//
//  MAILLAGES ET PARTITIONNEURS
//   Cas 1 a 8 : mesh3 (cube). Partitions : utilisateur (tranches en x),
//   metis, scotch (-sc 1, defaut), parmetis (-pm 1).
//   Cas 9 : meshS (square3) et cas 10 : meshL (segment), sur W, P, H, X, U,
//   avec la macro SUITEG (memes controles que SUITE, adaptes au type).
//
//  SUITE (macro SUITE, pour un communicateur, un partitionneur, et le mode
//  replique ou scatter). Toutes les reductions se font sur c.
//   S0  distribute(..., comm=c) est accepte.
//   S1  partition utilisateur en tranches de x, valeurs dans [0, mpiSize(c)[ :
//       la tranche mpiRank(c) est ENTIERE dans DTh.local. Detecte tout
//       "coverPartition[k] == mpirank" (msh3.cpp, distribute).
//   S2  int3d(DTh)(1) = 1 et int3d(DTh)(f) = int3d(Th)(f) : la reduction
//       se fait sur c (sur le monde, les moities compteraient deux fois).
//   S3  Udh.ndofglobal = ndof sequentiel (P2).
//   S4  Udh.checkPoU dans [0, 1e-8].
//   S5  voisins : Udh.intersection[0][j] dans [0, mpiSize(c)[, different
//       de mpiRank(c) ; puis appariement des listes d'intersection par
//       echange des coordonnees des ddl SUR c (cf. V7 de
//       test_distribute_multi.edp). Detecte buildInterfaceSubmesh /
//       buildInterfaceDofList (overlap = 0) et la detection des voisins.
//   S6  (replique) recomposition d'un champ global par la partition de
//       l'unite : sum_r loc2glob(D .* u_r) = u.
//   S7  (replique) Udh.numbering : coherent entre rangs et bijection sur
//       [0, ndofglobal[.
//   S8  Mat A = vP(Udh, Udh) (chemin "shell", SANS communicator=) puis
//       A^-1 : compare a la resolution sequentielle. Detecte une Mat PETSc
//       construite sur PETSC_COMM_WORLD au lieu de DTh.comm
//       (buildShellIfNeeded).
//   S8b Mat A(Udh) (constructeur depuis le fespace : intersection, D et
//       communicateur lus dans Udh), puis A = vP(Udh, Udh) et A^-1 : memes
//       controles que S8.
//   S8c Mat A(Udh) laisse Udh.D intact, bit a bit (HPDDM::restriction()
//       ecrase en place le tableau qu'on lui cede).
//   S9  transfert Vdh w = a entre deux Dmesh du MEME c (P1 affine -> P2,
//       exact) : nproc et rang dans buildTransferPlan / collectFragments.
//   S*  aucune exception pendant S1..S9.
//
//  COMPARAISON DE COMMUNICATEURS (bloc C, sur le monde)
//   C1  Dmesh sans comm= (defaut) <-> Dmesh avec comm=mpiCommWorld :
//       meme communicateur, le transfert doit marcher.
//   C2  monde <-> copie CONGRUENTE (mpiComm cc(mpiCommWorld, 0, mpirank)) :
//       memes rangs dans le meme ordre, le transfert doit marcher.
//   C3  deux Dmesh distribues avec la MEME variable cc : doit marcher (et
//       continuer de marcher si DistributedMesh duplique son communicateur).
//   C4  monde <-> moities : groupes differents, transfert REFUSE sur tous
//       les rangs, sans blocage.
//   C5  monde <-> monde permute : meme groupe, ordre different
//       (MPI_SIMILAR), transfert REFUSE sur tous les rangs.
//   C7  Mat A(Udh, communicator = c) : accepte si c est congruent au
//       communicateur du Dmesh (copie cc), refuse sur tous les rangs sinon
//       (Dmesh sur le monde permute).
//   C6  Mat construite a la main (Mat A(n, intersection, D, communicator =
//       mpiCommWorld)) puis A = vP(Udh, Udh), Dmesh sur cc : acceptee (comm
//       congruent), meme solution que Mat A(Udh). Pas de faux positif.
//   C8  Mat A(UdhH) d'une moitie, assemblee avec un fespace du monde : refus.
//   C8b Mat A(Udh P1) assemblee avec un fespace P2 du meme Dmesh : refus.
//   La verification d'une Mat deja construite a lieu a l'assemblage : une
//   Mat construite sur le MAUVAIS communicateur peut bloquer avant (non teste).
//
//  DUREE DE VIE (bloc L)
//   L1  le mpiComm passe a distribute est declare dans un bloc et libere a
//       la fin du bloc (MPI_Comm_free) ; le Dmesh, declare dehors, doit
//       rester utilisable : fespace (collectif), ndofglobal, int3d.
//
//  RANG HORS DU COMMUNICATEUR (bloc O)
//   O1  tous les rangs appellent distribute(Th, comm=cX) ; le rang monde 0,
//       pour qui cX = MPI_COMM_NULL, doit recevoir une erreur propre
//       (ExecError attrapable), les autres doivent reussir.
//   O2  meme chose avec le DERNIER rang du monde exclu (jamais le rang 0) :
//       refus local (localError), message affiche par ce rang lui-meme.
//
//  ERREURS DEPENDANT DU RANG (cas 11, R, sur cX)
//   L'incoherence n'existe que sur le rang 1 de cX (rang monde 2). Sans
//   decision collective, ce rang leve l'erreur seul pendant que les autres
//   entrent dans le transfert et l'attendent : BLOCAGE. Attendu : refus sur
//   tous les rangs de cX, message affiche une fois par le rang monde 1.
//   Deux Dmesh du meme maillage sur cX, partitions en tranches decalees d'un
//   rang : les maillages locaux ne se recouvrent pas, le transfert prend le
//   chemin general (avec echanges), verifie par un temoin.
//   E7  w = u, u[] agrandi d'un element sur un rang ("outdated source").
//   E8  interpolateD(plan, x, y), x agrandi sur un rang ("outdated plan").
//   E9  interpolateMat(plan, num, M, col), num agrandi sur un rang.
//   Exige mpisize >= 3 (cX de taille >= 2). A lancer SOUS TIMEOUT, un
//   controle a la fois (-e 7, -e 8, -e 9) : avant la correction, chacun bloque.
//
//  BLOCS QUI PEUVENT INTERROMPRE L'EXECUTION. Une confusion de rangs se
//  manifeste souvent par un BLOCAGE (envoi vers un rang qui n'attend rien)
//  ou une erreur MPI fatale (communicateur libere ou nul), pas par un FAIL.
//  Une exception levee sur une partie des rangs seulement desynchronise les
//  collectifs : la suite peut alors afficher des ecarts absurdes, puis
//  bloquer au bloc suivant. Seul le premier FAIL d'un bloc est fiable.
//  Lancer sous timeout, et bloc par bloc pendant la mise au point :
//    timeout 600 ff-mpirun -np 4 test_subcomm.edp -ns -v 0
//    timeout 300 ff-mpirun -np 4 test_subcomm.edp -ns -v 0 -case 2
//  L1 et O1 sont les plus susceptibles d'arreter tout le job : ils sont
//  places en dernier, et isoles dans les cas 6 et 7.
//
//  ETAT AVANT LES SOUS-COMMUNICATEURS (commit 8ede36dbc, -np 4)
//   1 W  41/41 PASS.
//   2 P  S0 PASS (le controle de TAILLE accepte un monde permute), S1 FAIL,
//        PoU fausse (max|sum-1| = 2), exception, puis blocage.
//   3 H  S0 FAIL : refus "sub-communicator not yet supported".
//   4 X  S0 FAIL : meme refus.
//   5 C  C3 PASS ; C1 s'arrete sur ffassert(pSrc->DTh->comm ==
//        pDst->DTh->comm), non attrapable (MPI_Abort).
//   6 L  "ddl intersection asymmetric", puis MPI_Abort.
//   7 O  FAIL : tous les rangs refusent, au lieu du seul rang hors de cX.
//
//  ETAT APRES LES ETAPES 0 A 7 (sous-communicateurs acceptes)
//   Tout le fichier passe, sans -stop ni -skip : -np 4 et -np 3, -ov 1 et
//   -ov 0 (173/173 sur le rang 0). Le cas 8 U a revele en cours de route un
//   Allreduce reste sur mpiCommWorld dans le chemin XFER_SINGLE_RANK de
//   buildTransferPlan (reportCoverage(..., nullptr, ...)).
//
//  OPTIONS
//    -case  0 = tout (defaut), 1 = W, 2 = P, 3 = H, 4 = X,
//           5 = C, 6 = L, 7 = O, 8 = U, 9 = meshS, 10 = meshL,
//           11 = R (erreurs dependant du rang, E7..E9)
//    -nc    raffinement du cube                          (defaut 10)
//    -nc2   raffinement du cube inclus (transfert)       (defaut 7)
//    -ov    recouvrement passe a distribute              (defaut 1)
//    -pm    1 = ajoute partmethod = "parmetis" aux cas W, P, H
//           (FreeFEM configure avec ParMETIS)            (defaut 0)
//    -stop  k = n'execute que S0..Sk de chaque suite     (defaut 9)
//           -stop 7 saute S8 (PETSc) et S9 (transfert) : utile pour
//           isoler une regression de distribute ou du fespace.
//    -sc    1 = ajoute partmethod = "scotch" (cas mesh3) et l'utilise
//           comme second partitionneur des cas 9 et 10 ;
//           0 = metis a la place (build sans Scotch)       (defaut 1)
//    -nsq, -nsq2    raffinements des deux square3 (cas 9)  (defaut 16, 11)
//    -nseg, -nseg2  raffinements des deux segments (cas 10) (defaut 80, 57)
//    -e     cas 11 : 0 = E7, E8 et E9 ; 7, 8 ou 9 = un seul (defaut 0)
//    -skip  k = saute Sk (k = 8 ou 9) dans chaque suite   (defaut aucun)
//           -skip 8 teste le transfert (S9) sans PETSc (S8).
//
//  Exige mpisize >= 2 (le cas X et le bloc O excluent le rang monde 0).
// =====================================================================

load "PETSc"
include "getARGV.idp"

int cas = getARGV("-case", 0);
int nc  = getARGV("-nc", 10);
int nc2 = getARGV("-nc2", 7);
int ov  = getARGV("-ov", 1);
int pm  = getARGV("-pm", 0);
int stopAt = getARGV("-stop", 9);
int skipS  = getARGV("-skip", -1);
int eSel   = getARGV("-e", 0);      // cas 11 : 0 = E7, E8 et E9 ; 7, 8 ou 9 = un seul
int sc    = getARGV("-sc", 1);
int nsq   = getARGV("-nsq", 16);
int nsq2  = getARGV("-nsq2", 11);
int nseg  = getARGV("-nseg", 80);
int nseg2 = getARGV("-nseg2", 57);
string methB = "metis";          // second partitionneur des cas 9 et 10
if (sc) methB = "scotch";

assert(mpisize >= 2);

int npass = 0, ntot = 0;
// GMRES et non CG : l ASM par defaut de PETSc (restricted) n est pas symetrique,
// CG peut diverger (DIVERGED_ITS sur meshL a 2 sous-domaines).
string kspp = "-ksp_type gmres -pc_type asm -ksp_rtol 1e-12 -ksp_max_it 1000";

macro FIELD() (sin(3*x)*cos(2*y) + exp(z))// EOM
macro AFFINE() (1 + x + 2*y + 3*z)// EOM
macro grad(w) [dx(w), dy(w), dz(w)]// EOM

// tranche en x de l'element k du maillage T, parmi n tranches
macro SLICE(T, k, n) min(int(n*(T[k][0].x + T[k][1].x + T[k][2].x + T[k][3].x)/4.), n - 1)// EOM

// verdict : max sur COMM de E, compare a TOL ; affiche par le rang 0 de COMM
macro CHK(COMM, TG, LBL, E, TOL) {
  real chkL = E, chkG = 0;
  mpiAllReduce(chkL, chkG, COMM, mpiMAX);
  bool chkOk = (chkG <= TOL);
  ntot++; if (chkOk) npass++;
  if (mpiRank(COMM) == 0)
    cout << "  [" << TG << "] " << LBL << " : ecart = " << chkG
         << "   => " << (chkOk ? "PASS" : "FAIL") << endl;
}// EOM

// le refus doit avoir ete leve sur TOUS les rangs du monde
macro REFUSED(LBL, R) {
  int refL = R, refG = 0;
  mpiAllReduce(refL, refG, mpiCommWorld, mpiMIN);
  real refE = 1 - refG;
  CHK(mpiCommWorld, "C", LBL, refE, 0)
}// EOM

// ---------------------------------------------------------------------
//  SUITE : S0..S9 sur le communicateur COMM
//    CTAG  nom du communicateur pour l'affichage
//    SCAT  true = mode scatter (maillage global sur le rang 0 de COMM seul)
//    METH  "user" (tranches en x) | "metis" | "scotch" | "parmetis"
// ---------------------------------------------------------------------
macro SUITE(COMM, CTAG, SCAT, METH) {
  if (COMM) {
    int cr = mpiRank(COMM), cs = mpiSize(COMM);
    bool scat = SCAT;
    bool kg = !scat;
    string meth = METH;
    string tg = CTAG + "/" + meth;
    if (scat) tg = tg + "/scatter";
    if (cr == 0)
      cout << "--- " << tg << " : taille " << cs
           << ", rang 0 = rang monde " << mpirank << endl;

    /* Th : reference sequentielle, presente partout.
       ThW : maillage passe a distribute (rang 0 de COMM seul en scatter). */
    mesh3 Th = cube(nc, nc, nc);
    mesh3 ThW;
    if (!scat || cr == 0) ThW = cube(nc, nc, nc);
    int[int] part(ThW.nt);
    for (int k = 0; k < ThW.nt; ++k) part[k] = SLICE(ThW, k, cs);

    Dmesh3 DTh;
    int dok = 1;
    try {
      if (meth == "user")
        DTh = distribute(ThW, overlap = ov, comm = COMM, partition = part, keepGlobal = kg);
      else
        DTh = distribute(ThW, overlap = ov, comm = COMM, partmethod = meth, keepGlobal = kg);
    } catch (...) { dok = 0; }
    real e0 = 1 - dok;
    CHK(COMM, tg, "S0 distribute accepte          ", e0, 0)

    if (dok) {
      int crashed = 0;
      try {
        mesh3 L = DTh.local;

        /* S1 : la tranche propre (au sens de mpiRank(COMM)) est entiere
           dans le maillage local */
        if (meth == "user") {
          real vOwn = 0, vRef = 0;
          for (int k = 0; k < L.nt; ++k) if (SLICE(L, k, cs) == cr) vOwn += L[k].measure;
          for (int k = 0; k < Th.nt; ++k) if (SLICE(Th, k, cs) == cr) vRef += Th[k].measure;
          real e1 = abs(vOwn - vRef)/max(vRef, 1e-300);
          CHK(COMM, tg, "S1 tranche propre dans local   ", e1, 1e-10)
        }

        /* S2 : integrales, reduction sur COMM */
        {
          real v1 = int3d(DTh)(1.);
          real e2a = abs(v1 - 1.);
          CHK(COMM, tg, "S2 int3d(DTh)(1) = 1           ", e2a, 1e-10)
          real Id = int3d(DTh)(FIELD), Is = int3d(Th)(FIELD);
          real e2b = abs(Id - Is)/abs(Is);
          CHK(COMM, tg, "S2 int3d(DTh)(f) = int3d(Th)(f)", e2b, 1e-10)
        }

        fespace Udh(DTh, P2);
        fespace UhG(Th, P2);
        fespace Ul(L, P2);

        /* S3, S4 */
        real e3 = abs(Udh.ndofglobal - UhG.ndof);
        CHK(COMM, tg, "S3 ndofglobal = ndof sequentiel", e3, 0)
        real v4 = Udh.checkPoU;
        real e4 = v4;
        if (v4 < 0) e4 = 1e30;
        CHK(COMM, tg, "S4 checkPoU                    ", e4, 1e-8)

        /* S5 : voisins dans [0, cs[, puis appariement des intersections */
        {
          int nN = Udh.intersection[0].n;
          int nbad = 0;
          for (int j = 0; j < nN; ++j) {
            int nb = Udh.intersection[0][j];
            if (nb < 0 || nb >= cs || nb == cr) nbad++;
          }
          int nbadG = 0;
          mpiAllReduce(nbad, nbadG, COMM, mpiMAX);
          real e5a = nbadG;
          CHK(COMM, tg, "S5 voisins = rangs de comm     ", e5a, 0)

          real e5b = 1e30;
          if (nbadG == 0) {
            Ul pvx = x, pvy = y, pvz = z;
            real[int][int] pvMine(nN), pvHis(nN);
            mpiRequest[int] pvRq(2*nN);
            for (int j = 0; j < nN; ++j) {
              int[int] pvL = Udh.intersection[1 + j];
              int pvM = pvL.n;
              pvMine[j].resize(3*pvM); pvHis[j].resize(3*pvM);
              for (int p = 0; p < pvM; ++p) {
                pvMine[j][3*p]     = pvx[][pvL[p]];
                pvMine[j][3*p + 1] = pvy[][pvL[p]];
                pvMine[j][3*p + 2] = pvz[][pvL[p]];
              }
              Irecv(processor(Udh.intersection[0][j], COMM, pvRq[j]),      pvHis[j]);
              Isend(processor(Udh.intersection[0][j], COMM, pvRq[nN + j]), pvMine[j]);
            }
            for (int q = 0; q < 2*nN; ++q) { int pw = mpiWaitAny(pvRq); }
            e5b = 0;
            for (int j = 0; j < nN; ++j)
              for (int p = 0; p < pvMine[j].n; ++p)
                e5b = max(e5b, abs(pvMine[j][p] - pvHis[j][p]));
          }
          CHK(COMM, tg, "S5 appariement intersections   ", e5b, 1e-12)
        }

        /* S6, S7 : exigent loc2glob, donc le mode replique */
        if (!scat) {
          real[int] D = Udh.D;
          int[int] l2g = Udh.loc2glob;
          UhG gg = FIELD;
          real[int] acc(UhG.ndof); acc = 0;
          for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D[i]*gg[][l2g[i]];
          real[int] accG(UhG.ndof);
          mpiAllReduce(acc, accG, COMM, mpiSUM);
          accG -= gg[];
          real e6 = accG.linfty;
          CHK(COMM, tg, "S6 recomposition par la PoU    ", e6, 1e-10)

          int[int] gnum = Udh.numbering;
          real[int] gmx(UhG.ndof), gmn(UhG.ndof);
          gmx = -1; gmn = 1e30;
          for (int i = 0; i < Udh.ndof; ++i) { gmx[l2g[i]] = gnum[i]; gmn[l2g[i]] = gnum[i]; }
          real[int] gmxG(UhG.ndof), gmnG(UhG.ndof);
          mpiAllReduce(gmx, gmxG, COMM, mpiMAX);
          mpiAllReduce(gmn, gmnG, COMM, mpiMIN);
          real[int] dg = gmxG - gmnG;
          real e7a = dg.linfty;
          CHK(COMM, tg, "S7 numbering coherent          ", e7a, 0)
          gmxG.sort;
          real e7b = 0;
          for (int i = 0; i < gmxG.n; ++i) e7b = max(e7b, abs(gmxG[i] - i));
          CHK(COMM, tg, "S7 numbering bijectif          ", e7b, 0)
        }

        /* S8 : Mat PETSc sans communicator=, puis resolution */
        if (stopAt >= 8 && skipS != 8) {
          fespace U1dh(DTh, P1);
          fespace U1h(Th, P1);
          varf vPb(a, b) = int3d(DTh)(grad(a)'*grad(b)) + int3d(DTh)(1.*b)
                         + on(1, 2, 3, 4, 5, 6, a = 0);
          Mat A = vPb(U1dh, U1dh);
          set(A, sparams = kspp);
          real[int] rb = vPb(0, U1dh);
          U1dh uh;
          uh[] = A^-1 * rb;
          varf vS(a, b) = int3d(Th)(grad(a)'*grad(b)) + int3d(Th)(1.*b)
                        + on(1, 2, 3, 4, 5, 6, a = 0);
          matrix As = vS(U1h, U1h, solver = UMFPACK);
          real[int] bs = vS(0, U1h);
          U1h us;
          us[] = As^-1 * bs;
          real e8 = sqrt(int3d(DTh)(square(uh - us))) / sqrt(int3d(Th)(square(us)));
          CHK(COMM, tg, "S8 Mat + A^-1 = sequentiel     ", e8, 1e-7)

          /* S8c : Mat A(Udh) ne modifie pas Udh.D (restriction() ecrase son argument) */
          real[int] D0 = U1dh.D;
          Mat Ab(U1dh);
          real[int] D1 = U1dh.D;
          D1 -= D0;
          real e8c = D1.linfty;
          CHK(COMM, tg, "S8c Mat A(Udh) : Udh.D intact  ", e8c, 0)
          /* S8b : Mat A(Udh) puis A = vP(Udh, Udh) : meme resultat que S8 */
          Ab = vPb(U1dh, U1dh);
          set(Ab, sparams = kspp);
          U1dh ub;
          ub[] = Ab^-1 * rb;
          real e8m = sqrt(int3d(DTh)(square(ub - us))) / sqrt(int3d(Th)(square(us)));
          CHK(COMM, tg, "S8b Mat A(Udh) + A^-1          ", e8m, 1e-7)
        }

        /* S9 : transfert entre deux Dmesh du meme COMM */
        if (stopAt >= 9 && skipS != 9) {
          mesh3 Th2 = cube(nc2, nc2, nc2, [0.25 + 0.5*x, 0.25 + 0.5*y, 0.25 + 0.5*z]);
          Dmesh3 DTh2 = distribute(Th2, overlap = ov, comm = COMM);
          mesh3 L2 = DTh2.local;
          fespace A1dh(DTh, P1);
          fespace B2dh(DTh2, P2);
          fespace B2l(L2, P2);
          A1dh a = AFFINE;
          B2dh w = a;
          B2l wl = AFFINE;
          real[int] d9 = w[] - wl[];
          real e9a = d9.linfty;
          CHK(COMM, tg, "S9 Vdh w = a (declaration)     ", e9a, 1e-10)
          a = 2*AFFINE;
          w = a;
          d9 = w[] - 2*wl[];
          real e9b = d9.linfty;
          CHK(COMM, tg, "S9 w = a (reaffectation)       ", e9b, 1e-10)
        }
      } catch (...) { crashed = 1; }
      real eX = crashed;
      CHK(COMM, tg, "S* aucune exception            ", eX, 0)
    }
  }
}// EOM

// ---------------------------------------------------------------------
//  SUITEG : S0..S9 pour meshS et meshL (meme logique que SUITE).
//    MT, DMT  type du maillage et du maillage distribue (meshS, DmeshS...)
//    INTG     integrale du type (int2d, int1d)
//    NV       nombre de sommets par element (3, 2)
//    THG      maillage global de reference, construit sur tous les rangs
//             de COMM ; THG2 meme domaine, autre resolution (transfert S9)
//    BLAB     int[int] des labels du bord (Dirichlet de S8)
//  Differences avec SUITE : S1 compte les elements de la tranche propre
//  (pas d'accesseur .measure sur les elements meshS / meshL) ; S8 compare
//  l'integrale de la solution, et en mode replique la solution elle-meme
//  via loc2glob ; S9 transfere entre deux resolutions du meme domaine.
// ---------------------------------------------------------------------
macro SUITEG(COMM, CTAG, SCAT, METH, MT, DMT, INTG, NV, THG, THG2, BLAB) {
  if (COMM) {
    int cr = mpiRank(COMM), cs = mpiSize(COMM);
    bool scat = SCAT;
    bool kg = !scat;
    string meth = METH;
    string tg = CTAG + "/" + meth;
    if (scat) tg = tg + "/scatter";
    if (cr == 0)
      cout << "--- " << tg << " : taille " << cs
           << ", rang 0 = rang monde " << mpirank << endl;

    MT ThW;
    if (!scat || cr == 0) ThW = THG;
    int[int] part(ThW.nt);
    for (int k = 0; k < ThW.nt; ++k) {
      real xb = 0;
      for (int i = 0; i < NV; ++i) xb += ThW[k][i].x;
      part[k] = min(int(cs*xb/NV), cs - 1);
    }

    DMT DTh;
    int dok = 1;
    try {
      if (meth == "user")
        DTh = distribute(ThW, overlap = ov, comm = COMM, partition = part, keepGlobal = kg);
      else
        DTh = distribute(ThW, overlap = ov, comm = COMM, partmethod = meth, keepGlobal = kg);
    } catch (...) { dok = 0; }
    real e0 = 1 - dok;
    CHK(COMM, tg, "S0 distribute accepte          ", e0, 0)

    if (dok) {
      int crashed = 0;
      try {
        MT L = DTh.local;

        /* S1 : tous les elements de la tranche mpiRank(COMM) sont dans local */
        if (meth == "user") {
          int nOwn = 0, nRef = 0;
          for (int k = 0; k < L.nt; ++k) {
            real xb = 0;
            for (int i = 0; i < NV; ++i) xb += L[k][i].x;
            if (min(int(cs*xb/NV), cs - 1) == cr) nOwn++;
          }
          for (int k = 0; k < THG.nt; ++k) {
            real xb = 0;
            for (int i = 0; i < NV; ++i) xb += THG[k][i].x;
            if (min(int(cs*xb/NV), cs - 1) == cr) nRef++;
          }
          real e1 = abs(nOwn - nRef);
          if (nRef == 0) e1 = 1e30;
          CHK(COMM, tg, "S1 tranche propre dans local   ", e1, 0)
        }

        /* S2 : integrales, reduction sur COMM */
        {
          real v1 = INTG(DTh)(1.), w1 = INTG(THG)(1.);
          real e2a = abs(v1 - w1)/w1;
          CHK(COMM, tg, "S2 mesure(DTh) = mesure(Th)    ", e2a, 1e-10)
          real Id = INTG(DTh)(FIELD), Is = INTG(THG)(FIELD);
          real e2b = abs(Id - Is)/abs(Is);
          CHK(COMM, tg, "S2 integrale de f              ", e2b, 1e-10)
        }

        fespace Udh(DTh, P2);
        fespace UhG(THG, P2);
        fespace Ul(L, P2);

        /* S3, S4 */
        real e3 = abs(Udh.ndofglobal - UhG.ndof);
        CHK(COMM, tg, "S3 ndofglobal = ndof sequentiel", e3, 0)
        real v4 = Udh.checkPoU;
        real e4 = v4;
        if (v4 < 0) e4 = 1e30;
        CHK(COMM, tg, "S4 checkPoU                    ", e4, 1e-8)

        /* S5 : voisins dans [0, cs[, puis appariement des intersections */
        {
          int nN = Udh.intersection[0].n;
          int nbad = 0;
          for (int j = 0; j < nN; ++j) {
            int nb = Udh.intersection[0][j];
            if (nb < 0 || nb >= cs || nb == cr) nbad++;
          }
          int nbadG = 0;
          mpiAllReduce(nbad, nbadG, COMM, mpiMAX);
          real e5a = nbadG;
          CHK(COMM, tg, "S5 voisins = rangs de comm     ", e5a, 0)

          real e5b = 1e30;
          if (nbadG == 0) {
            Ul pvx = x, pvy = y, pvz = z;
            real[int][int] pvMine(nN), pvHis(nN);
            mpiRequest[int] pvRq(2*nN);
            for (int j = 0; j < nN; ++j) {
              int[int] pvL = Udh.intersection[1 + j];
              int pvM = pvL.n;
              pvMine[j].resize(3*pvM); pvHis[j].resize(3*pvM);
              for (int p = 0; p < pvM; ++p) {
                pvMine[j][3*p]     = pvx[][pvL[p]];
                pvMine[j][3*p + 1] = pvy[][pvL[p]];
                pvMine[j][3*p + 2] = pvz[][pvL[p]];
              }
              Irecv(processor(Udh.intersection[0][j], COMM, pvRq[j]),      pvHis[j]);
              Isend(processor(Udh.intersection[0][j], COMM, pvRq[nN + j]), pvMine[j]);
            }
            for (int q = 0; q < 2*nN; ++q) { int pw = mpiWaitAny(pvRq); }
            e5b = 0;
            for (int j = 0; j < nN; ++j)
              for (int p = 0; p < pvMine[j].n; ++p)
                e5b = max(e5b, abs(pvMine[j][p] - pvHis[j][p]));
          }
          CHK(COMM, tg, "S5 appariement intersections   ", e5b, 1e-12)
        }

        /* S6, S7 : exigent loc2glob, donc le mode replique */
        if (!scat) {
          real[int] D = Udh.D;
          int[int] l2g = Udh.loc2glob;
          UhG gg = FIELD;
          real[int] acc(UhG.ndof); acc = 0;
          for (int i = 0; i < Udh.ndof; ++i) acc[l2g[i]] += D[i]*gg[][l2g[i]];
          real[int] accG(UhG.ndof);
          mpiAllReduce(acc, accG, COMM, mpiSUM);
          accG -= gg[];
          real e6 = accG.linfty;
          CHK(COMM, tg, "S6 recomposition par la PoU    ", e6, 1e-10)

          int[int] gnum = Udh.numbering;
          real[int] gmx(UhG.ndof), gmn(UhG.ndof);
          gmx = -1; gmn = 1e30;
          for (int i = 0; i < Udh.ndof; ++i) { gmx[l2g[i]] = gnum[i]; gmn[l2g[i]] = gnum[i]; }
          real[int] gmxG(UhG.ndof), gmnG(UhG.ndof);
          mpiAllReduce(gmx, gmxG, COMM, mpiMAX);
          mpiAllReduce(gmn, gmnG, COMM, mpiMIN);
          real[int] dg = gmxG - gmnG;
          real e7a = dg.linfty;
          CHK(COMM, tg, "S7 numbering coherent          ", e7a, 0)
          gmxG.sort;
          real e7b = 0;
          for (int i = 0; i < gmxG.n; ++i) e7b = max(e7b, abs(gmxG[i] - i));
          CHK(COMM, tg, "S7 numbering bijectif          ", e7b, 0)
        }

        /* S8 : Mat PETSc sans communicator=, puis resolution */
        if (stopAt >= 8 && skipS != 8) {
          fespace U1dh(DTh, P1);
          fespace U1h(THG, P1);
          varf vPb(a, b) = INTG(DTh)(grad(a)'*grad(b)) + INTG(DTh)(1.*b) + on(BLAB, a = 0);
          Mat A = vPb(U1dh, U1dh);
          set(A, sparams = kspp);
          real[int] rb = vPb(0, U1dh);
          U1dh uh;
          uh[] = A^-1 * rb;
          varf vS(a, b) = INTG(THG)(grad(a)'*grad(b)) + INTG(THG)(1.*b) + on(BLAB, a = 0);
          matrix As = vS(U1h, U1h, solver = UMFPACK);
          real[int] bs = vS(0, U1h);
          U1h us;
          us[] = As^-1 * bs;
          real Id = INTG(DTh)(uh), Is = INTG(THG)(us);
          real e8a = abs(Id - Is)/abs(Is);
          CHK(COMM, tg, "S8 Mat + A^-1 : integrale      ", e8a, 1e-8)
          if (!scat) {
            int[int] l2g1 = U1dh.loc2glob;
            real e8b = 0;
            for (int i = 0; i < U1dh.ndof; ++i) e8b = max(e8b, abs(uh[][i] - us[][l2g1[i]]));
            CHK(COMM, tg, "S8 Mat + A^-1 : solution       ", e8b, 1e-8)
          }

          /* S8c : Mat A(Udh) ne modifie pas Udh.D (restriction() ecrase son argument) */
          real[int] D0 = U1dh.D;
          Mat Ab(U1dh);
          real[int] D1 = U1dh.D;
          D1 -= D0;
          real e8c = D1.linfty;
          CHK(COMM, tg, "S8c Mat A(Udh) : Udh.D intact  ", e8c, 0)
          /* S8b : Mat A(Udh) puis A = vP(Udh, Udh) : memes controles que S8 */
          Ab = vPb(U1dh, U1dh);
          set(Ab, sparams = kspp);
          U1dh ub;
          ub[] = Ab^-1 * rb;
          real Ib = INTG(DTh)(ub);
          real e8ma = abs(Ib - Is)/abs(Is);
          CHK(COMM, tg, "S8b Mat A(Udh) : integrale     ", e8ma, 1e-8)
          if (!scat) {
            int[int] l2g1b = U1dh.loc2glob;
            real e8mb = 0;
            for (int i = 0; i < U1dh.ndof; ++i) e8mb = max(e8mb, abs(ub[][i] - us[][l2g1b[i]]));
            CHK(COMM, tg, "S8b Mat A(Udh) : solution      ", e8mb, 1e-8)
          }
        }

        /* S9 : transfert vers un autre Dmesh du meme COMM (autre resolution) */
        if (stopAt >= 9 && skipS != 9) {
          DMT DTh2 = distribute(THG2, overlap = ov, comm = COMM);
          MT L2 = DTh2.local;
          fespace A1dh(DTh, P1);
          fespace B2dh(DTh2, P2);
          fespace B2l(L2, P2);
          A1dh a = AFFINE;
          B2dh w = a;
          B2l wl = AFFINE;
          real[int] d9 = w[] - wl[];
          real e9a = d9.linfty;
          CHK(COMM, tg, "S9 Vdh w = a (declaration)     ", e9a, 1e-10)
          a = 2*AFFINE;
          w = a;
          d9 = w[] - 2*wl[];
          real e9b = d9.linfty;
          CHK(COMM, tg, "S9 w = a (reaffectation)       ", e9b, 1e-10)
        }
      } catch (...) { crashed = 1; }
      real eX = crashed;
      CHK(COMM, tg, "S* aucune exception            ", eX, 0)
    }
  }
}// EOM

// SUITEG sur meshS (carre unite du plan z = 0) et meshL (segment [0,1])
macro SUITES(COMM, CTAG, SCAT, METH) {
  if (COMM) {
    meshS ThGs = square3(nsq, nsq);
    meshS ThG2s = square3(nsq2, nsq2);
    int[int] blabS = [1, 2, 3, 4];
    SUITEG(COMM, CTAG, SCAT, METH, meshS, DmeshS, int2d, 3, ThGs, ThG2s, blabS)
  }
}// EOM

macro SUITEL(COMM, CTAG, SCAT, METH) {
  if (COMM) {
    meshL ThGl = segment(nseg);
    meshL ThG2l = segment(nseg2);
    int[int] blabL = [1, 2];
    SUITEG(COMM, CTAG, SCAT, METH, meshL, DmeshL, int1d, 2, ThGl, ThG2l, blabL)
  }
}// EOM

// ---------------------------------------------------------------------
//  Communicateurs (globaux : ils vivent jusqu'a la fin du script)
// ---------------------------------------------------------------------
int colH = 0;
if (mpirank >= mpisize/2) colH = 1;
int colX = 0;
if (mpirank == 0) colX = mpiUndefined;
int colU = 0;
if (mpirank > 0) colU = 1;

mpiComm cP(mpiCommWorld, 0, mpisize - 1 - mpirank);   // monde permute
mpiComm cH(mpiCommWorld, colH, mpirank);              // deux moities
mpiComm cX(mpiCommWorld, colX, mpirank);              // sans le rang monde 0
mpiComm cU(mpiCommWorld, colU, mpirank);              // {0} et {1..mpisize-1}

// ---------------------------------------------------------------------
//  1. W : temoin sur mpiCommWorld
// ---------------------------------------------------------------------
if (cas == 0 || cas == 1) {
  if (mpirank == 0) cout << "===== W : mpiCommWorld (temoin)" << endl;
  SUITE(mpiCommWorld, "W", false, "user")
  SUITE(mpiCommWorld, "W", false, "metis")
  SUITE(mpiCommWorld, "W", true, "user")
  if (pm) { SUITE(mpiCommWorld, "W", false, "parmetis") }
  if (sc) { SUITE(mpiCommWorld, "W", false, "scotch") }
}

// ---------------------------------------------------------------------
//  2. P : monde permute
// ---------------------------------------------------------------------
if (cas == 0 || cas == 2) {
  if (mpirank == 0) cout << "===== P : monde permute" << endl;
  SUITE(cP, "P", false, "user")
  SUITE(cP, "P", false, "metis")
  SUITE(cP, "P", true, "user")
  if (pm) { SUITE(cP, "P", false, "parmetis") }
  if (sc) { SUITE(cP, "P", false, "scotch") }
}

// ---------------------------------------------------------------------
//  3. H : deux moities, en parallele
// ---------------------------------------------------------------------
if (cas == 0 || cas == 3) {
  if (mpirank == 0) cout << "===== H : deux moities" << endl;
  SUITE(cH, "H", false, "user")
  SUITE(cH, "H", false, "metis")
  SUITE(cH, "H", true, "metis")
  if (pm) { SUITE(cH, "H", false, "parmetis") }
  if (sc) { SUITE(cH, "H", false, "scotch") }
  mpiBarrier(mpiCommWorld);
}

// ---------------------------------------------------------------------
//  4. X : sans le rang monde 0 (racine scatter = rang monde 1)
// ---------------------------------------------------------------------
if (cas == 0 || cas == 4) {
  if (mpirank == 0) cout << "===== X : sans le rang monde 0" << endl;
  SUITE(cX, "X", false, "user")
  SUITE(cX, "X", true, "user")
  SUITE(cX, "X", true, "metis")
  if (sc) { SUITE(cX, "X", true, "scotch") }
  // E1 : erreur collective sur cX. La valeur mpiSize(cX) est hors de
  // [0, mpiSize(cX)[ mais dans [0, mpisize[ : refus attendu sur tous les
  // rangs de cX. Le rang monde 0 n'etant pas dans cX, le message
  // "partition[] has a value outside [0, comm size[" doit etre affiche
  // sur cerr par le rang 0 de cX (rang monde 1) : a verifier dans la sortie.
  if (cX) {
    mesh3 ThE = cube(nc, nc, nc);
    int[int] partE(ThE.nt);
    partE = 0;
    partE[0] = mpiSize(cX);
    int refused = 0;
    try { Dmesh3 DE = distribute(ThE, overlap = ov, comm = cX, partition = partE); }
    catch (...) { refused = 1; }
    real eE = 1 - refused;
    CHK(cX, "X", "E1 partition hors de [0, taille de cX[ : refus", eE, 0)

    // E2..E4 : erreurs de detectDistributionMode, collectives sur cX et
    // affichees par le rang monde 1 (a verifier dans la sortie).
    int crE = mpiRank(cX);
    {   // E2 : maillage sur le rang 1 de cX seulement -> "must be built on rank 0 of comm"
      mesh3 ThS;
      if (crE == 1) ThS = cube(nc, nc, nc);
      int refS = 0;
      try { Dmesh3 DThS = distribute(ThS, overlap = ov, comm = cX); } catch (...) { refS = 1; }
      real eS = 1 - refS;
      CHK(cX, "X", "E2 scatter hors du rang 0 de cX : refus", eS, 0)
    }
    {   // E3 : erreur typique, if (mpirank == 0) au lieu de if (mpiRank(cX) == 0) :
        // le rang monde 0 n'est pas dans cX -> "no rank has a mesh"
      mesh3 ThN;
      if (mpirank == 0) ThN = cube(nc, nc, nc);
      int refN = 0;
      try { Dmesh3 DThN = distribute(ThN, overlap = ov, comm = cX); } catch (...) { refN = 1; }
      real eN = 1 - refN;
      CHK(cX, "X", "E3 aucun rang de cX n'a le maillage : refus", eN, 0)
    }
    if (mpiSize(cX) >= 3) {   // E4 : rangs 0 et 1 de cX seulement -> "mixed mode"
      mesh3 ThM;
      if (crE <= 1) ThM = cube(nc, nc, nc);
      int refM = 0;
      try { Dmesh3 DThM = distribute(ThM, overlap = ov, comm = cX); } catch (...) { refM = 1; }
      real eM = 1 - refM;
      CHK(cX, "X", "E4 mode mixte : refus", eM, 0)
    }

    // E5, E5b, E6 : erreurs DETERMINISTES (meme condition sur tous les rangs
    // de cX), affichees par le rang monde 1 (a verifier dans la sortie).
    {
      mesh3 ThD = cube(nc, nc, nc);
      Dmesh3 DThD = distribute(ThD, overlap = ov, comm = cX);
      fespace V3d(DThD, [P1, P1, P1]);
      fespace V2d(DThD, [P1, P1]);
      V3d [e1, e2, e3];
      V2d [a1, a2] = [x, y];
      int ref5 = 0;
      try { [e1, e2] = [a1, a2]; } catch (...) { ref5 = 1; }
      real e5 = 1 - ref5;
      CHK(cX, "X", "E5 u = v, composantes differentes : refus", e5, 0)

      V2d [b1, b2];
      int ref5b = 0;
      try { b1 = a1; } catch (...) { ref5b = 1; }
      real e5b = 1 - ref5b;
      CHK(cX, "X", "E5b b1 = a1 sur fonction vectorielle : refus", e5b, 0)
    }
    {   // E6 : Udh.loc2glob sur un Dmesh en scatter (pas de maillage global)
      mesh3 ThL;
      if (crE == 0) ThL = cube(nc, nc, nc);
      Dmesh3 DThL = distribute(ThL, overlap = ov, comm = cX);
      fespace VL(DThL, P1);
      int ref6 = 0;
      try { int[int] l2g = VL.loc2glob; } catch (...) { ref6 = 1; }
      real e6 = 1 - ref6;
      CHK(cX, "X", "E6 loc2glob en scatter : refus", e6, 0)
    }
    {   // A1 : avertissement du second membre complexe (plugin PETSc reel) :
        // ce n'est pas une erreur ; il doit etre affiche UNE fois, par le
        // rang 0 de cX (rang monde 1), le rang monde 0 n'etant pas dans cX.
        // A verifier dans la sortie.
      mesh3 ThC = cube(nc, nc, nc);
      Dmesh3 DThC = distribute(ThC, overlap = ov, comm = cX);
      fespace VC(DThC, P1);
      varf vc(a, b) = int3d(DThC)(1i*b);
      int okA = 1;
      try { complex[int] bc = vc(0, VC); } catch (...) { okA = 0; }
      real eA = 1 - okA;
      CHK(cX, "X", "A1 second membre complexe : pas d'erreur", eA, 0)
    }
  }
  mpiBarrier(mpiCommWorld);
}

// ---------------------------------------------------------------------
//  8. U : tailles inegales, {0} de taille 1 et {1..mpisize-1}
// ---------------------------------------------------------------------
if (cas == 0 || cas == 8) {
  if (mpirank == 0) cout << "===== U : tailles 1 et mpisize-1" << endl;
  SUITE(cU, "U", false, "user")
  SUITE(cU, "U", false, "metis")
  SUITE(cU, "U", true, "user")
  mpiBarrier(mpiCommWorld);
}

// ---------------------------------------------------------------------
//  9. meshS et 10. meshL : SUITEG sur W, P, H, X et U
//     partitions : utilisateur, methB (scotch, ou metis avec -sc 0),
//     utilisateur en scatter
// ---------------------------------------------------------------------
if (cas == 0 || cas == 9) {
  if (mpirank == 0) cout << "===== 9 : meshS" << endl;
  SUITES(mpiCommWorld, "meshS-W", false, "user")
  SUITES(mpiCommWorld, "meshS-W", false, methB)
  SUITES(mpiCommWorld, "meshS-W", true, "user")
  SUITES(cP, "meshS-P", false, "user")
  SUITES(cP, "meshS-P", false, methB)
  SUITES(cP, "meshS-P", true, "user")
  SUITES(cH, "meshS-H", false, "user")
  SUITES(cH, "meshS-H", false, methB)
  SUITES(cH, "meshS-H", true, "user")
  mpiBarrier(mpiCommWorld);
  SUITES(cX, "meshS-X", false, "user")
  SUITES(cX, "meshS-X", false, methB)
  SUITES(cX, "meshS-X", true, "user")
  mpiBarrier(mpiCommWorld);
  SUITES(cU, "meshS-U", false, "user")
  SUITES(cU, "meshS-U", false, methB)
  SUITES(cU, "meshS-U", true, "user")
  mpiBarrier(mpiCommWorld);
}

if (cas == 0 || cas == 10) {
  if (mpirank == 0) cout << "===== 10 : meshL" << endl;
  SUITEL(mpiCommWorld, "meshL-W", false, "user")
  SUITEL(mpiCommWorld, "meshL-W", false, methB)
  SUITEL(mpiCommWorld, "meshL-W", true, "user")
  SUITEL(cP, "meshL-P", false, "user")
  SUITEL(cP, "meshL-P", false, methB)
  SUITEL(cP, "meshL-P", true, "user")
  SUITEL(cH, "meshL-H", false, "user")
  SUITEL(cH, "meshL-H", false, methB)
  SUITEL(cH, "meshL-H", true, "user")
  mpiBarrier(mpiCommWorld);
  SUITEL(cX, "meshL-X", false, "user")
  SUITEL(cX, "meshL-X", false, methB)
  SUITEL(cX, "meshL-X", true, "user")
  mpiBarrier(mpiCommWorld);
  SUITEL(cU, "meshL-U", false, "user")
  SUITEL(cU, "meshL-U", false, methB)
  SUITEL(cU, "meshL-U", true, "user")
  mpiBarrier(mpiCommWorld);
}

// ---------------------------------------------------------------------
//  5. C : comparaison de communicateurs (tous les rangs du monde)
// ---------------------------------------------------------------------
if (cas == 0 || cas == 5) {
  if (mpirank == 0) cout << "===== C : comparaison de communicateurs" << endl;
  mesh3 Th = cube(nc, nc, nc);
  mesh3 Th2 = cube(nc2, nc2, nc2, [0.25 + 0.5*x, 0.25 + 0.5*y, 0.25 + 0.5*z]);
  Dmesh3 DA = distribute(Th, overlap = ov);            // comm par defaut
  fespace A1dh(DA, P1);
  A1dh a = AFFINE;
  mpiComm cc(mpiCommWorld, 0, mpirank);   // copie congruente du monde

  // C3 en tete : il passe deja aujourd'hui (meme pointeur de comm), alors
  // que C1, C2, C4, C5 s'arretent sur un ffassert non attrapable (MPI_Abort).
  // C3 : deux Dmesh issus de la meme variable cc
  {
    real e = 1e30;
    try {
      Dmesh3 DC1 = distribute(Th, overlap = ov, comm = cc);
      Dmesh3 DC2 = distribute(Th2, overlap = ov, comm = cc);
      mesh3 LC2 = DC2.local;
      fespace C1dh(DC1, P1); fespace C2dh(DC2, P2); fespace C2l(LC2, P2);
      C1dh ac = AFFINE;
      C2dh w = ac;
      C2l wl = AFFINE;
      real[int] d = w[] - wl[];
      e = d.linfty;
    } catch (...) { e = 1e30; }
    CHK(mpiCommWorld, "C", "C3 meme variable cc            ", e, 1e-10)
  }

  // C1 : defaut <-> comm = mpiCommWorld
  {
    real e = 1e30;
    try {
      Dmesh3 DB = distribute(Th2, overlap = ov, comm = mpiCommWorld);
      mesh3 LB = DB.local;
      fespace B2dh(DB, P2); fespace B2l(LB, P2);
      B2dh w = a;
      B2l wl = AFFINE;
      real[int] d = w[] - wl[];
      e = d.linfty;
    } catch (...) { e = 1e30; }
    CHK(mpiCommWorld, "C", "C1 defaut <-> comm=mpiCommWorld", e, 1e-10)
  }

  // C2 : monde <-> copie congruente
  {
    real e = 1e30;
    try {
      Dmesh3 DC = distribute(Th2, overlap = ov, comm = cc);
      mesh3 LC = DC.local;
      fespace C2dh(DC, P2); fespace C2l(LC, P2);
      C2dh w = a;
      C2l wl = AFFINE;
      real[int] d = w[] - wl[];
      e = d.linfty;
    } catch (...) { e = 1e30; }
    CHK(mpiCommWorld, "C", "C2 monde <-> copie congruente  ", e, 1e-10)
  }

  // C4 : monde <-> moities, refus attendu
  {
    Dmesh3 DH;
    int okL = 1, okG = 0;
    try { DH = distribute(Th2, overlap = ov, comm = cH); } catch (...) { okL = 0; }
    mpiAllReduce(okL, okG, mpiCommWorld, mpiMIN);
    real eSetup = 1 - okG;
    CHK(mpiCommWorld, "C", "C4 mise en place (moities)     ", eSetup, 0)
    if (okG) {
      fespace H2dh(DH, P2);
      int refused = 0;
      try { H2dh w = a; } catch (...) { refused = 1; }
      REFUSED("C4 monde <-> moities : refus    ", refused)
    }
  }

  // C5 : monde <-> monde permute (MPI_SIMILAR), refus attendu
  {
    Dmesh3 DP;
    int okL = 1, okG = 0;
    try { DP = distribute(Th2, overlap = ov, comm = cP); } catch (...) { okL = 0; }
    mpiAllReduce(okL, okG, mpiCommWorld, mpiMIN);
    real eSetup = 1 - okG;
    CHK(mpiCommWorld, "C", "C5 mise en place (permute)     ", eSetup, 0)
    if (okG) {
      fespace P2dh(DP, P2);
      int refused = 0;
      try { P2dh w = a; } catch (...) { refused = 1; }
      REFUSED("C5 monde <-> permute : refus    ", refused)
    }
  }

  // C7 : Mat A(Udh, communicator = c). La comparaison des communicateurs a
  // lieu AVANT toute construction : le refus est sur, sans risque de blocage.
  {   // Dmesh sur cc, communicator = mpiCommWorld : congruent, accepte
    Dmesh3 DC7 = distribute(Th, overlap = ov, comm = cc);
    fespace V7(DC7, P1);
    int ok7 = 1;
    try { Mat A7(V7, communicator = mpiCommWorld); } catch (...) { ok7 = 0; }
    real e7 = 1 - ok7;
    CHK(mpiCommWorld, "C", "C7 Mat(Udh, comm congruent) : accepte", e7, 0)
  }
  {   // Dmesh sur cP, communicator = mpiCommWorld : MPI_SIMILAR, refuse
    Dmesh3 DP7 = distribute(Th, overlap = ov, comm = cP);
    fespace W7(DP7, P1);
    int refused = 0;
    try { Mat B7(W7, communicator = mpiCommWorld); } catch (...) { refused = 1; }
    REFUSED("C7 Mat(Udh, comm permute) : refus", refused)
  }

  // C6, C8 : verification d'une Mat DEJA construite, a l'assemblage
  // A = vP(Udh, Udh). Elle a lieu avant tout collectif de l'assemblage.
  // Non teste : une Mat construite sur le MAUVAIS communicateur (ex. WORLD
  // pour un Dmesh sur cX) peut bloquer des la construction, avant la
  // verification : c'est la limite connue, d'ou Mat A(Udh).
  {   // C6 : Mat brute sur mpiCommWorld, Dmesh sur cc (congruent) : acceptee,
      // et meme solution que Mat A(Udh)
    Dmesh3 DC6 = distribute(Th, overlap = ov, comm = cc);
    fespace U6(DC6, P1);
    varf v6(a6, b6) = int3d(DC6)(grad(a6)'*grad(b6)) + int3d(DC6)(1.*b6)
                    + on(1, 2, 3, 4, 5, 6, a6 = 0);
    real[int] rb6 = v6(0, U6);
    Mat Ar6(U6);
    Ar6 = v6(U6, U6);
    set(Ar6, sparams = kspp);
    U6 ur6;
    ur6[] = Ar6^-1 * rb6;
    real e6 = 1e30;
    try {
      real[int] D6 = U6.D;
      Mat A6(U6.ndof, U6.intersection, D6, communicator = mpiCommWorld);
      A6 = v6(U6, U6);
      set(A6, sparams = kspp);
      U6 u6;
      u6[] = A6^-1 * rb6;
      real[int] d6 = u6[] - ur6[];
      e6 = d6.linfty / max(ur6[].linfty, 1e-300);
    } catch (...) { e6 = 1e30; }
    CHK(mpiCommWorld, "C", "C6 Mat brute sur comm congruent : acceptee", e6, 1e-8)
  }
  {   // C8 : Mat A(UdhH) construite sur une moitie, assemblee avec un fespace
      // du monde : autre communicateur, refus sur tous les rangs
    Dmesh3 DH8 = distribute(Th, overlap = ov, comm = cH);
    fespace UH8(DH8, P1);
    Mat A8(UH8);
    fespace UW8(DA, P1);
    varf v8(a8, b8) = int3d(DA)(grad(a8)'*grad(b8)) + on(1, 2, 3, 4, 5, 6, a8 = 0);
    int refused = 0;
    try { A8 = v8(UW8, UW8); } catch (...) { refused = 1; }
    REFUSED("C8 Mat d'un autre comm : refus  ", refused)
  }
  {   // C8b : Mat A(Udh P1) assemblee avec un fespace P2 du meme Dmesh :
      // meme communicateur, taille locale differente, refus sur tous les rangs
    fespace UP1(DA, P1), UP2(DA, P2);
    Mat A8b(UP1);
    varf v8b(a8, b8) = int3d(DA)(grad(a8)'*grad(b8)) + on(1, 2, 3, 4, 5, 6, a8 = 0);
    int refused = 0;
    try { A8b = v8b(UP2, UP2); } catch (...) { refused = 1; }
    REFUSED("C8b Mat d'un autre fespace : refus", refused)
  }
}

// ---------------------------------------------------------------------
//  6. L : le communicateur est libere avant le Dmesh
// ---------------------------------------------------------------------
if (cas == 0 || cas == 6) {
  if (mpirank == 0) cout << "===== L : duree de vie du communicateur" << endl;
  mesh3 Th = cube(nc, nc, nc);
  fespace UhG(Th, P2);
  Dmesh3 DL;
  {
    mpiComm cl(mpiCommWorld, 0, mpirank);
    DL = distribute(Th, overlap = ov, comm = cl);
  }   // cl est libere ici (MPI_Comm_free)
  fespace Ldh(DL, P2);                  // collectif sur DL.comm
  real e1 = abs(Ldh.ndofglobal - UhG.ndof);
  CHK(mpiCommWorld, "L", "L1 ndofglobal apres liberation ", e1, 0)
  real v = int3d(DL)(1.);
  real e2 = abs(v - 1.);
  CHK(mpiCommWorld, "L", "L1 int3d apres liberation      ", e2, 1e-10)
}

// ---------------------------------------------------------------------
//  7. O : rang hors du communicateur
// ---------------------------------------------------------------------
if (cas == 0 || cas == 7) {
  if (mpirank == 0) cout << "===== O : rang hors du communicateur" << endl;
  mesh3 Th = cube(nc, nc, nc);
  Dmesh3 DO;
  int refused = 0;
  try { DO = distribute(Th, overlap = ov, comm = cX); } catch (...) { refused = 1; }
  int expected = 0;
  if (mpirank == 0) expected = 1;       // seul le rang monde 0 est hors de cX
  real e = abs(refused - expected);
  CHK(mpiCommWorld, "O", "O1 refus propre hors de comm   ", e, 0)

  // O2 : le rang exclu est le DERNIER rang du monde, jamais le rang 0 : le
  // message n'est visible que si ce rang l'affiche lui-meme (localError).
  // A verifier dans la sortie : "[rank <mpisize-1>] distribute: this rank
  // does not belong to comm", exactement une fois.
  {
    int colO = 0;
    if (mpirank == mpisize - 1) colO = mpiUndefined;
    mpiComm cO(mpiCommWorld, colO, mpirank);
    Dmesh3 DO2;
    int refused2 = 0;
    try { DO2 = distribute(Th, overlap = ov, comm = cO); } catch (...) { refused2 = 1; }
    int expected2 = 0;
    if (mpirank == mpisize - 1) expected2 = 1;
    real e2 = abs(refused2 - expected2);
    CHK(mpiCommWorld, "O", "O2 refus local, rang != 0      ", e2, 0)
  }
}

// ---------------------------------------------------------------------
//  11. R : erreurs dependant du rang (E7..E9), sur cX. Voir l'en-tete.
//      Place en dernier : avant la correction, chaque controle bloque.
// ---------------------------------------------------------------------
if ((cas == 0 || cas == 11) && mpisize >= 3) {
  if (mpirank == 0) cout << "===== R : erreurs dependant du rang" << endl;
  if (cX) {
    int crR = mpiRank(cX), csR = mpiSize(cX);
    mesh3 ThR = cube(nc, nc, nc);
    int[int] p1(ThR.nt), p2(ThR.nt);
    for (int k = 0; k < ThR.nt; ++k) {
      p1[k] = SLICE(ThR, k, csR);
      p2[k] = (p1[k] + 1) % csR;          /* tranches decalees d'un rang */
    }
    Dmesh3 DR1 = distribute(ThR, overlap = ov, comm = cX, partition = p1);
    Dmesh3 DR2 = distribute(ThR, overlap = ov, comm = cX, partition = p2);
    fespace UR(DR1, P1), VR(DR2, P1);
    Dtransfer3 PR = transferPlan(UR, VR);

    /* temoin : donnees coherentes, chemin general (XFER_GENERAL = 0) */
    {
      real[int] xs(UR.ndof), ys(VR.ndof);
      xs = 1;
      int pth = interpolateD(PR, xs, ys);
      real et = (pth != 0);
      CHK(cX, "R", "R0 temoin : chemin general     ", et, 0)
    }

    if (eSel == 0 || eSel == 7) {   /* E7 : source perimee sur un seul rang */
      UR u = FIELD;
      if (crR == 1) u[].resize(u[].n + 1);
      VR w;
      int ref7 = 0;
      try { w = u; } catch (...) { ref7 = 1; }
      real e7 = 1 - ref7;
      CHK(cX, "R", "E7 w = u, source perimee sur un rang : refus", e7, 0)
    }

    if (eSel == 0 || eSel == 8) {   /* E8 : plan perime sur un seul rang */
      real[int] xs(UR.ndof), ys(VR.ndof);
      xs = 1;
      if (crR == 1) xs.resize(UR.ndof + 1);
      int ref8 = 0;
      try { interpolateD(PR, xs, ys); } catch (...) { ref8 = 1; }
      real e8 = 1 - ref8;
      CHK(cX, "R", "E8 interpolateD, plan perime sur un rang : refus", e8, 0)
    }

    if (eSel == 0 || eSel == 9) {   /* E9 : numerotation de mauvaise taille sur un seul rang */
      int[int] num(UR.ndof);
      num = 0;                      /* valeurs sans importance : seule la taille est fausse */
      if (crR == 1) num.resize(UR.ndof + 1);
      matrix M9;
      real[int] col9;
      int ref9 = 0;
      try { interpolateMat(PR, num, M9, col9); } catch (...) { ref9 = 1; }
      real e9 = 1 - ref9;
      CHK(cX, "R", "E9 interpolateMat, numerotation fausse sur un rang : refus", e9, 0)
    }
  }
  mpiBarrier(mpiCommWorld);
}

// ---------------------------------------------------------------------
//  Bilan : chaque rang a ses propres compteurs (les rangs hors d'un
//  communicateur n'executent pas sa suite). Echec si un rang a un FAIL.
// ---------------------------------------------------------------------
int nfail = ntot - npass, gfail = 0;
mpiAllReduce(nfail, gfail, mpiCommWorld, mpiMAX);
if (mpirank == 0)
  cout << "test_subcomm : rang 0 " << npass << "/" << ntot << " PASS ; "
       << "max FAIL sur un rang = " << gfail
       << "   => " << (gfail == 0 ? "OK" : "ECHEC") << endl;
assert(gfail == 0);
