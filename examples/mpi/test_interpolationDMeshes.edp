// NBPROC 4
// PARAM -ns

// ---------------------------------------------------------------------
//  Jalon 1 : appariement de rangs entre deux maillages distribues
//            independants (overlapRankPairs / computeOverlapRankPairs).
//
//  Th1 = [0,1]^3 et Th2 = [0.5,1.5]^3 se recouvrent sur un huitieme de
//  leur volume ; Th3 = [10,11]^3 est franchement disjoint.
//
//  POURQUOI UNE PARTITION UTILISATEUR EN TRANCHES ET PAS METIS
//  ----------------------------------------------------------
//  Metis minimise la coupe, pas l'etendue : sur un cube decoupe en 4, la
//  BOITE ENGLOBANTE de chaque sous-domaine couvre presque tout le cube
//  (mesure : x[0,1] y[0,1] z[0.1875,1] pour le rang 0). L'appariement
//  all-to-all est alors la BONNE reponse, et aucun reglage de marge n'y
//  changera rien. Un test de non-trivialite sur partition metis ne
//  mesurerait donc rien du tout.
//
//  Avec des tranches selon x, l'appariement attendu se calcule a la main.
//  Tranche r de Th1 apres recouvrement et marge :
//      A_r = [r/n - e, (r+1)/n + e]      e = h + hmax
//      B_s = [0.5 + s/n - e, 0.5 + (s+1)/n + e]
//  et A_r coupe B_s ssi  r - s >= n/2 - 1 - 2*n*e.  Pour n = 4 et
//  nc = 32 (h = 1/32, hmax = sqrt(3)/32) cela vaut r - s >= 0.317, donc
//  exactement r > s : la matrice d'appariement est triangulaire
//  inferieure stricte, 6 paires sur 16. C'est l'oracle du test B2, et il
//  epingle la marge : avec 2*hmax on aurait e = 0.140, donc r - s >= -0.12,
//  soit la triangulaire INFERIEURE LARGE (10 paires) et B2 en echec.
//  Sensibilite verifiee a la main : a -ov 3 la geometrie bouge assez pour
//  que la matrice change et que B2 echoue avec un code de retour non nul.
//  B2 n'est donc pas une tautologie. Son garde inclut ov = 1, la valeur
//  pour laquelle la structure attendue est demontree ci-dessus.
//
//  PROPRIETES VERIFIEES  (toutes sans maillage global, donc valables
//  aussi en DM_SCATTER)
//   A.  Symetrie croisee : r dans send(moi) <=> moi dans recv(r).
//       C'est ce qui casse en premier si un indice est inverse dans le
//       test de recouvrement.
//   B1. Non-trivialite : l'appariement n'est pas all-to-all. Robuste,
//       verifiee pour tout np > 1 et tout nc.
//   B2. Structure exacte r > s. Verifiee seulement dans la configuration
//       nominale np = 4, nc = 32, ou elle est demontree ci-dessus.
//   C.  Cas disjoint : contre Th3, les deux listes sont vides sur tous
//       les rangs. Sans ce test, un bboxOverlap toujours vrai passerait
//       A, B1 et B2.
//   D.  Auto-appariement : DTh1 contre lui-meme donne send == recv et
//       contient mpirank. Cette auto-paire n'est pas un artefact de
//       communication : en mono-rang c'est le seul fragment, et c'est
//       elle qui portera toute la donnee au jalon 3.
//   E.  Partition metis : la symetrie doit tenir la aussi. Le taux de
//       remplissage est affiche sans etre asserte -- il depend du
//       partitionneur, pas du code teste.
//
//  JALON 2 -- echange des fragments. transferFragmentCounts(DA, DB, nE, nR)
//  remplit nE aligne sur sendToRanks et nR aligne sur recvFromRanks, chaque
//  entree valant le nombre d'elements du fragment correspondant (0 si vide).
//   F.  Conservation globale : la somme des elements emis sur tous les rangs
//       egale la somme des elements recus. Signal grossier mais immediat.
//   G.  Coherence par paire : ce que r declare envoyer a s egale ce que s
//       declare avoir recu de r, pour les n*n paires. Localise ce que F ne
//       fait que detecter, et attrape un desalignement des listes send/recv
//       (nE[i] range en face du mauvais rang).
//   H.  Auto-fragment exact : DTh1 contre lui-meme, la boite destination de
//       mon propre rang contient tout mon maillage local, donc le fragment
//       que je m'envoie a EXACTEMENT DTh1.local.nt elements -- et celui que
//       je recois aussi. Oracle exact, sans tolerance.
//   I.  Cas disjoint : contre Th3, aucun element emis ni recu, et surtout
//       AUCUN BLOCAGE. Une regression du protocole non bloquant se manifeste
//       en interblocage, pas en FAIL : lancer sous timeout.
//         timeout 300 ff-mpirun -np 4 test_interpolationDMeshes.edp -ns
//
//  JALON 3 -- interpolation et accumulation. transferP1(DA, uA, DB, uB)
//  transfere un champ P1 du maillage distribue A vers B.
//   J.  Couverture exacte. Th4 = [0.25,0.75]^3 est STRICTEMENT inclus dans
//       Th1 = [0,1]^3, donc tous ses DDL sont couverts. Transferer u = 1
//       revient a reconstruire la partition de l'unite : chaque fragment
//       porte chi_r * 1 = chi_r et la somme des interpolations vaut
//       somme(chi_r) = 1. Assertion SANS tolerance de discretisation.
//       C'est le test du mode de defaillance silencieux : un rang couvrant
//       qui n'enverrait pas son fragment donne une valeur < 1, pas 0, donc
//       invisible a un simple comptage de DDL non couverts. Il epingle
//       aussi la marge PAR EN DESSOUS -- la reduire ferait tomber J, alors
//       que B2 l'epingle par au dessus.
//   K.  Fonction affine 1 + x + 2y + 3z, exacte en P1 : erreur nulle a
//       l'arrondi. Valide buildInterpolationMatrixT lui-meme.
//   L.  Couverture partielle. DTh1 -> DTh2 (cubes decales) avec u = 1 : les
//       DDL franchement interieurs a [0,1]^3 valent 1, ceux franchement
//       exterieurs valent 0. La bande de largeur 2*hmax autour de la
//       frontiere est exclue, les points exactement sur dTh1 etant a la
//       merci de Find. C'est L qui echouerait avec data[2] = 0 : sans
//       inside, l'extrapolation donnerait des valeurs quelconques dehors.
//
//  Les verdicts passent par assert() : bin/test-driver-ff decide sur le
//  code de retour de FreeFEM, il ne relit pas la chaine FAIL affichee.
//
//  NON-DETERMINISME -- a lire avant de s'etonner d'une valeur qui bouge.
//  Depuis que exchangeFragments interpole a la volee sur MPI_Waitany, les
//  fragments sont accumules dans leur ORDRE D'ARRIVEE, qui varie d'une
//  execution a l'autre. L'ordre de sommation dans dstU[i] += change donc, et
//  les erreurs affichees varient au dernier bit : mesure sur 5 executions
//  identiques, le bloc K oscille entre 8.88178e-16 et 1.77636e-15.
//  N'ASSERTEZ JAMAIS UNE VALEUR EXACTE ici -- toutes les assertions
//  numeriques sont a 1e-10 et doivent le rester. Les blocs qui affichent
//  0 exact (J, N, O1, O2, O3) le font empiriquement, pas par garantie :
//  ne transformez pas cette observation en assertion.
//
//  Options :
//    -nc     raffinement de Th1 et Th2                  (defaut 32)
//    -ncm    raffinement des deux cubes metis du test E  (defaut 8)
//    -ncfar  raffinement de Th3, sans influence          (defaut 4)
//    -ov     recouvrement passe a distribute             (defaut 1)
//
//  Lancer :
//    ff-mpirun -np 4 test_interpolationDMeshes.edp -ns
// ---------------------------------------------------------------------

load "PETSc"
include "getARGV.idp"

int nc    = getARGV("-nc",    32);
int ncm   = getARGV("-ncm",    8);
int ncfar = getARGV("-ncfar",  4);
// nc4 = 15 et non 16 : DELIBEREMENT non commensurable avec nc = 32.
// Avec nc4 = 16 les sommets de Th4 tombent en 0.25 + k/32, exactement sur
// ceux de Th1, l'interpolation degenere en recopie de DDL et K ne testerait
// plus la geometrie -- l'erreur serait exactement 0 pour une mauvaise raison.
int nc4   = getARGV("-nc4",   15);
int nc5   = getARGV("-nc5",   10);
int ncnest = getARGV("-ncnest", 10);   // paire emboitee du bloc P   // paire grossiere pour les degres eleves
int nc6   = getARGV("-nc6",    6);
int ov    = getARGV("-ov",     1);

int n = mpisize;

// --- construction des tranches -----------------------------------------
// part[k] = tranche de x contenant le barycentre de l'element k.
// P0 interpole au barycentre, et sa numerotation de DDL suit celle des
// elements : px[][k] est donc bien x(barycentre de k).
macro SLABS(Th, x0, part)
{
  fespace PhSlab(Th, P0);
  PhSlab pxSlab = x;
  int[int] cntSlab(n);
  cntSlab = 0;
  for (int k = 0; k < Th.nt; k++) {
    int s = int((pxSlab[][k] - x0) * n);
    if (s < 0) s = 0;
    if (s > n - 1) s = n - 1;
    part[k] = s;
    cntSlab[s] = cntSlab[s] + 1;
  }
  assert(cntSlab.min > 0);   /* distribute refuse un rang sans element */
} // EOM

mesh3 Th1 = cube(nc, nc, nc);
mesh3 Th2 = cube(nc, nc, nc, [0.5 + x, 0.5 + y, 0.5 + z]);
mesh3 Th3 = cube(ncfar, ncfar, ncfar, [10 + x, 10 + y, 10 + z]);
// Strictement inclus dans Th1 : oracle de couverture exacte (bloc J).
mesh3 Th4 = cube(nc4, nc4, nc4, [0.25 + 0.5*x, 0.25 + 0.5*y, 0.25 + 0.5*z]);

int[int] p1(Th1.nt), p2(Th2.nt);
SLABS(Th1, 0.0, p1)
SLABS(Th2, 0.5, p2)

Dmesh3 DTh1 = distribute(Th1, overlap = ov, partition = p1);
Dmesh3 DTh2 = distribute(Th2, overlap = ov, partition = p2);
Dmesh3 DTh3 = distribute(Th3, overlap = ov);          // metis, sans importance
Dmesh3 DTh4 = distribute(Th4, overlap = ov);          // metis : couvre aussi ce chemin

// Paire grossiere Th5 -> Th6, Th6 strictement inclus dans Th5. Sert aux blocs
// M/N/O : P4 sur un maillage a 196k tetraedres serait hors de prix pour un
// test de make check.
mesh3 Th5 = cube(nc5, nc5, nc5);
mesh3 Th6 = cube(nc6, nc6, nc6, [0.25 + 0.5*x, 0.25 + 0.5*y, 0.25 + 0.5*z]);
Dmesh3 DTh5 = distribute(Th5, overlap = ov);
Dmesh3 DTh6 = distribute(Th6, overlap = ov);
// Meme paire sans recouvrement : interpolatePoU emprunte alors le chemin
// buildInterfaceDofList, distinct et jamais exerce jusqu'ici (bloc O).
Dmesh3 DTh5z = distribute(Th5, overlap = 0);
Dmesh3 DTh6z = distribute(Th6, overlap = 0);

if (mpirank == 0)
  cout << "== jalon 1 : appariement de rangs ==  np = " << n
       << "   nc = " << nc << "   overlap = " << ov << endl;

// --- remontee de la matrice d'appariement -------------------------------
// sAll[a*n+b] = 1 ssi le rang a declare envoyer au rang b.
// rAll[b*n+a] = 1 ssi le rang b declare recevoir du rang a.
// Apres reduction les deux matrices sont identiques sur tous les rangs,
// donc les verdicts aussi : pas de divergence possible entre rangs.
macro PAIRMATRIX(DA, DB, sAll, rAll)
{
  int[int] sndP(0), rcvP(0);
  overlapRankPairs(DA, DB, sndP, rcvP);
  int[int] sLocP(n*n), rLocP(n*n);
  sLocP = 0;
  rLocP = 0;
  for (int i = 0; i < sndP.n; i++) sLocP[mpirank*n + sndP[i]] = 1;
  for (int i = 0; i < rcvP.n; i++) rLocP[mpirank*n + rcvP[i]] = 1;
  mpiAllReduce(sLocP, sAll, mpiCommWorld, mpiSUM);
  mpiAllReduce(rLocP, rAll, mpiCommWorld, mpiSUM);
} // EOM

int[int] sAll(n*n), rAll(n*n);
PAIRMATRIX(DTh1, DTh2, sAll, rAll)

if (mpirank == 0) {
  cout << "  matrice send (ligne = emetteur, colonne = destinataire) :" << endl;
  for (int a = 0; a < n; a++) {
    cout << "      " << a << " :";
    for (int b = 0; b < n; b++) cout << " " << sAll[a*n + b];
    cout << endl;
  }
}

// Diagnostic : etendue en x de chaque tranche source, apres recouvrement.
// C'est ce qu'il faut lire en premier si B1 ou B2 echoue. Remonte sur le
// rang 0 plutot qu'imprime en ronde barriere, sinon la sortie s'entrelace
// avec les verdicts.
{
  mesh3 Loc = DTh1.local;
  fespace VLoc(Loc, P1);
  VLoc xLoc = x;
  real[int] xlo(n), xhi(n), gxlo(n), gxhi(n);
  xlo = 0;
  xhi = 0;
  xlo[mpirank] = xLoc[].min;
  xhi[mpirank] = xLoc[].max;
  mpiAllReduce(xlo, gxlo, mpiCommWorld, mpiSUM);
  mpiAllReduce(xhi, gxhi, mpiCommWorld, mpiSUM);
  if (mpirank == 0)
    for (int r = 0; r < n; r++)
      cout << "      tranche " << r << " : x[" << gxlo[r] << ", " << gxhi[r]
           << "]   hmax = " << Loc.hmax << endl;
}

// --- A : symetrie croisee -----------------------------------------------
int badSym = 0;
for (int a = 0; a < n; a++)
  for (int b = 0; b < n; b++)
    if (sAll[a*n + b] != rAll[b*n + a]) badSym++;

if (mpirank == 0)
  cout << "  [A symetrie croisee]   incoherences = " << badSym
       << "   => " << (badSym == 0 ? "PASS" : "FAIL") << endl;
assert(badSym == 0);

// --- B1 : non-trivialite -------------------------------------------------
int tot = 0;
for (int i = 0; i < n*n; i++) tot += sAll[i];

if (n > 1) {
  if (mpirank == 0)
    cout << "  [B1 non-trivialite]    paires = " << tot << " / " << n*n
         << "   => " << (tot < n*n ? "PASS" : "FAIL") << endl;
  assert(tot < n*n);
}
else if (mpirank == 0)
  cout << "  [B1 non-trivialite]    SKIP (np = 1 : all-to-all legitime)" << endl;

// --- B2 : structure exacte, configuration nominale seulement -------------
if (n == 4 && nc == 32 && ov == 1) {
  int badTri = 0;
  for (int a = 0; a < n; a++)
    for (int b = 0; b < n; b++) {
      int attendu = (a > b) ? 1 : 0;
      if (sAll[a*n + b] != attendu) badTri++;
    }
  if (mpirank == 0)
    cout << "  [B2 structure r > s]   ecarts = " << badTri
         << "   => " << (badTri == 0 ? "PASS" : "FAIL") << endl;
  assert(badTri == 0);
}
else if (mpirank == 0)
  cout << "  [B2 structure r > s]   SKIP (hors configuration nominale"
       << " np = 4, nc = 32, ov = 1)" << endl;

// --- C : cas disjoint ----------------------------------------------------
int[int] snd3(0), rcv3(0);
overlapRankPairs(DTh1, DTh3, snd3, rcv3);

int loc3 = snd3.n + rcv3.n;
int tot3 = 0;
mpiAllReduce(loc3, tot3, mpiCommWorld, mpiSUM);

if (mpirank == 0)
  cout << "  [C cas disjoint]       paires = " << tot3
       << "   => " << (tot3 == 0 ? "PASS" : "FAIL") << endl;
assert(tot3 == 0);

// --- D : auto-appariement ------------------------------------------------
int[int] sndSelf(0), rcvSelf(0);
overlapRankPairs(DTh1, DTh1, sndSelf, rcvSelf);

int badSelf = 0;
if (sndSelf.n != rcvSelf.n) badSelf = 1;
else {
  for (int i = 0; i < sndSelf.n; i++)
    if (sndSelf[i] != rcvSelf[i]) badSelf = 1;
}

int hasSelf = 0;
for (int i = 0; i < sndSelf.n; i++)
  if (sndSelf[i] == mpirank) hasSelf = 1;

int gBadSelf = 0, gHasSelf = 1;
mpiAllReduce(badSelf, gBadSelf, mpiCommWorld, mpiMAX);
mpiAllReduce(hasSelf, gHasSelf, mpiCommWorld, mpiMIN);

if (mpirank == 0)
  cout << "  [D auto-appariement]   send == recv : " << (gBadSelf == 0 ? "oui" : "non")
       << "   mpirank present : " << (gHasSelf == 1 ? "oui" : "non")
       << "   => " << (gBadSelf == 0 && gHasSelf == 1 ? "PASS" : "FAIL") << endl;
assert(gBadSelf == 0);
assert(gHasSelf == 1);

// =======================================================================
//  JALON 2 : echange des fragments
// =======================================================================

// Les listes d'appariement du couple (DTh1, DTh2). Le jalon 1 les consomme
// dans le macro PAIRMATRIX, dont la portee est locale : on les redemande ici
// pour indexer nEnv / nRec, qui suivent exactement le meme ordre.
int[int] snd(0), rcv(0);
overlapRankPairs(DTh1, DTh2, snd, rcv);

int[int] nEnv(0), nRec(0);
transferFragmentCounts(DTh1, DTh2, nEnv, nRec);

// Contrat d'alignement, verifie AVANT toute lecture de valeur.
assert(nEnv.n == snd.n);
assert(nRec.n == rcv.n);

mesh3 Loc1 = DTh1.local;
// Les fragments sont decoupes dans CoverMesh, pas LocalMesh : la couche
// supplementaire rend les points d'interface strictement interieurs au
// fragment, ce qui evite le repli par le bord de Find. Les DDL de cette
// couche portent zero (chi y est nul), donc l'identite nodale
// somme_r chi_r(v) = 1 est preservee. Les bornes ci-dessous se referent
// donc au cover, pas au local.
mesh3 Cov1 = DTh1.cover;

// --- F : conservation globale -------------------------------------------
int locEnv = 0, locRec = 0;
for (int i = 0; i < nEnv.n; i++) locEnv += nEnv[i];
for (int j = 0; j < nRec.n; j++) locRec += nRec[j];

int totEnv = 0, totRec = 0;
mpiAllReduce(locEnv, totEnv, mpiCommWorld, mpiSUM);
mpiAllReduce(locRec, totRec, mpiCommWorld, mpiSUM);

if (mpirank == 0)
  cout << "  [F conservation]       emis = " << totEnv << "   recus = " << totRec
       << "   => " << (totEnv == totRec ? "PASS" : "FAIL") << endl;
assert(totEnv == totRec);

// Aucun fragment ne peut contenir plus d'elements que le maillage local dont
// il est extrait : attrape un masque errone qui deborderait.
int badBound = 0;
for (int i = 0; i < nEnv.n; i++)
  if (nEnv[i] < 0 || nEnv[i] > Cov1.nt) badBound = 1;
int gBadBound = 0;
mpiAllReduce(badBound, gBadBound, mpiCommWorld, mpiMAX);
if (mpirank == 0)
  cout << "  [F borne nEnv <= cover] => " << (gBadBound == 0 ? "PASS" : "FAIL") << endl;
assert(gBadBound == 0);

// --- G : coherence par paire ---------------------------------------------
// Eall[r*n+s] : elements que r declare envoyer a s.
// Rall[r*n+s] : elements que s declare avoir recus de r.
int[int] Eloc(n*n), Rloc(n*n), Eall(n*n), Rall(n*n);
Eloc = 0;
Rloc = 0;
for (int i = 0; i < snd.n; i++) Eloc[mpirank*n + snd[i]] = nEnv[i];
for (int j = 0; j < rcv.n; j++) Rloc[rcv[j]*n + mpirank] = nRec[j];
mpiAllReduce(Eloc, Eall, mpiCommWorld, mpiSUM);
mpiAllReduce(Rloc, Rall, mpiCommWorld, mpiSUM);

int badPair = 0;
for (int i = 0; i < n*n; i++)
  if (Eall[i] != Rall[i]) badPair++;

if (mpirank == 0) {
  cout << "  matrice des elements transferes (ligne = emetteur) :" << endl;
  for (int a = 0; a < n; a++) {
    cout << "      " << a << " :";
    for (int b = 0; b < n; b++) cout << " " << Eall[a*n + b];
    cout << endl;
  }
  cout << "  [G coherence par paire] desaccords = " << badPair
       << "   => " << (badPair == 0 ? "PASS" : "FAIL") << endl;
}
assert(badPair == 0);

// --- H : auto-fragment exact ----------------------------------------------
// Pour DTh1 contre DTh1, la boite destination de mon rang est la boite de mon
// propre maillage local, gonflee : tous mes barycentres y tombent. Le fragment
// que je m'envoie doit donc etre le maillage local entier, sans tolerance.
int[int] sndS(0), rcvS(0), nEnvS(0), nRecS(0);
overlapRankPairs(DTh1, DTh1, sndS, rcvS);
transferFragmentCounts(DTh1, DTh1, nEnvS, nRecS);

int selfSent = -1, selfRecv = -1;
for (int i = 0; i < sndS.n; i++) if (sndS[i] == mpirank) selfSent = nEnvS[i];
for (int j = 0; j < rcvS.n; j++) if (rcvS[j] == mpirank) selfRecv = nRecS[j];

// Encadrement et non egalite : la boite destination de mon rang est celle de
// mon maillage LOCAL gonflee de h, et un element de la couche du cover peut
// avoir son barycentre au dela. La borne basse reste exacte -- tout element
// local a son barycentre dans la boite locale -- et garde tout son pouvoir
// de detection.
int badSelfFrag = 0;
if (selfSent < Loc1.nt || selfSent > Cov1.nt) badSelfFrag = 1;
if (selfRecv < Loc1.nt || selfRecv > Cov1.nt) badSelfFrag = 1;
int gBadSelfFrag = 0;
mpiAllReduce(badSelfFrag, gBadSelfFrag, mpiCommWorld, mpiMAX);

if (mpirank == 0)
  cout << "  [H auto-fragment]      rang 0 : emis " << selfSent
       << " / recus " << selfRecv << "   dans [" << Loc1.nt << ", " << Cov1.nt << "]"
       << "   => " << (gBadSelfFrag == 0 ? "PASS" : "FAIL") << endl;
assert(gBadSelfFrag == 0);

// --- I : cas disjoint, sans blocage ----------------------------------------
int[int] nEnv3(0), nRec3(0);
transferFragmentCounts(DTh1, DTh3, nEnv3, nRec3);

int loc3b = 0;
for (int i = 0; i < nEnv3.n; i++) loc3b += nEnv3[i];
for (int j = 0; j < nRec3.n; j++) loc3b += nRec3[j];
int tot3b = 0;
mpiAllReduce(loc3b, tot3b, mpiCommWorld, mpiSUM);

if (mpirank == 0)
  cout << "  [I cas disjoint]       elements transferes = " << tot3b
       << "   => " << (tot3b == 0 ? "PASS" : "FAIL") << endl;
assert(tot3b == 0);

// =======================================================================
//  JALON 3 : interpolation et accumulation
// =======================================================================

mesh3 Loc2 = DTh2.local;
mesh3 Loc4 = DTh4.local;
fespace V1(Loc1, P1);
fespace V2(Loc2, P1);
fespace V4(Loc4, P1);

// La numerotation de V1 coincide avec celle du GFESpace(P1) construit dans
// transferP1 : meme objet maillage (DTh1.local), meme EF, BuildDFNumbering
// deterministe.
V1 uOne = 1.0;

// --- J : couverture exacte -------------------------------------------------
V4 cover = 0;
transferP1(DTh1, uOne[], DTh4, cover[]);

real errCov = 0;
for (int i = 0; i < cover[].n; i++)
  errCov = max(errCov, abs(cover[][i] - 1.0));
real gErrCov = 0;
mpiAllReduce(errCov, gErrCov, mpiCommWorld, mpiMAX);

if (mpirank == 0)
  cout << "  [J couverture exacte]  max|sum(chi) - 1| = " << gErrCov
       << "   => " << (gErrCov < 1e-10 ? "PASS" : "FAIL") << endl;
assert(gErrCov < 1e-10);

// --- K : fonction affine ---------------------------------------------------
V1 uAff = 1 + x + 2*y + 3*z;
V4 got = 0;
transferP1(DTh1, uAff[], DTh4, got[]);

V4 want = 1 + x + 2*y + 3*z;
real errAff = 0;
for (int i = 0; i < got[].n; i++)
  errAff = max(errAff, abs(got[][i] - want[][i]));
real gErrAff = 0;
mpiAllReduce(errAff, gErrAff, mpiCommWorld, mpiMAX);

if (mpirank == 0)
  cout << "  [K fonction affine]    erreur Linf = " << gErrAff
       << "   => " << (gErrAff < 1e-10 ? "PASS" : "FAIL") << endl;
assert(gErrAff < 1e-10);

// --- L : couverture partielle ----------------------------------------------
V2 part = 0;
transferP1(DTh1, uOne[], DTh2, part[]);

V2 px = x, py = y, pz = z;
real band = 2.0 * Loc1.hmax;
real errIn = 0, errOut = 0;
int nIn = 0, nOut = 0;
for (int i = 0; i < part[].n; i++) {
  real a = px[][i], b = py[][i], c = pz[][i];
  if (a > band && a < 1 - band && b > band && b < 1 - band && c > band && c < 1 - band) {
    errIn = max(errIn, abs(part[][i] - 1.0));
    nIn++;
  }
  if (a > 1 + band || b > 1 + band || c > 1 + band) {
    errOut = max(errOut, abs(part[][i]));
    nOut++;
  }
}
real gErrIn = 0, gErrOut = 0;
int gnIn = 0, gnOut = 0;
mpiAllReduce(errIn, gErrIn, mpiCommWorld, mpiMAX);
mpiAllReduce(errOut, gErrOut, mpiCommWorld, mpiMAX);
mpiAllReduce(nIn, gnIn, mpiCommWorld, mpiSUM);
mpiAllReduce(nOut, gnOut, mpiCommWorld, mpiSUM);

if (mpirank == 0)
  cout << "  [L couverture part.]   dedans " << gnIn << " DDL, err = " << gErrIn
       << " ; dehors " << gnOut << " DDL, err = " << gErrOut
       << "   => " << (gErrIn < 1e-10 && gErrOut < 1e-10 && gnIn > 0 && gnOut > 0 ? "PASS" : "FAIL")
       << endl;
assert(gnIn > 0 && gnOut > 0);      // sinon le test serait vacuous
assert(gErrIn < 1e-10);
assert(gErrOut < 1e-10);

// =======================================================================
//  JALON 4 : liaison langage (interpolateD)
// =======================================================================
//
//  Une fonction EF sur fespace DISTRIBUE n'accepte ni initialisation ni
//  affectation par expression sur cette branche. On porte donc les valeurs
//  par une fonction EF sur le fespace LOCAL, qui partage exactement la
//  numerotation : v_dfes::update() construit son GFESpace sur DTh->LocalMesh
//  avec le meme EF. L'assertion ndof == ndof le verifie a chaque bloc.
//
//   M.  Degres croises sur un champ affine, exact dans tout espace de degre
//       >= 1 : l'erreur doit rester au niveau de l'arrondi. nc6 = 6 n'est pas
//       commensurable avec nc5 = 10 sur [0.25,0.75], donc les DDL ne
//       coincident pas et la geometrie est reellement exercee -- c'est
//       l'erreur commise puis corrigee au bloc K.
//   N.  Couverture (u = 1) en degre superieur. En P1 destination,
//       interpolatePoU court-circuite (lgmat.cpp:1342) ; en P2 c'est le
//       chemin long, une matrice d'interpolation appliquee a la PoU, qui
//       n'avait jamais ete exerce.
//   O.  overlap = 0 : interpolatePoU emprunte alors buildInterfaceDofList
//       (lgmat.cpp:1379), second chemin distinct jamais exerce.

mesh3 L5 = DTh5.local, L6 = DTh6.local;

// --- M : degres croises, champ affine ---------------------------------------
{
  fespace WdS1(DTh5, P2);  fespace WlS1(L5, P2);
  fespace WdD1(DTh6, P1);  fespace WlD1(L6, P1);
  assert(WdS1.ndof == WlS1.ndof && WdD1.ndof == WlD1.ndof);
  WlS1 uS = 1 + x + 2*y + 3*z;
  WlD1 uD = 0;
  interpolateD(WdS1, uS[], WdD1, uD[]);
  WlD1 ref = 1 + x + 2*y + 3*z;
  real eLoc = 0;
  for (int i = 0; i < uD[].n; i++) eLoc = max(eLoc, abs(uD[][i] - ref[][i]));
  real eGlob = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [M P2 -> P1]        erreur Linf = " << eGlob
         << "   => " << (eGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-10);
}
{
  fespace WdS2(DTh5, P1);  fespace WlS2(L5, P1);
  fespace WdD2(DTh6, P2);  fespace WlD2(L6, P2);
  assert(WdS2.ndof == WlS2.ndof && WdD2.ndof == WlD2.ndof);
  WlS2 uS = 1 + x + 2*y + 3*z;
  WlD2 uD = 0;
  interpolateD(WdS2, uS[], WdD2, uD[]);
  WlD2 ref = 1 + x + 2*y + 3*z;
  real eLoc = 0;
  for (int i = 0; i < uD[].n; i++) eLoc = max(eLoc, abs(uD[][i] - ref[][i]));
  real eGlob = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [M P1 -> P2]        erreur Linf = " << eGlob
         << "   => " << (eGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-10);
}
// P3 et P4 ne sont pas des EF 3D de base (ils exigent un plugin) : la paire
// de degres la plus ecartee disponible sans dependance est P1b -> P1dc, qui
// croise en plus une base a bulle et une base discontinue.
{
  fespace WdS3(DTh5, P1b);  fespace WlS3(L5, P1b);
  fespace WdD3(DTh6, P1dc); fespace WlD3(L6, P1dc);
  assert(WdS3.ndof == WlS3.ndof && WdD3.ndof == WlD3.ndof);
  WlS3 uS = 1 + x + 2*y + 3*z;
  WlD3 uD = 0;
  interpolateD(WdS3, uS[], WdD3, uD[]);
  WlD3 ref = 1 + x + 2*y + 3*z;
  real eLoc = 0;
  for (int i = 0; i < uD[].n; i++) eLoc = max(eLoc, abs(uD[][i] - ref[][i]));
  real eGlob = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [M P1b -> P1dc]        erreur Linf = " << eGlob
         << "   => " << (eGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-10);
}

// --- N : couverture en degre superieur ---------------------------------------
{
  fespace WdS4(DTh5, P1);  fespace WlS4(L5, P1);
  fespace WdD4(DTh6, P2);  fespace WlD4(L6, P2);
  WlS4 one = 1.0;
  WlD4 cov = 0;
  interpolateD(WdS4, one[], WdD4, cov[]);
  real cLoc = 0;
  for (int i = 0; i < cov[].n; i++) cLoc = max(cLoc, abs(cov[][i] - 1.0));
  real cGlob = 0;
  mpiAllReduce(cLoc, cGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [N P1 -> P2]  max|sum(chi) - 1| = " << cGlob
         << "   => " << (cGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(cGlob < 1e-10);
}
{
  fespace WdS5(DTh5, P2);  fespace WlS5(L5, P2);
  fespace WdD5(DTh6, P1);  fespace WlD5(L6, P1);
  WlS5 one = 1.0;
  WlD5 cov = 0;
  interpolateD(WdS5, one[], WdD5, cov[]);
  real cLoc = 0;
  for (int i = 0; i < cov[].n; i++) cLoc = max(cLoc, abs(cov[][i] - 1.0));
  real cGlob = 0;
  mpiAllReduce(cLoc, cGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [N P2 -> P1]  max|sum(chi) - 1| = " << cGlob
         << "   => " << (cGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(cGlob < 1e-10);
}
{
  fespace WdS6(DTh5, P2);  fespace WlS6(L5, P2);
  fespace WdD6(DTh6, P2);  fespace WlD6(L6, P2);
  WlS6 one = 1.0;
  WlD6 cov = 0;
  interpolateD(WdS6, one[], WdD6, cov[]);
  real cLoc = 0;
  for (int i = 0; i < cov[].n; i++) cLoc = max(cLoc, abs(cov[][i] - 1.0));
  real cGlob = 0;
  mpiAllReduce(cLoc, cGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [N P2 -> P2]  max|sum(chi) - 1| = " << cGlob
         << "   => " << (cGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(cGlob < 1e-10);
}

// --- O : overlap = 0 ----------------------------------------------------------
//  Ce bloc a servi a diagnostiquer puis a valider deux correctifs successifs.
//  Historique, car il documente ce que chaque assertion protege :
//
//   1. Avant renormalisation : min(cover) = 0.361 sur cette paire. Un DDL
//      destination sur une interface source n'etait localise par Find
//      (inside = 1) que dans une partie des fragments y portant un chi non
//      nul. Repare par dstU /= cover.
//   2. Restait 1 DDL sur 114 entierement manque -- cover = 0, aucun fragment
//      ne le contenait -- portant a lui seul l'erreur affine de 3.92. Cause :
//      le point etait exactement sur une face du maillage source, donc sur le
//      bord de TOUS les maillages locaux a recouvrement nul, et le repli
//      GenericDataFindBoundary de Find (GQuadTree.cpp:990-1020) n'y est pas
//      fiable. Repare en decoupant les fragments dans CoverMesh : la couche
//      supplementaire rend le point strictement interieur. Ses DDL portent
//      zero, chi y etant nul, donc somme_r chi_r(v) = 1 est preservee.
//
//  O1 verifie que la PoU elle-meme est saine a ov = 0 (elle l'a toujours ete).
//  O2 interdit le sur-comptage. O3 et O4 sont les temoins du correctif : ils
//  doivent rester a zero et a la precision machine.
{
  mesh3 L5z = DTh5z.local, L6z = DTh6z.local;
  fespace WdS7(DTh5z, P1);  fespace WlS7(L5z, P1);
  fespace WdD7(DTh6z, P1);  fespace WlD7(L6z, P1);

  // O1 : transfert de DTh5z vers lui-meme. Les DDL destination SONT les DDL
  // source, aucune interpolation n'intervient : on lit somme(chi) pure.
  WlS7 one = 1.0, self = 0;
  interpolateD(WdS7, one[], WdS7, self[]);
  real sLoc = 0;
  for (int i = 0; i < self[].n; i++) sLoc = max(sLoc, abs(self[][i] - 1.0));
  real sGlob = 0;
  mpiAllReduce(sLoc, sGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [O1 PoU a ov = 0]       max|somme(chi) - 1| = " << sGlob
         << "   => " << (sGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(sGlob < 1e-10);

  // O2 et O3 : couverture croisee Th5 -> Th6 a recouvrement nul.
  WlD7 cov = 0;
  interpolateD(WdS7, one[], WdD7, cov[]);
  real xLoc = 0;
  int missLoc = 0;
  for (int i = 0; i < cov[].n; i++) {
    xLoc = max(xLoc, cov[][i]);
    if (abs(cov[][i] - 1.0) > 1e-10) missLoc++;
  }
  real xGlob = 0;
  int missGlob = 0;
  mpiAllReduce(xLoc, xGlob, mpiCommWorld, mpiMAX);
  mpiAllReduce(missLoc, missGlob, mpiCommWorld, mpiSUM);

  if (mpirank == 0)
    cout << "  [O2 pas de sur-comptage] max(cov) = " << xGlob
         << "   => " << (xGlob < 1 + 1e-10 ? "PASS" : "FAIL") << endl;
  assert(xGlob < 1 + 1e-10);

  if (mpirank == 0)
    cout << "  [O3 couverture ov = 0]  DDL manques = " << missGlob << " / " << WdD7.ndof
         << "   => " << (missGlob == 0 ? "PASS" : "FAIL") << endl;
  assert(missGlob == 0);

  // O4 : le symptome d'origine. Avant correctif l'erreur valait 3.92, portee
  // par le seul DDL manque.
  WlS7 uS = 1 + x + 2*y + 3*z;
  WlD7 uD = 0;
  interpolateD(WdS7, uS[], WdD7, uD[]);
  WlD7 ref = 1 + x + 2*y + 3*z;
  real eLoc = 0;
  for (int i = 0; i < uD[].n; i++) eLoc = max(eLoc, abs(uD[][i] - ref[][i]));
  real eGlob = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [O4 affine a ov = 0]    erreur Linf = " << eGlob
         << "   => " << (eGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-10);
}

// =======================================================================
//  ETAPE 2 : chemin rapide "destination couverte localement"
// =======================================================================
//
//  Quand tout DDL destination local tombe dans le maillage source local, le
//  champ est entierement connu ici : aucune communication, et surtout NI
//  ponderation par chi NI renormalisation -- appliquer chi donnerait chi_r*u
//  au lieu de u, sans qu'aucun autre rang n'apporte le complement.
//
//  P.  Cas nominal. Ta = cube(10) et Tb = cube(20) sur le MEME domaine avec
//      les MEMES tranches : l'epaisseur de recouvrement vaut une maille, donc
//      h_dst = 1/20 < h_src = 1/10 et la tranche destination est strictement
//      incluse dans la tranche source. Le chemin rapide doit etre pris.
//      Mesure : x74 sur cette configuration (0.011 s contre 0.826 s).
//
//  Q.  Piege de l'etage 2. Les blocs M et N vont de DTh5 vers DTh6, tous deux
//      partitionnes par metis sur des domaines emboites : la boite d'un
//      sous-domaine metis de [0,1]^3 contient celle d'un sous-domaine de
//      [0.25,0.75]^3, donc l'ETAGE 1 PASSE et c'est l'etage 2 qui doit
//      rejeter. Verifie ici explicitement.
//
//  ATTENTION aux tolerances : contrairement au chemin mono-rang, le chemin
//  rapide n'est PAS numeriquement identique au chemin general -- il ne
//  renormalise pas. Mesure : 8.9e-15 contre 1.8e-15 sur le cas nominal. Les
//  deux sont a la precision machine, mais ne comparez jamais a l'egalite.

{
  mesh3 Ta = cube(ncnest, ncnest, ncnest);
  mesh3 Tb = cube(2*ncnest, 2*ncnest, 2*ncnest);
  int[int] pa(Ta.nt), pb(Tb.nt);
  SLABS(Ta, 0.0, pa)
  SLABS(Tb, 0.0, pb)
  Dmesh3 Da = distribute(Ta, overlap = ov, partition = pa);
  Dmesh3 Db = distribute(Tb, overlap = ov, partition = pb);
  mesh3 La = Da.local, Lb = Db.local;
  fespace Wda(Da, P1);  fespace Wla(La, P1);
  fespace Wdb(Db, P1);  fespace Wlb(Lb, P1);

  Wla uS = 1 + x + 2*y + 3*z;
  Wlb uD = 0;
  int pathAff = interpolateD(Wda, uS[], Wdb, uD[]);
  Wlb ref = 1 + x + 2*y + 3*z;
  real eLoc = 0;
  for (int i = 0; i < uD[].n; i++) eLoc = max(eLoc, abs(uD[][i] - ref[][i]));

  Wla one = 1.0;
  Wlb cov = 0;
  interpolateD(Wda, one[], Wdb, cov[]);
  real cLoc = 0;
  for (int i = 0; i < cov[].n; i++) cLoc = max(cLoc, abs(cov[][i] - 1.0));

  real eGlob = 0, cGlob = 0;
  int pMin = 0, pMax = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  mpiAllReduce(cLoc, cGlob, mpiCommWorld, mpiMAX);
  mpiAllReduce(pathAff, pMin, mpiCommWorld, mpiMIN);
  mpiAllReduce(pathAff, pMax, mpiCommWorld, mpiMAX);

  if (mpirank == 0)
    cout << "  [P emboite / valeurs]  affine = " << eGlob << "   couverture = " << cGlob
         << "   => " << (eGlob < 1e-10 && cGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-10);
  assert(cGlob < 1e-10);

  // Le chemin emprunte n'est observable que si interpolateD PROPAGE la valeur
  // rendue par interpolateDistributed. Tant qu'il renvoie 0L en dur, ce test
  // ne peut pas distinguer "chemin rapide pris" de "jamais pris", et les
  // assertions ci-dessus passeraient meme si l'optimisation etait morte.
  // A UN SEUL RANG le court-circuit de l'etape 1 s'applique AVANT celui de
  // l'etape 2, et c'est le bon ordre : il evite meme la matrice d'essai. Le
  // chemin attendu est donc 1 a np = 1, et 2 au dela.
  int pWant = (n == 1) ? 1 : 2;
  if (pMax > 0) {
    if (mpirank == 0)
      cout << "  [P emboite / chemin]   min = " << pMin << "  max = " << pMax
           << " (" << pWant << " attendu)   => "
           << (pMin == pWant && pMax == pWant ? "PASS" : "FAIL") << endl;
    assert(pMin == pWant && pMax == pWant);   // identique sur TOUS les rangs : sinon interblocage
  }
  else if (mpirank == 0)
    cout << "  [P emboite / chemin]   NON OBSERVABLE : interpolateD renvoie 0L en dur,"
         << " il doit propager interpolateDistributed" << endl;
}

// --- Q : l'etage 2 doit rejeter la paire metis emboitee -------------------
{
  fespace WdS(DTh5, P1);  fespace WlS(L5, P1);
  fespace WdD(DTh6, P1);  fespace WlD(L6, P1);
  WlS uS = 1 + x + 2*y + 3*z;
  WlD uD = 0;
  int pathQ = interpolateD(WdS, uS[], WdD, uD[]);
  WlD ref = 1 + x + 2*y + 3*z;
  real eLoc = 0;
  for (int i = 0; i < uD[].n; i++) eLoc = max(eLoc, abs(uD[][i] - ref[][i]));
  real eGlob = 0;
  int pMin = 0, pMax = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  mpiAllReduce(pathQ, pMin, mpiCommWorld, mpiMIN);
  mpiAllReduce(pathQ, pMax, mpiCommWorld, mpiMAX);

  // A np = 1 c'est le court-circuit mono-rang qui s'applique, pas le chemin
  // general : le rejet de l'etage 2 ne se mesure qu'a partir de deux rangs.
  int pWantQ = (n == 1) ? 1 : 0;
  if (mpirank == 0)
    cout << "  [Q metis emboite]      affine = " << eGlob
         << "   chemin = [" << pMin << ", " << pMax << "] (" << pWantQ << " attendu)"
         << "   => " << (eGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-10);
  if (pMax > 0 || pWantQ > 0) assert(pMin == pWantQ && pMax == pWantQ);
}

// --- E : la symetrie tient aussi sur partition metis ---------------------
{
  mesh3 Tm1 = cube(ncm, ncm, ncm);
  mesh3 Tm2 = cube(ncm, ncm, ncm, [0.5 + x, 0.5 + y, 0.5 + z]);
  Dmesh3 DM1 = distribute(Tm1, overlap = ov);
  Dmesh3 DM2 = distribute(Tm2, overlap = ov);

  int[int] sM(n*n), rM(n*n);
  PAIRMATRIX(DM1, DM2, sM, rM)

  int badSymM = 0;
  for (int a = 0; a < n; a++)
    for (int b = 0; b < n; b++)
      if (sM[a*n + b] != rM[b*n + a]) badSymM++;

  int totM = 0;
  for (int i = 0; i < n*n; i++) totM += sM[i];

  if (mpirank == 0)
    cout << "  [E metis / symetrie]   incoherences = " << badSymM
         << "   remplissage = " << totM << " / " << n*n
         << " (non asserte : depend du partitionneur)"
         << "   => " << (badSymM == 0 ? "PASS" : "FAIL") << endl;
  assert(badSymM == 0);
}

// =======================================================================
//  JALON 5 : plan de transfert reutilisable
// =======================================================================
//
//  transferPlan(Wsrc, Wdst) construit une fois les matrices d'interpolation,
//  la partition de l'unite, les cartes d'indices et la couverture ; les
//  applications suivantes ne font plus qu'un echange de vecteurs.
//
//  Le plan est PUREMENT GEOMETRIQUE : il ne depend pas du type scalaire
//  transfere. Un meme plan sert donc les transferts reels ET complexes,
//  ce que verifie le bloc T.
//
//   R.  Equivalence. interpolateD(P, u[], v[]) doit coincider avec
//       interpolateD(Wsrc, u[], Wdst, v[]). Tolerance et non egalite
//       binaire : les deux voies partagent le meme ordre d'accumulation
//       depuis le passage a Waitall, mais cover est accumule a la
//       construction sur la matrice de hachage et relu a l'application sur
//       la forme compactee triee -- l'ecart residuel vaut quelques ulp.
//   S.  Reutilisation. Trois applications successives du meme plan doivent
//       rendre exactement ce que rendent trois transferts sans plan. C'est
//       ce qui verifie qu'aucun etat residuel ne traine : dstU = 0 en tete
//       d'application et cover NON reaccumule sont les deux points ou cela
//       peut casser.
//   T.  Complexe. Jusqu'ici la surcharge interpolateD<Mesh,Complex> n'etait
//       qu'instanciee par le compilateur, jamais executee. Un plan bati une
//       fois sert ici un champ reel puis un champ complexe.
//   U.  Chemins rapides. path doit etre conserve dans le plan et respecte a
//       l'application. Sur XFER_LOCAL ni chi ni renormalisation : si
//       l'application les appliquait quand meme, l'erreur serait d'ordre
//       1 - chi, donc massive et immediatement visible.
//   V.  Plan perime. Appliquer un plan a des vecteurs de mauvaise taille
//       doit lever une erreur explicite, pas produire un resultat faux.

// --- R : equivalence plan / sans plan --------------------------------------
{
  fespace WrS(DTh1, P1);
  fespace WrD(DTh4, P1);
  Dtransfer3 P = transferPlan(WrS, WrD);

  V1 uS = 1 + x + 2*y + 3*z;
  V4 vDirect = 0, vPlan = 0;
  int pDir = interpolateD(WrS, uS[], WrD, vDirect[]);
  int pPln = interpolateD(P, uS[], vPlan[]);

  real eLoc = 0;
  for (int i = 0; i < vDirect[].n; i++)
    eLoc = max(eLoc, abs(vDirect[][i] - vPlan[][i]));
  real eGlob = 0;
  int pdG = 0, ppG = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  mpiAllReduce(pDir, pdG, mpiCommWorld, mpiMAX);
  mpiAllReduce(pPln, ppG, mpiCommWorld, mpiMAX);

  if (mpirank == 0)
    cout << "  [R1 P1 -> P1]          ecart = " << eGlob
         << "   chemins = " << pdG << "/" << ppG
         << "   => " << (eGlob < 1e-12 && pdG == ppG ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-12 && pdG == ppG);
}

{
  fespace WrS(DTh5, P2);  fespace WlrS(L5, P2);
  fespace WrD(DTh6, P1);  fespace WlrD(L6, P1);
  Dtransfer3 P = transferPlan(WrS, WrD);

  WlrS uS = 1 + x + 2*y + 3*z;
  WlrD vDirect = 0, vPlan = 0;
  interpolateD(WrS, uS[], WrD, vDirect[]);
  interpolateD(P, uS[], vPlan[]);

  real eLoc = 0;
  for (int i = 0; i < vDirect[].n; i++)
    eLoc = max(eLoc, abs(vDirect[][i] - vPlan[][i]));
  real eGlob = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [R2 P2 -> P1]          ecart = " << eGlob
         << "   => " << (eGlob < 1e-12 ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-12);
}

{
  fespace WrS(DTh5, P1);  fespace WlrS(L5, P1);
  fespace WrD(DTh6, P2);  fespace WlrD(L6, P2);
  Dtransfer3 P = transferPlan(WrS, WrD);

  WlrS uS = 1 + x + 2*y + 3*z;
  WlrD vDirect = 0, vPlan = 0;
  interpolateD(WrS, uS[], WrD, vDirect[]);
  interpolateD(P, uS[], vPlan[]);

  real eLoc = 0;
  for (int i = 0; i < vDirect[].n; i++)
    eLoc = max(eLoc, abs(vDirect[][i] - vPlan[][i]));
  real eGlob = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [R3 P1 -> P2]          ecart = " << eGlob
         << "   => " << (eGlob < 1e-12 ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-12);
}

{
  fespace WrS(DTh5, P2);  fespace WlrS(L5, P2);
  fespace WrD(DTh6, P2);  fespace WlrD(L6, P2);
  Dtransfer3 P = transferPlan(WrS, WrD);

  // u = 1 : le plan doit reproduire la couverture exacte du bloc N.
  WlrS one = 1.0;
  WlrD vDirect = 0, vPlan = 0;
  interpolateD(WrS, one[], WrD, vDirect[]);
  interpolateD(P, one[], vPlan[]);

  real eLoc = 0, cLoc = 0;
  for (int i = 0; i < vDirect[].n; i++) {
    eLoc = max(eLoc, abs(vDirect[][i] - vPlan[][i]));
    cLoc = max(cLoc, abs(vPlan[][i] - 1.0));
  }
  real eGlob = 0, cGlob = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  mpiAllReduce(cLoc, cGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [R4 P2 -> P2, u = 1]   ecart = " << eGlob
         << "   |plan - 1| = " << cGlob
         << "   => " << (eGlob < 1e-12 && cGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-12 && cGlob < 1e-10);
}

// --- S : reutilisation, trois champs successifs ----------------------------
{
  fespace WsS(DTh5, P2);  fespace WlsS(L5, P2);
  fespace WsD(DTh6, P1);  fespace WlsD(L6, P1);
  Dtransfer3 P = transferPlan(WsS, WsD);

  real eMax = 0;
  for (int k = 1; k <= 3; k++) {
    WlsS uk = k + k*x + 2*y + 3*z;
    WlsD a = 0, b = 0;
    interpolateD(WsS, uk[], WsD, a[]);
    interpolateD(P, uk[], b[]);
    for (int i = 0; i < a[].n; i++) eMax = max(eMax, abs(a[][i] - b[][i]));
  }
  real eGlob = 0;
  mpiAllReduce(eMax, eGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [S reutilisation x3]   ecart max = " << eGlob
         << "   => " << (eGlob < 1e-12 ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-12);
}

// --- T : le MEME plan sert le reel et le complexe --------------------------
{
  fespace WtS(DTh5, P1);  fespace WltS(L5, P1);
  fespace WtD(DTh6, P1);  fespace WltD(L6, P1);
  Dtransfer3 P = transferPlan(WtS, WtD);

  // d'abord un champ reel, pour que le plan ait deja servi
  WltS uR = 1 + x + 2*y + 3*z;
  WltD vR = 0;
  interpolateD(P, uR[], vR[]);
  WltD refR = 1 + x + 2*y + 3*z;
  real eR = 0;
  for (int i = 0; i < vR[].n; i++) eR = max(eR, abs(vR[][i] - refR[][i]));

  // puis un champ complexe, AVEC LE MEME PLAN
  WltS<complex> uC = 1 + 1i;
  WltD<complex> vC = 0;
  interpolateD(P, uC[], vC[]);
  real eC = 0;
  for (int i = 0; i < vC[].n; i++) eC = max(eC, abs(vC[][i] - (1 + 1i)));

  // et un champ complexe non constant, pour ne pas tester qu'une constante
  WltS<complex> uC2 = (1 + x) + 2i*y;
  WltD<complex> vC2 = 0;
  interpolateD(P, uC2[], vC2[]);
  WltD<complex> refC2 = (1 + x) + 2i*y;
  real eC2 = 0;
  for (int i = 0; i < vC2[].n; i++) eC2 = max(eC2, abs(vC2[][i] - refC2[][i]));

  real eRG = 0, eCG = 0, eC2G = 0;
  mpiAllReduce(eR, eRG, mpiCommWorld, mpiMAX);
  mpiAllReduce(eC, eCG, mpiCommWorld, mpiMAX);
  mpiAllReduce(eC2, eC2G, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [T reel puis complexe] reel = " << eRG << "   1+i = " << eCG
         << "   (1+x)+2iy = " << eC2G
         << "   => " << (eRG < 1e-10 && eCG < 1e-10 && eC2G < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(eRG < 1e-10 && eCG < 1e-10 && eC2G < 1e-10);
}

// --- U : les chemins rapides survivent au plan -----------------------------
//  U1 reprend la paire emboitee du bloc P : le plan doit memoriser
//  XFER_LOCAL et le rejouer SANS chi ni renormalisation.
{
  mesh3 Ua = cube(ncnest, ncnest, ncnest);
  mesh3 Ub = cube(2*ncnest, 2*ncnest, 2*ncnest);
  int[int] qa(Ua.nt), qb(Ub.nt);
  SLABS(Ua, 0.0, qa)
  SLABS(Ub, 0.0, qb)
  Dmesh3 DUa = distribute(Ua, overlap = ov, partition = qa);
  Dmesh3 DUb = distribute(Ub, overlap = ov, partition = qb);
  mesh3 LUa = DUa.local, LUb = DUb.local;
  fespace WuS(DUa, P1);  fespace WluS(LUa, P1);
  fespace WuD(DUb, P1);  fespace WluD(LUb, P1);

  Dtransfer3 P = transferPlan(WuS, WuD);

  WluS uS = 1 + x + 2*y + 3*z;
  WluD vDirect = 0, vPlan = 0;
  int pDir = interpolateD(WuS, uS[], WuD, vDirect[]);
  int pPln = interpolateD(P, uS[], vPlan[]);

  WluD ref = 1 + x + 2*y + 3*z;
  real eLoc = 0, dLoc = 0;
  for (int i = 0; i < vPlan[].n; i++) {
    eLoc = max(eLoc, abs(vPlan[][i] - ref[][i]));
    dLoc = max(dLoc, abs(vPlan[][i] - vDirect[][i]));
  }
  real eGlob = 0, dGlob = 0;
  int pdMin = 0, pdMax = 0, ppMin = 0, ppMax = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  mpiAllReduce(dLoc, dGlob, mpiCommWorld, mpiMAX);
  mpiAllReduce(pDir, pdMin, mpiCommWorld, mpiMIN);
  mpiAllReduce(pDir, pdMax, mpiCommWorld, mpiMAX);
  mpiAllReduce(pPln, ppMin, mpiCommWorld, mpiMIN);
  mpiAllReduce(pPln, ppMax, mpiCommWorld, mpiMAX);

  // 1 a un seul rang (court-circuit mono-rang), 2 au dela (emboite).
  int pWant = (n == 1) ? 1 : 2;
  if (mpirank == 0)
    cout << "  [U1 emboite / plan]    affine = " << eGlob << "   ecart = " << dGlob
         << "   chemins = [" << pdMin << "," << pdMax << "]/["
         << ppMin << "," << ppMax << "] (" << pWant << " attendu)"
         << "   => " << (eGlob < 1e-10 && dGlob < 1e-12
                         && ppMin == pWant && ppMax == pWant ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-10 && dGlob < 1e-12);
  assert(ppMin == pWant && ppMax == pWant);   // identique sur TOUS les rangs
  assert(pdMin == ppMin && pdMax == ppMax);   // le plan emprunte le meme chemin
}

//  U2 reprend le piege du bloc Q : boites emboitees mais couverture
//  incomplete. Le plan doit memoriser le REJET de l'etage 2.
{
  fespace WqS(DTh5, P1);  fespace WlqS(L5, P1);
  fespace WqD(DTh6, P1);  fespace WlqD(L6, P1);
  Dtransfer3 P = transferPlan(WqS, WqD);

  WlqS uS = 1 + x + 2*y + 3*z;
  WlqD vPlan = 0;
  int pPln = interpolateD(P, uS[], vPlan[]);
  WlqD ref = 1 + x + 2*y + 3*z;
  real eLoc = 0;
  for (int i = 0; i < vPlan[].n; i++) eLoc = max(eLoc, abs(vPlan[][i] - ref[][i]));

  real eGlob = 0;
  int ppMin = 0, ppMax = 0;
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  mpiAllReduce(pPln, ppMin, mpiCommWorld, mpiMIN);
  mpiAllReduce(pPln, ppMax, mpiCommWorld, mpiMAX);

  int pWantQ = (n == 1) ? 1 : 0;
  if (mpirank == 0)
    cout << "  [U2 metis / plan]      affine = " << eGlob
         << "   chemin = [" << ppMin << ", " << ppMax << "] (" << pWantQ << " attendu)"
         << "   => " << (eGlob < 1e-10 && ppMin == pWantQ && ppMax == pWantQ
                         ? "PASS" : "FAIL") << endl;
  assert(eGlob < 1e-10);
  assert(ppMin == pWantQ && ppMax == pWantQ);
}

// --- V : un plan perime doit se plaindre, pas mentir -----------------------
//  Le plan ne peut pas savoir qu'un maillage a ete refait ; il compare donc
//  les tailles memorisees a celles des vecteurs recus. Un remaillage produit
//  un nouvel objet fespace, donc une taille differente, donc l'assertion
//  mord. C'est le prix d'un objet explicite -- et c'est bien moins risque
//  qu'un cache implicite qui devinerait l'invalidation.
{
  fespace WvS(DTh5, P1);  fespace WlvS(L5, P1);
  fespace WvD(DTh6, P1);  fespace WlvD(L6, P1);
  fespace WvS2(DTh5, P2); fespace WlvS2(L5, P2);
  Dtransfer3 P = transferPlan(WvS, WvD);

  // le plan attend du P1 en source ; on lui donne du P2
  WlvS2 uBad = 1;
  WlvD vBad = 0;
  int caught = 0;
  try { interpolateD(P, uBad[], vBad[]); }
  catch(...) { caught = 1; }

  // et le plan doit rester utilisable apres l'erreur
  WlvS uOk = 1 + x + 2*y + 3*z;
  WlvD vOk = 0;
  interpolateD(P, uOk[], vOk[]);
  WlvD refOk = 1 + x + 2*y + 3*z;
  real eLoc = 0;
  for (int i = 0; i < vOk[].n; i++) eLoc = max(eLoc, abs(vOk[][i] - refOk[][i]));

  int cGlob = 0;
  real eGlob = 0;
  mpiAllReduce(caught, cGlob, mpiCommWorld, mpiMIN);   // MIN : exige TOUS les rangs
  mpiAllReduce(eLoc, eGlob, mpiCommWorld, mpiMAX);
  if (mpirank == 0)
    cout << "  [V plan perime]        detecte sur tous les rangs = " << cGlob
         << "   plan encore valide, erreur = " << eGlob
         << "   => " << (cGlob == 1 && eGlob < 1e-10 ? "PASS" : "FAIL") << endl;
  assert(cGlob == 1);
  assert(eGlob < 1e-10);
}
// =======================================================================
//  JALON 6 : la numerotation globale native coincide-t-elle avec PETSc ?
// =======================================================================
//
//  Prerequis a MatInterpolate. Assembler l'operateur de transfert en une
//  matrice PETSc exige de nommer ses COLONNES par des indices globaux de
//  l'espace source. Deux numerotations existent :
//
//    Wdh.numbering        distributedDofNumbering (distributeMesh.cpp)
//    GlobalNumbering(A,.) le _num interne du Mat, construit par HPDDM
//
//  Les deux partent des memes donnees -- dofIntersectionDof et Ddof, que
//  buildShellIfNeeded transmet a HPDDM -- et appliquent la meme regle de
//  propriete : seuil EPS sur Ddof, departage par rang. Mais ce sont deux
//  implementations distinctes, et rien ne GARANTIT qu'elles produisent les
//  memes entiers.
//
//  L'enjeu est direct : si elles coincident, MatInterpolate peut se servir
//  de Wdh.numbering et rester autonome ; sinon la numerotation doit devenir
//  un argument, fourni par GlobalNumbering sur un Mat deja construit.
//
//  PETSc/HPDDM refuse overlap = 0 (format Schwarz additif), d'ou ovMat.

{
  int ovMat = (ov == 0) ? 1 : ov;
  mesh3 Tw = cube(8, 8, 8);

  int[int] pw(Tw.nt);
  SLABS(Tw, 0.0, pw)
  Dmesh3 DwSlab = distribute(Tw, overlap = ovMat, partition = pw);
  Dmesh3 DwMetis = distribute(Tw, overlap = ovMat);

  int badTot = 0;

  macro CHECKNUM(Dw, Pk, tag)
  {
    fespace Ww(Dw, Pk);
    varf vw(u, v) = int3d(Dw)(dx(u)*dx(v) + dy(u)*dy(v) + dz(u)*dz(v)) + on(1, u = 0.0);
    Mat Aw = vw(Ww, Ww);
    int[int] numPetsc;
    GlobalNumbering(Aw, numPetsc);
    int[int] numNatif = Ww.numbering;

    int szLoc = (numPetsc.n != numNatif.n) ? 1 : 0;
    int badLoc = 0, nmin = min(numPetsc.n, numNatif.n);
    for (int i = 0; i < nmin; i++) if (numPetsc[i] != numNatif[i]) badLoc++;
    int hiP = numPetsc.max, hiN = numNatif.max;

    int szG = 0, badG = 0, hiPG = 0, hiNG = 0;
    mpiAllReduce(szLoc, szG, mpiCommWorld, mpiSUM);
    mpiAllReduce(badLoc, badG, mpiCommWorld, mpiSUM);
    mpiAllReduce(hiP, hiPG, mpiCommWorld, mpiMAX);
    mpiAllReduce(hiN, hiNG, mpiCommWorld, mpiMAX);
    badTot = badTot + badG + szG + abs(hiPG - hiNG);

    if (mpirank == 0)
      cout << "  [W " << tag << "]  ndofglobal " << Ww.ndofglobal
           << "   max petsc/natif " << hiPG << "/" << hiNG
           << "   ecarts " << badG << "   tailles " << szG
           << "   => " << (badG == 0 && szG == 0 && hiPG == hiNG ? "PASS" : "FAIL") << endl;
  }// EOM

  CHECKNUM(DwSlab,  P1, "tranches P1")
  CHECKNUM(DwSlab,  P2, "tranches P2")
  CHECKNUM(DwMetis, P1, "metis    P1")
  CHECKNUM(DwMetis, P2, "metis    P2")

  if (mpirank == 0)
    cout << "  [W verdict]            " << (badTot == 0
         ? "les deux numerotations COINCIDENT : Wdh.numbering utilisable tel quel"
         : "elles DIFFERENT : la numerotation devra etre un argument") << endl;
  assert(badTot == 0);
}

// =======================================================================
//  JALON 7 : transport brut sur le plan (exchangeRawOnPlan)
// =======================================================================
//
//  Premiere brique de MatInterpolate. Pour nommer les COLONNES de la matrice
//  assemblee, le recepteur doit connaitre l'indice global source de chaque
//  DDL des fragments qu'il a recus. Or cette information vit chez
//  l'EMETTEUR : la chaine est
//
//    c  --inj_j-->  DDL local de srcVh  --numbering-->  indice global
//
//  et les deux fleches sont chez celui qui envoie. Il faut donc la
//  transporter, par un gather/scatter PUR -- jamais a travers une matrice
//  d'interpolation, qui melangerait des indices distincts et rendrait du
//  bruit.
//
//  exchangeRawOnPlan reutilise le tuyau du plan sans ponderation par chi ni
//  renormalisation. Son seul parametre propre est fillHoles : la valeur
//  donnee aux DDL de fragment sans image source. Pour une VALEUR, zero
//  convient ; pour un INDICE, zero est un indice legitime -- celui du
//  premier DDL possede par le rang 0 -- et confondre "pas d'image" avec
//  "DDL global n0" rattacherait des coefficients a la mauvaise colonne,
//  silencieusement. D'ou -1.
//
//  probeRawTransfer rend, pour l'ensemble des fragments recus :
//    [0] nombre total de DDL de fragment
//    [1] nombre de trous (valeur -1)
//    [3] min des indices non-trous     [4] max des indices non-trous
//  et retourne le chemin emprunte par le plan.
//
//   X1.  Transport de la numerotation. Les indices recus doivent tous
//        tomber dans [0, ndofglobal). C'est la condition necessaire pour
//        que l'assemblage les utilise comme colonnes.
//   X2.  Transport d'une CONSTANTE. Le test le plus fort : si le
//        gather/scatter est fidele, toutes les valeurs non-trous valent
//        exactement la constante, donc min == max == K. Un decalage
//        d'indice, une troncature ou un ecrasement des trous se voient
//        immediatement.
//   X3.  Transport du rang emetteur. Chaque fragment porte le rang qui l'a
//        produit ; les valeurs recues doivent donc tomber dans [0, np).
//   X4.  Invariance geometrique. Le nombre de DDL transportes et le nombre
//        de trous ne dependent PAS des valeurs transportees. Les trois
//        transports doivent donner les memes comptes.
//
//  A un seul rang le plan emprunte XFER_SINGLE_RANK : il n'y a aucun
//  fragment, donc rien a transporter, et la sonde se contente de rendre le
//  chemin. Le bloc est alors sans objet.

{
  fespace WxS(DTh5, P1);  fespace WlxS(L5, P1);
  fespace WxD(DTh6, P1);
  Dtransfer3 Px = transferPlan(WxS, WxD);

  int[int] numSrc = WxS.numbering;
  int ndofG = WxS.ndofglobal;

  int[int] rA(5), rB(5), rC(5);
  int pathA = probeRawTransfer(Px, numSrc, rA);

  if (pathA != 0) {
    if (mpirank == 0)
      cout << "  [X transport brut]     SANS OBJET (chemin " << pathA
           << " : aucun fragment echange)" << endl;
  }
  else {
    /* X2 : une constante, pour prouver la fidelite du gather/scatter */
    int[int] konst(numSrc.n);
    konst = 42;
    probeRawTransfer(Px, konst, rB);

    /* X3 : le rang emetteur */
    int[int] whoami(numSrc.n);
    whoami = mpirank;
    probeRawTransfer(Px, whoami, rC);

    /* reductions : les comptes se somment, les extrema se reduisent */
    int totG = 0, holG = 0, holBG = 0, holCG = 0, totBG = 0, totCG = 0;
    int loAG = 0, hiAG = 0, loBG = 0, hiBG = 0, loCG = 0, hiCG = 0;
    mpiAllReduce(rA[0], totG,  mpiCommWorld, mpiSUM);
    mpiAllReduce(rA[1], holG,  mpiCommWorld, mpiSUM);
    mpiAllReduce(rB[0], totBG, mpiCommWorld, mpiSUM);
    mpiAllReduce(rB[1], holBG, mpiCommWorld, mpiSUM);
    mpiAllReduce(rC[0], totCG, mpiCommWorld, mpiSUM);
    mpiAllReduce(rC[1], holCG, mpiCommWorld, mpiSUM);
    mpiAllReduce(rA[3], loAG, mpiCommWorld, mpiMIN);
    mpiAllReduce(rA[4], hiAG, mpiCommWorld, mpiMAX);
    mpiAllReduce(rB[3], loBG, mpiCommWorld, mpiMIN);
    mpiAllReduce(rB[4], hiBG, mpiCommWorld, mpiMAX);
    mpiAllReduce(rC[3], loCG, mpiCommWorld, mpiMIN);
    mpiAllReduce(rC[4], hiCG, mpiCommWorld, mpiMAX);

    int valides = totG - holG;

    /* X1 : indices globaux dans les bornes */
    int okA = (valides > 0 && loAG >= 0 && hiAG < ndofG) ? 1 : 0;
    if (mpirank == 0)
      cout << "  [X1 numerotation]      " << valides << " indices dans ["
           << loAG << ", " << hiAG << "]   borne " << ndofG
           << "   => " << (okA ? "PASS" : "FAIL") << endl;
    assert(okA);

    /* X2 : fidelite du transport */
    int okB = (loBG == 42 && hiBG == 42) ? 1 : 0;
    if (mpirank == 0)
      cout << "  [X2 constante 42]      recu [" << loBG << ", " << hiBG << "]"
           << "   => " << (okB ? "PASS" : "FAIL") << endl;
    assert(okB);

    /* X3 : le rang emetteur voyage correctement */
    int okC = (loCG >= 0 && hiCG < n) ? 1 : 0;
    if (mpirank == 0)
      cout << "  [X3 rang emetteur]     recu [" << loCG << ", " << hiCG
           << "]   borne " << n
           << "   => " << (okC ? "PASS" : "FAIL") << endl;
    assert(okC);

    /* X4 : les comptes ne dependent pas des valeurs */
    int okD = (totG == totBG && totG == totCG
               && holG == holBG && holG == holCG) ? 1 : 0;
    if (mpirank == 0)
      cout << "  [X4 invariance]        DDL " << totG << "/" << totBG << "/" << totCG
           << "   trous " << holG << "/" << holBG << "/" << holCG
           << "   => " << (okD ? "PASS" : "FAIL") << endl;
    assert(okD);

    if (mpirank == 0)
      cout << "  [X bilan]              " << totG << " DDL transportes, dont "
           << holG << " sans image source ("
           << (totG > 0 ? 100.0*holG/totG : 0.0) << " %)" << endl;
  }
}

// =======================================================================
//  JALON 8 : l'operateur assemble agit-il comme le transfert ?
// =======================================================================
//
//  interpolateMat rend la matrice locale de l'operateur de transfert :
//    lignes   = DDL destination locaux
//    colonnes = indices globaux source, compactes en 0..m-1
//    colNum[k] = indice global de la colonne k
//
//  Le test qui compte est  loc * u_global == interpolateD(Plan, u, .)  et
//  il est FORT : les deux chemins de calcul sont entierement disjoints.
//  interpolateD accumule a la volee, fragment par fragment, en ponderant
//  par chi puis en renormalisant ; loc a subi tri, fusion des doublons,
//  renormalisation et compression des colonnes. Rien n'est partage sinon
//  les matrices P.M[j] et le plan lui-meme.
//
//  Deliberement SANS PETSc : le raccord viendra apres. Trois defauts sur
//  quatre -- transport fausse, doublons non fusionnes, renormalisation mal
//  placee -- se voient ici, et les diagnostiquer a travers PETSc couterait
//  dix fois plus cher.
//
//  Pour appliquer loc il faut u en numerotation GLOBALE. On rassemble par
//  somme puis division par le nombre de rangs contributeurs : un DDL
//  partage porte la meme valeur partout, donc la moyenne le restitue. Cette
//  reduction sur ndofglobal est grossiere -- c'est un test, pas de la
//  production.
//
//   Y1.  Chemin general, P1 -> P1, champ affine.
//   Y2.  Chemin general, degres croises P2 -> P1.
//   Y3.  Chemin emboite (XFER_LOCAL) : ni chi ni renormalisation. Si
//        l'assemblage les appliquait, l'ecart serait d'ordre 1 - chi.
//   Y4.  Champ NON polynomial. Un champ affine est reproduit exactement par
//        les deux voies, ce qui pourrait masquer un operateur faux mais
//        exact sur les affines ; un champ oscillant ne pardonne pas.

macro CHECKASM(WyS, WlyS, WyD, WlyD, Plan, expr, tag)
{
  int[int] numS = WyS.numbering;
  matrix loc;  real[int] colNum;
  int pth = interpolateMat(Plan, numS, loc, colNum);

  WlyS uS = expr;

  /* rassemblement en numerotation globale */
  int ng = WyS.ndofglobal;
  real[int] acc(ng), cnt(ng);
  acc = 0.0;  cnt = 0.0;
  for (int d = 0; d < uS[].n; d++) {
    acc[numS[d]] = acc[numS[d]] + uS[][d];
    cnt[numS[d]] = cnt[numS[d]] + 1.0;
  }
  real[int] accG(ng), cntG(ng);
  mpiAllReduce(acc, accG, mpiCommWorld, mpiSUM);
  mpiAllReduce(cnt, cntG, mpiCommWorld, mpiSUM);
  for (int g = 0; g < ng; g++) { if (cntG[g] > 0.0) accG[g] = accG[g] / cntG[g]; }

  /* la matrice appliquee au vecteur restreint a ses colonnes */
  real[int] uCol(colNum.n);
  for (int k = 0; k < colNum.n; k++) uCol[k] = accG[colNum[k]];
  real[int] vMat = loc * uCol;

  /* le transfert, par le chemin habituel */
  WlyD vRef = 0;
  interpolateD(Plan, uS[], vRef[]);

  real e = 0, nrm = 0;
  for (int i = 0; i < vMat.n; i++) {
    e = max(e, abs(vMat[i] - vRef[][i]));
    nrm = max(nrm, abs(vRef[][i]));
  }
  real eG = 0, nrmG = 0;
  int pMin = 0, pMax = 0;
  mpiAllReduce(e, eG, mpiCommWorld, mpiMAX);
  mpiAllReduce(nrm, nrmG, mpiCommWorld, mpiMAX);
  mpiAllReduce(pth, pMin, mpiCommWorld, mpiMIN);
  mpiAllReduce(pth, pMax, mpiCommWorld, mpiMAX);

  if (mpirank == 0)
    cout << "  [" << tag << "]  chemin " << pMin << "   |v| = " << nrmG
         << "   ecart = " << eG
         << "   => " << (eG < 1e-12 && pMin == pMax ? "PASS" : "FAIL") << endl;
  assert(eG < 1e-12);
  assert(pMin == pMax);
}// EOM

/* --- Y1, Y2, Y4 : chemin general sur la paire DTh5 -> DTh6 ------------- */
{
  fespace WyS(DTh5, P1);  fespace WlyS(L5, P1);
  fespace WyD(DTh6, P1);  fespace WlyD(L6, P1);
  Dtransfer3 Py = transferPlan(WyS, WyD);
  CHECKASM(WyS, WlyS, WyD, WlyD, Py, 1 + x + 2*y + 3*z, "Y1 P1 -> P1 affine ")
  CHECKASM(WyS, WlyS, WyD, WlyD, Py, sin(3*pi*x)*cos(2*pi*y) + z*z, "Y4 P1 -> P1 oscill.")
}

{
  fespace WyS(DTh5, P2);  fespace WlyS(L5, P2);
  fespace WyD(DTh6, P1);  fespace WlyD(L6, P1);
  Dtransfer3 Py = transferPlan(WyS, WyD);
  CHECKASM(WyS, WlyS, WyD, WlyD, Py, 1 + x + 2*y + 3*z, "Y2 P2 -> P1 croise ")
}

/* --- Y3 : chemin emboite, ni chi ni renormalisation -------------------- */
{
  mesh3 Ya = cube(ncnest, ncnest, ncnest);
  mesh3 Yb = cube(2*ncnest, 2*ncnest, 2*ncnest);
  int[int] ya(Ya.nt), yb(Yb.nt);
  SLABS(Ya, 0.0, ya)
  SLABS(Yb, 0.0, yb)
  Dmesh3 DYa = distribute(Ya, overlap = ov, partition = ya);
  Dmesh3 DYb = distribute(Yb, overlap = ov, partition = yb);
  mesh3 LYa = DYa.local, LYb = DYb.local;
  fespace WyS(DYa, P1);  fespace WlyS(LYa, P1);
  fespace WyD(DYb, P1);  fespace WlyD(LYb, P1);
  Dtransfer3 Py = transferPlan(WyS, WyD);
  CHECKASM(WyS, WlyS, WyD, WlyD, Py, sin(3*pi*x)*cos(2*pi*y) + z*z, "Y3 emboite oscill. ")
}

// =======================================================================
//  JALON 9 : l'operateur assemble en Mat PETSc
// =======================================================================
//
//  Aboutissement de MatInterpolate. Le jalon 8 validait l'assemblage EN
//  LOCAL, matrice appliquee a la main ; ici on la confie a PETSc.
//
//  L'ESPACE COLONNE. C'est le point qui a coute le plus cher a comprendre.
//  PETSc convertit le vecteur d'entree via ptA->_cnum, copie de la
//  numerotation du Mat SOURCE sur nSrcDof entrees (PETSc-code.hpp:4262-4265),
//  et le produit lit _exchange[1]->getDof() == nSrcDof valeurs. Pour que la
//  matrice et cette conversion designent les memes colonnes, le PREFIXE de
//  colGlobal doit reproduire srcNumbering A L'IDENTIQUE -- meme ordre, meme
//  contenu, DDL locaux non touches compris. Les colonnes venues d'autres
//  rangs viennent APRES ; PETSc les recupere par son propre VecScatter.
//
//  Une version anterieure compressait et TRIAIT les colonnes. Cela marchait
//  par accident quand toutes les colonnes locales se trouvaient touchees et
//  la numerotation croissante -- a np = 2 oui, a np = 4 non. Symptome : 45 a
//  80 % des DDL destination a zero, sans aucune assertion.
//
//  C'est aussi ce qui aligne l'implementation sur macro_ddm, dont l'espace
//  colonne est VhExchange, l'espace EF du maillage recolle : meme convention
//  d'interface avec PETSc, par une construction differente.
//
//  CONTRAT : le srcNumbering passe a interpolateMat doit etre celui du Mat
//  fourni en 3e argument de constructor. Rien ne le verifie.
//
//  ORDRE DES ARGUMENTS : constructor(P, MD, MS, loc, numbering = col)
//  args[1] = lignes = DESTINATION, args[2] = colonnes = SOURCE. Inverser
//  donnerait la transposee sans rien signaler.
//
//  PETSc/HPDDM refuse overlap = 0 (PETSc-code.hpp:405-408), d'ou ovz.
//
//   Z1.  Pmat * u contre interpolateD, chemin general.
//   Z2.  Conservation : Pmat * 1.
//   Z3.  Chemin emboite (XFER_LOCAL) : ni chi ni renormalisation.
//   Z4.  Degres croises P2 -> P1.
//   Z5.  Adjonction <Pu,w> == <u,P'w>. La transposee n'a aucun sens pour un
//        transfert a la volee : c'est ce que la materialisation apporte.
//   Z6.  Maillages disjoints : matrice entierement vide, Pmat * u == 0,
//        exactement comme interpolateD.

macro MATCHECK(mcDS, mcDD, mcLS, mcLD, mckS, mckD, mcTag)
{
  fespace McS(mcDS, mckS);   fespace MclS(mcLS, mckS);
  fespace McD(mcDD, mckD);   fespace MclD(mcLD, mckD);
  varf mcvs(u, v) = int3d(mcDS)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v)) + on(1, u=0.0);
  varf mcvd(u, v) = int3d(mcDD)(dx(u)*dx(v)+dy(u)*dy(v)+dz(u)*dz(v)) + on(1, u=0.0);
  Mat McMS = mcvs(McS, McS);
  Mat McMD = mcvd(McD, McD);

  Dtransfer3 McP = transferPlan(McS, McD);
  int[int] mcnum;   GlobalNumbering(McMS, mcnum);
  matrix mcloc;     real[int] mccol;
  int mcpath = interpolateMat(McP, mcnum, mcloc, mccol);

  /* le prefixe de mccol doit reproduire mcnum a l'identique */
  int mcpref = 1;
  for (int k = 0; k < mcnum.n; k++) { if (mccol[k] != mcnum[k]) mcpref = 0; }

  Mat McPn;
  constructor(McPn, McMD, McMS, mcloc, numbering = mccol);

  /* Z1 : Pmat * u == interpolateD */
  MclS mcu = 1 + x + 2*y + 3*z + sin(3*pi*x)*cos(2*pi*y);
  MclD mcref = 0;
  interpolateD(McP, mcu[], mcref[]);
  real[int] mcv = McPn * mcu[];
  real mce = 0;
  for (int i = 0; i < mcv.n; i++) mce = max(mce, abs(mcv[i] - mcref[][i]));

  /* Z2 : conservation */
  MclS mcone = 1.0;
  MclD mccref = 0;
  interpolateD(McP, mcone[], mccref[]);
  real[int] mcc1 = McPn * mcone[];
  real mcec = 0;
  for (int i = 0; i < mcc1.n; i++) mcec = max(mcec, abs(mcc1[i] - mccref[][i]));

  /* Z5 : adjonction, produits scalaires en numerotation PETSc */
  MclD mcw = cos(2*pi*x)*sin(3*pi*z);
  real[int] mcPtw = McPn' * mcw[];
  real[int] mcvG, mcwG, mctG, mcuG;
  ChangeNumbering(McMD, mcv,    mcvG);
  ChangeNumbering(McMD, mcw[],  mcwG);
  ChangeNumbering(McMS, mcPtw,  mctG);
  ChangeNumbering(McMS, mcu[],  mcuG);
  real mclhsL = 0, mcrhsL = 0;
  for (int i = 0; i < mcvG.n; i++) mclhsL += mcvG[i]*mcwG[i];
  for (int i = 0; i < mctG.n; i++) mcrhsL += mctG[i]*mcuG[i];

  real mceG=0, mcecG=0, mclhs=0, mcrhs=0;
  int mcpMin=0, mcpMax=0, mcprefG=0, mcxG=0, mcx=mccol.n-mcnum.n;
  mpiAllReduce(mce,   mceG,   mpiCommWorld, mpiMAX);
  mpiAllReduce(mcec,  mcecG,  mpiCommWorld, mpiMAX);
  mpiAllReduce(mcpath, mcpMin, mpiCommWorld, mpiMIN);
  mpiAllReduce(mcpath, mcpMax, mpiCommWorld, mpiMAX);
  mpiAllReduce(mcpref, mcprefG, mpiCommWorld, mpiMIN);
  mpiAllReduce(mcx,   mcxG,   mpiCommWorld, mpiSUM);
  mpiAllReduce(mclhsL, mclhs, mpiCommWorld, mpiSUM);
  mpiAllReduce(mcrhsL, mcrhs, mpiCommWorld, mpiSUM);
  real mcrel = (abs(mclhs) > 1e-30) ? abs(mclhs-mcrhs)/abs(mclhs) : abs(mclhs-mcrhs);

  if (mpirank == 0)
    cout << "  [" << mcTag << "] chemin " << mcpMin << "  prefixe " << mcprefG
         << "  distantes " << mcxG
         << " | Pu " << mceG << " | P1 " << mcecG << " | adj " << mcrel
         << "  => " << (mceG < 1e-10 && mcecG < 1e-10 && mcrel < 1e-8
                        && mcprefG == 1 && mcpMin == mcpMax ? "PASS" : "FAIL") << endl;
  assert(mcprefG == 1);
  assert(mceG < 1e-10 && mcecG < 1e-10);
  assert(mcrel < 1e-8);
  assert(mcpMin == mcpMax);
}// EOM

/* --- Z1, Z2, Z4, Z5 : chemin general ---------------------------------- */
{
  int ovz = (ov == 0) ? 1 : ov;
  mesh3 Ja = cube(nc5, nc5, nc5);
  mesh3 Jb = cube(nc6, nc6, nc6, [0.25 + 0.5*x, 0.25 + 0.5*y, 0.25 + 0.5*z]);
  Dmesh3 DJa = distribute(Ja, overlap = ovz);
  Dmesh3 DJb = distribute(Jb, overlap = ovz);
  mesh3 LJa = DJa.local, LJb = DJb.local;
  MATCHECK(DJa, DJb, LJa, LJb, P1, P1, "Z1 general P1->P1")
  MATCHECK(DJa, DJb, LJa, LJb, P2, P1, "Z4 croise  P2->P1")
}

/* --- Z3 : chemin emboite ---------------------------------------------- */
{
  int ovz = (ov == 0) ? 1 : ov;
  mesh3 Ja = cube(ncnest, ncnest, ncnest);
  mesh3 Jb = cube(2*ncnest, 2*ncnest, 2*ncnest);
  int[int] ja(Ja.nt), jb(Jb.nt);
  SLABS(Ja, 0.0, ja)
  SLABS(Jb, 0.0, jb)
  Dmesh3 DJa = distribute(Ja, overlap = ovz, partition = ja);
  Dmesh3 DJb = distribute(Jb, overlap = ovz, partition = jb);
  mesh3 LJa = DJa.local, LJb = DJb.local;
  MATCHECK(DJa, DJb, LJa, LJb, P1, P1, "Z3 emboite P1->P1")
}

/* --- Z6 : maillages disjoints ----------------------------------------- */
{
  int ovz = (ov == 0) ? 1 : ov;
  mesh3 Ja = cube(6, 6, 6);
  mesh3 Jb = cube(4, 4, 4, [2.0 + x, 2.0 + y, 2.0 + z]);
  Dmesh3 DJa = distribute(Ja, overlap = ovz);
  Dmesh3 DJb = distribute(Jb, overlap = ovz);
  mesh3 LJa = DJa.local, LJb = DJb.local;
  MATCHECK(DJa, DJb, LJa, LJb, P1, P1, "Z6 disjoints     ")
}

mpiBarrier(mpiCommWorld);
if (mpirank == 0)
  cout << "== jalons 1 a 9 : toutes les assertions passent ==" << endl;

// =======================================================================
//  JALON 10 : diagnostic de couverture (transferCoverage)
// =======================================================================
//  transferCoverage(P, out) renseigne out = [nEmpty, nPartial, vmin, nRows]
//  et renvoie le chemin. Les quatre valeurs sont LOCALES au rang -- comme
//  probeRawTransfer, la reduction est a la charge du script.
//
//  INVARIANT TESTE
//  ---------------
//  cover est l'interpolee de la partition de l'unite : elle vaut 1 sur tout
//  DDL destination atteint par au moins un fragment source. Deux ecarts :
//    cover ~ 0        le DDL n'est couvert par aucun fragment, et
//                     applyTransferPlan le laisse a zero. C'est le zero
//                     silencieux que ce diagnostic rend visible.
//    0 < cover != 1   couverture partielle. Benin pour du Lagrange (le
//                     quotient se simplifie des que les poids sont uniformes
//                     sur les noeuds de l'element), mais signale que la
//                     troncature par barycentre de buildFragmentFor a jete
//                     des elements qu'elle n'aurait pas du.
//
//  CV1. Couverture nominale. Th4 est strictement inclus dans Th1, donc aucun
//      DDL ne doit manquer. C'est le test de NON-REGRESSION du jalon : il
//      tombe le jour ou buildFragmentFor se met a perdre des elements.
//  CV2. Couverture debordante. Th2 = [0.5,1.5]^3 sort de Th1 = [0,1]^3.
//      L'oracle n'est PAS un nombre fige -- il dependrait du partitionneur
//      et se perimerait a la premiere mise a jour de metis. On transfere
//      u = 1, dont l'image vaut EXACTEMENT 1 sur tout DDL couvert et
//      EXACTEMENT 0 sinon (numerateur et denominateur sont la meme somme),
//      et on verifie que le nombre de zeros egale nEmpty. Cela verifie que
//      le diagnostic compte bien ce qu'il annonce. Croise avec un oracle
//      geometrique : aucun DDL strictement interieur a Th1 ne doit etre nul.
//  CV3. Les trois chemins. nRows doit valoir le ndof destination sur
//      XFER_GENERAL, XFER_SINGLE_RANK et XFER_LOCAL. Ce dernier est le seul
//      ou le plan ne stocke aucun vecteur cover (cover.resize(0)) : sans le
//      cas particulier de transferCoverage il renverrait 0 au lieu du ndof.
//      La paire emboitee empruntee ici passe bien par XFER_LOCAL des que
//      mpisize > 1 ; a np = 1 tout passe par XFER_SINGLE_RANK.

// --- CV1 : couverture nominale ----------------------------------------------
{
  fespace WyS1(DTh1, P1);
  fespace WyD1(DTh4, P1);
  Dtransfer3 Py1 = transferPlan(WyS1, WyD1);
  real[int] sy1(4);
  int py1 = transferCoverage(Py1, sy1);

  int nEy1 = int(sy1[0]), nPy1 = int(sy1[1]);
  real vmy1 = sy1[2];
  int okRy1 = (int(sy1[3]) == WyD1.ndof) ? 1 : 0;

  int gEy1 = 0, gPy1 = 0, gRy1 = 0;
  real gVy1 = 0;
  mpiAllReduce(nEy1, gEy1, mpiCommWorld, mpiSUM);
  mpiAllReduce(nPy1, gPy1, mpiCommWorld, mpiSUM);
  mpiAllReduce(okRy1, gRy1, mpiCommWorld, mpiMIN);
  mpiAllReduce(vmy1, gVy1, mpiCommWorld, mpiMIN);

  if (mpirank == 0)
    cout << "  [CV1 couverture nominale] vides = " << gEy1 << "  partiels = " << gPy1
         << "  min cover = " << gVy1 << "  nRows ok = " << gRy1
         << "   => " << (gEy1 == 0 && gPy1 == 0 && abs(gVy1 - 1.0) < 1e-9 && gRy1 == 1
                         ? "PASS" : "FAIL") << endl;
  assert(gEy1 == 0 && gPy1 == 0);
  assert(abs(gVy1 - 1.0) < 1e-9);
  assert(gRy1 == 1);
}

// --- CV2 : couverture debordante --------------------------------------------
{
  fespace WyS2(DTh1, P1);
  fespace WyD2(DTh2, P1);
  Dtransfer3 Py2 = transferPlan(WyS2, WyD2);
  real[int] sy2(4);
  transferCoverage(Py2, sy2);

  V1 uy2 = 1.0;
  V2 gy2 = 0;
  interpolateD(WyS2, uy2[], WyD2, gy2[]);

  int nZy2 = 0;
  for (int i = 0; i < gy2[].n; i++) if (gy2[][i] == 0.0) nZy2++;
  int nEy2 = int(sy2[0]);
  int okEy2 = (nZy2 == nEy2) ? 1 : 0;

  V2 yx = x, yy = y, yz = z;
  real bandy2 = 2.0 * Loc1.hmax;
  int nBy2 = 0;
  for (int i = 0; i < gy2[].n; i++) {
    real a = yx[][i], b = yy[][i], c = yz[][i];
    if (a > bandy2 && a < 1 - bandy2 && b > bandy2 && b < 1 - bandy2
        && c > bandy2 && c < 1 - bandy2)
      if (gy2[][i] == 0.0) nBy2++;
  }

  int gEy2 = 0, gOky2 = 0, gBy2 = 0;
  mpiAllReduce(nEy2, gEy2, mpiCommWorld, mpiSUM);
  mpiAllReduce(okEy2, gOky2, mpiCommWorld, mpiMIN);
  mpiAllReduce(nBy2, gBy2, mpiCommWorld, mpiSUM);

  if (mpirank == 0)
    cout << "  [CV2 couverture debord.]  vides = " << gEy2
         << "  zeros == nEmpty : " << gOky2
         << "  interieurs nuls = " << gBy2
         << "   => " << (gEy2 > 0 && gOky2 == 1 && gBy2 == 0 ? "PASS" : "FAIL") << endl;
  assert(gEy2 > 0);        /* sinon le test serait vacuous */
  assert(gOky2 == 1);
  assert(gBy2 == 0);
}

// --- CV3 : les trois chemins, et le cas cover vide --------------------------
{
  int ovy3 = (ov == 0) ? 1 : ov;
  mesh3 Ya = cube(ncnest, ncnest, ncnest);
  mesh3 Yb = cube(2*ncnest, 2*ncnest, 2*ncnest);
  int[int] ya(Ya.nt), yb(Yb.nt);
  SLABS(Ya, 0.0, ya)
  SLABS(Yb, 0.0, yb)
  Dmesh3 DYa = distribute(Ya, overlap = ovy3, partition = ya);
  Dmesh3 DYb = distribute(Yb, overlap = ovy3, partition = yb);

  fespace WyS3(DYa, P1);
  fespace WyD3(DYb, P1);
  Dtransfer3 Py3 = transferPlan(WyS3, WyD3);
  real[int] sy3(4);
  int py3 = transferCoverage(Py3, sy3);

  int okRy3 = (int(sy3[3]) == WyD3.ndof) ? 1 : 0;
  /* sur XFER_LOCAL le plan ne stocke pas de cover : le cas particulier de
     transferCoverage doit renvoyer 0 vide, 0 partiel et un min a 1 */
  int okLy3 = 1;
  if (py3 == 2)
    okLy3 = (int(sy3[0]) == 0 && int(sy3[1]) == 0 && abs(sy3[2] - 1.0) < 1e-12) ? 1 : 0;
  /* non-vacuite : des que mpisize > 1, cette paire doit emprunter XFER_LOCAL */
  int okPy3 = (mpisize == 1) ? (py3 == 1 ? 1 : 0) : (py3 == 2 ? 1 : 0);

  int gRy3 = 0, gLy3 = 0, gPy3 = 0;
  mpiAllReduce(okRy3, gRy3, mpiCommWorld, mpiMIN);
  mpiAllReduce(okLy3, gLy3, mpiCommWorld, mpiMIN);
  mpiAllReduce(okPy3, gPy3, mpiCommWorld, mpiMIN);

  if (mpirank == 0)
    cout << "  [CV3 chemins/cover vide]  chemin = " << py3
         << "  nRows ok = " << gRy3 << "  invariants XFER_LOCAL = " << gLy3
         << "  chemin attendu = " << gPy3
         << "   => " << (gRy3 == 1 && gLy3 == 1 && gPy3 == 1 ? "PASS" : "FAIL") << endl;
  assert(gRy3 == 1);
  assert(gLy3 == 1);
  assert(gPy3 == 1);
}

mpiBarrier(mpiCommWorld);
if (mpirank == 0)
  cout << "== jalon 10 : diagnostic de couverture, assertions passees ==" << endl;
