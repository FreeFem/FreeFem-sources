// NBPROC 2
// PARAM -wg -ns -ffddm_overlap 1
include "ffddm.idp"
load "PETSc"

meshS Th = square3(20, 20);
DmeshS DTh = distribute(Th, overlap = ffddmoverlap);
meshS ThLocal = DTh.local;

// --- scalaire P2 ---
fespace UhS(ThLocal,P2), UdhS(DTh,P2), UhGS(Th,P2);
real[int] DS = UdhS.D; int[int] l2gS = UdhS.loc2glob;
assert(DS.n==UdhS.ndof && l2gS.n==UdhS.ndof);
func fa = x+2*y+3*z+x*y;  UhGS gGS=fa; UhS gLS=fa;
real eBijS=0; for(int i=0;i<gLS.n;++i) eBijS=max(eBijS,abs(gLS[][i]-gGS[][l2gS[i]]));
real[int] dS(UdhS.ndof); for(int i=0;i<UdhS.ndof;++i) dS[i]=DS[i]*gGS[][l2gS[i]];
real[int] aS(UhGS.ndof); aS=0; for(int i=0;i<UdhS.ndof;++i) aS[l2gS[i]]+=dS[i];
real[int] aGS(UhGS.ndof); mpiAllReduce(aS,aGS,mpiCommWorld,mpiSUM);
real ePoUS=0; for(int i=0;i<UhGS.ndof;++i) ePoUS=max(ePoUS,abs(aGS[i]-gGS[][i]));

// --- vectoriel [P2,P2,P2] ---
fespace UhV(ThLocal,[P2,P2,P2]), UdhV(DTh,[P2,P2,P2]), UhGV(Th,[P2,P2,P2]);
real[int] DV = UdhV.D; int[int] l2gV = UdhV.loc2glob;
assert(DV.n==UdhV.ndof && l2gV.n==UdhV.ndof);
UhV [v1,v2,v3]=[x+2*y,y-z,x*z]; UhGV [V1,V2,V3]=[x+2*y,y-z,x*z];
real eBijV=0; for(int i=0;i<v1[].n;++i) eBijV=max(eBijV,abs(v1[][i]-V1[][l2gV[i]]));
real[int] dV(UdhV.ndof); for(int i=0;i<UdhV.ndof;++i) dV[i]=DV[i]*V1[][l2gV[i]];
real[int] aV(UhGV.ndof); aV=0; for(int i=0;i<UdhV.ndof;++i) aV[l2gV[i]]+=dV[i];
real[int] aGV(UhGV.ndof); mpiAllReduce(aV,aGV,mpiCommWorld,mpiSUM);
real ePoUV=0; for(int i=0;i<UhGV.ndof;++i) ePoUV=max(ePoUV,abs(aGV[i]-V1[][i]));

real eBS,ePS,eBV,ePV;
mpiAllReduce(eBijS,eBS,mpiCommWorld,mpiMAX); mpiAllReduce(ePoUS,ePS,mpiCommWorld,mpiMAX);
mpiAllReduce(eBijV,eBV,mpiCommWorld,mpiMAX); mpiAllReduce(ePoUV,ePV,mpiCommWorld,mpiMAX);
if (mpirank==0){
  cout << "==== SWEEP (np=" << mpisize << ", overlap=" << ffddmoverlap << ") ====" << endl;
  cout << " P2 scal : bij=" << eBS << " PoU=" << ePS << endl;
  cout << " [P2]^3  : bij=" << eBV << " PoU=" << ePV << endl;
  cout << ((eBS<1e-8&&ePS<1e-8&&eBV<1e-8&&ePV<1e-8)?" => PASS":" => FAIL") << endl;
}
