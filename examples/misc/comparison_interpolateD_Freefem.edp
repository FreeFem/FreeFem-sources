// NBPROC 1
//PARAMS -ns -wg
load "medit"
load "Element_P3"
load "PETSc"
load "mmg"

macro dimension()3// EOM
include "macro_ddm.idp"

macro FSRC() (1 + x + 2*y + 3*z + sin(3*pi*x)*cos(2*pi*y) + z*z) // EOM

// Maillages raffinés & EF associés
mesh3 Th1, Th2;
Th1 = cube(15,15,15);
if (mpirank == 0) {
    fespace Mh(Th1, P1);
    Mh met = max(min(((x-0.5)^2+(y-0.5)^2+(z-0.5)^2), 0.2), 2e-3);
    Th1 = mmg3d(Th1, metric = met[], hgrad = 2);
    Th2 = mmg3d(Th1, hmax = 0.08);
}
broadcast(processor(0), Th1);
broadcast(processor(0), Th2);

fespace Uh(Th1, P2);
fespace Vh(Th2, P3);

// Distributed meshes
Dmesh3 DTh1 = distribute(Th1, keepGlobal = true);
Dmesh3 DTh2 = distribute(Th2, keepGlobal = true);

fespace Udh(DTh1, P2);
fespace Vdh(DTh2, P3);

// Same but macro_ddm
mesh3 ThA = Th1, ThB = Th2;
DmeshCreate(ThA);
DmeshCreate(ThB);

fespace VA(ThA, P2);
fespace VB(ThB, P3);

/*
medit("Th1", Th1);
medit("Th2", Th2);
*/

// Référence au global
Uh ug = FSRC;
matrix AFF = interpolate(Uh, Uh);
Uh ugInterp; ugInterp[] = AFF*ug[];

macro InterpMatD(WS, WD, A, colNum)
{
    Dtransfer3 plTmp = transferPlan(WS, WD);
    int[int] numTmp = WS.numbering;
    interpolateMat(plTmp, numTmp, A, colNum);
} // EOM

// V0: identical mesh, identical EF, identity matrix, v == u
if (mpisize == 1){
    // Vecteur référence
    mesh3 L1 = DTh1.local;
    fespace u1(L1,P2);
    u1 uD = FSRC;
    VA uA = FSRC;
    // Native
    matrix Anative;
    real[int] colNum;
    InterpMatD(Udh, Udh, Anative, colNum);
    Udh uNative;
    uNative[] = Anative*uD[];
    // macro_ddm
    Mat MA, C;
    MatCreate(ThA, MA, P2);
    MatInterpolate(ThA, P2, MA, ThA, P2, MA, C);
    real[int] uC = C*uA[];
    // Comparison
    matrix D = Anative - AFF;
    cout << "Norm of the matrix difference (Anative - AFF): " << D.linfty << endl;
    real[int] du = ugInterp[] - ug[];
    cout << "Norm of the vector differences (AFF - u original): " << du.linfty << endl;
    real[int] dv = uNative[] - ugInterp[];
    cout << "Norm of the vector differences (Anative - AFF): " << dv.linfty << endl;
    real[int] dA = uNative[] - uC;
    cout << "Norm of the vector differences (Anative - macro_ddm): " << dA.linfty << endl;
    real[int] dM = ugInterp[] - uC;
    cout << "Norm of the vector differences (AFF - macro_ddm): " << dM.linfty << endl;
}
